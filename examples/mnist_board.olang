# MNIST by a settling system that the board can run (docs/settling.md 4, 5.6, 5.9; docs/redesign.md M11): a 784-H-10 dyn
# system, certified and held in the certified set (Restrain after every step - the board runs only certified systems),
# taught by equilibrium propagation with its lessons' settles in floating point (dyn's) or on the simulated board
# engine (board/engine: the processing system pushes the drives and quantized weights, the engine settles in fixed
# point, the states go back into the system and the contrast and Adam's step are taken in F32 on the master weights).
# After every epoch the test set is answered both ways - free settles in F32 and on the board - with the agreement of
# their answers. Arguments, all optional: the epochs (3), "float" or "board" for where the lessons settle (board), the
# training samples used (60000), the hidden neurons (128), the batch (32), the seed (1), Adam's rate (0.001), beta (0.5)
# and the readout's temperature (0.25). The spiking system on the board is covered by board/engine's tests (XOR and the
# firing rates), not by an MNIST run.

import "std/io"
import "std/json"
import "std/os"
import "std/rand"
import "std/time"
import "../board/engine"
import "../data/loader"
import "../data/mnist"
import "../dyn/conn"
import "../dyn/learn"
import "../dyn/neuron"
import "../dyn/settle"
import "../dyn/system"
import "../nn/optim"

fn number(args Array<String&>&, i I64, fallback F64) F64 ? json.Error {
    if i >= args.Len(): return fallback
    return try json.Json.Parse(args[i]).AsNum()
}

fn main() ? {
    args := os.Args()
    epochs := I64(try number(args, 1, 3))
    onBoard Bool = args.Len() <= 2 or args[2] == "board"
    samples := I64(try number(args, 3, 60000))
    hidden := I64(try number(args, 4, 128))
    batch := I64(try number(args, 5, 32))
    seed := U64(try number(args, 6, 1))
    rate := try number(args, 7, 0.001)
    beta := try number(args, 8, 0.5)
    temperature := try number(args, 9, 0.25)
    data := try mnist.Mnist.Load("data/mnist", mnist.Source)
    part := loader.Labeled(data.Train.Features[:samples * 784], data.Train.Labels[:samples], 784, 10)

    s := system.System<F32>(batch)
    pixels := s.Population(s.Root(), "pixels", 784, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    inner := s.Population(s.Root(), "hidden", hidden, neuron.Neuron.Rate(neuron.Rho.Tanh))
    digits := s.Population(s.Root(), "digits", 10, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes(temperature)))
    s.Connect(pixels, inner, conn.Wiring.Dense)
    s.Connect(inner, digits, conn.Wiring.Dense, reciprocal = true)
    try s.Plan(rand.Rand(seed))
    s.Certify(0.9)
    l := try learn.Learner<F32>(s)
    e := try engine.Engine.Lower(s)
    opt := optim.AdamW(s.Params(), s.ParamGrads(), rate = rate)
    try io.PutLine(("784-" + $hidden + "-10 settling system for the board, " + $s.Params().Count() + " parameters, lessons settled " +
        $("on the board" if onBoard else "in F32") + ", batches of " + $batch + ", beta " + $beta + ", T " + $temperature +
        "; a sweep " + $(e.SweepCycles()) + " cycles and the constant " + $(e.ConstantCycles()) + " at one row on the board"))
    trainSet := loader.Loader(part, batch, seed)
    testSet := loader.Loader(data.Test, batch, seed, false)
    for k in range 1, epochs + 1 {
        t0 := time.Now()
        trainSet.Epoch()
        refused := 0
        for b in range trainSet.Batches() {
            if trainSet.Fill(b, s.Pop(pixels).Drive, s.Pop(digits).Labels) < batch: continue
            try teach(s, l, e, beta, onBoard) catch {
                refused++
                continue
            }
            opt.Step()
            s.Restrain(0.9)
            try e.Load(s)
        }
        spent := F64(time.Since(t0)) * 1e-9
        t1 := time.Now()
        boardRight, floatRight, agree, sweeps := answer(s, e, testSet, pixels, digits)
        try io.PutLine(("epoch " + $k + ": " + $refused + " lessons refused, " + $spent.Fixed(1) + " s; test accuracy " + $(100.0 * floatRight).Fixed(2) +
            "% in F32, " + $(100.0 * boardRight).Fixed(2) + "% on the board (" + $sweeps.Fixed(1) + " sweeps a settle), answers agreeing on " +
            $(100.0 * agree).Fixed(2) + "% (" + $(F64(time.Since(t1)) * 1e-9).Fixed(1) + " s); constants clipped " +
            $(100.0 * F64(e.Clipped) / F64(e.Constants)).Fixed(2) + "%, totals or potentials saturated " + $(e.Saturations) + " times"))
    }
}

# one lesson on the batch in s's drives, its settles where asked; refused (the gradients then as they were) where a settle
# does not settle within its budget
fn teach(s mut system.System<F32>&, l mut learn.Learner<F32>&, e mut engine.Engine&, beta F64, onBoard Bool) ? learn.LearnError, engine.NotSettled {
    if not onBoard {
        try l.Lesson(s.Root(), beta)
        return
    }
    try e.Lesson(s, beta)
    l.Contrast(s.Root(), beta)
}

# the test set answered on the board and by dyn in F32, by free settles: the board's accuracy, dyn's, the fraction of
# samples both answer alike, and the sweeps a settle took on the board (a refused settle counts as wrong)
fn answer<D>(s mut system.System<F32>&, e mut engine.Engine&, l mut loader.Loader<D>&, pixels system.Pop, digits system.Pop) F64, F64, F64, F64 {
    l.Epoch()
    classes := Array<I32>(s.Batch)
    floatAnswers := Array<I32>(s.Batch)
    right, floatRight, agree, seen, sweeps, settles := 0, 0, 0, 0, 0, 0
    tol := s.LessonTolerance(0.5)
    budget := s.BudgetFor(tol).Sweeps
    col := e.RegionDesc[I64(digits) * engine.RegionWords + 1]
    e.Nudge(settle.Phase.Free, 0)
    for b in range l.Batches() {
        n := l.Fill(b, s.Pop(pixels).Drive, classes)
        seen += n
        s.Settle(settle.Phase.Free, settle.Budget(budget, tol))
        s.Predict(settle.Phase.Free, digits, floatAnswers)
        e.Inputs(s, n)
        ok Bool = true
        try e.Settle(settle.Phase.Free, budget, tol) catch engine.NotSettled { ok = false }
        sweeps += e.Last.Sweeps
        settles++
        for i in range n {
            best I64 = 0
            for j in range 1, 10 {
                if e.Activity(settle.Phase.Free, i, col + j) > e.Activity(settle.Phase.Free, i, col + best): best = j
            }
            if ok and I32(best) == classes[i]: right++
            if floatAnswers[i] == classes[i]: floatRight++
            if ok and I32(best) == floatAnswers[i]: agree++
        }
    }
    return F64(right) / F64(seen), F64(floatRight) / F64(seen), F64(agree) / F64(seen), F64(sweeps) / F64(settles)
}
