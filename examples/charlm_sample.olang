# text from the model examples/charlm.olang trained, loaded from data/shakespeare/charlm.ckpt: generated twice from one
# seed - with a key-value cache (each token run once) and running the context again for each token - timed, and the
# two compared: greedily (temperature 0) they must agree for as long as the context is not full. Arguments: the
# characters (500), the temperature (0.8), the seed (1)

import "std/io"
import "std/json"
import "std/os"
import "std/rand"
import "std/time"
import "../nn"
import "../train"
import "../generate"
import "../datasets/text"

depth I64 = 4
width I64 = 128
heads I64 = 4
context I64 = 64

fn main() ? io.IoError + os.OsError + text.TextError + ParseError + json.JsonError + nn.CheckpointError {
    args := os.Args()
    count I64 = 500
    if args.Len() > 1 { count = try args[1].ParseInt() }
    temperature F64 = 0.8
    if args.Len() > 2 { temperature = try (try json.Parse(args[2])).AsNum() }
    seed U64 = 1
    if args.Len() > 3 { seed = U64(try args[3].ParseInt()) }
    c := try text.Load("data/shakespeare/input.txt")
    r := rand.Rand(seed)
    dec := nn.Graph<F32>(context, 1, true)
    dm := train.Gpt(dec, c.Size(), context, width, heads, depth)
    dec.Plan(r)
    try dec.Load("data/shakespeare/charlm.ckpt")
    full := nn.Graph<F32>(context, 1)
    fm := train.Gpt(full, c.Size(), context, width, heads, depth)
    full.Plan(r)
    try full.Load("data/shakespeare/charlm.ckpt")

    greedyCached := try generate.Cached(dec, dm, c, "ROMEO:", context - 6, 0.0, r)
    greedyRerun := try generate.Rerun(full, fm, c, "ROMEO:", context - 6, 0.0, r)
    verdict := "agree" if greedyCached == greedyRerun else "DIFFER"
    try io.Print("greedy, " $context " characters: the cache and the rerun " $verdict "\n")

    ra := rand.Rand(seed)
    t0 := time.Now()
    sample := try generate.Cached(dec, dm, c, "\n", count, temperature, ra)
    cachedNs := time.Since(t0)
    rb := rand.Rand(seed)
    t1 := time.Now()
    again := try generate.Rerun(full, fm, c, "\n", count, temperature, rb)
    rerunNs := time.Since(t1)
    try io.Print($count " characters at temperature " $temperature ": " $(F64(count) / (F64(cachedNs) * 1e-9)).Fixed(0)
        " a second with the cache, " $(F64(count) / (F64(rerunNs) * 1e-9)).Fixed(0) " running the context again\n")
    try io.Print("--- with the cache ---\n" $sample "\n--- running the context again ---\n" $again "\n---\n")
}
