# MNIST with a small convolutional network: two 3x3 convolutions (padding 1) of C1 and C2 channels, each followed by
# ReLU and 2x2 max pooling, then one dense layer from the 7 x 7 x C2 features to the 10 classes - softmax
# cross-entropy, batches of 128, AdamW at 1e-3, measured on the test set after every epoch, as examples/mnist_mlp.olang
# measures its perceptron. Each convolution is im2col into the graph's workspace and one product (conv.olang), so a
# step allocates nothing: resident memory is printed after the first steps and after every epoch to show it stays
# flat. With "profile" as the last argument, the time of each kind of operation is printed after the first epoch.
# Arguments, all optional: the epochs (3), the seed (1), the threads (1), C1 (16), C2 (32).

import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../nn"
import "../layers"
import "../optim"
import "../train"
import "../vision"
import "../datasets/idx"
import "../datasets/loader"
import "../datasets/mnist"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() or args[i] == "profile" { return fallback }
    return try args[i].ParseInt()
}

# the process's resident memory, kB
fn rss() I64 {
    t := try os.ReadFile("/proc/self/status") catch default ""
    i := try t.Find("VmRSS:") catch default 0
    rest := t[i + 6:]
    j := try rest.Find("kB") catch default 0
    return try rest[:j].Trim().ParseInt() catch default -1
}

fn main() ? io.IoError + os.OsError + mnist.MnistError + idx.IdxError + ParseError {
    args := os.Args()
    epochs := try number(args, 1, 3)
    seed := U64(try number(args, 2, 1))
    threads := try number(args, 3, 1)
    c1 := try number(args, 4, 16)
    c2 := try number(args, 5, 32)
    profile Bool = args.Len() > 1 and args[args.Len() - 1] == "profile"
    data := try mnist.Load("data/mnist", mnist.Source)

    batch I64 = 128
    g := nn.Graph<F32>(batch, threads)
    x := g.Input(784)
    y := g.Classes()
    conv1 := vision.NewConv(g, 1, c1, 3, 28, 28, 1, 1)               # 28 x 28 x C1
    conv2 := vision.NewConv(g, c1, c2, 3, 14, 14, 1, 1)              # 14 x 14 x C2
    head := layers.NewDense(g, 7 * 7 * c2, 10)
    h1 := g.MaxPool2d(g.Relu(conv1.Apply(g, x)), c1, 28, 28, 2, 2)  # 14 x 14 x C1
    h2 := g.MaxPool2d(g.Relu(conv2.Apply(g, h1)), c2, 14, 14, 2, 2) # 7 x 7 x C2
    logits := head.Apply(g, h2)
    loss := g.SoftmaxCrossEntropy(logits, y)
    r := rand.Rand(seed)
    g.Plan(r)
    c := train.Classifier(x, y, logits, loss)
    o optim.AdamW<F32>&g = optim.AdamW<F32>(g)
    trainSet := loader.Loader(data.Train, batch, seed)
    testSet := loader.Loader(data.Test, batch, seed, false)
    try io.Print("conv 3x3 1->" $c1 ", relu, pool 2; conv 3x3 " $c1 "->" $c2 ", relu, pool 2; dense " $(7 * 7 * c2)
        "->10: " $g.ParamCount " parameters, batches of " $batch ", AdamW, " $threads " threads; the arena "
        $(F64(g.ArenaSize() * 4) * 1e-6).Fixed(1) " MB\n")
    g.Profiling = profile
    total I64 = 0
    for e in range 1, epochs + 1 {
        trainSet.Epoch()
        t0 := time.Now()
        sum F64 = 0.0
        seen I64 = 0
        for b in range trainSet.Batches() {
            n := trainSet.Fill(b, g.InputData(c.X), g.ClassData(c.Y))
            g.Forward(n)
            g.Backward(c.Loss)
            o.Step(g)
            sum += F64(g.Scalar(c.Loss)) * F64(n)
            seen += n
            if e == 1 and (b == 9 or b == 99) { try io.Print("  after step " $(b + 1) ": resident " $rss() " kB\n") }
        }
        spent := time.Since(t0)
        total += spent
        if profile and e == 1 {
            for k in range nn.KindNames.Len() {
                f := g.Times[2 * k]
                bw := g.Times[2 * k + 1]
                if f + bw > 0 {
                    try io.Print("  " $nn.KindNames[k] ": forward " $(F64(f) * 1e-9).Fixed(2) " s, backward "
                        $(F64(bw) * 1e-9).Fixed(2) " s\n")
                }
            }
            g.Profiling = false
        }
        testLoss, accuracy := train.Evaluate(g, c, testSet)
        try io.Print("epoch " $e ": train loss " $(sum / F64(seen)).Fixed(4) ", test loss " $testLoss.Fixed(4)
            ", test accuracy " $(100.0 * accuracy).Fixed(2) "%, " $(F64(spent) * 1e-9).Fixed(2) " s, resident "
            $rss() " kB\n")
    }
    try io.Print("mean epoch " $(F64(total) * 1e-9 / F64(epochs)).Fixed(2) " s\n")
}
