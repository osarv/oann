# MNIST by a settling system of dyn (docs/redesign.md 4.3, M8): 784 pixel inputs (one-way into the hidden units,
# folded into a constant once a settle), a population of tanh units, ten readouts (cross-entropy at T = 0.25), the
# hidden and readout units connected symmetrically - taught by equilibrium propagation (learn.Learner.Lesson: a free
# settle, the nudged phases at +beta and -beta side by side, their contrast) and Adam, then measured on the test set,
# where an answer is a free settle. The optimizer is nn/optim's AdamW over the system's flat parameter region. Arguments, all
# optional: the epochs (1), the training samples used (60000), the hidden units (128), the batch (32), the seed (1),
# Adam's rate (0.001), beta (0.5), the threads a sweep may be split over (1), the fraction of the weights kept (1, no
# pruning: below 1 a Prune rule (magnitude, cubic schedule) thins the trained system tick by tick), the pace of a tick
# (0.1), the lessons between ticks (200), the epochs relearned after (1) and, for a dense run (keep 1), the lessons taught after
# the epochs (0: a control with as many lessons as a pruned run took), and the sweeps: plain (Jacobi, the default), anderson
# (Anderson's acceleration, depth 5; andersonN for depth N), seidel (Gauss-Seidel) or both (Gauss-Seidel, Anderson depth 5),
# and the certificate: none (certified in the sup norm when made, then free; the default), sup or spectral (certified in
# that norm and restrained into it after every step, System.Restrain).

import "std/io"
import "std/json"
import "std/os"
import "std/rand"
import "std/time"
import "../dyn/system"
import "../dyn/neuron"
import "../dyn/conn"
import "../dyn/settle"
import "../dyn/learn"
import "../nn/optim"
import "../data/idx"
import "../data/loader"
import "../data/mnist"

fn number(args Array<String&>&, i I64, fallback F64) F64 ? json.Error {
    if i >= args.Len(): return fallback
    return try json.Json.Parse(args[i]).AsNum()
}

# the sweeps named by args[i]: plain, anderson (depth 5), andersonN (depth N), seidel, both (seidel, depth 5)
fn sweepsOf(args Array<String&>&, i I64) settle.Sweeping {
    if i >= args.Len(): return settle.Sweeping()
    word := args[i]
    if word == "seidel": return settle.Sweeping(0, true)
    if word == "both": return settle.Sweeping(5, true)
    if word == "anderson": return settle.Sweeping(5)
    if word.StartsWith("anderson"): return settle.Sweeping(I64(word[8:].ParseInt()!))
    return settle.Sweeping()
}

fn main() ? io.Error, os.Error, mnist.MnistError, idx.IdxError, json.Error, learn.LearnError {
    args := os.Args()
    epochs := I64(try number(args, 1, 1))
    samples := I64(try number(args, 2, 60000))
    hidden := I64(try number(args, 3, 128))
    batch := I64(try number(args, 4, 32))
    seed := U64(try number(args, 5, 1))
    rate := try number(args, 6, 0.001)
    beta := try number(args, 7, 0.5)
    threads := I64(try number(args, 8, 1))
    keep := try number(args, 9, 1.0)
    pace := try number(args, 10, 0.1)
    between := I64(try number(args, 11, 200))
    relearn := I64(try number(args, 12, 1))
    extra := I64(try number(args, 13, 0))
    data := try mnist.Mnist.Load("data/mnist", mnist.Source)
    part := loader.Labeled(data.Train.Features[:samples * 784], data.Train.Labels[:samples], 784, 10)

    s := system.System<F32>(batch, threads)
    pixels := s.Population(s.Root(), "pixels", 784, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    inner := s.Population(s.Root(), "hidden", hidden, neuron.Neuron.Rate(neuron.Rho.Tanh))
    digits := s.Population(s.Root(), "digits", 10, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes()))
    s.Connect(pixels, inner, conn.Wiring.Dense)
    s.Connect(inner, digits, conn.Wiring.Symmetric)
    if keep < 1.0: s.Attach(s.Root(), system.Rule.Prune(conn.Score.Magnitude, keep, pace, 0.0, conn.Schedule.Cubic), system.Clock.Episode)
    s.Plan(rand.Rand(seed))!
    s.Use(sweepsOf(args, 14))
    cert := args[15] if 15 < args.Len() else "none"
    if cert != "spectral": s.Bound = system.Norm.Sup
    s.Certify(0.9)
    restrain := cert == "sup" or cert == "spectral"
    l := learn.Learner<F32>(s)!
    opt := optim.AdamW(s.Params(), s.ParamGrads(), rate = rate)
    tol := s.LessonTolerance(beta)
    try io.Put(("784-" + $hidden + "-10 settling system (dyn), " + $s.Params().Count() + " parameters, " + $samples + " training samples, batches of " +
        $batch + ", beta " + $beta + ", lesson tolerance " + $tol + ", budget " + $s.BudgetFor(tol, beta).Sweeps + " sweeps, " + $threads + " threads, " +
        $s.Scheme + ", gain " + $s.Gain().Fixed(3) + ", spectral bound " + $s.Contraction().Fixed(3) + "\n"))

    trainSet := loader.Loader(part, batch, seed)
    testSet := loader.Loader(data.Test, batch, seed, false)
    labels := Array<I32>(batch)
    for e in range 1, epochs + 1 {
        try epoch(s, l, opt, trainSet, testSet, pixels, digits, tol, beta, labels, "epoch " + $e, 0, restrain)
    }
    if keep >= 1.0 {
        if extra > 0: try epoch(s, l, opt, trainSet, testSet, pixels, digits, tol, beta, labels, "extra " + $extra, extra, restrain)
        return
    }
    m := s.Macs()
    try io.Put("dense: " + $m.Once + " multiply-adds once a settle, " + $m.Sweep + " a sweep\n")
    ticks := 0
    for not thinned(s, keep) {
        trainSet.Epoch()
        trainSet.Fill(0, s.Pop(pixels).Drive, s.Pop(digits).Labels)
        s.Settle(settle.Phase.Free, settle.Budget())
        try l.Tick(system.Clock.Episode)
        ticks++
        try epoch(s, l, opt, trainSet, testSet, pixels, digits, tol, beta, labels, "tick " + $ticks, between, restrain)
    }
    for e in range 1, relearn + 1 {
        try epoch(s, l, opt, trainSet, testSet, pixels, digits, tol, beta, labels, "relearn " + $e, 0, restrain)
    }
    converted := s.Sparsify(0.5)
    try show(s, testSet, pixels, digits, tol, labels, "sparse rows (" + $converted + " connections): ")
}

# the weights live against all of them
fn thinned(s system.System<F32>&, keep F64) Bool {
    live, all := 0, 0
    for c in range s.E.Links.Len() {
        lk := s.Link(system.Conn(c))
        live += lk.Live()
        all += lk.PostSize * lk.PreSize
    }
    return live <= I64((keep * F64(all)).Ceil())
}

# one pass of lessons (the first "lessons" batches, or the whole epoch at 0), each with an optimizer step and the masks
# held, then the test set: prints the accuracy, the sweeps an answer and the multiply-adds a settle
fn epoch<D>(s mut system.System<F32>&, l mut learn.Learner<F32>&, opt mut optim.AdamW<F32, F32>&, trainSet mut loader.Loader<D>&, testSet mut loader.Loader<D>&, pixels system.Pop, digits system.Pop, tol F64, beta F64, labels mut Array<I32>&, name String&, lessons I64, restrain Bool) ? io.Error {
    t0 := time.Now()
    trainSet.Epoch()
    sweeps, taught, refused := 0, 0, 0
    loss F64 = 0.0
    for b in range trainSet.Batches() {
        if lessons > 0 and taught >= lessons: break
        if trainSet.Fill(b, s.Pop(pixels).Drive, s.Pop(digits).Labels) < s.Batch: continue
        ok := true
        lesson := try l.Lesson(s.Root(), beta) catch { ok = false } default learn.Taught()
        if not ok {
            refused++
            continue
        }
        sweeps += lesson.Sweeps
        taught++
        loss += s.Loss(settle.Phase.Free)
        opt.Step()
        s.Hold()
        if restrain: s.Restrain(0.9)
    }
    spent := F64(time.Since(t0)) * 1e-9
    try io.Put($name + ": train loss " + $(loss / F64(taught)).Fixed(4) + ", " + $(F64(sweeps) / F64(taught)).Fixed(1) +
        " sweeps a lesson, " + $refused + " refused, " + $spent.Fixed(1) + " s, " + $(spent * 1e6 / F64(taught.Max(1))).Fixed(0) + " us a lesson; ")
    try show(s, testSet, pixels, digits, tol, labels, "")
}

# the test accuracy and what an answer costs in multiply-adds, with the weights live of all
fn show<D>(s mut system.System<F32>&, testSet mut loader.Loader<D>&, pixels system.Pop, digits system.Pop, tol F64, labels mut Array<I32>&, name String&) ? io.Error {
    t0 := time.Now()
    accuracy, answer := evaluate(s, testSet, pixels, digits, tol, labels)
    each := F64(time.Since(t0)) * 1e-3 / F64(testSet.Batches())
    m := s.Macs()
    live, all := 0, 0
    for c in range s.E.Links.Len() {
        lk := s.Link(system.Conn(c))
        live += lk.Live()
        all += lk.PostSize * lk.PreSize
    }
    try io.Put($name + "gain " + $s.Gain().Fixed(3) + ", spectral bound " + $s.Contraction().Fixed(3) + ", test accuracy " + $(100.0 * accuracy).Fixed(2) + "%, " + $answer.Fixed(1) + " sweeps an answer, " + $each.Fixed(1) + " us a settle (a batch), " + $live + " of " + $all +
        " weights live, " + $m.Once + " multiply-adds once, " + $m.Sweep + " a sweep, " + $m.Settle(I64(answer.Round())) + " a settle\n")
}

# the fraction of l's samples whose free settle answers their class, and the mean sweeps an answer took; a settle that
# does not converge counts as wrong
fn evaluate<D>(s mut system.System<F32>&, l mut loader.Loader<D>&, pixels system.Pop, digits system.Pop, tol F64, labels mut Array<I32>&) F64, F64 {
    l.Epoch()
    predicted := Array<I32>(s.Batch)
    right, seen, sweeps, settles := 0, 0, 0, 0
    b := s.BudgetFor(tol)
    for k in range l.Batches() {
        n := l.Fill(k, s.Pop(pixels).Drive, labels)
        seen += n
        out := s.Settle(settle.Phase.Free, b)
        if not out.Converged: continue
        sweeps += out.Sweeps
        settles++
        s.Predict(settle.Phase.Free, digits, predicted)
        for i in range n {
            if predicted[i] == labels[i]: right++
        }
    }
    return F64(right) / F64(seen), F64(sweeps) / F64(settles)
}
