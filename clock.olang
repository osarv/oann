# Clock - a monotonic clock for timing, read through the C library: clock_gettime(CLOCK_MONOTONIC) fills a timespec,
# which on the platforms olang targets is two 64-bit numbers - seconds, then nanoseconds - so an I64[2] stands for it

extern fn clock_gettime(clock I32, ts Array<I64>) I32

# seconds since an arbitrary fixed point, to the nanosecond: the difference of two readings is the time between them
fn Now() F64 {
    ts := Array<I64>(2)
    clock_gettime(1, ts)
    return F64(ts[0]) + F64(ts[1]) * 1e-9
}

test "Now moves forward" {
    a := Now()
    s I64 = 0
    for i in range 1000000 { s += i }
    b := Now()
    assert b >= a and s > 0
}
