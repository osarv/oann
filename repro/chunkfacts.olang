# repro/chunkfacts - kernels/scan's chunked delta rule reserves everything it uses (its scratch and a gemm.Workspace per
# task in the scan.Work), and each of its parts is allocation-free by its facts when asserted alone - the job's run, the
# chunk loop, gemm's products over the chunk matrices - yet `DeltaRuleChunked<F32, F32>.Allocates` is true: the driver
# that builds the job locally from its parameters (out, state, keep, the Work's scratch slice and workspace Vec) and runs
# it is counted as allocating. Run, the resident memory does not grow with the calls (72 kB of first touches, the same
# over 2000 or 20000), so the fact is conservative, not a leak. It keeps the chunked form (1.7-2.7x faster backward) out of ad/graph, whose Forward and
# Backward are pinned allocation-free.
#   olang repro/chunkfacts.olang   prints the fact and the growth over 20000 calls; expected: false
# Status: reproduces (new)

import "std/io"
import "std/os"
import "../kernels/mat"
import sc "../kernels/scan"

fn rss() I64 ? os.Error {
    for line in (try os.ReadFile("/proc/self/status")).Lines() {
        if not line.StartsWith("VmRSS:"): continue
        kb := try line[6:].Trim().Split(" ")[0].ParseInt() catch { return 0 }
        return kb
    }
    return 0
}

fn main() ? io.Error, os.Error {
    len, heads, dim := 128, 2, 16
    n := len
    at := sc.Seq(len, 32, heads)
    w := sc.Work<F32>(1)
    w.ReserveDelta(n, heads * dim, heads * dim, at)
    q, k, v, o := Array<F32>(n * heads * dim, 0.01), Array<F32>(n * heads * dim, 0.02), Array<F32>(n * heads * dim, 0.03), Array<F32>(n * heads * dim)
    b, g := Array<F32>(n * heads, 0.5), Array<F32>(n * heads, 0.9)
    st := Array<F32>(heads * dim * dim)
    om, sm := mat.Mat<F32>(o, 0, n, heads * dim, heads * dim), mat.Mat<F32>(st, 0, heads * dim, dim, dim)
    qm, km, vm := mat.Mat<F32>(q, 0, n, heads * dim, heads * dim), mat.Mat<F32>(k, 0, n, heads * dim, heads * dim), mat.Mat<F32>(v, 0, n, heads * dim, heads * dim)
    bm, gm := mat.Mat<F32>(b, 0, n, heads, heads), mat.Mat<F32>(g, 0, n, heads, heads)
    sc.DeltaRuleChunked(w, om, sm, qm, km, vm, bm, gm, at)
    before := try rss()
    for _ in range 20000: sc.DeltaRuleChunked(w, om, sm, qm, km, vm, bm, gm, at)
    try io.PutLn("DeltaRuleChunked<F32, F32>.Allocates: " + $sc.DeltaRuleChunked<F32, F32>.Allocates + "; resident growth over 20000 calls: " + $((try rss()) - before) + " kB")
}
