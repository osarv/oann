# Narrowing to BF16 is a call per element: F32 -> BF16 (BF16(x), and so every store of a BF16 computed in F32) becomes
# a call of the C library's __truncsfbf2 - not inlined, not vectorized - and BF16 arithmetic, promoted to F32 and
# narrowed back after each operation, pays it per operation. Widening, by an integer shift (T4), runs at memory speed.
# The way round it by bits - x.Bits(), round to nearest even, U16(...).BF16FromBits() - is exact (the same bits as
# BF16(x) on every input tried) but stays scalar: FromBits goes through an empty inline asm (E33's guard against
# InstCombine), which no loop vectorizes through. Found measuring mixed precision: std/linalg's BF16 product widens
# its operands to F32 while packing but writes its result through Cast, so a 1024 x 512 x 128 product in BF16 took
# 8.2 ms against 1.3 in F32 (1024 x 128 x 128: 1.9 against 0.39) - the narrowing of its 524,288 results, not the
# arithmetic.
# Expected: narrowing about as cheap as widening (a few vector instructions per 16 elements). Actual (build with -b and
# run): about 10-14 ns an element for BF16(x), 24-27 for a BF16 multiply-add, 1.3-2 for the bits, against 0.8-1.1 for
# widening and an F32 multiply-add.
# Status: reproduces on olang 472373d (BF16(x) 8.7-10.1 ns an element, the bits 1.3, widening 0.8, at a load of 4-7);
# being changed in olang (wt-cgfix3). oann narrows by bits (kernels.ToBF16) in its own kernels; std/linalg's products it
# cannot reach.
import "std/rand"
import "std/time"

fn narrow(x F32) BF16 {
    u := x.Bits()
    h U32 = ((u >> 16) | 64) if x != x else ((u + 32767 + ((u >> 16) & 1)) >> 16)
    return U16(h).BF16FromBits()
}

fn main() ? {
    n I64 = 4 * 1024 * 1024
    a := Array<F32>(n)
    r := rand.Rand(1)
    for i in range n { a[i] = F32(r.Normal()) }
    b := Array<BF16>(n)
    c := Array<F32>(n)
    d := Array<BF16>(n)
    for round in range 3 {
        t0 := time.Now()
        for i in range n { b[i] = BF16(a[i]) }
        t1 := time.Now()
        for i in range n { c[i] = F32(b[i]) }
        t2 := time.Now()
        for i in range n { d[i] = b[i] * b[i] + b[i] }
        t3 := time.Now()
        for i in range n { c[i] = a[i] * a[i] + a[i] }
        t4 := time.Now()
        for i in range n { d[i] = narrow(a[i]) }
        t5 := time.Now()
        ns := fn(t I64) String { return $(F64(t) / F64(n)).Fixed(2) }
        println("ns an element: BF16(x) " $ns(t1 - t0) ", widening " $ns(t2 - t1) ", BF16 multiply-add " $ns(t3 - t2)
            ", F32 multiply-add " $ns(t4 - t3) ", narrowing by bits " $ns(t5 - t4))
    }
    same I64 = 0
    for i in range n {
        if narrow(a[i]).Bits() == BF16(a[i]).Bits() { same++ }
    }
    println($same " of " $n " narrowed alike")
}
