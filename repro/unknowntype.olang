# Status: reproduces (olang 184d72f19). A parameter typed by a module member that does not exist (time.Instant; std/time
# has none) passes the checker, and the build then stops in lowering: "it does not lower an unknown type (a check
# error or gap)". Expected: a check error naming the unknown type, as for an unknown plain name.
import "std/time"

fn ms(t0 time.Instant) F64 { return F64(time.Since(t0)) }

fn main() {
    Print(ms(time.Now()))
}
