# A conditional of literals - "1.0 if x > 0.0 else 0.0" - as one value of a match or of another conditional does not
# adapt to the other values' type as a literal does (S12b/E28: one type for all values, a literal adapting): it is taken
# for an F64 and the F32 values beside it are then an error. A lone literal arm adapts (case 0 => 1.0 beside an F32
# compiles), and so does the conditional when every value is a literal (return 1.0 if x > 0.0 else 0.0 from an F32
# function compiles, E28 taking the target's type); beside a value of another type it does not. Found adopting
# std/linalg's GemmAct: linalg's ActivationSlope is written this way ("case Activation.Relu => 1.0 if x > 0.0 else 0.0"
# beside "case Activation.Gelu => geluSlope(x)"), so ActivationSlope - and the matrix ActivationBackward built on it -
# does not compile for an F32 matrix at all, only for F64 (std/linalg's tests use F64). oann's own backward kernels
# (ops.ReluBackward, ops.GeluTanhBackward) are unaffected.
# Expected: compiles, printing "1 1 5". Actual: error[S12b] "every value of this match is F64, found F32" at the third
# value (and error[E28] "both values of 'a if c else b' have one type, found F64 and F32" for the nested conditional).
# Status: reproduces on olang 472373d.
fn slope(x F32, k I64) F32 {
    return match k {
        case 0 => 1.0
        case 1 => 1.0 if x > 0.0 else 0.0
        nomatch => x * 2.0
    }
}

fn pick(x F32, c Bool) F32 {
    y F32 = (1.0 if x > 0.0 else 0.0) if c else x
    return y
}

fn main() ? {
    println($slope(2.5, 0) " " $pick(2.5, true) " " $slope(2.5, 2))
}
