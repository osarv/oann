# D13c: a struct whose constructor reads through a reference parameter has no zero value, so it can never be the
# element of a List (List.grow makes Array<T>(n), zero-filled) - although List never reads those zeros, and the
# value pushed is a real one. A layer built on a graph ("Dense(g, in, out)", registering its parameters) cannot be kept
# in a List; the workaround is a plain-data struct and a factory function (NewDense).
# Actual: error[D13c] "Item has no zero value ... it reads through a null reference", pointing into std/prelude/list.
type Counter struct() {
    n mut I64 = 0
}

fn (c mut Counter&) next() I64 {
    c.n++
    return c.n
}

type Item struct(c mut Counter&) {
    id I64 = c.next()
}

fn main() ? {
    c := Counter()
    items := List<Item>()
    for i in range 3 { items.Push(Item(c)) }
    assert items.Len() == 3 and items[2].id == 3
}
