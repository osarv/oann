# vnnitile - a packed INT8 micro-kernel in the VNNI layout (b as [k/4][16][4] bytes, a's four bytes of a step broadcast
# to every lane) does not build to vpdpbusd: each lane's four adjacent products summed into I32 is written as the sum it
# is, and LLVM forms vpdpbusd only from a reduction to one value (reduce.add of mul(zext, sext) - olang's LaneDot, a
# `(x * w).Sum<I32>()` of 256-lane blocks). Here it widens every byte and multiplies with vpmaddwd on 32-bit lanes, 16
# products an instruction where vpdpbusd does 64 - the packed GemmI8's gap (kernels/gemm's dots pad the depth to 256 and
# take one reduction per output instead, its horizontal sum costing about as much as the four vpdpbusd it closes, and
# below a depth of ~192 the padding does not pay). Expected: a lane form per output vector - a `Sum<I32>` over groups of
# four lanes, or LaneDot keeping a vector accumulator - that is vpdpbusd acc, broadcast(a), b on a target with VNNI.
# Status: fixed by olang's grouped lane total, E39's Sum<A>(n) (2026-11-17, branch wt-vnnitile): the row is written
# `t.v[i * 16:i * 16 + 16] += (pa[o:o + 4] * b).Sum<I32>(4)`, a's four bytes one group's, shared by every group, and
# builds to vpbroadcastd + vpdpbusd on AVX-512 VNNI. Build from the repository's root:
#   olang build -output build/vnnitile repro/vnnitile.olang && objdump -d build/vnnitile | grep -c vpdpbusd   # 4

type tile struct() {
    v Array<I32> = Array<I32>(96)
}

# rows of 6 by 16 outputs: t[i, j] += sum over t < 4 of pa[p, i, t] qb[p, j, t] - E39's grouped total, a's four bytes
# one group's, shared by every group (vpdpbusd acc, broadcast(a), b)
fn micro(depth I64, pa Array<U8>&, qb Array<I8>&, t mut tile&) {
    for p in range depth {
        b := qb[p * 64:p * 64 + 64]
        comptime for i in range 6 {
            o I64 = p * 24 + 4 * i
            t.v[i * 16:i * 16 + 16] += (pa[o:o + 4] * b).Sum<I32>(4)
        }
    }
}

fn main() {
    pa := Array<U8>(24 * 64)
    qb := Array<I8>(64 * 64)
    for i in range pa.Len(): pa[i] = U8(i % 251)
    for i in range qb.Len(): qb[i] = I8(i % 127)
    t := tile()
    micro(64, pa, qb, t)
    Println($t.v[5])
}
