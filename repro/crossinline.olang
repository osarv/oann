# crossinline - a program whose IR passes the size from which olang links by ThinLTO (compiler/build.olang, ThinFrom, 8
# MB) loses the inlining and vectorizing a full-LTO link does: the same small product, gemm 16 x 16 x 11 in F64, takes
# 614 ns a call in this file without the graph import and the four graph lines in main, and 1379-1456 ns with them (they
# only make the program large: ad/graph instantiates every kernel). The instances of generics are split over several
# objects, and the ThinLTO link imports no body over ImportLimit (70) instructions and does not vectorize again
# (vectorizesAtLink), so a kernel loop calling a helper whose instance landed in another object calls it per element:
# elem's activations called fastExp64 per element - 12 ns an element against 2 in a small program - until elem gave them
# array-wide forms (SigmoidInPlace64, TanhInPlace64, ..., compiled beside fastExp64). Expected: a kernel as fast in a large program as in a
# small one.
# Status: fixed (olang 2026-11-16: oann programs link by full LTO) (new). Measured 2026-11-16, olang-bin, AVX-512. Build and run from the repository's root:
#   olang build -output build/crossinline repro/crossinline.olang && build/crossinline

import "std/rand"
import "std/time"
import "../ad/graph"
import "../kernels/gemm"
import "../kernels/mat"

fn main() {
    g := graph.Graph<F64>(16)
    x := g.Input(11)
    g.Keep(g.Mean(g.Act(g.Linear(x, g.Param(graph.Init.Uniform(-1.0, 1.0), false, 16, 11)), mat.Act.Tanh)))
    try g.Plan(rand.Rand(1)) catch { unreachable }
    ws := gemm.Workspace<F64>(1, 64)
    m, n, k := 16, 16, 11
    a := Array<F64>(m * k)
    b := Array<F64>(n * k)
    c := Array<F64>(m * n)
    am := mat.Mat<F64>(a, 0, m, k, k)
    bm := mat.Mat<F64>(b, 0, n, k, k)
    cm := mat.Mat<F64>(c, 0, m, n, n)
    t0 := time.Now()
    for _ in range 200000: gemm.Gemm(ws, cm, am, false, bm, true, 1.0, 1.0)
    Println("gemm 16 x 16 x 11: " + $(F64(time.Since(t0)) / 200000.0).Fixed(0) + " ns a call")
}
