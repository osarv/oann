# repro/reassignfacts - G42 counts a struct local reassigned from a method of its own value (`u = u.Inner()`, a view
# sharing u's referent) as allocating, while taking the same view into a new local does not. Found pinning ad/ops's
# storageOf (`for u.Rank() > 2: u = u.Select(0, 0)!`), which made every batched product "allocate"; unrolled there.
# Expected: both asserts hold - the struct holds a reference and a number, and nothing is made.
# Status: fixed (olang 3b47ad852, 2026-11-21); reproduced before: the first assert was a compile error (S17a).
#   olang test repro/reassignfacts.olang

type View struct(data mut Array<F32>&, depth I64) {
    data
    depth
}

fn (v View&) Inner() View { return View(v.data, v.depth - 1) }

fn reassigned(v View&) I64 {
    u := v
    for u.depth > 0: u = u.Inner()
    return u.depth
}

fn fresh(v View&) I64 {
    u := v.Inner()
    return u.depth
}

assert not reassigned.Allocates, "a local reassigned from its own view allocates nothing"
assert not fresh.Allocates, "a new local from a view allocates nothing"
