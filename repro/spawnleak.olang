# Status: fixed (olang 3b47ad852, 2026-11-21); reproduced before. A loop of joins that spawn one task keeps ~800 bytes a join when the task takes a long-lived
# struct holding arrays by reference and a generic mut value (here a Windows source and a staging buffer), against ~2
# bytes a join for repro/joinleak.olang's task over a plain array. Expected: flat.
import "std/os"
import "../data/text"

type Stage struct(tokens Array<I32>, targets Array<I32>, failure String = "") {
    tokens
    targets
    failure
}

fn resident() I64 {
    stat := try os.ReadFile("/proc/self/statm") catch { unreachable }
    return try stat.Split(" ")[1].ParseInt(10) catch { unreachable }
}

fn draw<S>(src mut S&, a mut Stage&, batch I64) {
    try src.Random(a.tokens, a.targets, batch) catch e { a.failure = $e }
}

fn step<S>(src mut S&, a mut Stage&) {
    join { spawn draw(src, a, 4) }
}

fn main() {
    src := text.Windows(Array<I32>[I32(i % 4) for i in range 800], 8, 1)
    a := Stage(Array<I32>(32), Array<I32>(32))
    for _ in range 2000: step(src, a)
    before := resident()
    for _ in range 100000: step(src, a)
    Println("grew by " + $(resident() - before) + " pages over 100000 joins")
}
