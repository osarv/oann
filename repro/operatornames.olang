# E31 reserves the operator methods' names for every method of every type, whatever the method means: a graph builder
# recording a product, g.MatMul(a, b, transA, transB), or an element-wise one, g.Mul(a, b), cannot be declared -
# "MatMul's parameters besides its receiver: expected 1, found 4". oann named them Product and Multiply. Worth
# weighing whether only a method of the operator's shape should be taken for the operator, and others left alone.
# Status: a rule (E31 - the operator methods' names, public or private since M6b, keep the operator's shape), kept as
# a record; olang 9621af3 reports it as before.
type Graph struct() {
    n mut I64 = 0
}

fn (g mut Graph&) MatMul(a I64, b I64, ta Bool, tb Bool) I64 {
    g.n++
    return g.n
}

fn main() ? {
    g := Graph()
    assert g.MatMul(1, 2, false, true) == 1
}
