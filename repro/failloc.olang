# a failing assert in a test reports only the test's name ("FAIL - the second assert fails"), not which assert or
# where - with several asserts in a test the only way to find it is to split the test. Run: olang -t failloc.olang
extern fn getpid() I32

test "the second assert fails" {
    p := getpid()
    assert p > 0
    assert p < 0
    assert p != 0
}
