# E31: "At" takes exactly one operand besides its receiver, so a matrix can be neither indexed m[r, c] nor given a
# two-argument method named At. Expected (wished): x[i, j] calls At(i, j), x[i, j] = v calls SetAt(i, j, v).
# Actual: error[E31] "At's parameters besides its receiver: expected 1, found 2" at the declaration.
type Grid struct(Cols I64) {
    Cols
    data mut Array<F32>& = Array<F32>(Cols * Cols)
}

fn (g Grid&) At(r I64, c I64) F32 { return g.data[r * g.Cols + c] }

fn main() ? {
    g := Grid(3)
    assert g.At(1, 2) == 0.0
}
