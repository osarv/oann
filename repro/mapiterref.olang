# Iterating a Map whose values hold a writable reference (a struct with a `mut Array<F32>&` field, as tensor.Tensor
# has) fails to compile inside the prelude's MapIter: "T25c: 'MapEntry' writes through or keeps its parameter 'value'
# ... this Box is a read-only copy" at std/prelude/map.olang:279. Keys() and Ref(key) work.
# Status: fixed (olang d0951cebd, `for e in m`; was m.Iter()). Expected: the loop compiles (entries read-only). Run: olang repro/mapiterref.olang

type Box struct(n I64) {
    data mut Array<F32>& = Array<F32>(n)
}

fn main() {
    m := Map<String, Box>()
    m.Put("a", Box(3))
    for e in m: Println(e.Key + " " + $e.Value.data.Len())
}
