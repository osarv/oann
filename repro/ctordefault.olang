# a constructor parameter whose default is a global fails: error[E12] "expected Mode, found ?", reported twice. The same
# default on a plain function parameter works (fn rate(m Mode = DefaultMode)), and so does writing the value itself
# (M Mode = Mode.Fast(0.5)) - oann's optim.AdamW had to repeat its default regularizer instead of naming it.
type Mode enum {
    Fast(rate F64)
    Slow
}

DefaultMode Mode = Mode.Fast(0.5)

type Runner struct(n I64, M Mode = DefaultMode) {
    M
    data mut Array<F32>& = Array<F32>(n)
}

fn main() ? {
    r := Runner(3)
    assert r.M is Mode.Fast and r.data.Len() == 3
}
