# A constructor of a non-generic struct may name a type variable in a parameter (here g mut G<<T>>&) - nothing
# rejects the declaration - but no call can be made: every call fails, at the argument, with "expected G<<T>>&, found
# G<F32>" (the type variable still spelled <<T>>, G8b's old form). Found asking whether oann's layers, which hold only
# graph handles and so are the same for every element type, could be built by a constructor taking the generic graph
# (layers.Dense(g, 784, 128)) instead of a factory function (layers.NewDense) - since olang a3ed507 the other reason for
# the factory (a constructor reading through a reference parameter had no zero value, so the layer could not be a List
# element) is gone.
# Expected: either an error at the declaration (the type declares no type parameters) or a constructor generic over
# its parameters, inferred at the call like a generic function's. Actual (olang 9621af3): error[E12] at each call.
type G<T> struct() {
    n mut I64 = 0
}

fn (g mut G<<T>>&) Param() I64 {
    g.n++
    return g.n
}

type Dense struct(g mut G<<T>>&, inputs I64) {
    W I64 = g.Param()
    In I64 = inputs
}

fn main() ? {
    g := G<F32>()
    d := Dense(g, 3)
    assert d.W == 1
}
