# L10a: a hex literal denotes a bit pattern, but one with the top bit set does not fit U64 - the constant has to be
# written U64(0x9E3779B97F4A7C15), or in decimal. Actual: error[T6] "'0x9E3779B97F4A7C15' does not fit U64".
Golden U64 = 0x9E3779B97F4A7C15
AllOnes U64 = 0xFFFFFFFFFFFFFFFF

fn main() ? {
    assert Golden == 11400714819323198485 and AllOnes == U64(0) - 1
}
