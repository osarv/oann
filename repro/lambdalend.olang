# O17 over-rejects a value lent to a callee that captures it in a lambda run by tasks. y is a local Matrix value whose
# references live in g's arena (a view, as nn.Graph.Value gives); fillPlain(y) is accepted, fill(y) - the same writes,
# made from a lambda handed to linalg.ParallelRows - is "the callee can store through it". The lambda keeps nothing
# (it writes numbers through y.Data) and ParallelRows has nowhere to keep the closure, so nothing of y outlives the
# call. Found writing nn.Graph's INT8 Linear (quant.Linear splits its rows over tasks this way); worked around by
# passing y.Data and y.Stride (quant.LinearInto).
# Expected: builds and prints "ok". Actual: error[O17] at fill(y). olang efdb82c and master 2e83597 alike.
import "std/linalg"

type G struct(n I64) {
    mem mut Array<F32>& = Array<F32>(n)
}

fn (g G&) value() linalg.Matrix<F32> { return linalg.View(g.mem, 0, 2, 2) }

fn fill(y mut linalg.Matrix<F32>&) {
    linalg.ParallelRows(2, 1, 1, fn(lo, hi) {
        for r in range lo, hi { y.Data[r * y.Stride] = 1.0 }
    })
}

fn fillPlain(y mut linalg.Matrix<F32>&) {
    for r in range 2 { y.Data[r * y.Stride] = 1.0 }
}

fn (g mut G&) run() {
    y := g.value()
    fillPlain(y)
    fill(y)
}

fn main() ? {
    g := G(4)
    g.run()
    assert g.mem[0] == 1.0 and g.mem[2] == 1.0
    println("ok")
}
