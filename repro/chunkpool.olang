# The runtime's chunk pool takes a chunk only from its head (__olang_new_chunk), and a closing scope puts its chunks on
# the pool newest first. So a function whose scope takes a large chunk and then a smaller one leaves the large one
# behind the small one: the next call finds the small one at the head, maps a new large chunk, and the old one is never
# used again. Memory grows by the large allocation on every call, for the life of the process.
# This is std/linalg's Gemm exactly: gemmIn makes its B panel (k x n, 405KB for a 128 x 784 product) and then its A
# panel (64KB), so every packed product maps 405KB that is never reused - an oann training epoch on MNIST grows by
# ~220MB, although nothing outlives a step. strace shows one mmap per call (`strace -e mmap build/chunkpool`).
# Expected: rss grows by a few kB. Actual: ~400kB per call (80MB over 200 calls).
import "std/io"
import "std/os"

fn rss() I64 {
    t := try os.ReadFile("/proc/self/status") catch default ""
    i := try t.Find("VmRSS:") catch default 0
    rest := t[i + 6:]
    j := try rest.Find("kB") catch default 0
    return try rest[:j].Trim().ParseInt() catch default -1
}

# a large scratch array and then a smaller one, both filled (so their pages are resident) and dropped at the return
fn work(big I64, small I64) F32 {
    a := Array<F32>(big, 1.0)
    b := Array<F32>(small, 2.0)
    return a[big - 1] + b[small - 1]
}

fn main() ? io.IoError {
    before := rss()
    s F32 = 0.0
    for i in range 200 { s += work(100000, 16384) }
    try io.Print("rss grew " $(rss() - before) " kB over 200 calls (" $s ")\n")
}
