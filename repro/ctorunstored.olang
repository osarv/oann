# O26 over-rejects: a constructor that only READS a reference parameter - computing its fields from it and storing no
# reference to it - still makes the instance count as referring to the argument's storage, so returning an instance
# built from a local is an error. Found writing datasets/text (Corpus(text) computes a vocabulary and token ids from
# the text and keeps neither the text nor a view of it).
# Expected: compiles; the instance holds only what its constructor built. Actual: error[O26] "this value refers to this
# function's own storage, which dies at the return - build it in '&return'" at the return. Workaround: declare the
# argument where the result lives (t String&return = ...), keeping the text alive for nothing.
type Counts struct(text String&) {
    letters I64 = count(text)
}

fn count(t String&) I64 {
    n I64 = 0
    for c in t {
        if c.IsLetter() { n++ }
    }
    return n
}

fn fromLocal() Counts {
    t := String(Array<Char>(3, 'a'))
    return Counts(t)
}

fn main() ? {
    c := fromLocal()
    assert c.letters == 3
}
