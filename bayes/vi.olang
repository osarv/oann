# bayes/vi - variational inference: automatic differentiation variational inference (ADVI, Kucukelbir et al.) of a
# Gaussian approximation q to any target.Differentiable posterior - oann's graph gives the log joint's gradient through
# target.GraphTarget. The evidence lower bound ELBO = E_q[log p(z)] + H[q] is climbed by nn/optim's Adam on
# reparameterised draws z = mu + L eps, eps ~ N(0, I): mean-field (L diagonal, 2d parameters - for large models) or
# full-rank (L lower triangular, d + d (d + 1) / 2). L's diagonal is kept as its logarithm, so it stays positive.
#
#     fit := try vi.Fit.MeanField(t, r, steps = 3000)        # fit.Q (a gauss.Gaussian), fit.Elbo
#     fit := try vi.Fit.FullRank(t, r, steps = 3000, samples = 4, rate = 0.02)

import "std/rand"
import "../tensor"
import "../nn/optim"
import "dense"
import "gauss"
import "target"
import "mcmc"
import "../ad/graph"

# a fitted approximation: q, from the variational parameters averaged over the last tenth of the steps, and the ELBO
# estimated over them
type Fit struct(d I64) {
    Q gauss.Gaussian = gauss.Gaussian(d)
    Elbo F64
}

# q with a diagonal covariance, fitted from mu = start (0 when empty), sd 1 / 10
fn Fit.MeanField<D target.Differentiable>(t D&, r mut rand.Rand&, steps I64 = 3000, samples I64 = 1, rate F64 = 0.02, start Array<F64> = Array<F64>(0)) Fit ? tensor.ShapeError {
    return try Fit.fit(t, r, steps, samples, rate, start, false)
}

# q with a full covariance, fitted from mu = start (0 when empty), L = I / 10
fn Fit.FullRank<D target.Differentiable>(t D&, r mut rand.Rand&, steps I64 = 3000, samples I64 = 1, rate F64 = 0.02, start Array<F64> = Array<F64>(0)) Fit ? tensor.ShapeError {
    return try Fit.fit(t, r, steps, samples, rate, start, true)
}

# the parameters: mu (d), then L's entries row after row, i >= j (all d (d + 1) / 2 when full, the diagonal's d when
# not), each diagonal entry as its logarithm
fn Fit.fit<D target.Differentiable>(t D&, r mut rand.Rand&, steps I64, samples I64, rate F64, start Array<F64>&, full Bool) Fit ? tensor.ShapeError {
    d := t.Dim()
    lsize := d * (d + 1) / 2 if full else d
    params := tensor.Tensor<F64>.Zeros(d + lsize)
    grads := tensor.Tensor<F64>.Zeros(d + lsize)
    p := params.Flat()!
    gr := grads.Flat()!
    for i in range start.Len(): p[i] = start[i]
    for i in range d: p[d + diagAt(i, full)] = 0.1.Log()
    opt := optim.AdamW(params, grads, rate = rate)
    z := Array<F64>(d, 0.0)
    gz := Array<F64>(d, 0.0)
    elbo F64 = 0.0
    tail := (steps / 10).Max(1)
    avg := Array<F64>(p.Len(), 0.0)          # the parameters averaged over the last tail steps (Polyak): Adam at a
                                             # fixed rate wanders around the optimum, its average does not
    for step in range steps {
        for i in range gr.Len(): gr[i] = 0.0
        lp F64 = 0.0
        for _ in range samples {
            eps := r.Normals(d)
            draw(p, eps, z, d, full)
            lp += t.Gradient(z, gz) / F64(samples)
            ascend(p, gr, eps, gz, d, full, F64(samples))
        }
        # the entropy, sum log L_ii plus a constant: its gradient 1 on each log-diagonal parameter (negated: Adam
        # descends)
        h F64 = 0.0
        for i in range d {
            h += p[d + diagAt(i, full)]
            gr[d + diagAt(i, full)] -= 1.0
        }
        opt.Step()
        if step < steps - tail: continue
        elbo += (lp + h + 0.5 * F64(d) * (1.0 + gauss.Log2Pi)) / F64(tail)
        for i in range p.Len(): avg[i] += p[i] / F64(tail)
    }
    out := Fit(d)
    out.Elbo = elbo
    l := lower(avg, d, full)
    for i in range d: out.Q.Mean[i] = avg[i]
    cov := dense.MatMul(l, l, d, d, d, tb = true)
    for i in range d * d: out.Q.Cov[i] = cov[i]
    return out
}

# where L's diagonal entry i is among L's parameters
fn diagAt(i I64, full Bool) I64 { return i * (i + 1) / 2 + i if full else i }

# L as a d by d matrix
fn lower(p Array<F64>&, d I64, full Bool) Array<F64> {
    l := Array<F64>(d * d, 0.0)
    for i in range d {
        if not full {
            l[i * d + i] = p[d + i].Exp()
            continue
        }
        for j in range i: l[i * d + j] = p[d + i * (i + 1) / 2 + j]
        l[i * d + i] = p[d + diagAt(i, true)].Exp()
    }
    return l
}

# z = mu + L eps
fn draw(p Array<F64>&, eps Array<F64>&, z mut Array<F64>&, d I64, full Bool) {
    for i in range d {
        z[i] = p[i] + p[d + diagAt(i, full)].Exp() * eps[i]
        if not full: continue
        for j in range i: z[i] += p[d + i * (i + 1) / 2 + j] * eps[j]
    }
}

# the negated gradient of log p(z) by the parameters, over samples draws, added into gr: by mu, gz; by L_ij, gz_i eps_j
# (times L_ii on the diagonal, kept as its logarithm)
fn ascend(p Array<F64>&, gr mut Array<F64>&, eps Array<F64>&, gz Array<F64>&, d I64, full Bool, samples F64) {
    for i in range d {
        gr[i] -= gz[i] / samples
        k := d + diagAt(i, full)
        gr[k] -= gz[i] * eps[i] * p[k].Exp() / samples
        if not full: continue
        for j in range i: gr[d + i * (i + 1) / 2 + j] -= gz[i] * eps[j] / samples
    }
}

# a Gaussian target: N(m, S) in closed form, the exact answer both approximations should reach
type normal struct(m Array<F64>, prec Array<F64>) {
    m
    prec
}

fn (p normal&) Dim() I64 { return p.m.Len() }

fn (p normal&) LogDensity(z Array<F64>&) F64 {
    g := Array<F64>(p.m.Len(), 0.0)
    return p.Gradient(z, g)
}

fn (p normal&) Gradient(z Array<F64>&, grad mut Array<F64>&) F64 {
    d := p.m.Len()
    e := Array<F64>[z[i] - p.m[i] for i in range d]
    pe := dense.Times(p.prec, e, d, d)
    s F64 = 0.0
    for i in range d {
        grad[i] = -pe[i]
        s -= 0.5 * e[i] * pe[i]
    }
    return s
}

test "ADVI recovers a Gaussian target: full-rank exactly, mean-field its known underestimate" {
    r := rand.Rand(4)
    cov := Array<F64>[1.0, 0.6, 0.6, 2.0]
    prec := try dense.Inverse(cov, 2)
    t := normal(Array<F64>[1.0, -1.0], prec)
    full := try Fit.FullRank(t, r, steps = 4000, samples = 4, rate = 0.02)
    for i in range 2: assert (full.Q.Mean[i] - t.m[i]).Abs() < 0.05
    for i in range 4: assert (full.Q.Cov[i] - cov[i]).Abs() < 0.12
    mf := try Fit.MeanField(t, r, steps = 4000, samples = 4, rate = 0.02)
    # mean-field's variances are the precision's diagonal's reciprocals, not the marginal variances
    for i in range 2: assert (mf.Q.Mean[i] - t.m[i]).Abs() < 0.05
    for i in range 2: assert (mf.Q.Var(i) - 1.0 / prec[i * 2 + i]).Abs() < 0.08
    # the ELBO of the exact fit is log Z = log((2 pi)^(d/2) det(S)^(1/2)); mean-field's lies below it
    logz := gauss.Log2Pi + 0.5 * (2.0 - 0.36).Log()
    assert (full.Elbo - logz).Abs() < 0.05 and mf.Elbo < full.Elbo
}

test "ADVI against HMC on a small logistic regression" {
    r := rand.Rand(33)
    n := 60
    data := target.Data.Logistic(n, Array<F64>[0.3, -1.0, 1.5], r)
    g := graph.Graph<F64>(1)
    nodes := target.Logistic.Record(g, n, 3, 4.0)
    try g.Plan(r)
    nodes.Set(g, data.X, data.Y)
    t := target.GraphTarget(g, nodes.Loss)
    full := try Fit.FullRank(t, r, steps = 6000, samples = 4, rate = 0.01)
    mf := try Fit.MeanField(t, r, steps = 6000, samples = 4, rate = 0.01)
    h := mcmc.Chain.Hmc(t, full.Q.Mean, 8000, 1000, r)
    for i in range 3 {
        sd := h.Sd(i)
        # measured: full-rank means within 0.03 sd of HMC's, sds 1-3% low; mean-field's sds 3-12% low
        assert (full.Q.Mean[i] - h.Mean(i)).Abs() < 0.1 * sd and (full.Q.Sd(i) / sd - 1.0).Abs() < 0.08
        assert (mf.Q.Mean[i] - h.Mean(i)).Abs() < 0.3 * sd and mf.Q.Sd(i) < 1.1 * sd
    }
    assert full.Elbo >= mf.Elbo - 0.05
}
