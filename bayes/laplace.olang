# bayes/laplace - the Gaussian update of a Gaussian belief by observations of a linear (or any smooth) predictor:
# the posterior's mode found by Newton's method on the joint parameters the observations touch (the iterated extended
# Kalman filter: each step a Kalman update by the pseudo-observation the likelihood's quadratic expansion gives), and
# its covariance by Laplace's approximation at the mode. Projecting the posterior back onto a Gaussian after every
# event is assumed-density filtering: the sequential path of paired-comparison and rating filters, with
# state.Drift moving the beliefs between events.
#
# Likelihoods (`Likelihood`, of a scalar predictor eta per observation):
#   Normal(v)      y ~ N(eta, v)
#   Logit          y in {0, 1}, P(y = 1) = sigmoid(eta)
#   Probit         y in {0, 1}, P(y = 1) = Phi(eta)
#   Binomial       y successes of `trials`, logit link
#   Poisson        y counts, log link (an exposure is an offset)
#   Ordered(cuts)  y in {0 ... K}, P(y <= k) = sigmoid(cuts[k] - eta), the cut points increasing
#
#     lik := laplace.Likelihood.Ordered(Array<F64>[-1.0, 1.0])
#     try laplace.Update(g, laplace.Rows(a, offsets), lik, y, trials)   # g the prior on entry, the posterior after
#     try laplace.UpdateDiag(b, idx, coef, 0.0, lik, y)                 # one event touching components idx of a Diag

import "dense"
import "gauss"
import "quadrature"

# ---- likelihoods ----

# the likelihood families
type Family enum {
    Normal
    Logit
    Probit
    Binomial
    Poisson
    Ordered
}

# a likelihood of a scalar predictor: its family and parameters (the normal's variance, the ordered model's cut points)
type Likelihood struct(family Family, cuts I64 = 0) {
    Kind Family = family
    Var F64 = 1.0
    Cuts Array<F64> = Array<F64>(cuts, 0.0)
}

# y ~ N(eta, v)
fn Likelihood.Normal(v F64) Likelihood {
    l := Likelihood(Family.Normal)
    l.Var = v
    return l
}

# the ordered logistic model with these increasing cut points: y in {0 ... cuts.Len()}
fn Likelihood.Ordered(cuts Array<F64>&) Likelihood {
    l := Likelihood(Family.Ordered, cuts.Len())
    for i in range cuts.Len(): l.Cuts[i] = cuts[i]
    return l
}

# a likelihood's log density at a predictor, and its first derivative and negated second derivative there (the
# curvature, positive for every family here: each is log-concave in eta)
type Local struct() {
    LogP F64
    Slope F64
    Curv F64
}

# log p(y | eta) and its derivatives in eta; trials counts the binomial's trials, ignored by the others
fn (l Likelihood&) At(eta F64, y F64, trials F64 = 1.0) Local {
    out := l.Kernel(eta, y, trials)
    match l.Kind {
        case Family.Normal: out.LogP -= 0.5 * (l.Var.Log() + gauss.Log2Pi)
        case Family.Binomial: out.LogP += LogChoose(trials, y)
        case Family.Poisson: out.LogP -= LogGamma(y + 1.0)
        case _ { }
    }
    return out
}

# At without the terms that do not depend on eta (the normalising constants): what the update compares and steps by
fn (l Likelihood&) Kernel(eta F64, y F64, trials F64 = 1.0) Local {
    out := Local()
    match l.Kind {
        case Family.Normal {
            e := y - eta
            out.LogP = -0.5 * e * e / l.Var
            out.Slope = e / l.Var
            out.Curv = 1.0 / l.Var
        }
        case Family.Logit: return Local.binomial(eta, y, 1.0)
        case Family.Binomial: return Local.binomial(eta, y, trials)
        case Family.Probit {
            s := 2.0 * y - 1.0
            r := gauss.Mills(s * eta)
            out.LogP = gauss.LogNormalCdf(s * eta)
            out.Slope = s * r
            out.Curv = r * (s * eta + r)
        }
        case Family.Poisson {
            rate := eta.Exp()
            out.LogP = y * eta - rate
            out.Slope = y - rate
            out.Curv = rate
        }
        case Family.Ordered: return l.ordered(eta, I64(y))
    }
    return out
}

# the sum of Kernel's log densities over observations
fn (l Likelihood&) kernelSum(eta Array<F64>&, y Array<F64>&, w Array<F64>&) F64 {
    out F64 = 0.0
    for k in range y.Len(): out += l.Kernel(eta[k], y[k], w[k]).LogP
    return out
}

# successes y of trials at logit eta, without the binomial coefficient
fn Local.binomial(eta F64, y F64, trials F64) Local {
    q := Sigmoid(eta)
    out := Local()
    out.LogP = y * LogSigmoid(eta) + (trials - y) * LogSigmoid(-eta)
    out.Slope = y - trials * q
    out.Curv = trials * q * (1.0 - q)
    return out
}

# category k of the ordered model: p = F_k - F_(k-1), F_j = sigmoid(c_j - eta), F_-1 = 0, F_K = 1
fn (l Likelihood&) ordered(eta F64, k I64) Local {
    hi := cut.edge(l.Cuts, k, eta)
    lo := cut.edge(l.Cuts, k - 1, eta)
    p := (hi.Value - lo.Value).Max(1e-300)
    d1 := -(hi.Density - lo.Density) / p                              # p' / p
    d2 := (hi.Density * (1.0 - 2.0 * hi.Value) - lo.Density * (1.0 - 2.0 * lo.Value)) / p    # p'' / p
    out := Local()
    out.LogP = p.Log()
    out.Slope = d1
    out.Curv = d1 * d1 - d2
    return out
}

# F_j and its density f_j = F_j (1 - F_j) at the ordered model's cut j (0 and 1 past either end)
type cut struct() {
    Value F64
    Density F64
}

fn cut.edge(cuts Array<F64>&, j I64, eta F64) cut {
    out := cut()
    if j < 0: return out
    if j >= cuts.Len() {
        out.Value = 1.0
        return out
    }
    f := Sigmoid(cuts[j] - eta)
    out.Value = f
    out.Density = f * (1.0 - f)
    return out
}

# the logistic function
fn Sigmoid(z F64) F64 {
    if z >= 0.0: return 1.0 / (1.0 + (-z).Exp())
    e := z.Exp()
    return e / (1.0 + e)
}

# E[sigmoid(eta)] for eta ~ N(mean, var) by the probit approximation sigmoid(mean / sqrt(1 + pi var / 8)): sigmoid
# matched to Phi(sqrt(pi / 8) z) at the origin, whose Gaussian mean is exact. Within about 0.02 of the exact mean
fn SigmoidMean(mean F64, var F64) F64 { return Sigmoid(mean / (1.0 + 3.141592653589793 * var.Max(0.0) / 8.0).Sqrt()) }

# log sigmoid(z), without overflow either way
fn LogSigmoid(z F64) F64 {
    if z >= 0.0: return -(-z).Exp().Log1p()
    return z - z.Exp().Log1p()
}

# log Gamma(x) for x > 0: Lanczos' approximation (g = 7, nine terms), the reflection taken below 1/2
fn LogGamma(x F64) F64 {
    if x < 0.5: return (3.141592653589793 / (3.141592653589793 * x).Sin()).Log() - LogGamma(1.0 - x)
    z := x - 1.0
    a := lanczos[0]
    for i in range 1, 9: a += lanczos[i] / (z + F64(i))
    t := z + 7.5
    return 0.5 * (2.0 * 3.141592653589793).Log() + (z + 0.5) * t.Log() - t + a.Log()
}

# Lanczos' coefficients for g = 7
lanczos := Array<F64>[0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7]

# log (n choose k)
fn LogChoose(n F64, k F64) F64 { return LogGamma(n + 1.0) - LogGamma(k + 1.0) - LogGamma(n - k + 1.0) }

# ---- predictors ----

# what writes the observations' predictors and their gradients at a state z: eta[k] for observation k, jac[k * d + i]
# its derivative by component i. A linear predictor is `Rows`; a bilinear or any smooth one is the caller's
type Predictor trait {
    Linearize(z Array<F64>&, eta mut Array<F64>&, jac mut Array<F64>&)
}

# the linear predictor eta = A z + offset: A n by d, row after row
type Rows struct(a Array<F64>, offset Array<F64>) {
    A Array<F64> = a
    Offset Array<F64> = offset
}

fn (l Rows&) Linearize(z Array<F64>&, eta mut Array<F64>&, jac mut Array<F64>&) {
    d := z.Len()
    for k in range eta.Len() {
        eta[k] = l.Offset[k]
        for i in range d {
            eta[k] += l.A[k * d + i] * z[i]
            jac[k * d + i] = l.A[k * d + i]
        }
    }
}

# ---- the update ----

# g moved from the prior to the Laplace approximation of the posterior after observations y (with trials, for the
# binomial; an empty array is one trial each) of the predictor p under lik. Newton steps until no component moves by
# more than tolerance, or iterations; a step that lowers the log posterior is halved until it does not. Gives the
# steps taken.
#
# Every iterate is z = m + P u (each step's mean is m + P J^T a), so the prior's quadratic form in the log posterior is
# u . (z - m): the prior's precision is never formed. The predictor is linearized once per step, at the point the
# damping accepted.
fn Update<P Predictor>(g mut gauss.Gaussian&, p P&, lik Likelihood&, y Array<F64>&, trials Array<F64>&, iterations I64 = 50, tolerance F64 = 1e-10) I64 ? dense.Error {
    d := g.Dim()
    n := y.Len()
    w := Array<F64>[(trials[k] if trials.Len() > 0 else 1.0) for k in range n]
    s := newton(d, n)
    for i in range d: s.Z[i] = g.Mean[i]
    p.Linearize(s.Z, s.Eta, s.Jac)
    s.Value = lik.kernelSum(s.Eta, y, w)
    steps I64 = 0
    for _ in range iterations {
        try s.kalman(g, lik, y, w)
        steps++
        if s.damped(g, p, lik, y, w) <= tolerance: break
    }
    try s.kalman(g, lik, y, w)
    g.Shrink(s.Pj, s.L, n)
    for i in range d: g.Mean[i] = s.Z[i]
    return steps
}

# the state of Newton's method in Update: the iterate z = m + P u, the predictor and its Jacobian there, and the log
# posterior up to a constant; the last Kalman step's P J^T, the factor of J P J^T + R, and its proposal; the damping's
# trial point
type newton struct(d I64, n I64) {
    Z Array<F64> = Array<F64>(d, 0.0)
    U Array<F64> = Array<F64>(d, 0.0)
    Eta Array<F64> = Array<F64>(n, 0.0)
    Jac Array<F64> = Array<F64>(n * d, 0.0)
    Value F64 = 0.0
    Pj Array<F64> = Array<F64>(d * n, 0.0)
    S Array<F64> = Array<F64>(n * n, 0.0)
    L Array<F64> = Array<F64>(n * n, 0.0)
    A Array<F64> = Array<F64>(n, 0.0)
    Next Array<F64> = Array<F64>(d, 0.0)
    UNext Array<F64> = Array<F64>(d, 0.0)
    Try Array<F64> = Array<F64>(d, 0.0)
    UTry Array<F64> = Array<F64>(d, 0.0)
    EtaTry Array<F64> = Array<F64>(n, 0.0)
    JacTry Array<F64> = Array<F64>(n * d, 0.0)
}

# one Kalman update of the prior g by the pseudo-observations linearized at z: Next = m + P J^T a, UNext = J^T a, with
# Pj and L kept for the covariance
fn (s mut newton&) kalman(g gauss.Gaussian&, lik Likelihood&, y Array<F64>&, w Array<F64>&) ? dense.Error {
    d := g.Dim()
    n := s.Eta.Len()
    for i in range d * n: s.Pj[i] = 0.0
    for k in range n {
        for j in range d: s.addColumn(g.Cov, k, j, s.Jac[k * d + j])
    }
    for k in range n {
        for l in range n: s.S[k * n + l] = 0.0
        for i in range d {
            jk := s.Jac[k * d + i]
            if jk == 0.0: continue
            for l in range n: s.S[k * n + l] += jk * s.Pj[i * n + l]
        }
        at := lik.Kernel(s.Eta[k], y[k], w[k])
        c := at.Curv.Max(1e-12)
        s.S[k * n + k] += 1.0 / c
        s.A[k] = at.Slope / c
        for i in range d: s.A[k] += s.Jac[k * d + i] * (s.Z[i] - g.Mean[i])
    }
    s.L = try dense.Cholesky(s.S, n)
    dense.SolveCholeskyInPlace(s.L, s.A, n)
    for i in range d {
        s.Next[i] = g.Mean[i]
        s.UNext[i] = 0.0
        for k in range n {
            s.Next[i] += s.Pj[i * n + k] * s.A[k]
            s.UNext[i] += s.Jac[k * d + i] * s.A[k]
        }
    }
}

# z moved toward Next, the step halved while it lowers the log posterior (at most 30 times), the predictor and the
# value taken at the point accepted; gives the largest move
fn (s mut newton&) damped<P Predictor>(g gauss.Gaussian&, p P&, lik Likelihood&, y Array<F64>&, w Array<F64>&) F64 {
    d := s.Z.Len()
    f F64 = 1.0
    value F64 = 0.0
    for _ in range 30 {
        for i in range d {
            s.Try[i] = s.Z[i] + f * (s.Next[i] - s.Z[i])
            s.UTry[i] = s.U[i] + f * (s.UNext[i] - s.U[i])
        }
        p.Linearize(s.Try, s.EtaTry, s.JacTry)
        value = lik.kernelSum(s.EtaTry, y, w)
        for i in range d: value -= 0.5 * s.UTry[i] * (s.Try[i] - g.Mean[i])
        if value >= s.Value - 1e-12 * s.Value.Abs(): break
        f *= 0.5
    }
    moved F64 = 0.0
    for i in range d {
        moved = moved.Max((s.Try[i] - s.Z[i]).Abs())
        s.Z[i] = s.Try[i]
        s.U[i] = s.UTry[i]
    }
    for k in range s.Eta.Len(): s.Eta[k] = s.EtaTry[k]
    for k in range s.Jac.Len(): s.Jac[k] = s.JacTry[k]
    s.Value = value
    return moved
}

# column k of P J^T plus x times column j of P (P symmetric: its row j); nothing for x zero, as most of a sparse
# predictor's Jacobian is
fn (s mut newton&) addColumn(cov Array<F64>&, k I64, j I64, x F64) {
    if x == 0.0: return
    d := s.Z.Len()
    n := s.Eta.Len()
    for i in range d: s.Pj[i * n + k] += x * cov[j * d + i]
}

# one event of a factorised belief: the predictor eta = sum coef[j] x[idx[j]] + offset observed as y under lik. The
# components idx are joined into one Gaussian, updated together, and their marginals written back (their correlations
# dropped: assumed-density filtering). Gives the event's log predictive density before the update, by `Predictive`
fn UpdateDiag(b mut gauss.Diag&, idx Array<I64>&, coef Array<F64>&, offset F64, lik Likelihood&, y F64, trials F64 = 1.0) F64 ? dense.Error {
    j := b.Marginal(idx)
    m := j.Linear(coef)
    score := Predictive(lik, m.Mean + offset, m.Var, y, trials)
    try Update(j, Rows(coef, Array<F64>[offset]), lik, Array<F64>[y], Array<F64>[trials])
    b.PutMarginals(idx, j)
    return score
}

# the log predictive density of y when eta ~ N(mean, var): exact for the normal, else by 32-point Gauss-Hermite
fn Predictive(lik Likelihood&, mean F64, var F64, y F64, trials F64 = 1.0) F64 {
    if lik.Kind == Family.Normal: return Likelihood.Normal(lik.Var + var).At(mean, y).LogP
    sd := var.Max(0.0).Sqrt()
    r := predictiveRule
    # log sum_k w_k p(y | mean + sd x_k), the largest term factored out
    logs := Array<F64>[lik.At(mean + sd * r.Nodes[k], y, trials).LogP + r.Weights[k].Log() for k in range r.Len()]
    top F64 = -1.0e300
    for v in logs: top = top.Max(v)
    s F64 = 0.0
    for v in logs: s += (v - top).Exp()
    return top + s.Log()
}

# the rule Predictive integrates by
predictiveRule := quadrature.Rule.Hermite(32)

# every family the tests check, with an observation each can take
fn families() Array<Likelihood> {
    return Array<Likelihood>[Likelihood.Normal(0.7), Likelihood(Family.Logit), Likelihood(Family.Probit), Likelihood(Family.Binomial), Likelihood(Family.Poisson), Likelihood.Ordered(Array<F64>[-1.0, 0.5, 2.0])]
}

test "likelihoods: derivatives and normalisation" {
    h := 1e-5
    for lik in families() {
        for eta in Array<F64>[-2.3, -0.4, 0.0, 0.9, 2.5] {
            for y in Array<F64>[0.0, 1.0] {
                at := lik.At(eta, y, 3.0)
                up := lik.At(eta + h, y, 3.0)
                down := lik.At(eta - h, y, 3.0)
                assert (at.Slope - (up.LogP - down.LogP) / (2.0 * h)).Abs() < 1e-6 * (1.0 + at.Slope.Abs())
                assert (at.Curv - (2.0 * at.LogP - up.LogP - down.LogP) / (h * h)).Abs() < 1e-3 * (1.0 + at.Curv.Abs())
                assert at.Curv > 0.0
            }
        }
    }
    # the discrete families sum to one over their outcomes
    total := fn(lik Likelihood, ys I64, trials F64): return [lik.At(0.7, F64(y), trials).LogP.Exp() for y in range ys].Sum()
    assert (total(Likelihood(Family.Logit), 2, 1.0) - 1.0).Abs() < 1e-12
    assert (total(Likelihood(Family.Probit), 2, 1.0) - 1.0).Abs() < 1e-12
    assert (total(Likelihood(Family.Binomial), 6, 5.0) - 1.0).Abs() < 1e-12
    assert (total(Likelihood(Family.Poisson), 60, 1.0) - 1.0).Abs() < 1e-12
    assert (total(Likelihood.Ordered(Array<F64>[-1.0, 0.5, 2.0]), 4, 1.0) - 1.0).Abs() < 1e-12
    assert (LogGamma(5.0) - 24.0.Log()).Abs() < 1e-12 and (LogGamma(0.5) - 3.141592653589793.Sqrt().Log()).Abs() < 1e-12
}

test "the normal likelihood is conjugate: one step is the exact posterior" {
    g := gauss.Gaussian.Of(Array<F64>[0.5, -0.2], Array<F64>[1.0, 0.3, 0.3, 2.0])
    exact := gauss.Gaussian.Of(g.Mean, g.Cov)
    a := Array<F64>[1.0, 2.0, -1.0, 0.5, 0.3, 0.3]
    y := Array<F64>[1.2, -0.4, 0.8]
    off := Array<F64>[0.1, 0.0, -0.2]
    try Update(g, Rows(a, off), Likelihood.Normal(0.4), y, Array<F64>(0))
    try exact.Observe(a, Array<F64>[y[k] - off[k] for k in range 3], dense.Identity(3, 0.4), jitter = 0.0)
    for i in range 2: assert (g.Mean[i] - exact.Mean[i]).Abs() < 1e-12
    for i in range 4: assert (g.Cov[i] - exact.Cov[i]).Abs() < 1e-12
}

test "every family: the mode and the curvature of the Laplace approximation" {
    a := Array<F64>[1.0, -1.0, 0.5, 1.0, 1.0, 0.0]
    off := Array<F64>[0.0, 0.2, -0.1]
    for lik in families() {
        g := gauss.Gaussian.Of(Array<F64>[0.3, -0.1], Array<F64>[0.8, 0.2, 0.2, 0.5])
        prior := try dense.Inverse(g.Cov, 2)
        m0 := Array<F64>[0.3, -0.1]
        y := Array<F64>[1.0, 0.0, 2.0] if lik.Kind != Family.Logit and lik.Kind != Family.Probit else Array<F64>[1.0, 0.0, 1.0]
        trials := Array<F64>[3.0, 3.0, 3.0]
        try Update(g, Rows(a, off), lik, y, trials)
        # the gradient of the log posterior is zero at the mode, its negated Hessian the posterior's precision
        grad := Array<F64>[-(prior[i * 2] * (g.Mean[0] - m0[0]) + prior[i * 2 + 1] * (g.Mean[1] - m0[1])) for i in range 2]
        prec := Array<F64>[p for p in prior]
        for k in range 3 {
            eta := a[k * 2] * g.Mean[0] + a[k * 2 + 1] * g.Mean[1] + off[k]
            at := lik.At(eta, y[k], trials[k])
            for i in range 2 {
                grad[i] += at.Slope * a[k * 2 + i]
                for j in range 2: prec[i * 2 + j] += at.Curv * a[k * 2 + i] * a[k * 2 + j]
            }
        }
        post := try dense.Inverse(g.Cov, 2)
        for i in range 2: assert grad[i].Abs() < 1e-8
        for i in range 4: assert (post[i] - prec[i]).Abs() < 1e-8
    }
}

test "one event of a factorised belief, and the predictive density" {
    # two items' strengths, the first preferred in a probit comparison: the preferred one up, the other down, both
    # less uncertain, and the predictive probability Phi((m0 - m1) / sqrt(1 + v0 + v1))
    b := gauss.Diag.Isotropic(3, 1.0)
    b.Mean[2] = 0.5
    lp := try UpdateDiag(b, Array<I64>[0, 2], Array<F64>[1.0, -1.0], 0.0, Likelihood(Family.Probit), 1.0)
    assert (lp - gauss.NormalCdf(-0.5 / 3.0.Sqrt()).Log()).Abs() < 1e-10
    assert b.Mean[0] > 0.0 and b.Mean[2] < 0.5 and b.Var[0] < 1.0 and b.Var[2] < 1.0 and b.Var[1] == 1.0
    # the logit predictive at no variance is the likelihood itself
    assert (Predictive(Likelihood(Family.Logit), 0.4, 0.0, 1.0) - LogSigmoid(0.4)).Abs() < 1e-12
}

test "the probit approximation of a sigmoid's Gaussian mean" {
    r := quadrature.Rule.Hermite(48)
    for mean in Array<F64>[-3.0, -0.7, 0.0, 0.4, 2.5] {
        for var in Array<F64>[0.0, 0.3, 1.0, 4.0] {
            exact := r.Expect(mean, var, fn(x F64) F64: return Sigmoid(x))
            assert (SigmoidMean(mean, var) - exact).Abs() < 0.02
        }
    }
    assert SigmoidMean(1.3, 0.0) == Sigmoid(1.3) and SigmoidMean(0.0, 2.0) == 0.5
}
