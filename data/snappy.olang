# snappy - Snappy's raw block format decompressed (google/snappy's format_description.txt), as Parquet's SNAPPY pages
# hold it: the uncompressed length as a varint, then elements, each a literal (bytes copied from the input) or a copy
# (bytes repeated from what was already written, an offset back and a length). The tag byte's low two bits say which:
# 0 a literal of length (tag >> 2) + 1, or with 60-63 there a length minus one in the next 1-4 bytes; 1 a copy of
# 4 + ((tag >> 2) & 7) bytes at an offset of 11 bits, the tag's top three and the next byte; 2 and 3 a copy of
# (tag >> 2) + 1 bytes at an offset in the next 2 or 4 bytes. A copy may overlap what it writes (offset < length):
# it repeats a run, so it is copied a byte at a time.

import cstring "string.h"

type SnappyError error {
    Corrupt   # a length or offset outside the block, or an output of another length than the header says
}

# the varint at src[at:]: its value and where it ends
fn varint(src Array<U8>&, at I64) I64, I64 ? SnappyError {
    v I64 = 0
    shift I64 = 0
    i := at
    for {
        if i >= src.Len() or shift > 56: error SnappyError.Corrupt
        b := I64(src[i])
        i += 1
        v |= (b & 127) << shift
        if b < 128: return v, i
        shift += 7
    }
}

# the little-endian number of n bytes at src[at:]
fn little(src Array<U8>&, at I64, n I64) I64 {
    v I64 = 0
    for k in range n: v |= I64(src[at + k]) << (8 * k)
    return v
}

# the length a block decompresses to, read from its header
fn SnappyLength(src Array<U8>&) I64 ? SnappyError {
    n, _ := try varint(src, 0)
    return n
}

# the block in src decompressed into dst, which holds exactly SnappyLength(src) bytes
fn Unsnappy(src Array<U8>&, dst mut Array<U8>&) ? SnappyError {
    n, i := try varint(src, 0)
    if n != dst.Len(): error SnappyError.Corrupt
    o I64 = 0
    for i < src.Len() {
        tag := I64(src[i])
        i += 1
        kind := tag & 3
        if kind == 0 {
            len := (tag >> 2) + 1
            if len > 60 {
                extra := len - 60
                if i + extra > src.Len(): error SnappyError.Corrupt
                len = little(src, i, extra) + 1
                i += extra
            }
            if i + len > src.Len() or o + len > n: error SnappyError.Corrupt
            cstring.memcpy(dst[o:], src[i:], U64(len))
            i += len
            o += len
            continue
        }
        len I64 = 0
        off I64 = 0
        if kind == 1 {
            if i >= src.Len(): error SnappyError.Corrupt
            len = 4 + ((tag >> 2) & 7)
            off = ((tag >> 5) << 8) | I64(src[i])
            i += 1
        } else {
            width := 2 if kind == 2 else 4
            if i + width > src.Len(): error SnappyError.Corrupt
            len = (tag >> 2) + 1
            off = little(src, i, width)
            i += width
        }
        if off == 0 or off > o or o + len > n: error SnappyError.Corrupt
        if off >= len {
            cstring.memcpy(dst[o:], dst[o - off:], U64(len))
        } else {
            for k in range len: dst[o + k] = dst[o - off + k]
        }
        o += len
    }
    if o != n: error SnappyError.Corrupt
}

# ---- tests ----

test Unsnappy "literals, short and long copies, an overlapping run" {
    # "abcd" literal, then a 1-byte-offset copy of 8 at offset 4 (overlapping), then a 2-byte-offset copy of 3 at 12
    src := Array<U8>[15, 3 << 2, 'a', 'b', 'c', 'd', 1 | ((8 - 4) << 2), 4, 2 | ((3 - 1) << 2), 12, 0]
    assert try SnappyLength(src) == 15
    dst := Array<U8>(15)
    try Unsnappy(src, dst)
    assert String(dst) == "abcdabcdabcdabc"
}

test Unsnappy "a literal whose length is in the next byte" {
    src := Array<U8>(2 + 2 + 100)
    src[0] = 100
    src[1] = 60 << 2
    src[2] = 99
    for k in range 100: src[3 + k] = U8('a' + k % 26)
    dst := Array<U8>(100)
    try Unsnappy(src[:103], dst)
    assert dst[0] == 'a' and dst[99] == U8('a' + 99 % 26)
}

test Unsnappy "refuses a copy reaching before the start" {
    src := Array<U8>[8, 0, 'a', 1 | (3 << 2), 5]
    dst := Array<U8>(8)
    bad := false
    try Unsnappy(src, dst) catch SnappyError.Corrupt { bad = true }
    assert bad
}
