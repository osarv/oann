# where a convolution's time goes: each pass of examples/mnist_cnn.olang's two convolutions on a batch of 128 - the
# forward as conv.Conv2d makes it (std/linalg's GemmPatches: the product of the patches packed straight from the
# images, with the bias) and, beside it, as it was made before (im2col, the product, the bias); then the backward's
# bias sums, im2col, dW's product, dcols' product and col2im - timed alone, with the products' rate. The two forwards
# alternate in every repetition, and their outputs are compared. Arguments: repetitions (20), threads (1).

import "std/io"
import "std/linalg"
import "std/os"
import "std/rand"
import "std/time"
import "../conv"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() { return fallback }
    return try args[i].ParseInt()
}

fn ms(ns I64, reps I64) String {
    return $(F64(ns) * 1e-6 / F64(reps)).Fixed(2)
}

fn gflops(m I64, n I64, k I64, ns I64, reps I64) String {
    return $(2.0 * F64(m * n * k) * F64(reps) / F64(ns)).Fixed(1)
}

fn main() ? io.IoError + ParseError {
    args := os.Args()
    reps := try number(args, 1, 20)
    threads := try number(args, 2, 1)
    B I64 = 128
    r := rand.Rand(1)
    for s in conv.Shape[conv.Shape(1, 28, 28, 16, 3, 1, 1), conv.Shape(16, 14, 14, 32, 3, 1, 1)] {
        m I64 = B * s.Positions()
        x := linalg.Matrix<F32>(B, s.H * s.W * s.C)
        x.FillNormal(r, 0.0, 1.0)
        w := linalg.Matrix<F32>(s.OutC, s.Patch())
        w.FillNormal(r, 0.0, 0.1)
        b := linalg.Matrix<F32>(1, s.OutC)
        y := linalg.Matrix<F32>(B, s.Positions() * s.OutC)
        dx := linalg.Matrix<F32>(B, s.H * s.W * s.C)
        dw := linalg.Matrix<F32>(s.OutC, s.Patch())
        db := linalg.Matrix<F32>(1, s.OutC)
        cols := linalg.Matrix<F32>(m, s.Patch())
        ws := linalg.GemmWorkspace<F32>()
        out := y.Reshape(m, s.OutC)
        y2 := linalg.Matrix<F32>(B, s.Positions() * s.OutC)
        out2 := y2.Reshape(m, s.OutC)
        times := Array<I64>(9)
        for rep in range reps {
            t0 := time.Now()
            conv.Conv2d(y, x, w, b, s, threads, ws)
            t1 := time.Now()
            conv.Im2col(x, s, cols, threads)
            t2 := time.Now()
            ws.Gemm(out2, cols, false, w, true, 1, 0, threads)
            t3 := time.Now()
            out2.AddRow(b)
            t4 := time.Now()
            out.ColumnSums(db, 0)
            t5 := time.Now()
            conv.Im2col(x, s, cols, threads)
            t6 := time.Now()
            ws.Gemm(dw, out, true, cols, false, 1, 0, threads)
            t7 := time.Now()
            ws.Gemm(cols, out, false, w, false, 1, 0, threads)
            t8 := time.Now()
            conv.Col2im(cols, s, dx, false, threads)
            t9 := time.Now()
            times[0] += t1 - t0
            times[1] += t2 - t1
            times[2] += t3 - t2
            times[3] += t4 - t3
            times[4] += t5 - t4
            times[5] += t6 - t5
            times[6] += t7 - t6
            times[7] += t8 - t7
            times[8] += t9 - t8
        }
        total I64 = times[0]
        for t in times[4:] { total += t }
        before I64 = total - times[0] + times[1] + times[2] + times[3]
        try io.Print("conv " $(s.C) "->" $(s.OutC) " " $(s.K) "x" $(s.K) " on " $(s.H) "x" $(s.W) ", batch " $B
            ": forward by GemmPatches " $ms(times[0], reps) " ms (" $gflops(m, s.OutC, s.Patch(), times[0], reps)
            " GFLOPS), as before " $ms(times[1] + times[2] + times[3], reps) " (im2col " $ms(times[1], reps)
            ", product " $ms(times[2], reps) " - " $gflops(m, s.OutC, s.Patch(), times[2], reps) " GFLOPS, bias "
            $ms(times[3], reps) "), outputs " $("equal" if y == y2 else "DIFFERENT") "; backward: bias sums "
            $ms(times[4], reps) ", im2col " $ms(times[5], reps) ", dW " $ms(times[6], reps) " ("
            $gflops(s.OutC, s.Patch(), m, times[6], reps) "), dcols " $ms(times[7], reps) " ("
            $gflops(m, s.Patch(), s.OutC, times[7], reps) "), col2im " $ms(times[8], reps) "; a step " $ms(total, reps)
            " ms (" $ms(before, reps) " as before)\n")
    }
}
