# where a convolution's time goes: each pass of examples/mnist_cnn.olang's two convolutions on a batch of 128 -
# im2col, the forward product, the bias, then the backward's bias sums, im2col again, dW's product, dcols' product and
# col2im - timed alone, with the products' rate. Arguments: repetitions (20), threads (1).

import "std/io"
import "std/linalg"
import "std/os"
import "std/rand"
import "std/time"
import "../conv"
import "../kernels"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() { return fallback }
    return try args[i].ParseInt()
}

fn ms(ns I64, reps I64) String {
    return $(F64(ns) * 1e-6 / F64(reps)).Fixed(2)
}

fn gflops(m I64, n I64, k I64, ns I64, reps I64) String {
    return $(2.0 * F64(m * n * k) * F64(reps) / F64(ns)).Fixed(1)
}

fn main() ? io.IoError + ParseError {
    args := os.Args()
    reps := try number(args, 1, 20)
    threads := try number(args, 2, 1)
    B I64 = 128
    r := rand.Rand(1)
    for s in conv.Shape[conv.Shape(1, 28, 28, 16, 3, 1, 1), conv.Shape(16, 14, 14, 32, 3, 1, 1)] {
        m I64 = B * s.Positions()
        x := linalg.Matrix<F32>(B, s.H * s.W * s.C)
        x.FillNormal(r, 0.0, 1.0)
        w := linalg.Matrix<F32>(s.OutC, s.Patch())
        w.FillNormal(r, 0.0, 0.1)
        b := linalg.Matrix<F32>(1, s.OutC)
        y := linalg.Matrix<F32>(B, s.Positions() * s.OutC)
        dx := linalg.Matrix<F32>(B, s.H * s.W * s.C)
        dw := linalg.Matrix<F32>(s.OutC, s.Patch())
        db := linalg.Matrix<F32>(1, s.OutC)
        cols := linalg.Matrix<F32>(m, s.Patch())
        work := Array<F32>(conv.GemmSpace(s, B, threads, F32(0)))
        out := y.Reshape(m, s.OutC)
        times := Array<I64>(7)
        for rep in range reps {
            t0 := time.Now()
            conv.Im2col(x, s, cols, threads)
            t1 := time.Now()
            kernels.Gemm(out, cols, false, w, true, 1, 0, threads, work)
            t2 := time.Now()
            out.AddRow(b)
            t3 := time.Now()
            out.ColumnSums(db, 0)
            t4 := time.Now()
            kernels.Gemm(dw, out, true, cols, false, 1, 0, threads, work)
            t5 := time.Now()
            kernels.Gemm(cols, out, false, w, false, 1, 0, threads, work)
            t6 := time.Now()
            conv.Col2im(cols, s, dx, false, threads)
            t7 := time.Now()
            times[0] += 2 * (t1 - t0)                   # im2col runs twice a step: forward and backward
            times[1] += t2 - t1
            times[2] += t3 - t2
            times[3] += t4 - t3
            times[4] += t5 - t4
            times[5] += t6 - t5
            times[6] += t7 - t6
        }
        total I64 = 0
        for t in times { total += t }
        try io.Print("conv " $(s.C) "->" $(s.OutC) " " $(s.K) "x" $(s.K) " on " $(s.H) "x" $(s.W) ", batch " $B
            ": im2col " $ms(times[0], reps) " ms (twice), forward product " $ms(times[1], reps) " ms ("
            $gflops(m, s.OutC, s.Patch(), times[1], reps) " GFLOPS), bias " $ms(times[2], reps) ", bias sums "
            $ms(times[3], reps) ", dW " $ms(times[4], reps) " (" $gflops(s.OutC, s.Patch(), m, times[4], reps)
            "), dcols " $ms(times[5], reps) " (" $gflops(m, s.Patch(), s.OutC, times[5], reps) "), col2im "
            $ms(times[6], reps) "; a step " $ms(total, reps) " ms\n")
    }
}
