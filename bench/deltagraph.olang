# ad/graph's DeltaRule node, forward and backward, one thread: ms a step (the best of rounds) at two shapes - batch x
# context, heads of dim. From the repository's root:
#     ./build/out ... (olang build -output build/bench_deltagraph bench/deltagraph.olang && ./build/bench_deltagraph)

import "std/io"
import "std/rand"
import "std/time"
import "../ad/graph"

fn main() ? io.Error {
    shapes := Array<I64>[4, 1024, 4, 64, 1, 4096, 8, 128]
    for x in range 0, shapes.Len(), 4 {
        b, t, h, d := shapes[x], shapes[x + 1], shapes[x + 2], shapes[x + 3]
        g := graph.Graph<F32>(b)
        q, k, v := g.Input(t, h * d), g.Input(t, h * d), g.Input(t, h * d)
        beta, gate := g.Input(t, h), g.Input(t, h)
        g.Watch(q)
        y := g.DeltaRule(q, k, v, beta, gate)
        target := g.Input(t, h * d)
        loss := g.Mse(y, target)
        try g.Plan(rand.Rand(1)) catch e { unreachable "shapes: " + $e }
        r := rand.Rand(2)
        for n in Array<graph.Var>[q, k, v, target] {
            a :~ g.Value(n).Flat()!
            for i in range a.Len(): a[i] = F32(r.Normal() * 0.1)
        }
        for n in Array<graph.Var>[beta, gate] {
            a :~ g.Value(n).Flat()!
            for i in range a.Len(): a[i] = F32(0.5 + 0.45 * r.Uniform(0.0, 1.0))
        }
        fwd, bwd := 1e30, 1e30
        for _ in range 3 {
            t0 := time.Now()
            g.Forward(b)
            fwd = fwd.Min(F64(time.Since(t0)) * 1e-6)
            t0 = time.Now()
            g.Backward(loss)
            bwd = bwd.Min(F64(time.Since(t0)) * 1e-6)
        }
        try io.PutLn($b + " x " + $t + ", " + $h + " heads of " + $d + ": forward " + $fwd.Fixed(1) + " ms, backward " + $bwd.Fixed(1) + " ms")
    }
}
