# G-M2 (GP5, docs/redesign.md 1.10 and 4.4): where the settle runs. examples/mnist_learn on MNIST - the 784-H-10
# settling system taught by equilibrium propagation and learn.AdamW, then measured on the test set - with the settle on
# the CPU (1 and 4 threads) and on the GPU (its residual read every 1, 4 or 16 sweeps: the mirror's Check), at batch 32,
# 128 and 512 and hidden 128 and 1024, whole epochs of the 60000 training samples.
#
# Each run is the program itself (build/examples_mnist_learn, built with -define Gpu=true), so what is timed is what a
# user gets: its epoch line's seconds (the lessons, every transfer included; not the test pass), sweeps a lesson (free
# and nudged) and test accuracy after the last epoch, and its free settle of a test batch. Interleaved: every round runs
# each backend of a cell (hidden, batch) once, the order rotated a round, seed = the round; then the medians over the
# rounds (a run's epochs averaged first), and the accuracy's range over the seeds. Every run's lines are printed as
# they come, then the table.
#
# From the repository's root (MNIST in data/mnist, make data):
#     make gpulearn ARGS="rounds epochs hiddens batches backends"     (3 1 128,1024 32,128,512 1,4,gpu1,gpu4,gpu16)

import "std/io"
import "std/os"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

fn listOf(args Array<String&>&, i I64, fallback String&) mut Array<String&>& {
    return (args[i] if i < args.Len() else fallback).Split(",")
}

fn median(xs mut Array<F64>&) F64 {
    xs.Sort(fn(a, b): return a < b)
    n := xs.Len()
    return xs[n / 2] if n % 2 == 1 else 0.5 * (xs[n / 2 - 1] + xs[n / 2])
}

# what one run printed: its epochs' seconds and sweeps a lesson averaged, the last epoch's test accuracy (%) and us a
# test settle
type Seen struct() {
    Seconds F64 = 0
    Sweeps F64 = 0
    Accuracy F64 = 0
    Answer F64 = 0
    Epochs I64 = 0
}

# the number before suffix in a piece of an epoch line ("2.83 s", "30.1 sweeps a lesson", "test accuracy 95.72%")
fn before(piece String&, suffix String&) F64 ? ParseError {
    words :~ piece[:piece.Len() - suffix.Len()].Split(" ")
    return try words[words.Len() - 1].ParseFloat()
}

fn Seen.Read(out String&) Seen ? ParseError {
    seen := Seen()
    for line in out.Split("\n") {
        if not line.StartsWith("epoch "): continue
        seen.Epochs++
        for piece in line.Split(", ") {
            p :~ piece.Split("; ")[0]
            if p.EndsWith(" s"): seen.Seconds += try before(p, " s")
            if p.EndsWith(" sweeps a lesson"): seen.Sweeps += try before(p, " sweeps a lesson")
            if p.EndsWith("%") and p.Contains("test accuracy"): seen.Accuracy = try before(p, "%")
            if p.EndsWith(" us a settle (a batch)"): seen.Answer = try before(p, " us a settle (a batch)")
        }
    }
    if seen.Epochs > 0 {
        seen.Seconds /= F64(seen.Epochs)
        seen.Sweeps /= F64(seen.Epochs)
    }
    return seen
}

fn nameOf(backend String&) String {
    if backend.StartsWith("gpu"): return "GPU, Check " + (backend[3:] if backend.Len() > 3 else "4")
    return "CPU " + backend + " thread" + ("s" if backend != "1" else "")
}

fn main() ? io.Error, os.Error, ParseError {
    args :~ os.Args()
    rounds := try number(args, 1, 3)
    epochs := try number(args, 2, 1)
    hiddens :~ listOf(args, 3, "128,1024")
    batches :~ listOf(args, 4, "32,128,512")
    backends :~ listOf(args, 5, "1,4,gpu1,gpu4,gpu16")
    n := backends.Len()
    try io.Put("G-M2: examples/mnist_learn on MNIST, " + $epochs + " epoch(s) a run, " + $rounds + " interleaved rounds a cell (seeds 1 to " + $rounds + ")\n")
    table := Vec<String>()
    for h in hiddens {
        for b in batches {
            seen := Array<Seen>(n * rounds)
            for round in range rounds {
                for k in range n {
                    i := (k + round) % n
                    out := try os.Output.Exec("./build/examples_mnist_learn", $epochs, "60000", h, b, $(round + 1), "0.001", "0.5", backends[i])
                    if out.Status != 0 {
                        try io.Put(out.Stdout + out.Stderr)
                        os.Exit(1)
                    }
                    s := try Seen.Read(out.Stdout)
                    seen[i * rounds + round] = s
                    try io.Put("hidden " + h + ", batch " + b + ", " + nameOf(backends[i]) + ", seed " + $(round + 1) + ": " + $s.Seconds.Fixed(2) + " s an epoch, " + $s.Sweeps.Fixed(1) + " sweeps a lesson, " + $s.Accuracy.Fixed(2) + "%, " + $s.Answer.Fixed(0) + " us a test settle\n")
                }
            }
            meds := Array<F64>(n)
            for i in range n {
                secs, sweeps, answer, acc := Array<F64>(rounds), Array<F64>(rounds), Array<F64>(rounds), Array<F64>(rounds)
                for r in range rounds {
                    s := seen[i * rounds + r]
                    secs[r], sweeps[r], answer[r], acc[r] = s.Seconds, s.Sweeps, s.Answer, s.Accuracy
                }
                meds[i] = median(secs)
                lo, hi := acc[0], acc[0]
                for a in acc {
                    lo = lo.Min(a)
                    hi = hi.Max(a)
                }
                table.Push(h + " | " + b + " | " + nameOf(backends[i]) + " | " + $meds[i].Fixed(2) + " | " + $median(sweeps).Fixed(1) + " | " + $median(acc).Fixed(2) + " (" + $lo.Fixed(2) + "-" + $hi.Fixed(2) + ") | " + $median(answer).Fixed(0))
            }
            # each against the fastest of the cell
            best := meds[0]
            for m in meds: best = best.Min(m)
            for i in range n {
                at := table.Len() - n + i
                table[at] = table[at] + " | " + $(meds[i] / best).Fixed(2)
            }
        }
    }
    try io.Put("\nhidden | batch | backend | s an epoch | sweeps a lesson | test accuracy % (seeds' range) | us a test settle | epoch / the cell's fastest\n")
    for row in table: try io.Put(row + "\n")
}
