# G-M1, cuBLASLt (docs/redesign.md 1.10, GP3): kernels/gpu/blas's planned products against GP1's cuBLAS Gemm and the
# CPU's kernels/gemm on G-M1's shapes (the MLP's, the settle's, larger batches and squares), every operand resident -
# and how far each is from the exact product. The ways:
#   CPU          kernels/gemm on one thread, F32
#   cuBLAS F32   GP1's Gemm (cublasGemmEx), F32
#   cuBLAS BF16  GP1's Gemm, BF16 operands and C, partial sums kept in F32 (DISALLOW_REDUCED_PRECISION_REDUCTION)
#   F32          a Product<F32, F32, F32>, Sums.Exact (no split-K), the heuristic's algorithm
#   F32 tuned    the same, Tune'd: the fastest of the algorithms the heuristic offers
#   BF16         Product<BF16, BF16, BF16>, Sums.Exact, the heuristic's
#   BF16 tuned   the same, tuned
#   BF16 fast    Product<BF16, BF16, BF16>, Sums.Fast (split-K, its parts possibly added in BF16), tuned
#   BF16>F32     Product<F32, BF16, BF16>: BF16 operands, C in F32, Sums.Exact, tuned
#   F32 via BF16 Product<F32, F32, F32>, Sums.FastBF16 (CUBLAS_COMPUTE_32F_FAST_16BF), tuned
#   F32 via TF32 Product<F32, F32, F32>, Sums.FastTF32, tuned
#   F32 x BF16 W Product<F32, F32, BF16>: BF16 weights widened each run, then F32, tuned
# The operands are uniform in [-1, 1): F32 numbers for the F32 ways, rounded to BF16 for the BF16 ways. Each way's
# error is against the exact product (F64, kernels/gemm) of the numbers it was given - so a BF16 way's is its sums' and
# C's rounding, and F32 via BF16 or TF32 includes rounding the operands - the largest |error| over the largest |exact|,
# and over k eps(BF16) max|a| max|b| (eps 2^-7), the bound of a sum kept in BF16.
# Times: each round repeats a product until it takes about 20 ms, after an untimed one (the GPU's clocks fall while
# idle); rounds interleave the ways; the median. Then for each shape where no exact BF16 way beats F32 tuned, every
# algorithm Tune tried for BF16 (id/tile/split-K/reduction: us).
# Arguments: rounds (5). From the repository's root: make gpult ARGS="5"

import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../kernels/gemm"
import "../kernels/mat"

Gpu Bool = false

if Gpu {
    import "../kernels/gpu/device"
    import "../kernels/gpu/blas"
}

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

fn median(xs mut Array<F64>&) F64 {
    xs.Sort(fn(a, b): return a < b)
    return xs[xs.Len() / 2]
}

type Shape struct(What String, M I64, K I64, N I64, Ta Bool, Tb Bool) {
    What
    M
    K
    N
    Ta
    Tb
}

fn shapes() Array<Shape> {
    return Array<Shape>[
        Shape("MLP fwd 1 / settle x->h", 128, 784, 128, false, true)
        Shape("MLP fwd 2 / settle h->y", 128, 128, 10, false, true)
        Shape("MLP bwd dh / settle y->h", 128, 10, 128, false, false)
        Shape("MLP dW2 / EP outer y h", 10, 128, 128, true, false)
        Shape("MLP dW1 / EP outer h x", 128, 128, 784, true, false)
        Shape("fwd 1, batch 32", 32, 784, 128, false, true)
        Shape("fwd 1, batch 512", 512, 784, 128, false, true)
        Shape("fwd 1, batch 4096", 4096, 784, 128, false, true)
        Shape("hidden 1024, batch 128", 128, 784, 1024, false, true)
        Shape("square 512", 512, 512, 512, false, false)
        Shape("square 1024", 1024, 1024, 1024, false, false)
        Shape("square 2048", 2048, 2048, 2048, false, false)
    ]
}

Names Array<String> = Array<String>["CPU", "cuBLAS F32", "cuBLAS BF16", "F32", "F32 tuned", "BF16", "BF16 tuned", "BF16 fast", "BF16>F32", "F32 via BF16", "F32 via TF32", "F32 x BF16 W"]

fn us(ns F64) String { return $(ns * 1e-3).Fixed(1) }

fn sci(x F64) String {
    if x == 0.0: return "0"
    e := x.Log10().Floor()
    return $(x / 10.0.Pow(e)).Fixed(1) + "e" + $I64(e)
}

# the exact product in F64 of the BF16 numbers in ha and hb, by kernels/gemm on four threads
fn exact(sh Shape&, ha Array<F32>&, hb Array<F32>&, ar I64, ac I64, br I64, bc I64) Array<F64> {
    a := Array<F64>(ha.Len())
    b := Array<F64>(hb.Len())
    for i in range a.Len(): a[i] = F64(ha[i])
    for i in range b.Len(): b[i] = F64(hb[i])
    c := Array<F64>(sh.M * sh.N)
    ws := gemm.Workspace<F64>(4, sh.M.Max(sh.K).Max(sh.N))
    cm := mat.Mat<F64>(c, 0, sh.M, sh.N, sh.N)
    gemm.Gemm(ws, cm, mat.Mat<F64>(a, 0, ar, ac, ac), sh.Ta, mat.Mat<F64>(b, 0, br, bc, bc), sh.Tb, F64(1), F64(0))
    return c
}

# the largest |got - want| over the largest |want|, and over k eps(BF16) max|a| max|b|
fn errors<S>(got Array<S>&, want Array<F64>&, k I64) F64, F64 {
    worst, big := 0.0, 0.0
    for i in range want.Len() {
        worst = worst.Max((F64(got[i]) - want[i]).Abs())
        big = big.Max(want[i].Abs())
    }
    return worst / big, worst / (F64(k) * 0.0078125)
}

if Gpu {
    fn table(dev mut device.Device&, rounds I64) ? io.Error, device.GpuError {
        try io.Put("== cuBLASLt on " + dev.Str() + ": us a product, resident (the median of " + $rounds + " rounds)\n")
        line := "shape | m x k x n"
        for w in Names: line = line + " | " + w
        try io.Put(line + "\n")
        errs := Vec<String>()
        evidence := Vec<String>()
        r := rand.Rand(1)
        for sh in shapes() {
            m, n, k := sh.M, sh.N, sh.K
            ar, ac := m, k
            if sh.Ta: ar, ac = k, m
            br, bc := k, n
            if sh.Tb: br, bc = n, k
            ha := Array<F32>(m * k)
            hb := Array<F32>(k * n)
            for i in range ha.Len(): ha[i] = F32(r.Uniform(-1.0, 1.0))
            for i in range hb.Len(): hb[i] = F32(r.Uniform(-1.0, 1.0))
            ha16 := Array<BF16>(ha.Len())
            hb16 := Array<BF16>(hb.Len())
            for i in range ha.Len(): ha16[i] = BF16(ha[i])
            for i in range hb.Len(): hb16[i] = BF16(hb[i])
            # the exact products: of the F32 operands, of their BF16 roundings, and of F32 a with BF16 b
            ra := Array<F32>(ha.Len())
            rb := Array<F32>(hb.Len())
            for i in range ha.Len(): ra[i] = F32(ha16[i])
            for i in range hb.Len(): rb[i] = F32(hb16[i])
            want := exact(sh, ha, hb, ar, ac, br, bc)
            want16 := exact(sh, ra, rb, ar, ac, br, bc)
            wantMixed := exact(sh, ha, rb, ar, ac, br, bc)
            hc := Array<F32>(m * n)
            hc16 := Array<BF16>(m * n)
            ws := gemm.Workspace<F32>(1, m.Max(k).Max(n), m * n)
            am := mat.Mat<F32>(ha, 0, ar, ac, ac)
            bm := mat.Mat<F32>(hb, 0, br, bc, bc)
            cm := mat.Mat<F32>(hc, 0, m, n, n)
            a32 := try device.Buf<F32>.Make(dev, ha.Len())
            b32 := try device.Buf<F32>.Make(dev, hb.Len())
            a16 := try device.Buf<BF16>.Make(dev, ha.Len())
            b16 := try device.Buf<BF16>.Make(dev, hb.Len())
            c32 := try device.Buf<F32>.Make(dev, m * n)
            c16 := try device.Buf<BF16>.Make(dev, m * n)
            a32.UploadAll(ha)
            b32.UploadAll(hb)
            a16.UploadAll(ha16)
            b16.UploadAll(hb16)
            da := device.DMat<F32>(a32, 0, ar, ac, ac)
            db := device.DMat<F32>(b32, 0, br, bc, bc)
            da16 := device.DMat<BF16>(a16, 0, ar, ac, ac)
            db16 := device.DMat<BF16>(b16, 0, br, bc, bc)
            dc := device.DMat<F32>(c32, 0, m, n, n)
            dc16 := device.DMat<BF16>(c16, 0, m, n, n)
            f32 := try blas.Product<F32, F32, F32>.Plan(dev, dc, da, sh.Ta, db, sh.Tb)
            f32t := try blas.Product<F32, F32, F32>.Plan(dev, dc, da, sh.Ta, db, sh.Tb)
            try f32t.Tune(dev, dc, da, db)
            bf := try blas.Product<BF16, BF16, BF16>.Plan(dev, dc16, da16, sh.Ta, db16, sh.Tb)
            bft := try blas.Product<BF16, BF16, BF16>.Plan(dev, dc16, da16, sh.Ta, db16, sh.Tb)
            try bft.Tune(dev, dc16, da16, db16)
            bff := try blas.Product<BF16, BF16, BF16>.Plan(dev, dc16, da16, sh.Ta, db16, sh.Tb, blas.Epilogue<BF16>.None, blas.Sums.Fast)
            try bff.Tune(dev, dc16, da16, db16)
            bfo := try blas.Product<F32, BF16, BF16>.Plan(dev, dc, da16, sh.Ta, db16, sh.Tb)
            try bfo.Tune(dev, dc, da16, db16)
            vbf := try blas.Product<F32, F32, F32>.Plan(dev, dc, da, sh.Ta, db, sh.Tb, blas.Epilogue<F32>.None, blas.Sums.FastBF16)
            try vbf.Tune(dev, dc, da, db)
            vtf := try blas.Product<F32, F32, F32>.Plan(dev, dc, da, sh.Ta, db, sh.Tb, blas.Epilogue<F32>.None, blas.Sums.FastTF32)
            try vtf.Tune(dev, dc, da, db)
            mix := try blas.Product<F32, F32, BF16>.Plan(dev, dc, da, sh.Ta, db16, sh.Tb)
            try mix.Tune(dev, dc, da, db16)
            ways := Names.Len()
            # one product of way i, enqueued
            wsr mut gemm.Workspace<F32>& = ws
            cmr mut mat.Mat<F32>& = cm
            dcr mut device.DMat<F32>& = dc
            dc16r mut device.DMat<BF16>& = dc16
            run := fn(i I64) {
                match i {
                    case 0: gemm.Gemm(wsr, cmr, am, sh.Ta, bm, sh.Tb, F32(1), F32(0))
                    case 1: blas.Gemm(dev, dcr, da, sh.Ta, db, sh.Tb, F32(1), F32(0))
                    case 2: blas.Gemm(dev, dc16r, da16, sh.Ta, db16, sh.Tb, F32(1), F32(0))
                    case 3: f32.Run(dev, dcr, da, db)
                    case 4: f32t.Run(dev, dcr, da, db)
                    case 5: bf.Run(dev, dc16r, da16, db16)
                    case 6: bft.Run(dev, dc16r, da16, db16)
                    case 7: bff.Run(dev, dc16r, da16, db16)
                    case 8: bfo.Run(dev, dcr, da16, db16)
                    case 9: vbf.Run(dev, dcr, da, db)
                    case 10: vtf.Run(dev, dcr, da, db)
                    case _: mix.Run(dev, dcr, da, db16)
                }
            }
            # the errors, each way once
            eline := sh.What
            for i in range 1, ways {
                run(i)
                rel, unit := 0.0, 0.0
                if i == 2 or (i >= 5 and i <= 7) {
                    c16.DownloadAll(hc16)
                    try dev.Sync()
                    rel, unit = errors(hc16, want16, k)
                } else {
                    c32.DownloadAll(hc)
                    try dev.Sync()
                    rel, unit = errors(hc, want16 if i == 8 else (wantMixed if i == 11 else want), k)
                }
                eline = eline + " | " + sci(rel) + " / " + sci(unit)
            }
            errs.Push(eline)
            # ns a product of way i over reps products
            timed := fn(i I64, reps I64) F64 ? device.GpuError {
                t0 := time.Now()
                for _ in range reps: run(i)
                if i > 0: try dev.Sync()
                return F64(time.Since(t0)) / F64(reps)
            }
            reps := Array<I64>(ways)
            for i in range ways {
                reps[i] = 1
                for {
                    if try timed(i, reps[i]) * F64(reps[i]) > 2e7 or reps[i] >= 1 << 20: break
                    reps[i] = reps[i] * 2
                }
            }
            times := Array<Array<F64>>(ways)
            for i in range ways: times[i] = Array<F64>(rounds)
            for round in range rounds {
                for i in range ways {
                    if i > 0: try timed(i, reps[i])
                    times[i][round] = try timed(i, reps[i])
                }
            }
            t := Array<F64>(ways)
            for i in range ways: t[i] = median(times[i])
            row := sh.What + " | " + $m + " x " + $k + " x " + $n
            for i in range ways: row = row + " | " + us(t[i])
            try io.Put(row + "\n")
            if t[6].Min(t[5]).Min(t[8]) >= t[4] {
                evidence.Push(sh.What + ": F32 tuned " + us(t[4]) + " us (" + f32t.Chosen.Str() + "); BF16 tried " + bft.TriedStr() + "; BF16>F32 tried " + bfo.TriedStr() + "; BF16 fast tried " + bff.TriedStr())
            }
            # the chosen algorithms, for the record
            evidence.Push("  chosen at " + sh.What + ": BF16 tuned " + bft.Chosen.Str() + "; BF16 fast " + bff.Chosen.Str())
        }
        try io.Put("\n== the error against the exact product: max|err| / max|exact| / (max|err| / (k eps(BF16) max|a| max|b|))\n")
        head := "shape"
        for i in range 1, Names.Len(): head = head + " | " + Names[i]
        try io.Put(head + "\n")
        for e in errs: try io.Put(e + "\n")
        try io.Put("\n== where no exact BF16 way beats F32 tuned: what Tune tried (id/tile/split-K/reduction: us), and what was chosen\n")
        for e in evidence: try io.Put(e + "\n")
    }
}

fn main() ? io.Error, ParseError {
    args := os.Args()
    rounds := try number(args, 1, 5)
    if Gpu {
        dev := try device.Device.Open() catch e {
            try io.Put("no GPU (" + $e + ")\n")
            return
        }
        try table(dev, rounds) catch device.GpuError e: try io.Put("GPU failed: " + $e + "\n")
    } else {
        try io.Put("bench/gpult needs -define Gpu=true\n")
    }
}
