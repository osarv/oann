# the INT8 product (quant.Linear) against std/linalg's F32 product with its bias and ReLU (GemmAct), on the shapes of
# oann's networks and a square one - interleaved, the median of each over rounds. Arguments: rounds (7), threads (1)

import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../linalg"
import "../quant"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

fn median(xs mut Array<F64>&) F64 {
    xs.Sort(fn(a, b): return a < b)
    return xs[xs.Len() / 2]
}

# the F32 product with its bias and ReLU, reps times
fn f32Product(y mut linalg.Matrix<F32>&, x linalg.Matrix<F32>&, w linalg.Matrix<F32>&, b linalg.Matrix<F32>&, reps I64, threads I64
        ws mut linalg.GemmWorkspace<F32>&) {
    for _ in range reps: ws.GemmAct(y, x, false, w, true, b, linalg.Activation.Relu, 1, 0, threads)!
}

# one shape's medians, in nanoseconds a product: F32, INT8 with its input quantized each time, INT8 alone
type Medians struct(f32 F64, dynamic F64, alone F64) { f32, dynamic, alone }

fn Medians.Measure(m I64, k I64, n I64, rounds I64, threads I64, r mut rand.Rand&, ws mut linalg.GemmWorkspace<F32>&) Medians {
    x := linalg.Matrix<F32>(m, k)
    x.FillUniform(r, 0.0, 1.0)
    w := linalg.Matrix<F32>(n, k)
    w.FillUniform(r, -0.2, 0.2)
    b := linalg.Matrix<F32>(1, n)
    b.FillUniform(r, -0.1, 0.1)
    q := quant.Weights.Quantize(w)
    a := quant.Activations(quant.ElementsFor(m, k))
    y := linalg.Matrix<F32>(m, n)
    # repeat each timing until it takes about 20 ms
    reps I64 = 1
    for {
        t0 := time.Now()
        f32Product(y, x, w, b, reps, threads, ws)
        if time.Since(t0) > 20000000 or reps > 1000000: break
        reps = reps * 2
    }
    f32s := Array<F64>(rounds)
    i8s := Array<F64>(rounds)
    qs := Array<F64>(rounds)
    for t in range rounds {
        t0 := time.Now()
        f32Product(y, x, w, b, reps, threads, ws)
        f32s[t] = F64(time.Since(t0)) / F64(reps)
        t1 := time.Now()
        for _ in range reps {
            a.QuantizeDynamic(x)
            quant.Linear(y, a, q, b.Row(0), true, threads)
        }
        i8s[t] = F64(time.Since(t1)) / F64(reps)
        t2 := time.Now()
        for _ in range reps: quant.Linear(y, a, q, b.Row(0), true, threads)
        qs[t] = F64(time.Since(t2)) / F64(reps)
    }
    return Medians(median(f32s), median(i8s), median(qs))
}

# the perceptron's layers at batch 1, 64 and 128; the CNN's two convolutions (patches x kernels) at batch 128; the
# character transformer's perceptron (1024 rows: 16 sequences of 64) and its decoding step (one row); squares
# (m, k and n of each product)
Shapes Array<I64> = Array<I64>[1, 784, 128, 64, 784, 128, 128, 784, 128, 128, 128, 10, 100352, 9, 16, 25088, 144, 32
    1024, 128, 512, 1024, 512, 128, 1, 128, 512, 1, 512, 128, 1, 128, 128, 512, 512, 512, 1024, 1024, 1024, 1, 1024, 1024]

fn main() ? io.Error, ParseError {
    args := os.Args()
    rounds := try number(args, 1, 7)
    threads := try number(args, 2, 1)
    r := rand.Rand(1)
    ws := linalg.GemmWorkspace<F32>()
    for i in range 0, Shapes.Len(), 3 {
        m := Shapes[i]
        k := Shapes[i + 1]
        n := Shapes[i + 2]
        t := Medians.Measure(m, k, n, rounds, threads, r, ws)
        ops F64 = 2.0 * F64(m) * F64(n) * F64(k)
        try io.Put(($m " x " $k " x " $n ": F32 " $(t.f32 * 1e-3).Fixed(2) " us (" $(ops / t.f32).Fixed(1)
            " GFLOPS), INT8 with dynamic quantization " $(t.dynamic * 1e-3).Fixed(2) " us (" $(ops / t.dynamic).Fixed(1)
            " GOPS, " $(t.f32 / t.dynamic).Fixed(2) "x), the product alone " $(t.alone * 1e-3).Fixed(2) " us ("
            $(ops / t.alone).Fixed(1) " GOPS, " $(t.f32 / t.alone).Fixed(2) "x)\n"))
    }
}
