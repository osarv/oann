# sampling a batch of continuations from a small GPT: running the whole context again for every token (a graph of
# Batch sequences, one Forward over the context a token) against decoding with key-value caches for the whole batch
# at once (generate.CachedBatch). Arguments: layers (2), width (128), batch (64), prompt (16), new tokens (48),
# vocabulary (512); the context is prompt + new tokens
import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../ad/graph"
import "../nn/train"
import "../nn/generate"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

fn main() ? io.Error, ParseError {
    args :~ os.Args()
    layers := try number(args, 1, 2)
    width := try number(args, 2, 128)
    batch := try number(args, 3, 64)
    p := try number(args, 4, 16)
    count := try number(args, 5, 48)
    vocab := try number(args, 6, 512)
    ctx := p + count
    r := rand.Rand(1)
    full mut graph.Graph<F32>& = graph.Graph<F32>(batch, 1, graph.Mode.Captured, false)
    fm := train.LanguageModel.Gpt(full, vocab, ctx, width, 4, layers, 0.0, false)
    try full.Plan(r) catch e { unreachable $e }
    dec mut graph.Graph<F32>& = graph.Graph<F32>(batch, 1, graph.Mode.Captured, true)
    dm := train.LanguageModel.Gpt(dec, vocab, ctx, width, 4, layers, 0.0, false)
    try dec.Plan(r) catch e { unreachable $e }
    try dec.Params().Convert(full.Params()) catch { unreachable }
    prompts := Array<I32>(batch * p)
    for i in range prompts.Len(): prompts[i] = I32(r.Below(vocab))
    # rerun: every token a Forward over the whole context of every row
    full.Training = false
    ids :~ full.Ints(fm.Tokens).Flat()!
    for b in range batch {
        for t in range p: ids[b * ctx + t] = prompts[b * p + t]
    }
    t0 := time.Now()
    for t in range p - 1, ctx - 1 {
        full.Forward(batch)
        z :~ full.Value(fm.Logits).Flat()!
        for b in range batch: ids[b * ctx + t + 1] = generate.Sample(z[(b * ctx + t) * vocab:(b * ctx + t + 1) * vocab], 1.0, r)
    }
    rerun := F64(time.Since(t0)) * 1e-9
    t1 := time.Now()
    out := generate.CachedBatch(dec, dm, prompts, p, count, 1.0, r)
    cached := F64(time.Since(t1)) * 1e-9
    tokens := F64(batch * count)
    try io.PutLn($layers + " x " + $width + ", batch " + $batch + ", prompt " + $p + ", " + $count + " new tokens (" + $out.Len() + "): rerun " + $(tokens / rerun).Fixed(0) + " tokens a second, cached batch " + $(tokens / cached).Fixed(0) + " (" + $(rerun / cached).Fixed(1) + "x)")
}
