# where a step of the character-level transformer (examples/charlm.olang's model) goes: the time in each kind of
# operation, forward and backward, gathered by the graph's own profiling, then clipping and the optimizer - over a
# number of steps after a few to warm up - and whether the process grows while it trains. Arguments: the steps (20),
# the threads (1), and the model as layers, width, heads, context and sequences (4 128 4 64 16); a last argument
# "bf16" runs it in mixed precision (graph.Graph<BF16>, F32 masters)

import "std/io"
import "std/os"
import "std/rand"
import "std/time"
import "../ad/graph"
import "../data/text"
import "../nn/optim"
import "../nn/train"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len(): return fallback
    return try args[i].ParseInt()
}

# the process's resident memory, kB
fn rss() I64 {
    t := try os.ReadFile("/proc/self/status") catch default ""
    i := try t.Find("VmRSS:") catch default 0
    rest := t[i + 6:]
    j := try rest.Find("kB") catch default 0
    return try rest[:j].Trim().ParseInt() catch default -1
}

fn ms(ns I64, steps I64) String {
    return $(F64(ns) * 1e-6 / F64(steps)).Fixed(2)
}

fn main() ? {
    all := os.Args()
    bf16 Bool = all.Len() > 1 and all[all.Len() - 1] == "bf16"
    args := all[:all.Len() - 1] if bf16 else all
    if bf16 {
        like BF16 = 0.0
        try run(args, like)
    } else {
        like F32 = 0.0
        try run(args, like)
    }
}

fn run<E>(args Array<String&>&, like E) ? {
    steps := try number(args, 1, 20)
    threads := try number(args, 2, 1)
    depth := try number(args, 3, 4)
    width := try number(args, 4, 128)
    heads := try number(args, 5, 4)
    context := try number(args, 6, 64)
    sequences := try number(args, 7, 16)
    try os.MkDirAll("data/shakespeare")
    try text.Fetch("data/shakespeare/input.txt", text.Shakespeare)
    c := try text.Corpus.Load("data/shakespeare/input.txt")
    g := graph.Graph<E>(sequences, threads)
    m := train.LanguageModel.Gpt(g, c.Size(), context, width, heads, depth)
    try g.Plan(rand.Rand(1))
    try io.Put(($depth + " layers of " + $width + ", " + $heads + " heads, context " + $context + ", " + $sequences + " sequences, " +
        $g.ParamCount + " parameters, " + $threads + " threads, " + $(g.Size()) + " nodes, an arena of " +
        $(F64(g.ArenaBytes()) / 1048576.0).Fixed(1) + " MB" + $(" and F32 masters" if g.HasMasters() else "") + "\n"))
    w := text.Windows(c.Train(), context, 1)
    if g.HasMasters(): try measure(g, m, optim.AdamW(g.Masters(), g.ParamGrads(), beta2 = 0.99, decay = 0.1, spans = optim.Spans(g)), w, steps)
    else: try measure(g, m, optim.AdamW(g.Params(), g.ParamGrads(), beta2 = 0.99, decay = 0.1, spans = optim.Spans(g)), w, steps)
}

fn measure<E, O>(g mut graph.Graph<E>&, m train.LanguageModel&, o mut O&, w mut text.Windows&, steps I64) ? io.Error {
    sequences := g.Batch
    for _ in range 3: train.LmStep(g, m, w, o, 1e-3, 1.0)
    before := rss()
    g.Profiling = true
    filling I64 = 0
    clipping I64 = 0
    stepping I64 = 0
    t0 := time.Now()
    for _ in range steps {
        a := time.Now()
        w.Random(g.Ints(m.Tokens).Flat()!, g.Ints(m.Targets).Flat()!, sequences)
        b := time.Now()
        g.Forward(g.Batch)
        g.Backward(m.Loss)
        d := time.Now()
        optim.ClipNorm(g.ParamGrads(), 1.0)
        e := time.Now()
        o.Step()
        g.SyncParams()
        f := time.Now()
        filling += b - a
        clipping += e - d
        stepping += f - e
    }
    total := time.Since(t0)
    after := rss()
    try io.Put("operation              forward ms  backward ms   (a step)\n")
    gemm I64 = 0
    attention I64 = 0
    rest I64 = 0
    for k in range graph.KindNames.Len() {
        fw := g.Times[2 * k]
        bw := g.Times[2 * k + 1]
        if fw + bw == 0: continue
        name := graph.KindNames[k]
        pad := " ".Repeat(22 - name.Len())
        try io.Put($name + $pad + " " + $ms(fw, steps) + "        " + $ms(bw, steps) + "\n")
        if name == "Linear" or name == "MatMul": gemm += fw + bw
        else if name == "Attention": attention += fw + bw
        else: rest += fw + bw
    }
    try io.Put(("filling the batch      " + $ms(filling, steps) + "\nclipping               " + $ms(clipping, steps) +
        "\noptimizer              " + $ms(stepping, steps) + "\n"))
    try io.Put(("products " + $ms(gemm, steps) + " ms, attention " + $ms(attention, steps) + " ms, the rest of the graph " +
        $ms(rest, steps) + " ms, clipping and optimizer " + $ms(clipping + stepping, steps) + " ms\n"))
    try io.Put(("a step " + $ms(total, steps) + " ms, " + $(F64(steps * g.Batch) / (F64(total) * 1e-9)).Fixed(0) +
        " tokens a second; resident memory grew " + $(after - before) + " kB over " + $steps + " steps\n"))
}
