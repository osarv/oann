# decoding speed of an open-weight model (llm/model) on this machine: tokens a second at each batch size, every
# sequence of the batch given a context of ctx positions first (random tokens, read 256 rows a step), then "steps"
# steps of one token each timed - and where a step's time goes (the products, attention, the rest) and the process's
# peak resident memory, and how fast the contexts were read. Arguments: the model's directory, the context (512), the steps (16), "int8" or "int4" for 8- or 4-bit weights,
# then the batch sizes (1 16 64); OANN_KV8 set: 8-bit keys and values

import "std/os"
import "std/time"
import "../llm/model"

# the peak resident memory in MB (VmHWM)
fn peak() I64 {
    status :~ try os.ReadFile("/proc/self/status") catch default ""
    for line in status.Lines() {
        if not line.StartsWith("VmHWM:"): continue
        return (try line[6:].Trim().Split(" ")[0].ParseInt() catch default 0) / 1024
    }
    return 0
}

fn main() {
    args :~ os.Args()
    if args.Len() < 2 {
        Println("bench/llm MODEL [ctx] [steps] [int8|int4|bf16] [batch ...]")
        return
    }
    ctx I64 = args[2].ParseInt()! if args.Len() > 2 else 512
    steps I64 = args[3].ParseInt()! if args.Len() > 3 else 16
    int8 := args.Len() > 4 and args[4] == "int8"
    int4 := args.Len() > 4 and args[4] == "int4"
    batches := Vec<I64>()
    for i in range 5, args.Len(): batches.Push(args[i].ParseInt()!)
    if batches.Len() == 0 {
        for b in [1, 16, 64]: batches.Push(b)
    }
    t0 := time.Now()
    m := model.Model.Load(args[1], false, int8, int4)!
    Println(args[1] + ": " + $(m.C.Params() / 1000000) + "M parameters, " + $(m.Bytes() / 1048576) + " MB of weights (" +
        ("INT8" if int8 else ("INT4" if int4 else "BF16")) + ", cache " + ("INT8" if (try os.Env("OANN_KV8") catch default "").Len() > 0 else "BF16") + "), " + ("AMX" if m.Tile else "F32") + ", loaded in " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    top := batches.View().Max()!
    per := (ctx + steps) / model.PageSize + 1
    kv8 := (try os.Env("OANN_KV8") catch default "").Len() > 0
    k := model.Cache(m.C, top * per, top, per, Kv8 = kv8)
    chunk I64 = (try os.Env("OANN_CHUNK") catch default "256").ParseInt()!     # context rows a step
    s := model.State(m, top + chunk, top, ctx + steps + model.PageSize)
    for batch in batches.View() {
        for i in range top * per {
            if k.Table[i] >= 0: k.Give(k.Table[i])
            k.Table[i] = -1
        }
        for i in range batch * per: k.Table[i] = k.Take()
        # the contexts, chunk rows a step
        rows := Vec<I64>()
        for b in range batch {
            for p in range ctx: rows.Push(b * ctx + p)
        }
        # (OANN_NOFILL: the cache's pages left as they are - the timing is the same, the logits meaningless)
        fill := (try os.Env("OANN_NOFILL") catch default "").Len() == 0
        for i in range 4: s.Times[i] = 0
        t2 := time.Now()
        for r0 in range 0, rows.Len() if fill else 0, chunk {
            s.Reset()
            for j in range r0, (r0 + chunk).Min(rows.Len()) {
                b := rows[j] / ctx
                p := rows[j] % ctx
                s.Add(I32((p * 7919 + b * 131) % m.C.Vocab), p, b, false)
            }
            m.Step(s, k)
        }
        if fill: Println("batch " + $batch + ": read " + $rows.Len() + " context tokens in " + (F64(time.Since(t2)) / 1e9).Fixed(2) + " s, " + (F64(rows.Len()) / F64(time.Since(t2)) * 1e9).Fixed(0) + " a second (products " + (F64(s.Times[0]) / 1e9).Fixed(2) + " s)")
        for i in range 4: s.Times[i] = 0
        t1 := time.Now()
        for t in range steps {
            s.Reset()
            for b in range batch: s.Add(I32((t * 31 + b) % m.C.Vocab), ctx + t, b, true)
            m.Step(s, k)
        }
        ns := F64(time.Since(t1))
        ms := fn(x I64) String { return (F64(x) / F64(steps) / 1e6).Fixed(1) }
        Println("batch " + $batch + ", context " + $ctx + ": " + (ns / F64(steps) / 1e6).Fixed(1) + " ms a step, " +
            (F64(batch * steps) / ns * 1e9).Fixed(1) + " tokens/s (products " + ms(s.Times[0]) + " ms, attention " +
            ms(s.Times[1]) + " ms, the rest " + ms(s.Times[2]) + " ms); peak " + $peak() + " MB")
    }
}
