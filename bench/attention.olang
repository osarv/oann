# attention's forward and backward as ops.olang computes them - a Gemm per sequence and head from std/linalg, on each
# head's strided view - against the dot products and updates over the same views that it replaced (kept here as the
# reference: they compute only the causal half, row by row). Both are timed over B sequences of T rows, D columns in
# "heads" heads, causal, on one task, in alternating rounds - a median of each - and their outputs and gradients
# compared. Arguments: B, T, D, heads, repetitions per round, rounds (16 64 128 4 10 9)

import "std/io"
import "std/linalg"
import "std/math"
import "std/os"
import "std/rand"
import "std/time"
import "../ops"
import "../kernels"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() { return fallback }
    return try args[i].ParseInt()
}

# ---- the reference: dot products and updates over the heads' views, the causal half only ----

fn loops(y linalg.Matrix<F32>&, q linalg.Matrix<F32>&, k linalg.Matrix<F32>&, v linalg.Matrix<F32>&, heads I64, T I64,
        probs linalg.Matrix<F32>&) {
    dh I64 = q.Cols / heads
    scale F32 = 1.0 / math.Sqrt(F32(dh))
    P := probs.Data
    for s in range q.Rows / T {
        for h in range heads {
            p0 I64 = (s * heads + h) * T
            r0 I64 = s * T
            c0 I64 = h * dh
            for i in range T {
                qo I64 = (r0 + i) * q.Stride + c0
                po I64 = (p0 + i) * probs.Stride
                last I64 = i + 1
                top F32 = 0.0
                for j in range last {
                    sc F32 = scale * kernels.Dot(q.Data, qo, k.Data, (r0 + j) * k.Stride + c0, dh)
                    P[po + j] = sc
                    if j == 0 or sc > top { top = sc }
                }
                total F32 = 0.0
                for j in range last {
                    e F32 = math.Exp(P[po + j] - top)
                    P[po + j] = e
                    total = total + e
                }
                inv F32 = 1.0 / total
                for j in range last { P[po + j] = P[po + j] * inv }
                for j in range last, T { P[po + j] = 0.0 }
                yo I64 = (r0 + i) * y.Stride + c0
                for c in range dh { y.Data[yo + c] = 0.0 }
                for j in range last { kernels.Axpy(y.Data, yo, P[po + j], v.Data, (r0 + j) * v.Stride + c0, dh) }
            }
        }
    }
}

fn loopsBackward(dy linalg.Matrix<F32>&, q linalg.Matrix<F32>&, k linalg.Matrix<F32>&, v linalg.Matrix<F32>&,
        heads I64, T I64, probs linalg.Matrix<F32>&, dq linalg.Matrix<F32>&, dk linalg.Matrix<F32>&,
        dv linalg.Matrix<F32>&, ds mut Array<F32>&) {
    dh I64 = q.Cols / heads
    scale F32 = 1.0 / math.Sqrt(F32(dh))
    P := probs.Data
    dq.Fill(0.0)
    dk.Fill(0.0)
    dv.Fill(0.0)
    for s in range q.Rows / T {
        for h in range heads {
            p0 I64 = (s * heads + h) * T
            r0 I64 = s * T
            c0 I64 = h * dh
            for i in range T {
                go I64 = (r0 + i) * dy.Stride + c0
                po I64 = (p0 + i) * probs.Stride
                dot F32 = 0.0
                for j in range i + 1 {
                    dp F32 = kernels.Dot(dy.Data, go, v.Data, (r0 + j) * v.Stride + c0, dh)
                    ds[i * T + j] = dp
                    dot = dot + dp * P[po + j]
                }
                for j in range i + 1 { ds[i * T + j] = scale * P[po + j] * (ds[i * T + j] - dot) }
            }
            for i in range T {
                o I64 = (r0 + i) * dq.Stride + c0
                qo I64 = (r0 + i) * q.Stride + c0
                go I64 = (r0 + i) * dy.Stride + c0
                po I64 = (p0 + i) * probs.Stride
                for j in range i + 1 {
                    kernels.Axpy(dq.Data, o, ds[i * T + j], k.Data, (r0 + j) * k.Stride + c0, dh)
                    kernels.Axpy(dk.Data, (r0 + j) * dk.Stride + c0, ds[i * T + j], q.Data, qo, dh)
                    kernels.Axpy(dv.Data, (r0 + j) * dv.Stride + c0, P[po + j], dy.Data, go, dh)
                }
            }
        }
    }
}

fn median(xs Array<I64>&) I64 {
    s := xs.ToList()
    s.Sort(fn(a, b) { return a < b })
    return s[s.Len() / 2]
}

fn ms(ns I64, reps I64) String {
    return $(F64(ns) * 1e-6 / F64(reps)).Fixed(2)
}

fn main() ? io.IoError + ParseError {
    args := os.Args()
    B := try number(args, 1, 16)
    T := try number(args, 2, 64)
    D := try number(args, 3, 128)
    heads := try number(args, 4, 4)
    reps := try number(args, 5, 10)
    rounds := try number(args, 6, 9)
    r := rand.Rand(1)
    n I64 = B * T
    q := linalg.Matrix<F32>(n, D)
    k := linalg.Matrix<F32>(n, D)
    v := linalg.Matrix<F32>(n, D)
    q.FillNormal(r, 0.0, 1.0)
    k.FillNormal(r, 0.0, 1.0)
    v.FillNormal(r, 0.0, 1.0)
    dy := linalg.Matrix<F32>(n, D)
    dy.FillNormal(r, 0.0, 1.0)
    y := linalg.Matrix<F32>(n, D)
    y2 := linalg.Matrix<F32>(n, D)
    probs := linalg.Matrix<F32>(n * heads, T)
    probs2 := linalg.Matrix<F32>(n * heads, T)
    dq := linalg.Matrix<F32>(n, D)
    dk := linalg.Matrix<F32>(n, D)
    dv := linalg.Matrix<F32>(n, D)
    dq2 := linalg.Matrix<F32>(n, D)
    dk2 := linalg.Matrix<F32>(n, D)
    dv2 := linalg.Matrix<F32>(n, D)
    scratch := Array<F32>(ops.AttentionScratch(T, D / heads))
    wss := Array<linalg.GemmWorkspace<F32>>(1, linalg.GemmWorkspace<F32>())
    ops.WarmAttention(wss, T, D / heads)
    times := Array<I64>(4 * rounds)               # the loops' forward, the Gemms', then the two backwards, by round
    for round in range rounds {
        t0 := time.Now()
        for i in range reps { loops(y, q, k, v, heads, T, probs) }
        t1 := time.Now()
        for i in range reps { ops.Attention(y2, q, k, v, heads, T, true, probs2, scratch, 1, wss) }
        t2 := time.Now()
        for i in range reps { loopsBackward(dy, q, k, v, heads, T, probs, dq, dk, dv, scratch) }
        t3 := time.Now()
        for i in range reps { ops.AttentionBackward(dy, q, k, v, heads, T, true, probs2, dq2, false, dk2, false, dv2, false, scratch, 1, wss) }
        t4 := time.Now()
        times[0 * rounds + round] = t1 - t0
        times[1 * rounds + round] = t2 - t1
        times[2 * rounds + round] = t3 - t2
        times[3 * rounds + round] = t4 - t3
    }
    worst F32 = math.Max(math.Max(y.MaxAbsDifference(y2), dq.MaxAbsDifference(dq2)),
        math.Max(dk.MaxAbsDifference(dk2), dv.MaxAbsDifference(dv2)))
    try io.Print("B " $B ", T " $T ", D " $D ", " $heads " heads, medians of " $rounds " rounds of " $reps ": forward "
        $ms(median(times[0 * rounds:(0 + 1) * rounds]), reps) " ms by the loops, " $ms(median(times[1 * rounds:(1 + 1) * rounds]), reps) " by a Gemm per head; backward "
        $ms(median(times[2 * rounds:(2 + 1) * rounds]), reps) " by the loops, " $ms(median(times[3 * rounds:(3 + 1) * rounds]), reps) " by Gemms; outputs and gradients "
        "differ by at most " $worst "\n")
}
