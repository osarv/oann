# bench/gpullm - a language model's decoding on the GPU (llm/gpu) against the CPU's step, then its speed:
#
#     bench_gpullm MODEL_DIR [steps] [batch ...]
#
# The check: one sequence of 24 tokens read in one step, then 8 greedy tokens, on the CPU (F32 activations) and on the
# device (BF16 activations): the largest difference of any logit, the largest logit, and whether every greedy token
# agrees. The speed: for each batch (default 1 8 32 64), `steps` steps (default 256) of one token a sequence from
# position 0, every row's logits brought down - tokens a second over all of them, and over the last quarter (the
# longest contexts). Built with -define Gpu=true (make gpullm).

import gdev "../kernels/gpu/device"
import "../llm/gpu"
import "../llm/model"
import "std/os"
import "std/time"

fn best(lg Array<F32>&) I64 {
    b I64 = 0
    for i in range lg.Len() {
        if lg[i] > lg[b]: b = i
    }
    return b
}

fn fail(msg String&) noreturn {
    Println("bench_gpullm: " + msg)
    os.Exit(1)
}

fn check(dev mut gdev.Device&, m model.Model&) ? gdev.GpuError {
    c model.Config& = m.C
    kc := model.Cache(c, 2, 1, 2, true)
    kg := model.Cache(c, 2, 1, 2, device = true)
    for i in range 2 {
        kc.Table[i] = kc.Take()
        kg.Table[i] = kg.Take()
    }
    sc := model.State(m, 24, 24, 64)
    sg := model.State(m, 24, 24, 64)
    dec := try gpu.Decoder.Make(dev, m, 24, 24, kg, 64)
    for i in range 24 {
        t := I32((i * 7919 + 1000) % c.Vocab)
        sc.Add(t, i, 0, true)
        sg.Add(t, i, 0, true)
    }
    worst, top := 0.0, 0.0
    agree, total := 0, 0
    for step in range 9 {
        m.Step(sc, kc)
        try dec.Step(m, sg, kg)
        for i in range sc.NOut * c.Vocab {
            worst = worst.Max(F64((sc.Logits[i] - sg.Logits[i]).Abs()))
            top = top.Max(F64(sc.Logits[i].Abs()))
        }
        for j in range sc.NOut {
            total++
            if best(sc.LogitsOf(j, c.Vocab)) == best(sg.LogitsOf(j, c.Vocab)): agree++
        }
        next := I32(best(sc.LogitsOf(sc.NOut - 1, c.Vocab)))
        sc.Reset()
        sg.Reset()
        sc.Add(next, 24 + step, 0, true)
        sg.Add(next, 24 + step, 0, true)
    }
    Println("check: largest logit difference " + worst.Fixed(4) + " of logits up to " + top.Fixed(2) + "; the most likely token agrees at " + $agree + " of " + $total + " rows")
}

fn speed(dev mut gdev.Device&, m model.Model&, steps I64, batches Array<I64>&) ? gdev.GpuError {
    c model.Config& = m.C
    most I64 = 0
    for b in batches: most = most.Max(b)
    per := steps / model.PageSize + 1
    room := dev.MiB * 1048576 - gpu.WeightBytes(m) - 1536 * 1048576
    need := most * per * model.PageBytes(c)
    Println("cache: " + $(most * per) + " pages, " + $(need / 1048576) + " MB of " + $(room / 1048576) + " MB left after the weights (" + $(model.PageBytes(c) / model.PageSize / 1024) + " KB a token)")
    if need > room: fail("no room for batch " + $most + " over " + $steps + " positions: fewer steps or a smaller batch")
    k := model.Cache(c, most * per, most, per, device = true)
    for i in range most * per: k.Table[i] = k.Take()
    s := model.State(m, most, most, steps)
    t0 := time.Now()
    dec := try gpu.Decoder.Make(dev, m, most, most, k, steps)
    Println("on the device: " + $(dec.Bytes / 1048576) + " MB, " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    for b in batches {
        late I64 = 0
        from := steps - steps / 4
        start := time.Now()
        for p in range steps {
            if p == from: late = time.Now()
            s.Reset()
            for q in range b: s.Add(I32((p * 7919 + q * 104729 + 1000) % c.Vocab), p, q, true)
            try dec.Step(m, s, k)
        }
        all := F64(time.Since(start)) / 1e9
        tail := F64(time.Since(late)) / 1e9
        Println("batch " + $b + ": " + (F64(b * steps) / all).Fixed(1) + " tokens/s over " + $steps + " steps (" + (all * 1000.0 / F64(steps)).Fixed(1) + " ms a step); " +
            (F64(b * (steps - from)) / tail).Fixed(1) + " tokens/s at positions " + $from + " to " + $steps)
    }
}

fn main() {
    args := os.Args()
    if args.Len() < 2: fail("usage: bench_gpullm MODEL_DIR [steps] [batch ...]")
    steps := try args[2].ParseInt() catch default 256 if args.Len() > 2 else 256
    bs := Vec<I64>()
    for i in range 3, args.Len(): bs.Push(try args[i].ParseInt() catch { fail("a batch is a number") })
    if bs.Len() == 0 {
        for b in [1, 8, 32, 64]: bs.Push(b)
    }
    t0 := time.Now()
    m := try model.Model.Load(args[1], true) catch { fail("cannot load the model in " + args[1]) }
    why := gpu.Refusal(m)
    if why != "": fail("llm/gpu does not run this model: " + why)
    dev := try gdev.Device.Open() catch e { fail($e) }
    Println(dev.Str() + "; " + args[1] + ": " + $(m.C.Params() / 1000000) + "M parameters, " + $(gpu.WeightBytes(m) / 1048576) + " MB on the device, loaded in " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    try check(dev, m) catch e { fail("the check: " + $e) }
    try speed(dev, m, steps, bs.ToArray()) catch e { fail("the speed: " + $e) }
}
