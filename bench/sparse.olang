# a sparse projection against a dense one (docs/settling.md 2.12, 5.9). First the kernels: an n x n block of F32
# weights at a density, its transport in both directions for a batch (as a sweep runs it: the batch's rows
# sample-major, the sparse block's product on the batch transposed into feature-major and back, the transposes counted)
# and its contrast (two TN products of the batch - two outer products at one row - or the same sampled at the block's
# entries) - the dense block's through std/linalg's Gemm with a workspace, zeros included. Then whole circuits: 256
# inputs into 2048 hidden neurons with a lateral block at a density, reciprocal with 10 readouts, stored Dense or
# Sparse - a lesson at 32 rows and a free settle at one, the same weights either way. Interleaved: every round times
# each variant once; the median of the rounds is printed. Arguments: rounds (7), threads for the dense products (1).

import "std/io"
import "std/linalg"
import "std/math"
import "std/os"
import "std/rand"
import "std/time"
import "../sparse"
import "../circuit"

fn number(args Array<String&>&, i I64, fallback I64) I64 ? ParseError {
    if i >= args.Len() { return fallback }
    return try args[i].ParseInt()
}

fn median(x mut Array<I64>&) F64 {
    x.Sort(fn(a, b) { return a < b })
    return F64(x[x.Len() / 2])
}

# a's rows transposed into t: t[j * b + i] = a[i * n + j]
fn transpose(a Array<F32>&, rows I64, cols I64, t mut Array<F32>&) {
    for i in range rows {
        for j in range cols { t[j * rows + i] = a[i * cols + j] }
    }
}

# y[i * cols + j] += t[j * rows + i]
fn addTransposed(t Array<F32>&, rows I64, cols I64, y mut Array<F32>&) {
    for i in range rows {
        for j in range cols { y[i * cols + j] = y[i * cols + j] + t[j * rows + i] }
    }
}

fn main() ? io.IoError + ParseError {
    args := os.Args()
    rounds := try number(args, 1, 7)
    threads := try number(args, 2, 1)
    r := rand.Rand(1)
    println("n x n block, batch b, density d: microseconds a transport (both directions) and a contrast; median of " $rounds " interleaved rounds")
    println("    n   b      d   dense-tr  sparse-tr   ratio   dense-ct  sparse-ct   ratio")
    for n in I64[1024, 4096] {
        for b in I64[1, 32] {
            x := Array<F32>(b * n)
            y := Array<F32>(b * n)
            for i in range x.Len() {
                x[i] = F32(r.Uniform(-1.0, 1.0))
                y[i] = F32(r.Uniform(-1.0, 1.0))
            }
            total := Array<F32>(b * n)
            back := Array<F32>(b * n)
            xt := Array<F32>(b * n)
            yt := Array<F32>(b * n)
            tt := Array<F32>(b * n)
            bt := Array<F32>(b * n)
            ws := linalg.GemmWorkspace<F32>()
            for d in F64[0.01, 0.02, 0.05, 0.1, 0.2, 0.5] {
                ptr := Array<I64>(n + 1)
                idx := List<I32>()
                sparse.DrawPattern(n, n, d, r, ptr, idx)
                w := sparse.Csr<F32>(n, n, ptr, idx.ToArray())
                for e in range w.Nnz() { w.Values[e] = F32(r.Uniform(-0.05, 0.05)) }
                dense := linalg.Matrix<F32>(n, n)
                w.Dense(dense.Data)
                g := linalg.Matrix<F32>(n, n)
                gs := Array<F32>(w.Nnz())
                xm := linalg.View(x, 0, b, n)
                ym := linalg.View(y, 0, b, n)
                tm := linalg.View(total, 0, b, n)
                bm := linalg.View(back, 0, b, n)
                dt := Array<I64>(rounds)
                st := Array<I64>(rounds)
                dc := Array<I64>(rounds)
                sc := Array<I64>(rounds)
                for k in range rounds {
                    t0 := time.Now()
                    ws.Gemm(tm, xm, false, dense, true, 1, 1, threads)
                    ws.Gemm(bm, ym, false, dense, false, 1, 1, threads)
                    t1 := time.Now()
                    if b == 1 {
                        w.MulAdd(x, 0, 1, total, 0, 1, 1, 1)
                        w.MulAddT(y, 0, 1, back, 0, 1, 1, 1)
                    } else {
                        transpose(x, b, n, xt)
                        transpose(y, b, n, yt)
                        for i in range tt.Len() {
                            tt[i] = 0.0
                            bt[i] = 0.0
                        }
                        w.MulAdd(xt, 0, b, tt, 0, b, b, 1)
                        w.MulAddT(yt, 0, b, bt, 0, b, b, 1)
                        addTransposed(tt, b, n, total)
                        addTransposed(bt, b, n, back)
                    }
                    t2 := time.Now()
                    if b == 1 {
                        linalg.Ger2(g, y, x, x, y, 1, 0)        # at one row the dense contrast is two outer products
                    } else {
                        ws.Gemm(g, ym, true, xm, false, 1, 0, threads)
                        ws.Gemm(g, xm, true, ym, false, 1, 1, threads)
                    }
                    t3 := time.Now()
                    if b > 1 {
                        transpose(x, b, n, xt)
                        transpose(y, b, n, yt)
                        w.Sampled(gs, 0, yt, 0, b, xt, 0, b, b, 1, false)
                        w.Sampled(gs, 0, xt, 0, b, yt, 0, b, b, 1, true)
                    } else {
                        w.Sampled(gs, 0, y, 0, 1, x, 0, 1, 1, 1, false)
                        w.Sampled(gs, 0, x, 0, 1, y, 0, 1, 1, 1, true)
                    }
                    t4 := time.Now()
                    dt[k] = t1 - t0
                    st[k] = t2 - t1
                    dc[k] = t3 - t2
                    sc[k] = t4 - t3
                }
                # the sampled contrast against the dense one at the entries
                worst F64 = 0.0
                for i in range n {
                    for e in range w.Ptr[i], w.Ptr[i + 1] {
                        worst = math.Max(worst, math.Abs(F64(gs[e]) - F64(g.Get(i, I64(w.Idx[e])))))
                    }
                }
                assert worst < 1e-3
                a := median(dt) * 1e-3
                s := median(st) * 1e-3
                c := median(dc) * 1e-3
                e := median(sc) * 1e-3
                println($n.PadStart(5) " " $b.PadStart(3) " " $d.Fixed(2).PadStart(6) " " $a.Fixed(1).PadStart(10) " " $s.Fixed(1).PadStart(10) " "
                    $(a / s).Fixed(2).PadStart(7) " " $c.Fixed(1).PadStart(10) " " $e.Fixed(1).PadStart(10) " " $(c / e).Fixed(2).PadStart(7))
            }
        }
    }
    circuits(rounds)
}

# the circuit of the second part, its lateral block at density d stored as store, planned from seed 1 and certified
fn big(rows I64, d F64, store circuit.Layout) circuit.Circuit<F32>& {
    c circuit.Circuit<F32>&return = circuit.Circuit<F32>(rows)
    x := c.Input(256)
    h := c.Hidden(2048)
    o := c.Readout(10)
    c.Project(x, h, circuit.Wiring.OneWay)
    c.Project(h, h, circuit.Wiring.Reciprocal, d, false, store)
    c.Project(h, o)
    r := rand.Rand(1)
    c.Plan(r)
    c.Certify(0.9)
    for j in range c.DriveData(x).Len() { c.DriveData(x)[j] = F32(r.Uniform(0.0, 1.0)) }
    for b in range rows { c.LabelData(o)[b] = I32(b % 10) }
    return c
}

fn circuits(rounds I64) {
    println("")
    println("256 -> 2048 (lateral block at density d) <-> 10: milliseconds a lesson at 32 rows and a free settle at one, the block Dense or Sparse")
    println("      d   lesson-dense  lesson-sparse   ratio   settle-dense  settle-sparse   ratio   sweeps")
    for d in F64[0.01, 0.05, 0.1, 0.25, 0.5] {
        ld := big(32, d, circuit.Layout.Dense)
        ls := big(32, d, circuit.Layout.Sparse)
        sd := big(1, d, circuit.Layout.Dense)
        ss := big(1, d, circuit.Layout.Sparse)
        a := Array<I64>(rounds)
        b := Array<I64>(rounds)
        e := Array<I64>(rounds)
        f := Array<I64>(rounds)
        sweeps I64 = 0
        lesson := circuit.Lesson(0.5)
        for k in range rounds {
            t0 := time.Now()
            sweeps = try ld.Teach(32, lesson) catch default 0
            t1 := time.Now()
            try ls.Teach(32, lesson) catch { }
            t2 := time.Now()
            sd.Reset(circuit.Phase.Free)
            try sd.Settle(circuit.Phase.Free, 1000, 1e-4) catch { }
            t3 := time.Now()
            ss.Reset(circuit.Phase.Free)
            try ss.Settle(circuit.Phase.Free, 1000, 1e-4) catch { }
            t4 := time.Now()
            a[k] = t1 - t0
            b[k] = t2 - t1
            e[k] = t3 - t2
            f[k] = t4 - t3
        }
        # the two layouts are one circuit: the same equilibrium
        assert ld.Potential(circuit.Phase.Free).MaxAbsDifference(ls.Potential(circuit.Phase.Free)) < 1e-3
        la := median(a) * 1e-6
        lb := median(b) * 1e-6
        sa := median(e) * 1e-6
        sb := median(f) * 1e-6
        println($d.Fixed(2).PadStart(7) " " $la.Fixed(2).PadStart(14) " " $lb.Fixed(2).PadStart(14) " " $(la / lb).Fixed(2).PadStart(7) " "
            $sa.Fixed(3).PadStart(14) " " $sb.Fixed(3).PadStart(14) " " $(sa / sb).Fixed(2).PadStart(7) " " $sweeps.PadStart(8))
    }
}
