# bench/speech - the real-time factor of Whisper (speech/transcribe): for a model directory and a clip, the seconds of
# the log-mel, the encoder (a 30 s window, 1500 positions) and the greedy decoding, over the clip's length, on each
# thread count given; F32 and BF16 products (BF16 where AMX is). Medians of `rounds`.
#
#     bench_speech MODEL_DIR CLIP.wav [rounds] [threads ...]

import "std/os"
import "std/time"
import "../speech/mel"
import "../speech/transcribe"

fn median(xs mut Array<F64>&) F64 {
    for i in range xs.Len() {
        for j in range i + 1, xs.Len() {
            if xs[j] < xs[i] {
                t := xs[i]
                xs[i] = xs[j]
                xs[j] = t
            }
        }
    }
    return xs[xs.Len() / 2]
}

fn main() {
    args := os.Args()
    if args.Len() < 3 {
        Println("usage: bench_speech MODEL_DIR CLIP.wav [rounds] [threads ...]")
        os.Exit(2)
    }
    dir := args[1]
    x := mel.Wav(args[2])!
    rounds := args[3].ParseInt()! if args.Len() > 3 else I64(3)
    threads := Vec<I64>()
    for i in range 4, args.Len(): threads.Push(args[i].ParseInt()!)
    if threads.Len() == 0 {
        threads.Push(1)
        threads.Push(4)
    }
    secs := F64(x.Len()) / F64(mel.Rate)
    Println("clip " + args[2] + ": " + $secs + " s")
    for mode in range 3 {
        bf := mode == 1
        q8 := mode == 2
        if bf and not TargetHasTileDot: continue
        for t in threads {
            w := transcribe.Whisper.Load(dir, bf, 1, t, q8)!
            o := transcribe.Options()
            fe := Array<F64>(rounds)
            en := Array<F64>(rounds)
            de := Array<F64>(rounds)
            toks I64 = 0
            for r in range rounds {
                t0 := time.Now()
                clip, frames := w.Mel.Clip(x)
                t1 := time.Now()
                w.Window(clip, frames)
                t2 := time.Now()
                gen := w.Decode(w.Prompt(o), o)
                t3 := time.Now()
                fe[r] = F64(t1 - t0) / 1e9
                en[r] = F64(t2 - t1) / 1e9
                de[r] = F64(t3 - t2) / 1e9
                toks = gen.Len()
            }
            f, e, d := median(fe), median(en), median(de)
            total := f + e + d
            Println(("BF16" if bf else "INT8" if q8 else "F32 ") + " threads " + $t + ": mel " + $f + " s, encoder " + $e + " s, decoder " + $d + " s (" + $toks + " tokens, " + $(d / F64(toks) * 1000.0) + " ms each); RTF " + $(total / secs))
        }
    }
}
