# image/flux2 - the rectified-flow transformer of Black Forest Labs' FLUX.2 (the klein models), run for inference as
# diffusers publishes it: transformer/config.json and diffusion_pytorch_model.safetensors. It reads an image's noisy
# latent tokens (one per 16 x 16 pixels, In numbers each), a prompt's embeddings and the noise level, and writes the
# velocity of every latent token: the direction a sampler moves the latents along (image/klein).
#
# The rows of a pass are the prompt's T tokens, then the image's N. Both are embedded to Dim; `Double` blocks keep a
# stream of weights each (the text's and the image's) and join them only in the attention; `Single` blocks then run the
# rows as one stream, the attention's projections and the perceptron's first layer one product, their outputs joined by
# a second. Every norm is a LayerNorm with no weights, scaled and shifted by the noise level's embedding (the
# modulations, one set for all double blocks and one for all single ones); queries and keys are RMS-normed a head and
# rotated by the row's position - four axes of HeadDim / 4 dimensions (time, row, column, token), an image token at
# (0, y, x, 0) and a prompt token at (0, 0, 0, l). No product has a bias.
#
# Products. The weights stay BF16, as they are stored. Exact: F32 activations times the weights widened (the
# reference's arithmetic on a CPU). Otherwise the activations are rounded to BF16 and the products and the attention
# run on AMX tiles where the target has them, summed in F32.

import "std/json"
import "std/os"
import "std/time"
import "../io/checkpoint"
import "../kernels/attention"
import "../kernels/gemm"
import "../kernels/mat"
import "../tensor"

type ModelError error {
    Unsupported(what String)
    Malformed(what String)
}

# ---- the configuration ----

type Config struct() {
    Dim I64 = 0             # num_attention_heads x attention_head_dim
    Heads I64 = 0
    HeadDim I64 = 0
    Double I64 = 0          # num_layers
    Single I64 = 0          # num_single_layers
    In I64 = 0              # in_channels: a latent token's numbers (the output's too)
    Text I64 = 0            # joint_attention_dim: a prompt token's
    Ffn I64 = 0             # Dim x mlp_ratio
    TimeDim I64 = 0         # timestep_guidance_channels
    Theta F64 = 2000.0      # rope_theta
    Eps F64 = 1e-6
}

fn intOf(j json.Json&, key String&) I64 ? ModelError {
    v :~ try j[key] catch { error ModelError.Malformed("config.json has no " + key) }
    return try v.AsInt() catch { error ModelError.Malformed("config.json's " + key) }
}

fn numOf(j json.Json&, key String&) F64 ? ModelError {
    v :~ try j[key] catch { error ModelError.Malformed("config.json has no " + key) }
    return try v.AsNum() catch { error ModelError.Malformed("config.json's " + key) }
}

fn Config.Parse(text String&) Config ? ModelError {
    j :~ try json.Json.Parse(text) catch { error ModelError.Malformed("config.json is not JSON") }
    kind :~ try (try j["_class_name"] catch { error ModelError.Malformed("no _class_name") }).AsStr() catch { error ModelError.Malformed("_class_name") }
    if kind != "Flux2Transformer2DModel": error ModelError.Unsupported(kind + " (Flux2Transformer2DModel runs)")
    c := Config()
    c.Heads = try intOf(j, "num_attention_heads")
    c.HeadDim = try intOf(j, "attention_head_dim")
    c.Dim = c.Heads * c.HeadDim
    c.Double = try intOf(j, "num_layers")
    c.Single = try intOf(j, "num_single_layers")
    c.In = try intOf(j, "in_channels")
    c.Text = try intOf(j, "joint_attention_dim")
    c.Ffn = I64(F64(c.Dim) * (try numOf(j, "mlp_ratio")))
    c.TimeDim = try intOf(j, "timestep_guidance_channels")
    c.Theta = try numOf(j, "rope_theta")
    c.Eps = try numOf(j, "eps")
    if (try intOf(j, "patch_size")) != 1: error ModelError.Unsupported("a patch_size other than 1")
    guided :~ try j["guidance_embeds"] catch default json.Json.Bool(false)
    if (try guided.AsBool() catch default false): error ModelError.Unsupported("guidance embeddings (the distilled klein models have none)")
    axes :~ try j["axes_dims_rope"] catch { error ModelError.Malformed("config.json has no axes_dims_rope") }
    match axes {
        case json.Json.Arr(items) {
            if items.Len() != 4: error ModelError.Unsupported("position axes other than four")
            for a in items {
                if (try a.AsInt() catch { error ModelError.Malformed("axes_dims_rope") }) * 4 != c.HeadDim: error ModelError.Unsupported("position axes that are not a quarter of a head each")
            }
        }
        case _: error ModelError.Malformed("axes_dims_rope")
    }
    return c
}

# ---- weights ----

# y = x W^T of In inputs and Out outputs: W row-major [Out x In], BF16 as stored
type Lin struct(In I64, Out I64) {
    In
    Out
    W mut Array<BF16>& = Array<BF16>(In * Out)
}

# a double block: each stream's attention projections (Qkv: the queries', keys' and values' rows one after another),
# output and perceptron, and the gains of its queries' and keys' RMS norms
type DoubleBlock struct(c Config&) {
    ImgQkv Lin = Lin(c.Dim, 3 * c.Dim)
    ImgO Lin = Lin(c.Dim, c.Dim)
    ImgQ mut Array<F32>& = Array<F32>(c.HeadDim)
    ImgK mut Array<F32>& = Array<F32>(c.HeadDim)
    ImgUp Lin = Lin(c.Dim, 2 * c.Ffn)
    ImgDown Lin = Lin(c.Ffn, c.Dim)
    TxtQkv Lin = Lin(c.Dim, 3 * c.Dim)
    TxtO Lin = Lin(c.Dim, c.Dim)
    TxtQ mut Array<F32>& = Array<F32>(c.HeadDim)
    TxtK mut Array<F32>& = Array<F32>(c.HeadDim)
    TxtUp Lin = Lin(c.Dim, 2 * c.Ffn)
    TxtDown Lin = Lin(c.Ffn, c.Dim)
}

# a single block: one product to the queries, keys, values and the perceptron's gate and up, one from the attention's
# output and the perceptron's hidden layer back to the stream
type SingleBlock struct(c Config&) {
    Wide Lin = Lin(c.Dim, 3 * c.Dim + 2 * c.Ffn)
    Out Lin = Lin(c.Dim + c.Ffn, c.Dim)
    Q mut Array<F32>& = Array<F32>(c.HeadDim)
    K mut Array<F32>& = Array<F32>(c.HeadDim)
}

type reader struct(f checkpoint.File&) {
    f
}

# rows from .. from + rows of l from the tensor "name" ([rows, In])
fn (r reader&) lin(l mut Lin&, name String&, from I64 = 0, rows I64 = -1) ? ModelError {
    n := l.Out if rows < 0 else rows
    e := try r.f.Find(name) catch { error ModelError.Malformed("no tensor " + name) }
    if e.Shape.Len() != 2 or e.Shape[0] != n or e.Shape[1] != l.In: error ModelError.Malformed(name + " is " + $e.Shape + ", not [" + $n + ", " + $l.In + "]")
    t := try tensor.Tensor<BF16>.Over(l.W, from * l.In, n, l.In) catch { error ModelError.Malformed(name) }
    try r.f.Read(name, t) catch { error ModelError.Malformed(name) }
}

fn (r reader&) vec(dst mut Array<F32>&, name String&) ? ModelError {
    t := try tensor.Tensor<F32>.Over(dst, 0, dst.Len()) catch { error ModelError.Malformed(name) }
    try r.f.Read(name, t) catch { error ModelError.Malformed("no tensor " + name + " of " + $dst.Len()) }
}

fn (r reader&) double(b mut DoubleBlock&, p String&, d I64) ? ModelError {
    try r.lin(b.ImgQkv, p + "attn.to_q.weight", 0, d)
    try r.lin(b.ImgQkv, p + "attn.to_k.weight", d, d)
    try r.lin(b.ImgQkv, p + "attn.to_v.weight", 2 * d, d)
    try r.lin(b.ImgO, p + "attn.to_out.0.weight")
    try r.vec(b.ImgQ, p + "attn.norm_q.weight")
    try r.vec(b.ImgK, p + "attn.norm_k.weight")
    try r.lin(b.ImgUp, p + "ff.linear_in.weight")
    try r.lin(b.ImgDown, p + "ff.linear_out.weight")
    try r.lin(b.TxtQkv, p + "attn.add_q_proj.weight", 0, d)
    try r.lin(b.TxtQkv, p + "attn.add_k_proj.weight", d, d)
    try r.lin(b.TxtQkv, p + "attn.add_v_proj.weight", 2 * d, d)
    try r.lin(b.TxtO, p + "attn.to_add_out.weight")
    try r.vec(b.TxtQ, p + "attn.norm_added_q.weight")
    try r.vec(b.TxtK, p + "attn.norm_added_k.weight")
    try r.lin(b.TxtUp, p + "ff_context.linear_in.weight")
    try r.lin(b.TxtDown, p + "ff_context.linear_out.weight")
}

fn (r reader&) single(b mut SingleBlock&, p String&) ? ModelError {
    try r.lin(b.Wide, p + "attn.to_qkv_mlp_proj.weight")
    try r.lin(b.Out, p + "attn.to_out.weight")
    try r.vec(b.Q, p + "attn.norm_q.weight")
    try r.vec(b.K, p + "attn.norm_k.weight")
}

# ---- the model ----

type Model struct(C Config, Exact Bool) {
    C
    Exact                                               # F32 activations (the reference's arithmetic); else BF16
    Tile Bool = not Exact
    ImgIn Lin = Lin(C.In, C.Dim)                        # x_embedder
    TxtIn Lin = Lin(C.Text, C.Dim)                      # context_embedder
    Time1 Lin = Lin(C.TimeDim, C.Dim)                   # the noise level's embedding: two layers, SiLU between
    Time2 Lin = Lin(C.Dim, C.Dim)
    ModImg Lin = Lin(C.Dim, 6 * C.Dim)                  # the double blocks' modulations: shift, scale, gate, twice
    ModTxt Lin = Lin(C.Dim, 6 * C.Dim)
    ModSingle Lin = Lin(C.Dim, 3 * C.Dim)
    doubles := Vec<DoubleBlock>()
    for _ in range C.Double: doubles.Push(DoubleBlock(C))
    Doubles mut Array<DoubleBlock>& = doubles.ToArray()
    singles := Vec<SingleBlock>()
    for _ in range C.Single: singles.Push(SingleBlock(C))
    Singles mut Array<SingleBlock>& = singles.ToArray()
    NormOut Lin = Lin(C.Dim, 2 * C.Dim)                 # the last norm's scale and shift
    Out Lin = Lin(C.Dim, C.In)                          # proj_out
    Threads I64 = gemm.Cores()
}

# the transformer in directory dir (config.json, diffusion_pytorch_model.safetensors)
fn Model.Load(dir String&, exact Bool = false) Model ? ModelError, os.Error {
    c := try Config.Parse(try os.ReadFile(dir + "/config.json"))
    f := try checkpoint.File.Load(dir + "/diffusion_pytorch_model.safetensors") catch checkpoint.SafetensorsError { error ModelError.Malformed(dir + "/diffusion_pytorch_model.safetensors") }
    r := reader(f)
    m := Model(c, exact)
    try r.lin(m.ImgIn, "x_embedder.weight")
    try r.lin(m.TxtIn, "context_embedder.weight")
    try r.lin(m.Time1, "time_guidance_embed.timestep_embedder.linear_1.weight")
    try r.lin(m.Time2, "time_guidance_embed.timestep_embedder.linear_2.weight")
    try r.lin(m.ModImg, "double_stream_modulation_img.linear.weight")
    try r.lin(m.ModTxt, "double_stream_modulation_txt.linear.weight")
    try r.lin(m.ModSingle, "single_stream_modulation.linear.weight")
    for i in range c.Double: try r.double(m.Doubles[i], "transformer_blocks." + $i + ".", c.Dim)
    for i in range c.Single: try r.single(m.Singles[i], "single_transformer_blocks." + $i + ".")
    try r.lin(m.NormOut, "norm_out.linear.weight")
    try r.lin(m.Out, "proj_out.weight")
    return m
}

# the parameters
fn (m Model&) Params() I64 {
    c := m.C
    d := c.Dim
    double := 2 * (4 * d * d + 3 * d * c.Ffn)
    single := d * (3 * d + 2 * c.Ffn) + (d + c.Ffn) * d
    return c.Double * double + c.Single * single + d * (c.In * 2 + c.Text + c.TimeDim + d + 17 * d)
}

# ---- a run: an image of Rows x Cols latent tokens after a prompt of T ----

# What a pass reads beside the stream, the same on any device: each row's rotation (a pair of a head's dimensions
# each), and the noise level's modulations - the double blocks' image and text rows' (shift, scale, gate for the
# attention, then for the perceptron: 6 Dim), the single blocks' (shift, scale, gate) and the last norm's (scale, shift)
type Signals struct(m Model&, T I64, Rows I64, Cols I64) {
    Cos mut Array<F32>& = Array<F32>((T + Rows * Cols) * m.C.HeadDim / 2)
    Sin mut Array<F32>& = Array<F32>((T + Rows * Cols) * m.C.HeadDim / 2)
    temb mut Array<F32>& = Array<F32>(m.C.Dim.Max(m.C.TimeDim))
    tmp mut Array<F32>& = Array<F32>(m.C.Dim.Max(m.C.TimeDim))
    ModImg mut Array<F32>& = Array<F32>(6 * m.C.Dim)
    ModTxt mut Array<F32>& = Array<F32>(6 * m.C.Dim)
    ModOne mut Array<F32>& = Array<F32>(3 * m.C.Dim)
    ModOut mut Array<F32>& = Array<F32>(2 * m.C.Dim)
    ws mut gemm.Workspace<F32>& = gemm.Workspace<F32>(1, 6 * m.C.Dim.Max(m.C.TimeDim))
    m.angles(Cos, Sin, T, Rows, Cols)
}

type Run struct(m Model&, T I64, Rows I64, Cols I64) {
    T
    Rows
    Cols
    N I64 = Rows * Cols
    S I64 = T + Rows * Cols
    wide I64 = 3 * m.C.Dim + 2 * m.C.Ffn
    x mut Array<F32>& = Array<F32>(S * m.C.Dim)             # the stream: the prompt's rows, then the image's
    h mut Array<F32>& = Array<F32>(S * m.C.Dim)
    p mut Array<F32>& = Array<F32>(S * wide)                # a row's queries, keys, values, then its perceptron's gate and up
    att mut Array<F32>& = Array<F32>(S * m.C.Dim)
    ctx mut Array<F32>& = Array<F32>(T * m.C.Dim)           # the prompt embedded (SetText), the same every pass
    xb mut Array<BF16>& = Array<BF16>(S * (m.C.Dim + m.C.Ffn).Max(m.C.Text) if m.Tile else 0)
    yb mut Array<BF16>& = Array<BF16>(S * 3 * m.C.Dim if m.Tile else 0)
    ob mut Array<BF16>& = Array<BF16>(S * m.C.Dim if m.Tile else 0)
    lse mut Array<F32>& = Array<F32>(m.C.Heads * S)
    fl mut attention.Flash<F32>& = attention.Flash<F32>.For(m.Threads, S, m.C.HeadDim)
    made := Vec<gemm.Workspace<F32>>()
    for _ in range m.Threads: made.Push(gemm.Workspace<F32>(1, S.Max(wide)))
    ws mut Array<gemm.Workspace<F32>>& = made.ToArray()
    G Signals = Signals(m, T, Rows, Cols)                   # the rows' rotations and the noise level's modulations
    Out mut Array<F32>& = Array<F32>(Rows * Cols * m.C.In)  # a pass's result: each latent token's velocity
    Products I64 = 0                                        # nanoseconds in the linear maps and in attention
    Attention I64 = 0
}

# each row's rotation: axis a's HeadDim / 8 frequencies Theta^(-2 j / (HeadDim / 4)) times the row's position on it
fn (m Model&) angles(cos mut Array<F32>&, sin mut Array<F32>&, t I64, rows I64, cols I64) {
    half := m.C.HeadDim / 2
    per := half / 4
    for r in range t + rows * cols {
        i := r - t
        pos Array<I64> = [0, 0, 0, r] if r < t else [0, i / cols, i % cols, 0]
        for a in range 4 {
            for j in range per {
                ang := F64(pos[a]) / m.C.Theta.Pow(F64(2 * j) / F64(2 * per))
                cos[r * half + a * per + j] = F32(ang.Cos())
                sin[r * half + a * per + j] = F32(ang.Sin())
            }
        }
    }
}

# f(rows r0 .. r1) over the cores
fn (m Model&) rows(n I64, f fn&(r0 I64, r1 I64)) {
    t := m.Threads.Min(n).Max(1)
    join {
        for i in range t: spawn f(i * n / t, (i + 1) * n / t)
    }
}

fn round(dst mut Array<BF16>&, at I64, src mat.Mat<F32>&, r0 I64, r1 I64) {
    for r in range r0, r1 {
        o := src.Off + r * src.Ld
        for i in range src.Cols: dst[at + r * src.Cols + i] = BF16(src.Data[o + i])
    }
}

# outputs o0 .. o1 of dst = src W^T: BF16 tiles from xb (src rounded), or F32 activations times the weights widened
fn part(ws mut gemm.Workspace<F32>&, dst mat.Mat<F32>&, src mat.Mat<F32>&, xb mut Array<BF16>&, w Lin&, o0 I64, o1 I64, tile Bool) {
    c := mat.Mat<F32>(dst.Data, dst.Off + o0, dst.Rows, o1 - o0, dst.Ld)
    b := mat.Mat<BF16>(w.W, o0 * w.In, o1 - o0, w.In, w.In)
    if tile {
        gemm.Gemm(ws, c, mat.Mat<BF16>(xb, 0, src.Rows, w.In, w.In), false, b, true)
        return
    }
    gemm.Gemm(ws, c, src, false, b, true)
}

# dst = src W^T (dst's columns w.Out, src's w.In), the outputs split over the cores in multiples of 16
fn (m Model&) lin(e mut Run&, dst mat.Mat<F32>, src mat.Mat<F32>, w Lin&) {
    t0 := time.Now()
    defer: e.Products += time.Since(t0)
    tile := m.Tile and src.Rows >= 16
    if tile: m.rows(src.Rows, fn(r0 I64, r1 I64) { round(e.xb, 0, src, r0, r1) })
    t := m.Threads.Min(w.Out / 16).Max(1)
    join {
        for i in range t: spawn part(e.ws[i], dst, src, e.xb, w, (i * w.Out / t) / 16 * 16, ((i + 1) * w.Out / t) / 16 * 16 if i + 1 < t else w.Out, tile)
    }
}

fn silu(x F32) F32 { return x / (1.0 + (-x).Exp()) }

# rows r0 .. r1 of y (n wide): LayerNorm of x's with no weights, times 1 + scale and plus shift (mod's, n each)
fn modNorm(y mut Array<F32>&, x Array<F32>&, n I64, r0 I64, r1 I64, mod Array<F32>&, shift I64, scale I64, eps F64) {
    for r in range r0, r1 {
        o := r * n
        s F64 = 0.0
        for i in range n: s += F64(x[o + i])
        mean := s / F64(n)
        v F64 = 0.0
        for i in range n: v += (F64(x[o + i]) - mean) * (F64(x[o + i]) - mean)
        inv := 1.0 / (v / F64(n) + eps).Sqrt()
        for i in range n: y[o + i] = F32((F64(x[o + i]) - mean) * inv) * (1.0 + mod[scale + i]) + mod[shift + i]
    }
}

# rows r0 .. r1 of x (n wide) plus gate times y's (y's rows ld apart)
fn addGated(x mut Array<F32>&, y Array<F32>&, n I64, r0 I64, r1 I64, mod Array<F32>&, gate I64) {
    for r in range r0, r1 {
        for i in range n: x[r * n + i] += mod[gate + i] * y[r * n + i]
    }
}

# rows r0 .. r1 of p (ld apart): the heads of the queries (at column 0) and the keys (at column d) RMS-normed with
# gains gq and gk, then rotated by the row's position
fn headsOf(p mut Array<F32>&, ld I64, d I64, hd I64, r0 I64, r1 I64, gq Array<F32>&, gk Array<F32>&, cos Array<F32>&, sin Array<F32>&, eps F64) {
    half := hd / 2
    for r in range r0, r1 {
        for qk in range 2 {
            g :~ gq if qk == 0 else gk
            for hh in range d / hd {
                o := r * ld + qk * d + hh * hd
                ss F64 = 0.0
                for i in range hd: ss += F64(p[o + i]) * F64(p[o + i])
                inv := F32(1.0 / (ss / F64(hd) + eps).Sqrt())
                for j in range half {
                    a, b := p[o + 2 * j] * inv * g[2 * j], p[o + 2 * j + 1] * inv * g[2 * j + 1]
                    cs, sn := cos[r * half + j], sin[r * half + j]
                    p[o + 2 * j] = a * cs - b * sn
                    p[o + 2 * j + 1] = b * cs + a * sn
                }
            }
        }
    }
}

# rows r0 .. r1 of p (ld apart): silu(gate) x up, gate at column from and up f after it, written f wide at column to
# (to < from: a row is read ahead of where it is written)
fn swiglu(p mut Array<F32>&, ld I64, from I64, to I64, f I64, r0 I64, r1 I64) {
    for r in range r0, r1 {
        o := r * ld
        for i in range f: p[o + to + i] = silu(p[o + from + i]) * p[o + from + f + i]
    }
}

fn widen(dst mut Array<F32>&, src Array<BF16>&, from I64, to I64) {
    for i in range from, to: dst[i] = F32(src[i])
}

# every row's attention to every row (queries, keys and values the first 3 Dim columns of p's rows) into att
fn (m Model&) attend(e mut Run&) {
    t0 := time.Now()
    defer: e.Attention += time.Since(t0)
    d := m.C.Dim
    n := e.S
    at := attention.Heads(m.C.Heads, n, Causal = false)
    if not m.Tile {
        out := mat.Mat<F32>(e.att, 0, n, d, d)
        attention.FlashAttention<F32, F32>(e.fl, out, mat.Mat<F32>(e.p, 0, n, d, e.wide), mat.Mat<F32>(e.p, d, n, d, e.wide), mat.Mat<F32>(e.p, 2 * d, n, d, e.wide), e.lse, at)
        return
    }
    qkv := mat.Mat<F32>(e.p, 0, n, 3 * d, e.wide)
    m.rows(n, fn(r0 I64, r1 I64) { round(e.yb, 0, qkv, r0, r1) })
    out := mat.Mat<BF16>(e.ob, 0, n, d, d)
    attention.FlashAttention<BF16, F32>(e.fl, out, mat.Mat<BF16>(e.yb, 0, n, d, 3 * d), mat.Mat<BF16>(e.yb, d, n, d, 3 * d), mat.Mat<BF16>(e.yb, 2 * d, n, d, 3 * d), e.lse, at)
    m.rows(n, fn(r0 I64, r1 I64) { widen(e.att, e.ob, r0 * d, r1 * d) })
}

# the prompt's embeddings ([T x Text]) embedded for the passes to come
fn (m Model&) SetText(e mut Run&, embeds mut Array<F32>&) {
    m.lin(e, mat.Mat<F32>(e.ctx, 0, e.T, m.C.Dim, m.C.Dim), mat.Mat<F32>(embeds, 0, e.T, m.C.Text, m.C.Text), m.TxtIn)
}

# dst = src W^T, one row
fn (m Model&) row(g mut Signals&, dst mut Array<F32>&, src mut Array<F32>&, w Lin&) {
    gemm.Gemm(g.ws, mat.Mat<F32>(dst, 0, 1, w.Out, w.Out), mat.Mat<F32>(src, 0, 1, w.In, w.In), false, mat.Mat<BF16>(w.W, 0, w.Out, w.In, w.In), true)
}

# g's modulations for noise level sigma: the level, times 1000, as cosines and sines of TimeDim / 2 frequencies,
# through two layers (SiLU between), then SiLU and each modulation's map
fn (m Model&) Signal(g mut Signals&, sigma F64) {
    c := m.C
    half := c.TimeDim / 2
    for j in range half {
        arg := sigma * 1000.0 * (-(10000.0).Log() * F64(j) / F64(half)).Exp()
        g.tmp[j] = F32(arg.Cos())
        g.tmp[half + j] = F32(arg.Sin())
    }
    m.row(g, g.temb, g.tmp, m.Time1)
    for i in range c.Dim: g.tmp[i] = silu(g.temb[i])
    m.row(g, g.temb, g.tmp, m.Time2)
    for i in range c.Dim: g.tmp[i] = silu(g.temb[i])
    m.row(g, g.ModImg, g.tmp, m.ModImg)
    m.row(g, g.ModTxt, g.tmp, m.ModTxt)
    m.row(g, g.ModOne, g.tmp, m.ModSingle)
    m.row(g, g.ModOut, g.tmp, m.NormOut)
}

# one pass: the velocity of the latents ([N x In], row y Cols + x the token at (y, x)) at noise level sigma (1: pure
# noise, 0: the image), into e.Out
fn (m Model&) Forward(e mut Run&, latents mut Array<F32>&, sigma F64) {
    c := m.C
    d := c.Dim
    t, n := e.T, e.N
    m.Signal(e.G, sigma)
    for i in range t * d: e.x[i] = e.ctx[i]
    m.lin(e, mat.Mat<F32>(e.x, t * d, n, d, d), mat.Mat<F32>(latents, 0, n, c.In, c.In), m.ImgIn)
    for b in m.Doubles: m.double(e, b)
    for b in m.Singles: m.single(e, b)
    m.rows(n, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, t + r0, t + r1, e.G.ModOut, d, 0, c.Eps) })
    m.lin(e, mat.Mat<F32>(e.Out, 0, n, c.In, c.In), mat.Mat<F32>(e.h, t * d, n, d, d), m.Out)
}

fn (m Model&) double(e mut Run&, b DoubleBlock&) {
    c := m.C
    d := c.Dim
    f := c.Ffn
    t, n, s := e.T, e.N, e.S
    w := e.wide
    # the attention: each stream normed and projected by its own weights, the rows attending as one sequence
    m.rows(t, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, r0, r1, e.G.ModTxt, 0, d, c.Eps) })
    m.rows(n, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, t + r0, t + r1, e.G.ModImg, 0, d, c.Eps) })
    m.lin(e, mat.Mat<F32>(e.p, 0, t, 3 * d, w), mat.Mat<F32>(e.h, 0, t, d, d), b.TxtQkv)
    m.lin(e, mat.Mat<F32>(e.p, t * w, n, 3 * d, w), mat.Mat<F32>(e.h, t * d, n, d, d), b.ImgQkv)
    m.rows(t, fn(r0 I64, r1 I64) { headsOf(e.p, w, d, c.HeadDim, r0, r1, b.TxtQ, b.TxtK, e.G.Cos, e.G.Sin, c.Eps) })
    m.rows(n, fn(r0 I64, r1 I64) { headsOf(e.p, w, d, c.HeadDim, t + r0, t + r1, b.ImgQ, b.ImgK, e.G.Cos, e.G.Sin, c.Eps) })
    m.attend(e)
    m.lin(e, mat.Mat<F32>(e.h, 0, t, d, d), mat.Mat<F32>(e.att, 0, t, d, d), b.TxtO)
    m.lin(e, mat.Mat<F32>(e.h, t * d, n, d, d), mat.Mat<F32>(e.att, t * d, n, d, d), b.ImgO)
    m.rows(t, fn(r0 I64, r1 I64) { addGated(e.x, e.h, d, r0, r1, e.G.ModTxt, 2 * d) })
    m.rows(n, fn(r0 I64, r1 I64) { addGated(e.x, e.h, d, t + r0, t + r1, e.G.ModImg, 2 * d) })
    # the perceptrons
    m.rows(t, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, r0, r1, e.G.ModTxt, 3 * d, 4 * d, c.Eps) })
    m.rows(n, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, t + r0, t + r1, e.G.ModImg, 3 * d, 4 * d, c.Eps) })
    m.lin(e, mat.Mat<F32>(e.p, d, t, 2 * f, w), mat.Mat<F32>(e.h, 0, t, d, d), b.TxtUp)
    m.lin(e, mat.Mat<F32>(e.p, t * w + d, n, 2 * f, w), mat.Mat<F32>(e.h, t * d, n, d, d), b.ImgUp)
    m.rows(s, fn(r0 I64, r1 I64) { swiglu(e.p, w, d, 0, f, r0, r1) })
    m.lin(e, mat.Mat<F32>(e.h, 0, t, d, d), mat.Mat<F32>(e.p, 0, t, f, w), b.TxtDown)
    m.lin(e, mat.Mat<F32>(e.h, t * d, n, d, d), mat.Mat<F32>(e.p, t * w, n, f, w), b.ImgDown)
    m.rows(t, fn(r0 I64, r1 I64) { addGated(e.x, e.h, d, r0, r1, e.G.ModTxt, 5 * d) })
    m.rows(n, fn(r0 I64, r1 I64) { addGated(e.x, e.h, d, t + r0, t + r1, e.G.ModImg, 5 * d) })
}

fn (m Model&) single(e mut Run&, b SingleBlock&) {
    c := m.C
    d := c.Dim
    f := c.Ffn
    s := e.S
    w := e.wide
    m.rows(s, fn(r0 I64, r1 I64) { modNorm(e.h, e.x, d, r0, r1, e.G.ModOne, 0, d, c.Eps) })
    m.lin(e, mat.Mat<F32>(e.p, 0, s, w, w), mat.Mat<F32>(e.h, 0, s, d, d), b.Wide)
    m.rows(s, fn(r0 I64, r1 I64) { headsOf(e.p, w, d, c.HeadDim, r0, r1, b.Q, b.K, e.G.Cos, e.G.Sin, c.Eps) })
    m.attend(e)
    # the second product's input, in place: the attention's output, then the perceptron's hidden layer
    m.rows(s, fn(r0 I64, r1 I64) {
        for r in range r0, r1 {
            for i in range d: e.p[r * w + i] = e.att[r * d + i]
        }
        swiglu(e.p, w, 3 * d, d, f, r0, r1)
    })
    m.lin(e, mat.Mat<F32>(e.h, 0, s, d, d), mat.Mat<F32>(e.p, 0, s, d + f, w), b.Out)
    m.rows(s, fn(r0 I64, r1 I64) { addGated(e.x, e.h, d, r0, r1, e.G.ModOne, 2 * d) })
}
