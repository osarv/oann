# oann-image - a picture of a prompt, written as a PNG:
#   oann-image MODEL "PROMPT" OUT.png [--size WxH] [--steps N] [--seed S] [--exact]
# MODEL is a directory holding FLUX.2 klein as its Hugging Face repository lays it out (image/klein). --size is
# 1024x1024 by default, each side a multiple of 16; --steps 4, what the distilled models are made for; --exact runs F32
# activations (the reference's arithmetic, slower).
import "std/io"
import "std/os"
import "std/time"
import "klein"
import "png"

fn fail(msg String&) noreturn {
    try io.PutErrLn("oann-image: " + msg) catch { }
    os.Exit(1)
}

fn usage() noreturn { fail("usage: oann-image MODEL \"PROMPT\" OUT.png [--size WxH] [--steps N] [--seed S] [--exact]") }

fn main() {
    a := os.Args()
    if a.Len() < 4: usage()
    width, height, steps I64 = 1024, 1024, 4
    seed U64 = 0
    exact := false
    i I64 = 4
    for i < a.Len() {
        if a[i] == "--exact" {
            exact = true
            i++
            continue
        }
        if i + 1 >= a.Len(): usage()
        if a[i] == "--size" {
            parts := a[i + 1].Split("x")
            if parts.Len() != 2: usage()
            width = try parts[0].ParseInt() catch { usage() }
            height = try parts[1].ParseInt() catch { usage() }
        } else if a[i] == "--steps" {
            steps = try a[i + 1].ParseInt() catch { usage() }
        } else if a[i] == "--seed" {
            seed = U64(try a[i + 1].ParseInt() catch { usage() })
        } else {
            usage()
        }
        i += 2
    }
    t0 := time.Now()
    px, w, h := try klein.Generate(a[1], a[2], width, height, steps, seed, exact, fn(step I64) {
        try io.PutErrLn("step " + $(step + 1) + " of " + $steps + " (" + $(time.Since(t0) / 1000000000) + " s)") catch { }
    }) catch e { fail($e) }
    try os.WriteFile(a[3], png.Encode(px, w, h)) catch { fail("cannot write " + a[3]) }
    Println(a[3] + ": " + $w + " x " + $h + " in " + $(time.Since(t0) / 1000000000) + " s")
}
