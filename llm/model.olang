# llm/model - open-weight decoder-only transformers run for inference: the dense architectures of the Qwen2, Qwen3,
# Llama (Llama 3, SmolLM2), Mistral, Granite, SmolLM3 and Gemma 3 families, and the mixtures of experts of the Qwen3-MoE, Granite-MoE
# and OLMoE families, as their Hugging Face checkpoints have them
# (config.json and model.safetensors, or shards listed by model.safetensors.index.json) - RMSNorm, rotary positions
# (the model's theta; linear, Llama 3's and YaRN's scaling), grouped-query attention, a SwiGLU perceptron; Qwen2's
# biases on the query, key and value projections, Qwen3's RMSNorm of each query and key head (QK-norm) before the
# rotation; Granite's multipliers of the embedding, the residual branches, the scores and the logits; SmolLM3's layers
# without rotation; Gemma 3's norms around each branch, norm weights read as 1 + w, a GELU-gated perceptron, a theta of
# its own for its sliding-window layers; a sliding window of attention where the config sets one; a head tied to the embedding or one of
# its own. A mixture-of-experts layer routes each row to its top-k experts (a softmax over the router's logits in F32,
# renormalized over the k or not, as the config says) and adds their SwiGLU perceptrons' outputs, weighted: the rows
# of a step are grouped by expert, so an expert's weights are read once a step for all the rows that chose it.
#
# A step runs any set of rows through the model at once - each row one token of one sequence at its position, so a
# step mixes the prompts being read (many rows of one sequence) with the sequences being decoded (one row each): the
# continuous batching llm/engine drives. Every product of a step is shared by all its rows, so the weights are read
# from memory once a step, whatever the batch; decoding is bound by that reading, and a batch of 64 costs little more
# than a batch of one.
#
# Products. Where the target has AMX (TargetHasTileDot) the weights stay BF16 and are packed once, at load, into the
# pair layout of std/tile's AddDot in blocks of Nb (32) output columns: a step rounds its activations to BF16 and each
# task adds X . W^T into its blocks of the result with AddDot (F32 sums) - no packing per step. Elsewhere, or with Exact
# set, the activations stay F32 and kernels/gemm multiplies them by the BF16 weights widened (bit for bit the product of
# the widened weights). INT8 weights (Load's int8, on AMX): 8 bits and a scale per 32 inputs of an output, symmetric,
# widened to BF16 (times the scale, rounded to nearest) 512 inputs of a block at a time into the L1 cache and added
# from there; the head stays BF16.
#
# Attention reads a paged key-value cache (Cache): pages of 64 positions of one sequence, BF16, the keys of a page and
# head held in AddDot's pair layout over the positions and the values over the head's dimensions, so a row's scores
# against a page (its head group's queries, 16 rows padded, times the page's keys) and the page's share of the output
# (the weights times the values, 64 positions deep) are each one AddDot; a sequence's pages are wherever the pool had
# them (llm/engine allocates and frees them). The exact path computes the same in F32 loops.
#
# Nothing in a step allocates: every buffer is made for the largest step (State) and the cache for its pages up front.

import "std/json"
import "std/time"
import "std/os"
import "std/io"
import stdtile "std/tile"
import "../io/checkpoint"
import "gguf"
import "../kernels/gemm"
import "../kernels/mat"
import "../kernels/elem"

type ModelError error {
    Unsupported(what String) # an architecture or option this module does not run
    Malformed(what String)   # a config or checkpoint that does not hold what it should
}

# ---- the configuration ----

type Config struct() {
    Arch String             # config.json's model_type: qwen2, qwen3, llama, mistral, granite or smollm3
    Vocab I64
    Dim I64                 # hidden_size
    Layers I64
    Heads I64
    KvHeads I64
    HeadDim I64
    Ffn I64                 # intermediate_size
    Theta F64               # rope_theta
    PosScale F64 = 1.0      # positions divided by this (rope_scaling of type linear)
    Eps F64                 # rms_norm_eps
    QkNorm Bool             # Qwen3's per-head RMSNorm of queries and keys
    Bias Bool               # biases on the query, key and value projections (Qwen2)
    Tied Bool               # the head is the embedding
    MaxPos I64              # max_position_embeddings
    Rope String = "default" # rope_scaling's type: default, linear, llama3 or yarn
    RopeFactor F64 = 1.0    # its factor
    RopeLow F64 = 1.0       # llama3: low_freq_factor; yarn: beta_slow
    RopeHigh F64 = 4.0      # llama3: high_freq_factor; yarn: beta_fast
    RopeOld I64 = 8192      # original_max_position_embeddings
    RopeAttn F64 = 1.0      # yarn: the factor on cos and sin (attention_factor, 0.1 ln(factor) + 1 by default)
    EmbedScale F64 = 1.0    # the embedding times this (Granite's embedding_multiplier)
    ResScale F64 = 1.0      # each branch's output times this before it is added (residual_multiplier)
    ScoreScale F64 = 0.0    # the scores times this (attention_multiplier); 0: 1 / sqrt(HeadDim)
    LogitScale F64 = 1.0    # the logits divided by this (logits_scaling)
    NoRope mut Array<Bool>& = Array<Bool>(0)    # each layer: positions not rotated (SmolLM3's no_rope_layers 0); empty: all rotated
    Window mut Array<I64>& = Array<I64>(0)      # each layer: the positions a row attends to, itself included (0: all); empty: all
    QkWide Bool = false     # the QK-norm over a row's whole queries and keys, not each head's (OLMoE)
    Experts I64 = 0         # a mixture of experts: the experts of a layer (num_experts, num_local_experts); 0: none
    TopK I64 = 0            # the experts a row is routed to (num_experts_per_tok)
    MoeFfn I64 = 0          # an expert's hidden width (moe_intermediate_size, else intermediate_size)
    NormTopK Bool = false   # the top k's weights renormalized to sum to 1 (norm_topk_prob; Granite-MoE's softmax over the k)
    Moe mut Array<Bool>& = Array<Bool>(0)       # each layer: a mixture of experts (else the dense perceptron)
    Gelu Bool = false       # the perceptron's gate through GELU's tanh form (gelu_pytorch_tanh), not SiLU
    PostNorms Bool = false  # each branch's output normed before it is added (Gemma's post_attention and post_feedforward)
    NormPlus F32 = 0.0      # added to every norm weight as it is read (Gemma's 1 + w)
    ThetaLocal F64 = 0.0    # the sliding-window layers' rope theta, unscaled (Gemma's rope_local_base_freq); 0: Theta
    FreqDiv mut Array<F64>& = Array<F64>(0)     # each rotary frequency divided by its factor (a GGUF's rope_freqs, longrope's short_factor); empty: none
    FreqLong mut Array<F64>& = Array<F64>(0)    # longrope's long_factor: the divisors at positions from RopeOld on; empty: FreqDiv's
    Rot I64 = 0             # the dimensions of a head rotated, its first (partial_rotary_factor: Phi's 96 of 128); 0: all
    ImageToken I64 = -1     # a vision-language model's (llm/vision): the token standing for an image's embedded patches,
    ImageTokens I64 = 0     # how many of them an image is,
    ImageStart I64 = -1     # and the tokens around them
    ImageEnd I64 = -1
}

# whether layer li rotates by the local frequencies (a window's, where ThetaLocal is set)
fn (c Config&) LocalRope(li I64) Bool { return c.ThetaLocal > 0.0 and c.WindowOf(li) > 0 }

# the local layers' rotary frequencies: ThetaLocal's, unscaled
fn (c Config&) LocalFreqs() Array<F64> {
    return Array<F64>[c.ThetaLocal.Pow(-2.0 * F64(i) / F64(c.HeadDim)) for i in range c.HeadDim / 2]
}

# whether layer li is a mixture of experts
fn (c Config&) MoeAt(li I64) Bool { return c.Moe.Len() > 0 and c.Moe[li] }

# the architectures run
Archs Array<String>& = ["qwen2", "qwen3", "llama", "mistral", "granite", "smollm3", "qwen3_moe", "granitemoe", "olmoe", "gemma3_text", "phi3"]

# half the dimensions of a head rotated: the pairs i and i + RotHalf
fn (c Config&) RotHalf() I64 { return (c.Rot if c.Rot > 0 else c.HeadDim) / 2 }

# layer li's rows attend to the positions after pos - window (0 every position)
fn (c Config&) WindowOf(li I64) I64 { return c.Window[li] if c.Window.Len() > 0 else 0 }

# whether layer li rotates its queries and keys
fn (c Config&) Rotates(li I64) Bool { return c.NoRope.Len() == 0 or not c.NoRope[li] }

# the scale of the scores
fn (c Config&) Scale() F64 { return c.ScoreScale if c.ScoreScale > 0.0 else 1.0 / F64(c.HeadDim).Sqrt() }

# YaRN: the dimension whose frequency turns "turns" times over the original context
fn (c Config&) turnDim(turns F64) F64 { return F64(c.HeadDim) * (F64(c.RopeOld) / (turns * 2.0 * Pi)).Log() / (2.0 * c.Theta.Log()) }

# the rotary frequencies of the pairs of a head's dimensions (i and i + HeadDim / 2), scaled as rope_scaling says
# (linear scaling is PosScale's, applied to the positions)
fn (c Config&) Freqs(long Bool = false) Array<F64> {
    half := c.RotHalf()
    f := Array<F64>[c.Theta.Pow(-2.0 * F64(i) / F64(2 * half)) for i in range half]
    if c.Rope == "llama3" {
        # Llama 3.1's: long wavelengths divided by the factor, short ones kept, those between blended
        lowWave := F64(c.RopeOld) / c.RopeLow
        highWave := F64(c.RopeOld) / c.RopeHigh
        for i in range half {
            wave := 2.0 * Pi / f[i]
            if wave < highWave: continue
            if wave > lowWave {
                f[i] = f[i] / c.RopeFactor
                continue
            }
            smooth := (F64(c.RopeOld) / wave - c.RopeLow) / (c.RopeHigh - c.RopeLow)
            f[i] = (1.0 - smooth) * f[i] / c.RopeFactor + smooth * f[i]
        }
    } else if c.Rope == "yarn" {
        # YaRN: frequencies that turn fewer than beta_slow times over the original context interpolated (divided by
        # the factor), more than beta_fast times kept, a linear ramp between
        dim := F64(c.HeadDim)
        lo := c.turnDim(c.RopeHigh).Floor().Max(0.0)
        hi := c.turnDim(c.RopeLow).Ceil().Min(dim - 1.0)
        if hi == lo: hi += 0.001
        for i in range half {
            ramp := ((F64(i) - lo) / (hi - lo)).Max(0.0).Min(1.0)
            f[i] = f[i] / c.RopeFactor * ramp + f[i] * (1.0 - ramp)
        }
    }
    div :~ c.FreqLong if long and c.FreqLong.Len() == half else c.FreqDiv
    if div.Len() == half {
        for i in range half: f[i] = f[i] / div[i]
    }
    return f
}

# a list of numbers in j at key
fn factors(j json.Json&, key String&) Array<F64> ? ModelError {
    xs :~ try (try j[key] catch { error ModelError.Malformed(key) }).AsArr() catch { error ModelError.Malformed(key) }
    return Array<F64>[try x.AsNum() catch { error ModelError.Malformed(key) } for x in xs]
}

fn intOr(j json.Json&, key String&, d I64) I64 {
    if not j.Has(key) or (try j[key] catch { return d }).IsNull(): return d
    return try (try j[key] catch { return d }).AsInt() catch { return d }
}

fn numOr(j json.Json&, key String&, d F64) F64 {
    if not j.Has(key) or (try j[key] catch { return d }).IsNull(): return d
    return try (try j[key] catch { return d }).AsNum() catch { return d }
}

fn boolOr(j json.Json&, key String&, d Bool) Bool {
    if not j.Has(key) or (try j[key] catch { return d }).IsNull(): return d
    return try (try j[key] catch { return d }).AsBool() catch { return d }
}

# a config.json's architecture
fn Config.Parse(text String&) Config ? ModelError {
    j :~ try json.Json.Parse(text) catch { error ModelError.Malformed("config.json is not JSON") }
    c := Config()
    # Gemma 3's vision-language models: the language model is text_config's, the image's tokens the top level's
    if j.Has("text_config") and j.Has("vision_config") {
        top :~ j
        if (try (try top["model_type"] catch { error ModelError.Malformed("no model_type") }).AsStr() catch default "") != "gemma3": error ModelError.Unsupported("a vision-language model other than Gemma 3's")
        c.ImageToken = intOr(top, "image_token_index", -1)
        c.ImageTokens = intOr(top, "mm_tokens_per_image", 256)
        c.ImageStart = intOr(top, "boi_token_index", -1)
        c.ImageEnd = intOr(top, "eoi_token_index", -1)
        j ~ try top["text_config"] catch { error ModelError.Malformed("text_config") }
        if not j.Has("model_type"): error ModelError.Malformed("text_config has no model_type")
        c.Tied = true
    }
    c.Arch = try (try j["model_type"] catch { error ModelError.Malformed("no model_type") }).AsStr() catch { error ModelError.Malformed("model_type") }
    known := false
    for a in Archs {
        if a == c.Arch: known = true
    }
    if not known: error ModelError.Unsupported("model_type " + c.Arch + " (" + Archs.Join(", ") + " run)")
    c.Vocab = intOr(j, "vocab_size", 0)
    c.Dim = intOr(j, "hidden_size", 0)
    c.Layers = intOr(j, "num_hidden_layers", 0)
    c.Heads = intOr(j, "num_attention_heads", 0)
    c.KvHeads = intOr(j, "num_key_value_heads", c.Heads)
    c.HeadDim = intOr(j, "head_dim", c.Dim / c.Heads if c.Heads > 0 else 0)
    c.Ffn = intOr(j, "intermediate_size", 0)
    c.Theta = numOr(j, "rope_theta", 10000.0)
    c.Eps = numOr(j, "rms_norm_eps", 1e-6)
    c.QkNorm = c.Arch == "qwen3" or c.Arch == "qwen3_moe" or c.Arch == "olmoe" or c.Arch == "gemma3_text"
    c.QkWide = c.Arch == "olmoe"
    if intOr(j, "clip_qkv", 0) != 0: error ModelError.Unsupported("clip_qkv")
    if boolOr(j, "mlp_bias", false): error ModelError.Unsupported("mlp_bias")
    c.Bias = boolOr(j, "attention_bias", c.Arch == "qwen2")
    c.Tied = boolOr(j, "tie_word_embeddings", c.Tied)
    c.MaxPos = intOr(j, "max_position_embeddings", 32768)
    # rope_scaling, or transformers 5's rope_parameters (rope_theta in it)
    key :~ "rope_scaling" if j.Has("rope_scaling") else "rope_parameters"
    if j.Has(key) {
        rs0 :~ try j[key] catch { error ModelError.Malformed(key) }
        # transformers 5's per layer type (Gemma 3): the full layers' here, the sliding ones' theta below
        rs :~ (try rs0["full_attention"] catch { error ModelError.Malformed(key) }) if not rs0.IsNull() and rs0.Has("full_attention") else rs0
        if not rs0.IsNull() and rs0.Has("sliding_attention") {
            sl :~ try rs0["sliding_attention"] catch { error ModelError.Malformed(key) }
            c.ThetaLocal = numOr(sl, "rope_theta", 10000.0)
        }
        if not rs.IsNull() {
            c.Theta = numOr(rs, "rope_theta", c.Theta)
            kind String& = "default"
            if rs.Has("rope_type"): kind ~ try (try rs["rope_type"] catch { error ModelError.Malformed("rope_type") }).AsStr() catch { error ModelError.Malformed("rope_type") }
            else if rs.Has("type"): kind ~ try (try rs["type"] catch { error ModelError.Malformed("type") }).AsStr() catch { error ModelError.Malformed("type") }
            c.RopeFactor = numOr(rs, "factor", 1.0)
            c.RopeOld = intOr(rs, "original_max_position_embeddings", intOr(j, "original_max_position_embeddings", c.MaxPos))
            if kind == "linear" {
                c.PosScale = c.RopeFactor
            } else if kind == "llama3" {
                c.Rope = kind
                c.RopeLow = numOr(rs, "low_freq_factor", 1.0)
                c.RopeHigh = numOr(rs, "high_freq_factor", 4.0)
            } else if kind == "yarn" {
                c.Rope = kind
                c.RopeLow = numOr(rs, "beta_slow", 1.0)
                c.RopeHigh = numOr(rs, "beta_fast", 32.0)
                c.RopeAttn = numOr(rs, "attention_factor", 0.1 * c.RopeFactor.Log() + 1.0 if c.RopeFactor > 1.0 else 1.0)
            } else if kind == "longrope" {
                # Phi's: each frequency divided by short_factor's divisor, by long_factor's at positions from the
                # original context on (as vLLM switches per position), cos and sin scaled by sqrt(1 + ln f / ln old)
                c.Rope = kind
                c.FreqDiv ~ try factors(rs, "short_factor")
                c.FreqLong ~ try factors(rs, "long_factor")
                f := F64(c.MaxPos) / F64(c.RopeOld)
                c.RopeAttn = numOr(rs, "attention_factor", (1.0 + f.Log() / F64(c.RopeOld).Log()).Sqrt() if f > 1.0 else 1.0)
            } else if kind != "default" {
                error ModelError.Unsupported("rope_scaling " + kind)
            }
        }
    }
    partial := numOr(j, "partial_rotary_factor", 1.0)
    if partial < 1.0: c.Rot = I64(F64(c.HeadDim) * partial)
    if c.Arch == "gemma3_text" {
        c.Gelu = true
        c.PostNorms = true
        c.NormPlus = 1.0
        c.EmbedScale = F64(c.Dim).Sqrt()
        c.ScoreScale = 1.0 / numOr(j, "query_pre_attn_scalar", F64(c.HeadDim)).Sqrt()
        c.ThetaLocal = numOr(j, "rope_local_base_freq", c.ThetaLocal if c.ThetaLocal > 0.0 else 10000.0)
        c.Tied = boolOr(j, "tie_word_embeddings", true)
        if numOr(j, "final_logit_softcapping", 0.0) != 0.0 or numOr(j, "attn_logit_softcapping", 0.0) != 0.0: error ModelError.Unsupported("logit soft-capping")
        act :~ try (try j["hidden_activation"] catch { error ModelError.Malformed("hidden_activation") }).AsStr() catch default "gelu_pytorch_tanh"
        if act != "gelu_pytorch_tanh": error ModelError.Unsupported("hidden_activation " + act)
    }
    if c.Arch == "granite" or c.Arch == "granitemoe" {
        c.EmbedScale = numOr(j, "embedding_multiplier", 1.0)
        c.ResScale = numOr(j, "residual_multiplier", 1.0)
        c.ScoreScale = numOr(j, "attention_multiplier", 0.0)
        c.LogitScale = numOr(j, "logits_scaling", 1.0)
    }
    if c.Layers > 0 and j.Has("no_rope_layers") {
        nr :~ try (try j["no_rope_layers"] catch { error ModelError.Malformed("no_rope_layers") }).AsArr() catch { error ModelError.Malformed("no_rope_layers") }
        if nr.Len() < c.Layers: error ModelError.Malformed("no_rope_layers")
        c.NoRope ~ Array<Bool>[(try nr[i].AsInt() catch { error ModelError.Malformed("no_rope_layers") }) == 0 for i in range c.Layers]
    }
    # a sliding window: Mistral's sliding_window, Qwen2's where use_sliding_window is set (on the layers from
    # max_window_layers), every layer's or the layer_types' "sliding_attention"
    window := intOr(j, "sliding_window", 0)
    if window > 0 and c.Layers > 0 and boolOr(j, "use_sliding_window", true) {
        from := intOr(j, "max_window_layers", 0) if c.Arch == "qwen2" or c.Arch == "qwen3" else 0
        c.Window ~ Array<I64>[window if i >= from else 0 for i in range c.Layers]
        pattern := intOr(j, "sliding_window_pattern", 0)
        if pattern > 0 {
            for i in range c.Layers: c.Window[i] = 0 if (i + 1) % pattern == 0 else window
        }
        if j.Has("layer_types") {
            lt :~ try (try j["layer_types"] catch { error ModelError.Malformed("layer_types") }).AsArr() catch { error ModelError.Malformed("layer_types") }
            for i in range c.Layers.Min(lt.Len()) {
                kind :~ try lt[i].AsStr() catch { error ModelError.Malformed("layer_types") }
                c.Window[i] = window if kind == "sliding_attention" else 0
            }
        }
    }
    c.Experts = intOr(j, "num_experts", intOr(j, "num_local_experts", 0))
    if c.Experts > 0 and c.Layers > 0 {
        c.TopK = intOr(j, "num_experts_per_tok", 0)
        c.MoeFfn = intOr(j, "moe_intermediate_size", c.Ffn)
        c.NormTopK = boolOr(j, "norm_topk_prob", c.Arch == "granitemoe")
        if c.TopK <= 0 or c.TopK > c.Experts or c.MoeFfn % 32 != 0: error ModelError.Malformed("the experts' sizes")
        if j.Has("shared_expert_intermediate_size") and intOr(j, "shared_expert_intermediate_size", 0) > 0: error ModelError.Unsupported("shared experts")
        # Qwen3-MoE's dense layers: those of mlp_only_layers, and all but every decoder_sparse_step-th
        step := intOr(j, "decoder_sparse_step", 1).Max(1)
        c.Moe ~ Array<Bool>[(i + 1) % step == 0 for i in range c.Layers]
        if j.Has("mlp_only_layers") {
            dense :~ try (try j["mlp_only_layers"] catch { error ModelError.Malformed("mlp_only_layers") }).AsArr() catch { error ModelError.Malformed("mlp_only_layers") }
            for x in dense {
                li := try x.AsInt() catch { error ModelError.Malformed("mlp_only_layers") }
                if li >= 0 and li < c.Layers: c.Moe[li] = false
            }
        }
    }
    if c.Vocab <= 0 or c.Dim <= 0 or c.Layers <= 0 or c.Heads <= 0 or c.KvHeads <= 0 or c.Ffn <= 0 or c.Heads % c.KvHeads != 0 {
        error ModelError.Malformed("config.json's sizes")
    }
    if c.Dim % 32 != 0 or c.Ffn % 32 != 0 or c.HeadDim % 32 != 0 or (c.Heads * c.HeadDim) % 32 != 0 {
        error ModelError.Unsupported("sizes that are not multiples of 32")
    }
    if c.Heads / c.KvHeads > 16: error ModelError.Unsupported("more than 16 query heads to a key-value head")
    return c
}

# the parameters (the embedding counted once when tied)
fn (c Config&) Params() I64 {
    q := c.Heads * c.HeadDim
    kv := c.KvHeads * c.HeadDim
    attn := c.Dim * (q + 2 * kv) + q * c.Dim + (q + 2 * kv if c.Bias else 0) + ((q + kv if c.QkWide else 2 * c.HeadDim) if c.QkNorm else 0)
    n := c.Vocab * c.Dim * (1 if c.Tied else 2) + c.Dim
    for li in range c.Layers: n += attn + 2 * c.Dim + (c.Experts * (c.Dim + 3 * c.Dim * c.MoeFfn) if c.MoeAt(li) else 3 * c.Dim * c.Ffn)
    return n
}

# ---- weights ----

# a linear map of In inputs to Out outputs, y = x W^T + b: W BF16, either packed in AddDot's pair layout in blocks of
# Nb outputs (element (o, i) at (o / Nb) In Nb + ((i / 2) Nb + o % Nb) 2 + i % 2) or as stored, row o at o In
type Linear struct(In I64, Out I64, Nb I64, Packed Bool, bias Bool = false, Int8 Bool = false, Int4 Bool = false) {
    In
    Out
    Nb
    Packed
    Int8                                                        # Q and Scale hold W: W[o, i] = Scale[o, i / Group] Q[o, i]
    Int4                                                        # Q4, D4 and C4 hold W (below, "4-bit weights")
    Group I64 = 32                      # inputs to a scale
    W mut Array<BF16>& = Array<BF16>(0 if Int8 or Int4 else In * Out)
    Q mut Array<I8>& = Array<I8>(In * Out if Int8 else 0)
    Scale mut Array<F32>& = Array<F32>(Out * In / Group if Int8 else 0)   # row o's at o In / Group
    Q4 mut Array<U8>& = Array<U8>(In * Out / 2 if Int4 else 0)
    D4 mut Array<F16>& = Array<F16>(Out * In / 32 if Int4 else 0)
    M4 mut Array<F16>& = Array<F16>(Out * In / 32 if Int4 else 0)
    C4 mut Array<I16>& = Array<I16>(Out * In / 32 if Int4 else 0)
    Bias mut Array<F32>& = Array<F32>(Out if bias else 0)
}

# element (o, i) of W
fn (w Linear&) Get(o I64, i I64) F32 {
    if w.Int8: return F32(w.Q[w.at(o, i)]) * w.Scale[(o * w.In + i) / w.Group]
    if w.Int4: return F32(w.D4[w.at4(o, i / 32)]) * F32(I64((w.Q4[w.byte4(o, i)] >> (4 if i % 8 >= 4 else 0)) & 15) - 8) + F32(w.M4[w.at4(o, i / 32)])
    return F32(w.W[w.at(o, i)])
}

# where element (o, i) is
fn (w Linear&) at(o I64, i I64) I64 {
    if not w.Packed: return o * w.In + i
    return (o / w.Nb) * w.In * w.Nb + ((i / 2) * w.Nb + o % w.Nb) * 2 + i % 2
}

# 4-bit weights. A scale and an offset a group of 32 inputs of an output: W[o, i] = D4 (q - 8) + M4, q in 0 .. 15 (the
# group's least value M4 - 8 D4, its largest M4 + 7 D4, as GGUF's Q4_1 has it with q's 8 moved into the offset). Laid out for VNNI's byte dots over 16 outputs at once: group g of
# a block of 16 outputs is four chunks of 64 bytes, chunk c holding inputs 32 g + 8 c + t (low nibbles) and
# 32 g + 8 c + 4 + t (high) of output n at byte 4 n + t. D4 and C4 (128 times the group's sum of q - 8, which a dot
# against activations shifted by 128 into bytes takes back) a group's 16 outputs together, as M4: 5.5 bits a weight.

# where group g of output o's scale and correction are
fn (w Linear&) at4(o I64, g I64) I64 { return ((o / 16) * (w.In / 32) + g) * 16 + o % 16 }

# the byte holding input i of output o
fn (w Linear&) byte4(o I64, i I64) I64 {
    return (((o / 16) * (w.In / 32) + i / 32) * 4 + (i % 32) / 8) * 64 + 4 * (o % 16) + i % 4
}

# a group of 32 weights of output o from input i0 quantized into 4 bits
fn (w mut Linear&) put4(o I64, i0 I64, v Array<F32>&, at I64) {
    lo := v[at]
    hi := v[at]
    for t in range 32 {
        lo = lo.Min(v[at + t])
        hi = hi.Max(v[at + t])
    }
    d := F32(F16((hi - lo) / 15.0))
    m := F32(F16(lo + 8.0 * d))
    inv := 1.0 / d if d != 0.0 else F32(0.0)
    sum I64 = 0
    for t in range 32 {
        q := I64(((v[at + t] - m) * inv).Round()).Max(-8).Min(7)
        sum += q
        b := w.byte4(o, i0 + t)
        sh := U8(4) if t % 8 >= 4 else U8(0)
        w.Q4[b] = (w.Q4[b] & ~(U8(15) << sh)) | (U8(q + 8) << sh)
    }
    w.D4[w.at4(o, i0 / 32)] = F16(d)
    w.M4[w.at4(o, i0 / 32)] = F16(m)
    w.C4[w.at4(o, i0 / 32)] = I16(128 * sum)
}

# the widest block of 64, 32 or 16 outputs every part divides into
fn blockOf(parts Array<I64>&) I64 {
    for nb in [32, 64, 16] {
        ok := true
        for p in parts {
            if p % nb != 0: ok = false
        }
        if ok: return nb
    }
    return 16
}

type Layer struct(c Config&, pack Bool, int8 Bool, moe Bool = false, int4 Bool = false) {
    Qkv Linear = Linear(c.Dim, (c.Heads + 2 * c.KvHeads) * c.HeadDim, blockOf([c.Heads * c.HeadDim, c.KvHeads * c.HeadDim]), pack, c.Bias, int8, int4)
    O Linear = Linear(c.Heads * c.HeadDim, c.Dim, blockOf([c.Dim]), pack, Int8 = int8, Int4 = int4)
    GateUp Linear = Linear(c.Dim, 0 if moe else 2 * c.Ffn, blockOf([c.Ffn]), pack, Int8 = int8, Int4 = int4)
    Down Linear = Linear(c.Ffn, 0 if moe else c.Dim, blockOf([c.Dim]), pack, Int8 = int8, Int4 = int4)
    Norm1 mut Array<F32>& = Array<F32>(c.Dim)
    Norm2 mut Array<F32>& = Array<F32>(c.Dim)
    PostAttn mut Array<F32>& = Array<F32>(c.Dim if c.PostNorms else 0)
    PostFfn mut Array<F32>& = Array<F32>(c.Dim if c.PostNorms else 0)
    QNorm mut Array<F32>& = Array<F32>((c.Heads * c.HeadDim if c.QkWide else c.HeadDim) if c.QkNorm else 0)
    KNorm mut Array<F32>& = Array<F32>((c.KvHeads * c.HeadDim if c.QkWide else c.HeadDim) if c.QkNorm else 0)
    Router mut Array<F32>& = Array<F32>(c.Experts * c.Dim if moe else 0)       # a mixture of experts: expert e's row at e Dim
    ups := Vec<Linear>()
    downs := Vec<Linear>()
    for _ in range c.Experts if moe else 0 {
        ups.Push(Linear(c.Dim, 2 * c.MoeFfn, blockOf([c.MoeFfn]), pack, Int8 = int8, Int4 = int4))
        downs.Push(Linear(c.MoeFfn, c.Dim, blockOf([c.Dim]), pack, Int8 = int8, Int4 = int4))
    }
    Ups mut Array<Linear>& = ups.ToArray()          # each expert's gate and up halves
    Downs mut Array<Linear>& = downs.ToArray()
}

# the safetensors of a model directory: one file, or the shards of an index
type Weights struct(files Array<checkpoint.File>&, where Map<String, I64>, paths Array<String>&, base Array<I64>&) {
    files
    where
    paths
    base                    # where each file's data starts
    buf mut Array<U8>& = Array<U8>(0)
    row mut Array<F32>& = Array<F32>(0)
    gg mut Vec<gguf.File>& = Vec<gguf.File>()     # a GGUF file in place of the safetensors (its one element)
    prefix String = ""      # what "model." is in the files (a vision-language model's language_model.model.)
    headDim I64 = 0
}

# the weights of a GGUF file, read by their Hugging Face names
fn Weights.Gguf(f gguf.File, headDim I64) Weights {
    w := Weights(Array<checkpoint.File>(0), Map<String, I64>(), Array<String>(0), Array<I64>(0))
    w.gg.Push(f)
    w.headDim = headDim
    return w
}

# a Hugging Face tensor's name in a GGUF file, and its expert (a mixture's experts are one tensor there; -1: none)
fn ggufName(name String&) String, I64 {
    if name == "model.embed_tokens.weight": return "token_embd.weight", -1
    if name == "lm_head.weight": return "output.weight", -1
    if name == "model.norm.weight": return "output_norm.weight", -1
    if not name.StartsWith("model.layers."): return name, -1
    rest :~ name["model.layers.".Len():]
    dot := try rest.Find(".") catch default 0
    blk := "blk." + rest[:dot] + "."
    part :~ rest[dot + 1:]
    if part.StartsWith("mlp.experts.") {
        tail :~ part["mlp.experts.".Len():]
        d := try tail.Find(".") catch default 0
        e := try tail[:d].ParseInt() catch default -1
        kind :~ tail[d + 1:]
        if kind == "gate_proj.weight": return blk + "ffn_gate_exps.weight", e
        if kind == "up_proj.weight": return blk + "ffn_up_exps.weight", e
        return blk + "ffn_down_exps.weight", e
    }
    for pair in ggufNames {
        if part == pair[0]: return blk + pair[1], -1
    }
    return blk + part, -1
}

ggufNames Array<Array<String>&>& = [
    ["self_attn.q_proj.weight", "attn_q.weight"], ["self_attn.k_proj.weight", "attn_k.weight"]
    ["self_attn.v_proj.weight", "attn_v.weight"], ["self_attn.o_proj.weight", "attn_output.weight"]
    ["self_attn.q_proj.bias", "attn_q.bias"], ["self_attn.k_proj.bias", "attn_k.bias"], ["self_attn.v_proj.bias", "attn_v.bias"]
    ["self_attn.q_norm.weight", "attn_q_norm.weight"], ["self_attn.k_norm.weight", "attn_k_norm.weight"]
    ["mlp.gate_proj.weight", "ffn_gate.weight"], ["mlp.up_proj.weight", "ffn_up.weight"], ["mlp.down_proj.weight", "ffn_down.weight"]
    ["input_layernorm.weight", "attn_norm.weight"], ["post_attention_layernorm.weight", "ffn_norm.weight"]
    ["mlp.gate.weight", "ffn_gate_inp.weight"]]

# file "path" opened, and where its data starts (after the 8 bytes of the header's length and the header)
fn opened(path String&, paths mut Vec<String>&, base mut Vec<I64>&) ? ModelError, os.Error {
    f := try os.File.Open(path)
    head := Array<U8>(8)
    got :~ try f.Read(head) catch io.Error { error ModelError.Malformed(path) }
    if got.Len() != 8: error ModelError.Malformed(path)
    n I64 = 0
    for i in range 8: n = n | (I64(head[i]) << (8 * i))
    paths.Push(path)
    base.Push(8 + n)
}

fn Weights.Open(dir String&) Weights ? ModelError, os.Error {
    files := Vec<checkpoint.File>()
    where := Map<String, I64>()
    paths := Vec<String>()
    base := Vec<I64>()
    single := dir + "/model.safetensors"
    if os.Exists(single) {
        f := try checkpoint.File.Load(single) catch checkpoint.SafetensorsError { error ModelError.Malformed(single) }
        for e in f.Entries: where.Put(e.Key, 0)
        files.Push(f)
        try opened(single, paths, base)
        return Weights(files.ToArray(), where, paths.ToArray(), base.ToArray())
    }
    index := dir + "/model.safetensors.index.json"
    j :~ try json.Json.Parse(try os.ReadFile(index)) catch json.Error { error ModelError.Malformed(index) }
    m :~ try (try j["weight_map"] catch { error ModelError.Malformed(index) }).AsObj() catch { error ModelError.Malformed(index) }
    shard := Map<String, I64>()
    for k in range m.Len() {
        name :~ try m.Values[k].AsStr() catch { error ModelError.Malformed(index) }
        if not shard.Has(name) {
            path := dir + "/" + name
            f := try checkpoint.File.Load(path) catch checkpoint.SafetensorsError { error ModelError.Malformed(path) }
            shard.Put(name, files.Len())
            files.Push(f)
            try opened(path, paths, base)
        }
        where.Put(m.Keys[k], try shard.Get(name) catch { unreachable })
    }
    return Weights(files.ToArray(), where, paths.ToArray(), base.ToArray())
}

# a tensor's name as the files have it
fn (w Weights&) named(name String&) String {
    if w.prefix.Len() == 0: return name
    if name.StartsWith("model."): return w.prefix + name["model.".Len():]
    if name == "lm_head.weight": return w.prefix[:w.prefix.Len() - "model.".Len()] + "lm_head.weight"
    return name
}

fn (w Weights&) Has(name String&) Bool {
    if w.gg.Len() > 0 {
        g, _ := ggufName(name)
        return w.gg[0].Has(g)
    }
    return w.where.Has(w.named(name))
}

# rows at..at + n of tensor "name" (each cols long; a tensor of 3 dimensions read as its rows one after another) as
# F32 into dst
fn (w mut Weights&) rowsOf(name String&, at I64, n I64, cols I64, dst mut Array<F32>&) ? ModelError {
    if w.gg.Len() > 0 {
        g, e := ggufName(name)
        t := try w.gg[0].Tensor(g) catch gguf.GgufError { error ModelError.Malformed("no tensor " + g) }
        if t.Dims[0] != cols: error ModelError.Malformed(g + " has rows of " + $t.Dims[0] + ", not " + $cols)
        total I64 = 1
        for d in range 1, t.Dims.Len(): total *= t.Dims[d]
        first := at + (e * n if e >= 0 else 0)
        if first + n > total: error ModelError.Malformed(g + " has " + $total + " rows")
        try w.gg.RefMut(0).Rows(g, first, n, dst, w.headDim) catch gguf.GgufError { error ModelError.Malformed("a read of " + g) }
        return
    }
    e, k := try w.entry(w.named(name))
    last := e.Shape[e.Shape.Len() - 1]
    total I64 = 1
    for d in range e.Shape.Len() - 1: total *= e.Shape[d]
    if last != cols and e.Shape.Len() > 2 {
        # a convolution's [out, channels, height, width]: rows of everything after the first
        inner I64 = 1
        for d in range 1, e.Shape.Len(): inner *= e.Shape[d]
        if inner == cols {
            last = cols
            total = e.Shape[0]
        }
    }
    ok := e.Type == checkpoint.Dtype.BF16 or e.Type == checkpoint.Dtype.F16 or e.Type == checkpoint.Dtype.F32
    if not ok or last != cols or at + n > total.Max(1): error ModelError.Malformed(e.Key + " is " + $e.Shape + " " + e.Type.Name() + ", not rows of " + $cols)
    width := e.Type.Width()
    if w.buf.Len() < n * cols * width: w.buf ~ Array<U8>(n * cols * width)
    b :~ w.buf[:n * cols * width]
    try w.read(k, e.Begin + at * cols * width, b)
    for i in range n * cols: dst[i] = valueAt(b, i, e.Type)
}

fn (w Weights&) entry(name String&) checkpoint.Entry, I64 ? ModelError {
    k := try w.where.Get(name) catch { error ModelError.Malformed("no tensor " + name) }
    e := try w.files[k].Find(name) catch { error ModelError.Malformed("no tensor " + name) }
    return e, k
}

# bytes from byte "at" of file k's data into buf
fn (w Weights&) read(k I64, at I64, buf mut Array<U8>&) ? ModelError {
    f := try os.File.Open(w.paths[k]) catch os.Error { error ModelError.Malformed("cannot open " + w.paths[k]) }
    checkpoint.Seek(f.Fd(), w.base[k] + at, 0)
    got I64 = 0
    for got < buf.Len() {
        part :~ try f.Read(buf[got:]) catch io.Error { error ModelError.Malformed("a read of " + $buf.Len() + " bytes") }
        if part.Len() == 0: error ModelError.Malformed("a short tensor")
        got += part.Len()
    }
}

# element i of raw data of dtype d, as F32
fn valueAt(b Array<U8>&, i I64, d checkpoint.Dtype) F32 {
    return match d {
        case checkpoint.Dtype.BF16: F32(BF16.FromBits(U16(b[2 * i]) | (U16(b[2 * i + 1]) << 8)))
        case checkpoint.Dtype.F16: F32(F16.FromBits(U16(b[2 * i]) | (U16(b[2 * i + 1]) << 8)))
        case _: F32.FromBits(U32(b[4 * i]) | (U32(b[4 * i + 1]) << 8) | (U32(b[4 * i + 2]) << 16) | (U32(b[4 * i + 3]) << 24))
    }
}

# tensor "name", [rows, In], into outputs from..from + rows of l; or its rows at..at + rows, where it is [n, m, In] (a
# mixture's experts in one tensor) or holds more rows
fn (w mut Weights&) fill(l mut Linear&, name String&, from I64, rows I64, at I64 = 0) ? ModelError {
    per := (4 * 1048576 / l.In).Max(1)
    if w.row.Len() < per * l.In: w.row ~ Array<F32>(per * l.In)
    for r0 in range 0, rows, per {
        n := per.Min(rows - r0)
        try w.rowsOf(name, at + r0, n, l.In, w.row)
        b :~ w.row
        for r in range n {
            o := from + r0 + r
            if l.Int8 {
                # symmetric, a scale per Group inputs of an output: the group's largest magnitude is 127
                for g0 in range 0, l.In, l.Group {
                    top F32 = 0.0
                    for i in range g0, g0 + l.Group {
                        v := b[r * l.In + i]
                        top = v if v > top else (-v if -v > top else top)
                    }
                    sc := top / 127.0 if top > 0.0 else F32(1.0)
                    l.Scale[(o * l.In + g0) / l.Group] = sc
                    inv := 1.0 / sc
                    for i in range g0, g0 + l.Group {
                        v := (b[r * l.In + i] * inv).Round()
                        l.Q[l.at(o, i)] = I8(v if v < 127.0 and v > -127.0 else (F32(127.0) if v > 0.0 else F32(-127.0)))
                    }
                }
            } else if l.Int4 {
                for g0 in range 0, l.In, 32: l.put4(o, g0, b, r * l.In + g0)
            } else if l.Packed {
                base := (o / l.Nb) * l.In * l.Nb + (o % l.Nb) * 2
                for i in range l.In: l.W[base + (i / 2) * l.Nb * 2 + i % 2] = BF16(b[r * l.In + i])
            } else {
                for i in range l.In: l.W[o * l.In + i] = BF16(b[r * l.In + i])
            }
        }
    }
}

# a matrix "name" of rows x cols into dst, F32, row-major
fn (w mut Weights&) matrix(dst mut Array<F32>&, name String&, rows I64, cols I64) ? ModelError {
    try w.rowsOf(name, 0, rows, cols, dst)
}

# for other modules reading the same files (llm/vision): a matrix of rows x cols, a vector of n, F32
fn (w mut Weights&) Matrix(dst mut Array<F32>&, name String&, rows I64, cols I64) ? ModelError { try w.matrix(dst, name, rows, cols) }

fn (w mut Weights&) Vector(dst mut Array<F32>&, name String&, n I64) ? ModelError { try w.vector(dst, name, 0, n) }

# a vector "name" of n elements into dst from "from"
fn (w mut Weights&) vector(dst mut Array<F32>&, name String&, from I64, n I64) ? ModelError {
    v := Array<F32>(n)
    try w.rowsOf(name, 0, 1, n, v)
    for i in range n: dst[from + i] = v[i]
}

# ---- the model ----

type Model struct(C Config, Tile Bool, Int8 Bool = false, Int4 Bool = false) {
    C                                       # the configuration
    Tile                                    # AddDot's products (BF16 activations); else F32 activations and gemm
    Int8                                    # the layers' weights in 8 bits, a scale per 32 inputs (the head and embedding BF16)
    Int4                                    # the layers' weights in 4 bits, a scale per 32 inputs (the head and embedding BF16)
    made := Vec<Layer>()
    for li in range C.Layers: made.Push(Layer(C, Tile, Int8, C.MoeAt(li), Int4))
    Layers mut Array<Layer>& = made.ToArray()
    Embed Linear = Linear(C.Dim, C.Vocab if not C.Tied else 0, 16, false)   # row-major; empty when tied
    Head Linear = Linear(C.Dim, roundUp(C.Vocab, 16), blockOf([roundUp(C.Vocab, 16)]), Tile)   # rows past Vocab 0
    Final mut Array<F32>& = Array<F32>(C.Dim)
    Threads I64 = gemm.Cores()
}

# the model in directory dir (config.json, model.safetensors or its shards): exact (F32 activations, gemm's products)
# where AMX is missing or exact is set
fn Model.Load(dir String&, exact Bool = false, int8 Bool = false, int4 Bool = false) Model ? ModelError, os.Error {
    if dir.EndsWith(".gguf") {
        g := try gguf.File.Open(dir) catch gguf.GgufError { error ModelError.Malformed(dir + " (GGUF)") }
        c := try Config.Parse(try g.ConfigJson() catch gguf.GgufError { error ModelError.Unsupported(dir + ": " + g.Arch) })
        w := Weights.Gguf(g, c.HeadDim)
        return try Model.From(c, w, exact, int8, int4)
    }
    c := try Config.Parse(try os.ReadFile(dir + "/config.json"))
    w := try Weights.Open(dir)
    for p in ["language_model.model.", "model.language_model."] {
        if w.where.Has(p + "embed_tokens.weight"): w.prefix = p
    }
    return try Model.From(c, w, exact, int8, int4)
}

# the model of config c with weights w
fn Model.From(c Config, w mut Weights&, exact Bool, int8 Bool, int4 Bool = false) Model ? ModelError {
    if exact and (int8 or int4): error ModelError.Unsupported("exact products of 8- or 4-bit weights")
    if int8 and int4: error ModelError.Unsupported("both 8- and 4-bit weights")
    m := Model(c, TargetHasTileDot and not exact, int8 and TargetHasTileDot, int4 and TargetHasTileDot)
    if w.Has("rope_freqs.weight") {
        m.C.FreqDiv ~ Array<F64>(c.HeadDim / 2)
        v := Array<F32>(c.HeadDim / 2)
        try w.vector(v, "rope_freqs.weight", 0, c.HeadDim / 2)
        for i in range v.Len(): m.C.FreqDiv[i] = F64(v[i])
    }
    q := c.Heads * c.HeadDim
    kv := c.KvHeads * c.HeadDim
    for i in range c.Layers {
        p := "model.layers." + $i + "."
        l := m.Layers[i]
        # Phi's projections stored fused: qkv_proj (queries, keys, values) and gate_up_proj (gate, up), as oann holds them
        if w.Has(p + "self_attn.qkv_proj.weight") {
            try w.fill(l.Qkv, p + "self_attn.qkv_proj.weight", 0, q + 2 * kv)
        } else {
            try w.fill(l.Qkv, p + "self_attn.q_proj.weight", 0, q)
            try w.fill(l.Qkv, p + "self_attn.k_proj.weight", q, kv)
            try w.fill(l.Qkv, p + "self_attn.v_proj.weight", q + kv, kv)
        }
        if c.Bias {
            try w.vector(l.Qkv.Bias, p + "self_attn.q_proj.bias", 0, q)
            try w.vector(l.Qkv.Bias, p + "self_attn.k_proj.bias", q, kv)
            try w.vector(l.Qkv.Bias, p + "self_attn.v_proj.bias", q + kv, kv)
        }
        try w.fill(l.O, p + "self_attn.o_proj.weight", 0, c.Dim)
        if c.MoeAt(i) {
            try loadExperts(w, l, c, p)
        } else if w.Has(p + "mlp.gate_up_proj.weight") {
            try w.fill(l.GateUp, p + "mlp.gate_up_proj.weight", 0, 2 * c.Ffn)
            try w.fill(l.Down, p + "mlp.down_proj.weight", 0, c.Dim)
        } else {
            try w.fill(l.GateUp, p + "mlp.gate_proj.weight", 0, c.Ffn)
            try w.fill(l.GateUp, p + "mlp.up_proj.weight", c.Ffn, c.Ffn)
            try w.fill(l.Down, p + "mlp.down_proj.weight", 0, c.Dim)
        }
        try w.vector(l.Norm1, p + "input_layernorm.weight", 0, c.Dim)
        if c.PostNorms {
            try w.vector(l.Norm2, p + "pre_feedforward_layernorm.weight", 0, c.Dim)
            try w.vector(l.PostAttn, p + "post_attention_layernorm.weight", 0, c.Dim)
            try w.vector(l.PostFfn, p + "post_feedforward_layernorm.weight", 0, c.Dim)
        } else {
            try w.vector(l.Norm2, p + "post_attention_layernorm.weight", 0, c.Dim)
        }
        if c.QkNorm {
            try w.vector(l.QNorm, p + "self_attn.q_norm.weight", 0, l.QNorm.Len())
            try w.vector(l.KNorm, p + "self_attn.k_norm.weight", 0, l.KNorm.Len())
        }
        if c.NormPlus != 0.0 {
            for a in [l.Norm1, l.Norm2, l.PostAttn, l.PostFfn, l.QNorm, l.KNorm] {
                for z in range a.Len(): a[z] += c.NormPlus
            }
        }
    }
    try w.vector(m.Final, "model.norm.weight", 0, c.Dim)
    for i in range c.Dim: m.Final[i] += c.NormPlus
    if c.Tied or not w.Has("lm_head.weight") {
        if not c.Tied: m.C.Tied = true
        m.Embed = Linear(c.Dim, 0, 16, false)
        try w.fill(m.Head, "model.embed_tokens.weight", 0, c.Vocab)
    } else {
        m.Embed = Linear(c.Dim, c.Vocab, 16, false)
        try w.fill(m.Embed, "model.embed_tokens.weight", 0, c.Vocab)
        try w.fill(m.Head, "lm_head.weight", 0, c.Vocab)
    }
    return m
}

# a mixture's router and experts: Qwen3-MoE's and OLMoE's an expert a tensor (mlp.gate, mlp.experts.E.*_proj),
# Granite-MoE's all experts in one ([E, 2 MoeFfn, Dim] gate and up halves, [E, Dim, MoeFfn])
fn loadExperts(w mut Weights&, l mut Layer&, c Config&, p String&) ? ModelError {
    f := c.MoeFfn
    if c.Arch == "granitemoe" and w.gg.Len() == 0 {
        try w.matrix(l.Router, p + "block_sparse_moe.router.layer.weight", c.Experts, c.Dim)
        for e in range c.Experts {
            try w.fill(l.Ups[e], p + "block_sparse_moe.input_linear.weight", 0, 2 * f, e * 2 * f)
            try w.fill(l.Downs[e], p + "block_sparse_moe.output_linear.weight", 0, c.Dim, e * c.Dim)
        }
        return
    }
    try w.matrix(l.Router, p + "mlp.gate.weight", c.Experts, c.Dim)
    for e in range c.Experts {
        q := p + "mlp.experts." + $e + "."
        try w.fill(l.Ups[e], q + "gate_proj.weight", 0, f)
        try w.fill(l.Ups[e], q + "up_proj.weight", f, f)
        try w.fill(l.Downs[e], q + "down_proj.weight", 0, c.Dim)
    }
}

# the bytes its weights take
fn (w Linear&) Bytes() I64 { return 2 * w.W.Len() + w.Q.Len() + w.Q4.Len() + 2 * (w.D4.Len() + w.M4.Len() + w.C4.Len()) + 4 * (w.Scale.Len() + w.Bias.Len()) }

# the bytes the weights take
fn (m Model&) Bytes() I64 {
    n I64 = m.Embed.Bytes() + m.Head.Bytes()
    for l in m.Layers {
        n += l.Qkv.Bytes() + l.O.Bytes() + l.GateUp.Bytes() + l.Down.Bytes() + 4 * l.Router.Len()
        for e in range l.Ups.Len(): n += l.Ups[e].Bytes() + l.Downs[e].Bytes()
    }
    return n
}

# ---- the key-value cache ----

PageSize I64 = 64

# Pages pages of 64 positions for every layer and key-value head, keys and values in BF16; Slots sequences of at most
# MaxPages pages each, Table[slot MaxPages + i] its i-th page. A page's keys for a head: position n's dimension d at
# ((d / 2) 32 + n) 2 + d % 2 (AddDot's pairs over the head's dimensions); its values: at ((n / 2) HeadDim + d) 2 + n % 2
type Cache struct(c Config&, Pages I64, Slots I64, MaxPages I64, exact Bool = false, Kv8 Bool = false) {
    Pages
    Slots
    MaxPages
    Kv8                     # values in 8 bits, a scale per position and head (V8, VS); else BF16. Keys are BF16 always
    Layers I64 = c.Layers
    KvHeads I64 = c.KvHeads
    HeadDim I64 = c.HeadDim
    K mut Array<BF16>& = Array<BF16>(c.Layers * Pages * c.KvHeads * c.HeadDim * PageSize)
    V mut Array<BF16>& = Array<BF16>(0 if Kv8 else c.Layers * Pages * c.KvHeads * c.HeadDim * PageSize)
    V8 mut Array<I8>& = Array<I8>(c.Layers * Pages * c.KvHeads * c.HeadDim * PageSize if Kv8 else 0)
    VS mut Array<F32>& = Array<F32>(c.Layers * Pages * c.KvHeads * PageSize if Kv8 else 0)   # position n's at at() / HeadDim + n
    KF mut Array<F32>& = Array<F32>(c.Layers * Pages * c.KvHeads * c.HeadDim * PageSize if exact else 0)  # exact: F32 too
    VF mut Array<F32>& = Array<F32>(c.Layers * Pages * c.KvHeads * c.HeadDim * PageSize if exact else 0)
    Table mut Array<I32>& = Array<I32>(Slots * MaxPages, -1)
    free mut Array<I32>& = Array<I32>[I32(Pages - 1 - i) for i in range Pages]
    nfree I64 = Pages
}

# the bytes one page takes over every layer: BF16 keys and values, or values of 8 bits and a scale a position
fn PageBytes(c Config&, kv8 Bool = false) I64 {
    if kv8: return c.Layers * c.KvHeads * PageSize * (3 * c.HeadDim + 4)
    return c.Layers * c.KvHeads * c.HeadDim * PageSize * 2 * 2
}

fn (k Cache&) Free() I64 { return k.nfree }

# a page off the free list, its values zeroed (a weight of zero times a stale NaN would be one; 8 bits and their scales
# are never one); -1 when none is left
fn (k mut Cache&) Take() I32 {
    if k.nfree == 0: return -1
    k.nfree--
    p := k.free[k.nfree]
    if k.Kv8: return p
    span := k.KvHeads * k.HeadDim * PageSize
    for l in range k.Layers {
        o := (l * k.Pages + I64(p)) * span
        for i in range span: k.V[o + i] = BF16(0.0)
        if k.VF.Len() > 0 {
            for i in range span: k.VF[o + i] = 0.0
        }
    }
    return p
}

fn (k mut Cache&) Give(p I32) {
    k.free[k.nfree] = p
    k.nfree++
}

# the offset of layer l's page p for head h (keys and values alike)
fn (k Cache&) at(l I64, p I64, h I64) I64 { return ((l * k.Pages + p) * k.KvHeads + h) * k.HeadDim * PageSize }

# ---- a step ----

# the rows of a step and the buffers it runs in, made for at most Rows rows of which at most Outs want logits
type State struct(m Model&, Rows I64, Outs I64, MaxCtx I64) {
    Rows
    Outs
    MaxCtx
    N I64 = 0                                       # the rows of this step
    Tok mut Array<I32>& = Array<I32>(Rows)          # each row's token,
    Pos mut Array<I64>& = Array<I64>(Rows)          # its position,
    Slot mut Array<I64>& = Array<I64>(Rows)         # its sequence's slot in the cache,
    Out mut Array<I64>& = Array<I64>(Rows, -1)      # and where its logits go (-1: none)
    Last mut Array<I64>& = Array<I64>(Rows)         # the last position it attends to (its own; an image's last for an image's rows)
    Given mut Array<I64>& = Array<I64>(Rows, -1)    # where its embedding is in Embeds (-1: its token's)
    Embeds mut Array<F32>& = Array<F32>(0)          # embeddings given in place of tokens' (an image's), Dim each
    NOut I64 = 0
    Times mut Array<I64>& = Array<I64>(4)           # ns in products, attention, the rest, steps
    SplitK Bool = true                              # a few rows' attention split by pages over the tasks
    part mut Array<F32>& = Array<F32>(maxUnits(m.C, Rows, MaxCtx) * partWidth(m.C))   # split items' partial softmaxes
    uoff mut Array<I64>& = Array<I64>(Rows * m.C.KvHeads + 1)                         # each item's first unit
    Logits mut Array<F32>& = Array<F32>(roundUp(Outs, 16) * m.Head.Out)
    x mut Array<F32>& = Array<F32>(Rows * m.C.Dim)
    h mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * widest(m.C))
    qkv mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * (m.C.Heads + 2 * m.C.KvHeads) * m.C.HeadDim)
    att mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * m.C.Heads * m.C.HeadDim)
    y mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * (2 * m.C.Ffn).Max(m.C.Dim))     # a perceptron's gate and up, or a projection's output
    xb mut Array<BF16>& = Array<BF16>(roundUp(Rows, 16) * widest(m.C) if m.Tile else 0)
    deq mut Array<BF16>& = Array<BF16>(m.Threads * widest(m.C) * 64 if m.Tile and (m.Int8 or m.Int4) else 0)   # each task's widened block
    scs mut Array<F32>& = Array<F32>(m.Threads * (256 + 2 * Gemv4 * widest(m.C) / 32))                  # and its scales (4 bits: its rows' too)
    qxs mut Array<U8>& = Array<U8>(m.Threads * Gemv4 * widest(m.C) if m.Int4 else 0)              # 4 bits: each task's rows in 8
    # a mixture of experts: each row's experts and weights, the rows grouped by expert, an expert's rows gathered
    pick mut Array<I32>& = Array<I32>(Rows * m.C.TopK)
    pickW mut Array<F32>& = Array<F32>(Rows * m.C.TopK)
    byExp mut Array<I32>& = Array<I32>(Rows * m.C.TopK)       # (row TopK + j) grouped by expert
    expAt mut Array<I64>& = Array<I64>(m.C.Experts + 1)
    gaps mut Array<I64>& = Array<I64>(m.C.Experts)
    rl mut Array<F32>& = Array<F32>(Rows * m.C.Experts)        # each row's router logits
    act mut Array<I64>& = Array<I64>(m.C.Experts)               # the experts some row chose, most rows first
    pairOut mut Array<F32>& = Array<F32>(Rows * m.C.TopK * m.C.Dim if m.Tile else 0)   # each (row, choice)'s expert output
    moeIn I64 = roundUp(Rows, 16) * m.C.Dim.Max(m.C.MoeFfn)                            # a task's share of tx, tg
    tx mut Array<BF16>& = Array<BF16>(m.Threads * roundUp(Rows, 16) * m.C.Dim.Max(m.C.MoeFfn) if m.Tile and m.C.Experts > 0 else 0)
    tg mut Array<F32>& = Array<F32>(m.Threads * roundUp(Rows, 16) * (3 * m.C.MoeFfn + 2 * m.C.Dim) if m.Tile and m.C.Experts > 0 else 0)
    gx mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * m.C.Dim if m.C.Experts > 0 else 0)
    gy mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * 2 * m.C.MoeFfn)
    gh mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * m.C.MoeFfn)
    go mut Array<F32>& = Array<F32>(roundUp(Rows, 16) * m.C.Dim if m.C.Experts > 0 else 0)
    cos mut Array<F32>& = Array<F32>(Rows * m.C.HeadDim / 2)
    sin mut Array<F32>& = Array<F32>(Rows * m.C.HeadDim / 2)
    freq Array<F64>& = m.C.Freqs()
    longFreq Array<F64>& = m.C.Freqs(true)
    lcos mut Array<F32>& = Array<F32>(Rows * m.C.HeadDim / 2 if m.C.ThetaLocal > 0.0 else 0)   # the local layers' rotation
    lsin mut Array<F32>& = Array<F32>(Rows * m.C.HeadDim / 2 if m.C.ThetaLocal > 0.0 else 0)
    lfreq Array<F64>& = m.C.LocalFreqs()
    tasks := Vec<Attend>()
    for _ in range m.Threads: tasks.Push(Attend(m.C, MaxCtx, m.Tile))
    work mut Array<Attend>& = tasks.ToArray()
    ws gemm.Workspace<F32> = gemm.Workspace<F32>(m.Threads)
    ws.Reserve(m.Head.Out.Max(2 * m.C.Ffn).Max(2 * m.C.MoeFfn).Max(Rows))
}

fn roundUp(n I64, m I64) I64 { return (n + m - 1) / m * m }

# the widest input of a product: the stream, the attention's output or the perceptron's hidden layer
fn widest(c Config&) I64 { return c.Dim.Max(c.Heads * c.HeadDim).Max(c.Ffn).Max(c.MoeFfn) }

# a task's scratch for attention: a head group's queries, scores, weights and output
type Attend struct(c Config&, maxCtx I64, tile Bool) {
    q mut Array<BF16>& = Array<BF16>(16 * c.HeadDim)
    s mut Array<F32>& = Array<F32>(16 * roundUp(maxCtx, PageSize))
    p mut Array<BF16>& = Array<BF16>(16 * roundUp(maxCtx, PageSize) if tile else 0)
    o mut Array<F32>& = Array<F32>(16 * c.HeadDim)
    qf mut Array<F32>& = Array<F32>(16 * c.HeadDim)
    ml mut Array<F32>& = Array<F32>(32)                         # each query's maximum and sum
    vb mut Array<BF16>& = Array<BF16>(c.HeadDim * PageSize)
}

# adds a row whose embedding is e's row at (Dim wide, as the model's input: not scaled), at position pos of the
# sequence in slot, attending to its sequence's positions to last (an image's rows see the whole image). Embeds grows
# to hold it where it must (at most once a size)
fn (s mut State&) AddGiven(e Array<F32>&, at I64, d I64, pos I64, last I64, slot I64, logits Bool) I64 {
    j := s.Add(0, pos, slot, logits)
    r := s.N - 1
    if s.Embeds.Len() < s.Rows * d: s.Embeds ~ Array<F32>(s.Rows * d)
    for i in range d: s.Embeds[r * d + i] = e[at * d + i]
    s.Given[r] = r
    s.Last[r] = last
    return j
}

# clears the step's rows
fn (s mut State&) Reset() {
    s.N = 0
    s.NOut = 0
}

# adds a row: token tok of the sequence in slot at position pos; logits wanted or not. Gives the row's logits row (-1)
fn (s mut State&) Add(tok I32, pos I64, slot I64, logits Bool) I64 {
    r := s.N
    s.Tok[r] = tok
    s.Pos[r] = pos
    s.Last[r] = pos
    s.Given[r] = -1
    s.Slot[r] = slot
    s.Out[r] = -1
    if logits {
        s.Out[r] = s.NOut
        s.NOut++
    }
    s.N++
    return s.Out[r]
}

# the logits of output row j
fn (s State&) LogitsOf(j I64, vocab I64) Array<F32>& { return s.Logits[j * vocab:(j + 1) * vocab] }

# y[yo + r ld ..] = x[xo + r ld ..] / rms * g for rows r < n of width d
fn rmsNorm(y mut Array<F32>&, yo I64, x Array<F32>&, xo I64, n I64, d I64, ld I64, g Array<F32>&, eps F64) {
    for r in range n {
        a := xo + r * ld
        b := yo + r * ld
        ss F32 = elem.DotIn<F32, F32>(x, a, x, a, d)
        inv := F32(1.0 / (F64(ss) / F64(d) + eps).Sqrt())
        for i in range d: y[b + i] = x[a + i] * inv * g[i]
    }
}

# dst[: rows, : w.Out] = src[: rows, : w.In] W^T + b, rows of src w.In apart and of dst w.Out apart
fn (m Model&) linear(xb mut Array<BF16>&, deq mut Array<BF16>&, scs mut Array<F32>&, qxs mut Array<U8>&, ws mut gemm.Workspace<F32>&, dst mut Array<F32>&, src mut Array<F32>&, rows I64, w Linear&) {
    if rows == 0: return
    if m.Tile {
        rp := roundUp(rows, 16)
        for i in range rows * w.In: xb[i] = BF16(src[i])
        for i in range rows * w.In, rp * w.In: xb[i] = BF16(0.0)
        blocks := w.Out / w.Nb
        tasks := m.Threads.Min(blocks)
        per := deq.Len() / m.Threads
        sp := scs.Len() / m.Threads
        qp := qxs.Len() / m.Threads
        join {
            for t in range tasks: spawn mmBlocks(dst, xb, w, rp, t * blocks / tasks, (t + 1) * blocks / tasks, deq[t * per:(t + 1) * per], scs[t * sp:(t + 1) * sp], qxs[t * qp:(t + 1) * qp], rows)
        }
    } else {
        c := mat.Mat<F32>(dst, 0, rows, w.Out, w.Out)
        a := mat.Mat<F32>(src, 0, rows, w.In, w.In)
        b := mat.Mat<BF16>(w.W, 0, w.Out, w.In, w.In)
        gemm.Gemm(ws, c, a, false, b, true)
    }
    if w.Bias.Len() > 0 {
        for r in range rows {
            for o in range w.Out: dst[r * w.Out + o] += w.Bias[o]
        }
    }
}

# blocks b0 .. b1 of dst = x W^T (rp rows) by AddDot; 8-bit weights widened a part of a block at a time into deq, each
# times its group's scale and rounded to BF16 (to nearest, even), the scales of a pair row of the block in deq's tail
fn mmBlocks(dst mut Array<F32>&, x Array<BF16>&, w Linear&, rp I64, b0 I64, b1 I64, deq mut Array<BF16>&, sc mut Array<F32>&, qx mut Array<U8>&, real I64) {
    if w.Int4 and real <= Gemv4 {
        quant8(x, w.In, real, qx, sc[256:])
        gemv4(dst, w, real, b0, b1, qx, sc[256:], sc[:256])
        return
    }
    span := w.In * w.Nb
    for b in range b0, b1 {
        c0 := b * w.Nb
        for r in range rp {
            for j in range w.Nb: dst[r * w.Out + c0 + j] = 0.0
        }
        if w.Int8 {
            # widened 512 deep at a time, into the L1 cache, and added from there (a batch of many rows: the whole
            # block at once, its C tiles loaded once)
            step := 512
            row := 2 * w.Nb
            ng := w.In / w.Group
            for k0 in range 0, w.In, step {
                depth := (w.In - k0).Min(step)
                o := b * span + k0 * w.Nb
                for p in range depth / 2 {
                    k := k0 + 2 * p
                    if k % w.Group == 0 {
                        g := k / w.Group
                        for n in range w.Nb {
                            v := w.Scale[(c0 + n) * ng + g]
                            sc[2 * n] = v
                            sc[2 * n + 1] = v
                        }
                    }
                    q := o + p * row
                    d := p * row
                    for j in range row {
                        bits := (F32(w.Q[q + j]) * sc[j]).Bits()
                        deq[d + j] = BF16.FromBits(U16((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16))
                    }
                }
                stdtile.AddDot(dst[c0:], w.Out, rp, w.Nb, x[k0:], w.In, depth, deq[:depth * w.Nb])!
            }
        } else if w.Int4 {
            # widened 512 deep at a time, as 8-bit weights are
            for k0 in range 0, w.In, 512 {
                depth := (w.In - k0).Min(512)
                widen4(w, c0, k0, depth, deq, sc)
                stdtile.AddDot(dst[c0:], w.Out, rp, w.Nb, x[k0:], w.In, depth, deq[:depth * w.Nb])!
            }
        } else {
            stdtile.AddDot(dst[c0:], w.Out, rp, w.Nb, x, w.In, w.In, w.W[b * span:(b + 1) * span])!
        }
    }
}

# the rows a product of 4-bit weights takes by byte dots (decoding); more are widened to BF16 for AddDot
Gemv4 I64 = 16

# rows 0 .. real of x (BF16, In apart) in 8 bits: a scale a group of 32 (its largest magnitude 127) into xs, the values
# rounded and shifted by 128 into bytes, and each group's sum (of the values as the bytes give them back) after the
# scales, at real In / 32
fn quant8(x Array<BF16>&, width I64, real I64, qx mut Array<U8>&, xs mut Array<F32>&) {
    ng := width / 32
    for r in range real {
        for g in range ng {
            o := r * width + g * 32
            big F32 = 0.0
            for t in range 32: big = big.Max(F32(x[o + t]).Abs())
            d := big / 127.0
            inv := 1.0 / d if d > 0.0 else F32(0.0)
            xs[r * ng + g] = d
            sum I64 = 0
            for t in range 32 {
                q := I64((F32(x[o + t]) * inv).Round())
                sum += q
                qx[o + t] = U8(q + 128)
            }
            xs[real * ng + r * ng + g] = d * F32(sum)
        }
    }
}

# blocks b0 .. b1 of dst = x W^T for rows 0 .. real, W in 4 bits, x in 8 (quant8): a group's 32 inputs of 16 outputs
# by eight VNNI steps (four inputs of a row shared by the 16) into I32, then scaled into F32 sums (acc, 16 a row)
fn gemv4(dst mut Array<F32>&, w Linear&, real I64, b0 I64, b1 I64, qx Array<U8>&, xs Array<F32>&, acc mut Array<F32>&) {
    ng := w.In / 32
    lanes := tile4()
    if real == 1 {
        gemv4one(dst, w, b0, b1, qx, xs, lanes)
        return
    }
    for cb in range b0 * w.Nb / 16, b1 * w.Nb / 16 {
        for i in range real * 16: acc[i] = 0.0
        for g in range ng {
            for i in range real * 16: lanes.ai[i] = 0
            for c in range 4 {
                o := ((cb * ng + g) * 4 + c) * 64
                for j in range 64 {
                    b := w.Q4[o + j]
                    lanes.lo[j] = I8(b & 15) - 8
                    lanes.hi[j] = I8(b >> 4) - 8
                }
                for r in range real {
                    x := r * w.In + 32 * g + 8 * c
                    lanes.ai[r * 16:r * 16 + 16] += (qx[x:x + 4] * lanes.lo[:64]).Sum<I32>(4)
                    lanes.ai[r * 16:r * 16 + 16] += (qx[x + 4:x + 8] * lanes.hi[:64]).Sum<I32>(4)
                }
            }
            a4 := (cb * ng + g) * 16
            for r in range real {
                sx := xs[r * ng + g]
                sum := xs[real * ng + r * ng + g]
                for n in range 16: acc[r * 16 + n] += sx * F32(w.D4[a4 + n]) * F32(lanes.ai[r * 16 + n] - I32(w.C4[a4 + n])) + sum * F32(w.M4[a4 + n])
            }
        }
        for r in range real {
            for n in range 16: dst[r * w.Out + cb * 16 + n] = acc[r * 16 + n]
        }
    }
}

# gemv4 for one row (decoding one sequence): the group's sums kept in one vector
fn gemv4one(dst mut Array<F32>&, w Linear&, b0 I64, b1 I64, qx Array<U8>&, xs Array<F32>&, lanes mut tile4&) {
    ng := w.In / 32
    for cb in range b0 * w.Nb / 16, b1 * w.Nb / 16 {
        for n in range 16: lanes.acc[n] = 0.0
        for g in range ng {
            xg :~ qx[32 * g:32 * g + 32]
            o := (cb * ng + g) * 256
            q :~ w.Q4[o:o + 256]
            for j in range 256 {
                lanes.lo[j] = I8(q[j] & 15) - 8
                lanes.hi[j] = I8(q[j] >> 4) - 8
            }
            ai :~ lanes.ai[:16]
            for n in range 16: ai[n] = 0
            comptime for c in range 4 {
                ai += (xg[8 * c:8 * c + 4] * lanes.lo[64 * c:64 * c + 64]).Sum<I32>(4)
                ai += (xg[8 * c + 4:8 * c + 8] * lanes.hi[64 * c:64 * c + 64]).Sum<I32>(4)
            }
            a4 := (cb * ng + g) * 16
            sx := xs[g]
            sum := xs[ng + g]
            for n in range 16: lanes.acc[n] += sx * F32(w.D4[a4 + n]) * F32(ai[n] - I32(w.C4[a4 + n])) + sum * F32(w.M4[a4 + n])
        }
        for n in range 16: dst[cb * 16 + n] = lanes.acc[n]
    }
}

# inputs k0 .. k0 + depth of outputs c0 .. c0 + Nb of 4-bit W widened to BF16 into deq in AddDot's pair layout (input
# 2 p + s of output n at p 2 Nb + 2 n + s); sc holds a group's 16 scales
fn widen4(w Linear&, c0 I64, k0 I64, depth I64, deq mut Array<BF16>&, sc mut Array<F32>&) {
    ng := w.In / 32
    row := 2 * w.Nb
    sc4 :~ sc[:64]
    f :~ sc[64:128]
    mc4 :~ sc[128:192]
    tb := tile4()
    for sb in range w.Nb / 16 {
        cb := c0 / 16 + sb
        for g in range k0 / 32, (k0 + depth) / 32 {
            o := (cb * ng + g) * 256
            a4 := (cb * ng + g) * 16
            for j in range 64 {
                sc4[j] = F32(w.D4[a4 + j / 4])
                mc4[j] = F32(w.M4[a4 + j / 4])
            }
            for half in range 8 {
                c := half / 2
                q :~ w.Q4[o + 64 * c:o + 64 * c + 64]
                if half % 2 == 0 {
                    for j in range 64: f[j] = sc4[j] * F32(I32(q[j] & 15) - 8) + mc4[j]
                } else {
                    for j in range 64: f[j] = sc4[j] * F32(I32(q[j] >> 4) - 8) + mc4[j]
                }
                for j in range 64 {
                    bits := f[j].Bits()
                    tb.b[j] = BF16.FromBits(U16((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16))
                }
                p0 := (32 * g + 4 * half - k0) / 2      # this quad's first pair: outputs' inputs 0, 1 there, 2, 3 next
                at := p0 * row + 32 * sb
                for n in range 16 {
                    deq[at + 2 * n] = tb.b[4 * n]
                    deq[at + 2 * n + 1] = tb.b[4 * n + 1]
                    deq[at + row + 2 * n] = tb.b[4 * n + 2]
                    deq[at + row + 2 * n + 1] = tb.b[4 * n + 3]
                }
            }
        }
    }
}

# gemv4's registers: a chunk's weights unpacked, the rows' I32 sums
type tile4 struct() {
    lo := Array<I8>(256)
    hi := Array<I8>(256)
    acc := Array<F32>(16)
    b := Array<BF16>(64)
    ai := Array<I32>(256)
}

# the rotation of each row's position: cos and sin of position x freq[i]
fn (m Model&) angles(s mut State&) {
    half := m.C.RotHalf()
    for r in range s.N {
        p := F64(s.Pos[r]) / m.C.PosScale
        long := m.C.FreqLong.Len() > 0 and s.Pos[r] >= m.C.RopeOld
        for i in range half {
            a := p * (s.longFreq[i] if long else s.freq[i])
            s.cos[r * half + i] = F32(a.Cos() * m.C.RopeAttn)
            s.sin[r * half + i] = F32(a.Sin() * m.C.RopeAttn)
        }
        for i in range half if s.lcos.Len() > 0 else 0 {
            a := F64(s.Pos[r]) * s.lfreq[i]
            s.lcos[r * half + i] = F32(a.Cos())
            s.lsin[r * half + i] = F32(a.Sin())
        }
    }
}

# the head at x[o ..] rotated by row r's angles (pairs i and i + half)
fn rotate(x mut Array<F32>&, o I64, cos Array<F32>&, sin Array<F32>&, r I64, half I64) {
    for i in range half {
        a := x[o + i]
        b := x[o + half + i]
        c := cos[r * half + i]
        sn := sin[r * half + i]
        x[o + i] = a * c - b * sn
        x[o + half + i] = b * c + a * sn
    }
}

# the logits of the rows that want them, for the step's rows: one pass through every layer
fn (m Model&) Step(s mut State&, k mut Cache&) {
    t0 := time.Now()
    tm I64 = 0
    t1 I64 = 0
    ta I64 = 0
    c Config& = m.C
    n := s.N
    d := c.Dim
    # the embedding of each row's token
    for r in range n {
        t := I64(s.Tok[r])
        if s.Given[r] >= 0 {
            for i in range d: s.x[r * d + i] = s.Embeds[s.Given[r] * d + i]
            continue
        }
        if c.Tied {
            for i in range d: s.x[r * d + i] = m.Head.Get(t, i)
        } else {
            for i in range d: s.x[r * d + i] = F32(m.Embed.W[t * d + i])
        }
        if c.EmbedScale != 1.0 {
            es := F32(c.EmbedScale)
            for i in range d: s.x[r * d + i] *= es
        }
    }
    rs := F32(c.ResScale)
    m.angles(s)
    for li in range c.Layers {
        l :~ m.Layers[li]
        rmsNorm(s.h, 0, s.x, 0, n, d, d, l.Norm1, c.Eps)
        t1 = time.Now()
        m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.qkv, s.h, n, l.Qkv)
        tm += time.Since(t1)
        # QK-norm, rotation, and the keys and values into the cache
        tasks := m.Threads.Min(n / 8)
        local := c.LocalRope(li)
        cs :~ s.lcos if local else s.cos
        sn :~ s.lsin if local else s.sin
        if tasks <= 1 {
            headsOf(c, l, s.qkv, cs, sn, s.Pos, s.Slot, k, li, 0, n)
        } else {
            join {
                for t in range tasks: spawn headsOf(c, l, s.qkv, cs, sn, s.Pos, s.Slot, k, li, t * n / tasks, (t + 1) * n / tasks)
            }
        }
        t2 := time.Now()
        m.attention(s, k, li)
        ta += time.Since(t2)
        t1 = time.Now()
        m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.y, s.att, n, l.O)
        tm += time.Since(t1)
        if c.PostNorms: rmsNorm(s.y, 0, s.y, 0, n, d, d, l.PostAttn, c.Eps)
        for i in range n * d: s.x[i] += s.y[i] * rs
        rmsNorm(s.h, 0, s.x, 0, n, d, d, l.Norm2, c.Eps)
        t1 = time.Now()
        if c.MoeAt(li): m.experts(s, l)
        else: m.dense(s, l, tasks)
        tm += time.Since(t1)
        if c.PostNorms: rmsNorm(s.y, 0, s.y, 0, n, d, d, l.PostFfn, c.Eps)
        for i in range n * d: s.x[i] += s.y[i] * rs
    }
    # the final norm of the rows that want logits, gathered in order, and the head
    for r in range n {
        j := s.Out[r]
        if j < 0: continue
        rmsNorm(s.h, j * d, s.x, r * d, 1, d, d, m.Final, c.Eps)
    }
    t1 = time.Now()
    m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.Logits, s.h, s.NOut, m.Head)
    if m.Head.Out != c.Vocab {
        # a vocabulary not a multiple of 16: the head's padded rows dropped, each row's logits moved down to Vocab apart
        for j in range s.NOut {
            for v in range c.Vocab: s.Logits[j * c.Vocab + v] = s.Logits[j * m.Head.Out + v]
        }
    }
    if c.LogitScale != 1.0 {
        ls := F32(1.0 / c.LogitScale)
        for i in range s.NOut * c.Vocab: s.Logits[i] *= ls
    }
    tm += time.Since(t1)
    all := time.Since(t0)
    s.Times[0] += tm
    s.Times[1] += ta
    s.Times[2] += all - tm - ta
    s.Times[3] += all
}

# the dense perceptron over the step's rows, s.h (normed) into s.y
fn (m Model&) dense(s mut State&, l Layer&, tasks I64) {
    n := s.N
    m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.y, s.h, n, l.GateUp)
    if tasks <= 1 {
        swiglu(s.h, s.y, m.C.Ffn, 0, n, m.C.Gelu)
    } else {
        join {
            for t in range tasks: spawn swiglu(s.h, s.y, m.C.Ffn, t * n / tasks, (t + 1) * n / tasks, m.C.Gelu)
        }
    }
    m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.y, s.h, n, l.Down)
}

# a mixture of experts over the step's rows, s.h (normed) into s.y: each row's top k experts by the router's softmax
# (F32), the rows grouped by expert, each expert's perceptron run once over its rows and added to them, weighted
fn (m Model&) experts(s mut State&, l Layer&) {
    c Config& = m.C
    n := s.N
    d := c.Dim
    k := c.TopK
    f := c.MoeFfn
    for r in range n: route(c, l, s.h, r, s.rl, s.pick, s.pickW)
    # counting sort of the (row, choice) pairs by expert
    for e in range c.Experts + 1: s.expAt[e] = 0
    for i in range n * k: s.expAt[I64(s.pick[i]) + 1]++
    for e in range c.Experts: s.expAt[e + 1] += s.expAt[e]
    for e in range c.Experts: s.gaps[e] = s.expAt[e]
    for i in range n * k {
        e := I64(s.pick[i])
        s.byExp[s.gaps[e]] = I32(i)
        s.gaps[e]++
    }
    for i in range n * d: s.y[i] = 0.0
    if m.Tile {
        m.expertsTiled(s, l)
        return
    }
    for e in range c.Experts {
        a := s.expAt[e]
        cnt := s.expAt[e + 1] - a
        if cnt == 0: continue
        for j in range cnt {
            r := I64(s.byExp[a + j]) / k
            for i in range d: s.gx[j * d + i] = s.h[r * d + i]
        }
        m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.gy, s.gx, cnt, l.Ups[e])
        swiglu(s.gh, s.gy, f, 0, cnt, c.Gelu)
        m.linear(s.xb, s.deq, s.scs, s.qxs, s.ws, s.go, s.gh, cnt, l.Downs[e])
        for j in range cnt {
            i := I64(s.byExp[a + j])
            r := i / k
            wt := s.pickW[i]
            for q in range d: s.y[r * d + q] += wt * s.go[j * d + q]
        }
    }
}

# the experts over the tasks, each task running whole experts on one core (an expert's products are small: a step of
# few rows would spend more on starting tasks than on the products), most rows first; each (row, choice)'s output
# into pairOut, then summed into the rows, weighted
fn (m Model&) expertsTiled(s mut State&, l Layer&) {
    c Config& = m.C
    k := c.TopK
    d := c.Dim
    na I64 = 0
    for e in range c.Experts {
        if s.expAt[e + 1] == s.expAt[e]: continue
        # insertion by rows, descending
        j := na
        cnt := s.expAt[e + 1] - s.expAt[e]
        for j > 0 and s.expAt[s.act[j - 1] + 1] - s.expAt[s.act[j - 1]] < cnt {
            s.act[j] = s.act[j - 1]
            j--
        }
        s.act[j] = e
        na++
    }
    tasks := m.Threads.Min(na)
    per := s.deq.Len() / m.Threads
    sp := s.scs.Len() / m.Threads
    qp := s.qxs.Len() / m.Threads
    if tasks <= 1 {
        expertRun(c, l, s.h, s.byExp, s.expAt, s.act, 0, 1, na, s.tx[:s.moeIn], s.tg[:s.tg.Len() / m.Threads], s.deq[:per], s.scs[:sp], s.qxs[:qp], s.pairOut)
    } else {
        tw := s.tg.Len() / m.Threads
        join {
            for t in range tasks: spawn expertRun(c, l, s.h, s.byExp, s.expAt, s.act, t, tasks, na, s.tx[t * s.moeIn:(t + 1) * s.moeIn], s.tg[t * tw:(t + 1) * tw], s.deq[t * per:(t + 1) * per], s.scs[t * sp:(t + 1) * sp], s.qxs[t * qp:(t + 1) * qp], s.pairOut)
        }
    }
    for r in range s.N {
        for j in range k {
            i := r * k + j
            wt := s.pickW[i]
            for q in range d: s.y[r * d + q] += wt * s.pairOut[i * d + q]
        }
    }
}

# experts act[t], act[t + tasks], ...: each one's rows gathered, its perceptron run by AddDot on this core, the outputs
# into pairOut at their (row, choice)
fn expertRun(c Config&, l Layer&, h Array<F32>&, byExp Array<I32>&, expAt Array<I64>&, act Array<I64>&, t I64, tasks I64, na I64, xb mut Array<BF16>&, g mut Array<F32>&, deq mut Array<BF16>&, sc mut Array<F32>&, qx mut Array<U8>&, pairOut mut Array<F32>&) {
    d := c.Dim
    f := c.MoeFfn
    k := c.TopK
    rows := xb.Len() / d.Max(f)
    gy := 0                     # g holds gy (rows 2f), gh (rows f), go (rows d)
    gh := rows * 2 * f
    gout := gh + rows * f
    for idx in range t, na, tasks {
        e := act[idx]
        a := expAt[e]
        cnt := expAt[e + 1] - a
        rp := roundUp(cnt, 16)
        for j in range cnt {
            r := I64(byExp[a + j]) / k
            for i in range d: xb[j * d + i] = BF16(h[r * d + i])
        }
        for i in range cnt * d, rp * d: xb[i] = BF16(0.0)
        up Linear& = l.Ups[e]
        mmBlocks(g[gy:gh], xb, up, rp, 0, up.Out / up.Nb, deq, sc, qx, cnt)
        for j in range cnt {
            for i in range f {
                gv := g[gy + j * 2 * f + i]
                xb[j * f + i] = BF16(gate(gv, c.Gelu) * g[gy + j * 2 * f + f + i])
            }
        }
        for i in range cnt * f, rp * f: xb[i] = BF16(0.0)
        down Linear& = l.Downs[e]
        mmBlocks(g[gout:], xb, down, rp, 0, down.Out / down.Nb, deq, sc, qx, cnt)
        for j in range cnt {
            i := I64(byExp[a + j])
            for q in range d: pairOut[i * d + q] = g[gout + j * d + q]
        }
    }
}

# row r's top k experts and their weights: the softmax of the router's logits (F32), the k largest, renormalized to
# sum to 1 where the config says
fn route(c Config&, l Layer&, h Array<F32>&, r I64, lg mut Array<F32>&, pick mut Array<I32>&, pickW mut Array<F32>&) {
    d := c.Dim
    k := c.TopK
    ne := c.Experts
    b := r * ne
    for e in range ne: lg[b + e] = elem.DotIn<F32, F32>(h, r * d, l.Router, e * d, d)
    top := elem.MaxIn<F32, F32>(lg, b, ne)
    total F32 = 0.0
    for e in range ne {
        lg[b + e] = F32(F64(lg[b + e] - top).Exp())
        total += lg[b + e]
    }
    kept F32 = 0.0
    for j in range k {
        best I64 = -1
        for e in range ne {
            if lg[b + e] >= 0.0 and (best < 0 or lg[b + e] > lg[b + best]): best = e
        }
        pick[r * k + j] = I32(best)
        pickW[r * k + j] = lg[b + best] / total
        kept += lg[b + best] / total
        lg[b + best] = -1.0
    }
    if c.NormTopK {
        for j in range k: pickW[r * k + j] /= kept
    }
}

# the scale of n values from x[o] in 8 bits: their largest magnitude / 127 (1 where all are 0)
fn quantScale(x Array<F32>&, o I64, n I64) F32 {
    top F32 = 0.0
    for i in range n {
        v := x[o + i]
        top = v if v > top else (-v if -v > top else top)
    }
    return top / 127.0 if top > 0.0 else F32(1.0)
}

# rows r0 .. r1: each query and key head normed (QK-norm) and rotated, and the keys and values into the cache
fn headsOf(c Config&, l Layer&, qkv mut Array<F32>&, cos Array<F32>&, sin Array<F32>&, pos Array<I64>&, slot Array<I64>&, k mut Cache&, li I64, r0 I64, r1 I64) {
    hd := c.HeadDim
    w3 := (c.Heads + 2 * c.KvHeads) * hd
    for r in range r0, r1 {
        o := r * w3
        if c.QkWide {
            # OLMoE's: the row's queries normed together, then its keys
            rmsNorm(qkv, o, qkv, o, 1, c.Heads * hd, 0, l.QNorm, c.Eps)
            rmsNorm(qkv, o + c.Heads * hd, qkv, o + c.Heads * hd, 1, c.KvHeads * hd, 0, l.KNorm, c.Eps)
        }
        for hh in range c.Heads + c.KvHeads {
            ho := o + hh * hd
            if c.QkNorm and not c.QkWide: rmsNorm(qkv, ho, qkv, ho, 1, hd, hd, l.QNorm if hh < c.Heads else l.KNorm, c.Eps)
            if c.Rotates(li): rotate(qkv, ho, cos, sin, r, c.RotHalf())
        }
        store(c, qkv, pos, slot, k, li, r)
    }
}

# rows r0 .. r1 of h = act(gate) up (SiLU or GELU), the gate and up halves of each row of y (2 f wide)
fn swiglu(h mut Array<F32>&, y Array<F32>&, f I64, r0 I64, r1 I64, gelu Bool = false) {
    for r in range r0, r1 {
        for i in range f: h[r * f + i] = gate(y[r * 2 * f + i], gelu) * y[r * 2 * f + f + i]
    }
}

# the gate's activation: SiLU, or GELU's tanh form (0.5 g (1 + tanh(sqrt(2 / pi) (g + 0.044715 g^3))))
fn gate(g F32, gelu Bool) F32 {
    if not gelu: return g / (1.0 + elem.FastExp(-g))
    u := F32(0.7978845608028654) * (g + F32(0.044715) * g * g * g)
    # tanh(u) = 1 - 2 / (e^(2u) + 1)
    return F32(0.5) * g * (2.0 - 2.0 / (elem.FastExp(2.0 * u) + 1.0))
}

# row r's keys and values into its page of the cache, layer li
fn store(c Config&, qkv Array<F32>&, posOf Array<I64>&, slot Array<I64>&, k mut Cache&, li I64, r I64) {
    hd := c.HeadDim
    q := c.Heads * hd
    kv := c.KvHeads * hd
    o := r * (q + 2 * kv)
    pos := posOf[r]
    page := I64(k.Table[slot[r] * k.MaxPages + pos / PageSize])
    n := pos % PageSize
    for h in range c.KvHeads {
        base := k.at(li, page, h)
        if k.Kv8 {
            # the values symmetric, the head's largest magnitude 127 (keys so lose too much: a few of their dimensions
            # are far larger than the rest)
            vs := quantScale(qkv, o + q + kv + h * hd, hd)
            k.VS[base / hd + n] = vs
            vi := 1.0 / vs
            for i in range hd {
                k.K[base + ((i / 2) * PageSize + n) * 2 + i % 2] = BF16(qkv[o + q + h * hd + i])
                k.V8[base + ((n / 2) * hd + i) * 2 + n % 2] = I8((qkv[o + q + kv + h * hd + i] * vi).Round())
            }
            continue
        }
        for i in range hd {
            k.K[base + ((i / 2) * PageSize + n) * 2 + i % 2] = BF16(qkv[o + q + h * hd + i])
            k.V[base + ((n / 2) * hd + i) * 2 + n % 2] = BF16(qkv[o + q + kv + h * hd + i])
        }
        if k.KF.Len() > 0 {
            for i in range hd {
                k.KF[base + ((i / 2) * PageSize + n) * 2 + i % 2] = qkv[o + q + h * hd + i]
                k.VF[base + ((n / 2) * hd + i) * 2 + n % 2] = qkv[o + q + kv + h * hd + i]
            }
        }
    }
}

# every row's attention at layer li, into s.att: the rows' head groups (items) split over the tasks. An item of more
# than ChunkPages pages is split into runs of that many - so a small batch with a long context still keeps every task
# busy - whose partial softmaxes (each query's maximum, sum and weighted values) are joined after, in order. Where an
# item is split depends on its own length alone, so a row's attention is the same whatever else is in the step
fn (m Model&) attention(s mut State&, k Cache&, li I64) {
    items := s.N * m.C.KvHeads
    for it in range items {
        p := s.Pos[it / m.C.KvHeads]
        np := s.Last[it / m.C.KvHeads] / PageSize + 1 - firstPos(m.C, li, p) / PageSize
        s.uoff[it + 1] = s.uoff[it] + ((np + ChunkPages - 1) / ChunkPages if s.SplitK else 1)
    }
    units := s.uoff[items]
    tasks := m.Threads.Min(units)
    if tasks <= 1 {
        attendUnits(m.C, m.Tile, s.qkv, s.att, s.Pos, s.Last, s.Slot, k, li, 0, units, s.uoff, items, s.work[0], s.part)
    } else {
        join {
            for t in range tasks: spawn attendUnits(m.C, m.Tile, s.qkv, s.att, s.Pos, s.Last, s.Slot, k, li, t * units / tasks, (t + 1) * units / tasks, s.uoff, items, s.work[t], s.part)
        }
    }
    if units > items: joinParts(m.C, s.att, s.part, s.uoff, items)
}

# the first position a row at position p attends to at layer li (its window's)
fn firstPos(c Config&, li I64, p I64) I64 {
    w := c.WindowOf(li)
    return (p - w + 1).Max(0) if w > 0 else 0
}

# the pages of a run of an item's attention
ChunkPages mut I64 = 16

# a unit's partial softmax: for each of the group's queries its maximum and sum, then its weighted values
fn partWidth(c Config&) I64 { return (c.Heads / c.KvHeads) * (c.HeadDim + 2) }

# the units of a step: every item's runs of pages at most
fn maxUnits(c Config&, rows I64, maxCtx I64) I64 {
    return rows * c.KvHeads * ((maxCtx / PageSize + 1 + ChunkPages - 1) / ChunkPages)
}

# each split item's runs joined in order: the values and sums scaled by e^(their maximum - the larger) as they meet
fn joinParts(c Config&, att mut Array<F32>&, part Array<F32>&, uoff Array<I64>&, items I64) {
    hd := c.HeadDim
    g := c.Heads / c.KvHeads
    pw := partWidth(c)
    for it in range items {
        if uoff[it + 1] - uoff[it] < 2: continue
        r := it / c.KvHeads
        h := it % c.KvHeads
        for j in range g {
            o := r * c.Heads * hd + (h * g + j) * hd
            u0 := uoff[it] * pw
            top := part[u0 + j]
            total := part[u0 + g + j]
            for i in range hd: att[o + i] = part[u0 + 2 * g + j * hd + i]
            for u in range uoff[it] + 1, uoff[it + 1] {
                b := u * pw
                m := part[b + j]
                next := m if m > top else top
                fa := elem.FastExp(top - next)
                fb := elem.FastExp(m - next)
                total = total * fa + part[b + g + j] * fb
                for i in range hd: att[o + i] = att[o + i] * fa + part[b + 2 * g + j * hd + i] * fb
                top = next
            }
            inv := 1.0 / total
            for i in range hd: att[o + i] *= inv
        }
    }
}

# the exact integers of n 8-bit values from x[o], as BF16, into dst
fn widen(dst mut Array<BF16>&, x Array<I8>&, o I64, n I64) {
    for i in range n: dst[i] = BF16.FromBits(U16(F32(x[o + i]).Bits() >> 16))   # the low bits are 0
}

# units u0 .. u1: item it (row it / KvHeads, head group it % KvHeads) has units uoff[it] .. uoff[it + 1] - 1, a run of
# ChunkPages of its pages each; an item of one unit writes its attention, the runs of a longer one their partial
# softmaxes into part
fn attendUnits(c Config&, tile Bool, qkv Array<F32>&, att mut Array<F32>&, pos Array<I64>&, last Array<I64>&, slot Array<I64>&, k Cache&, li I64, u0 I64, u1 I64, uoff Array<I64>&, items I64, a mut Attend&, part mut Array<F32>&) {
    hd := c.HeadDim
    g := c.Heads / c.KvHeads
    w3 := (c.Heads + 2 * c.KvHeads) * hd
    stride := a.s.Len() / 16
    scale := F32(c.Scale())
    span := hd * PageSize
    pw := partWidth(c)
    # the item of u0
    lo I64 = 0
    hi I64 = items
    for hi - lo > 1 {
        mid := (lo + hi) / 2
        if uoff[mid] <= u0: lo = mid
        else: hi = mid
    }
    it I64 = lo
    for u in range u0, u1 {
        for uoff[it + 1] <= u: it++
        chunks := uoff[it + 1] - uoff[it]
        r := it / c.KvHeads
        h := it % c.KvHeads
        p := pos[r]
        e := last[r]
        np := e / PageSize + 1
        first := firstPos(c, li, p)
        fp := first / PageSize                      # the window's first page
        pa := fp + (u - uoff[it]) * ChunkPages if chunks > 1 else fp
        pb := (pa + ChunkPages).Min(np) if chunks > 1 else np
        row := slot[r] * k.MaxPages
        n := (pb - pa) * PageSize                   # the positions of the run's pages
        valid := (e + 1).Min(pb * PageSize) - pa * PageSize
        skip := (first - pa * PageSize).Max(0)      # the run's positions before the window: weight 0
        if tile {
            for j in range g {
                for i in range hd: a.q[j * hd + i] = BF16(qkv[r * w3 + (h * g + j) * hd + i])
                for t in range n: a.s[j * stride + t] = 0.0
                for i in range hd: a.o[j * hd + i] = 0.0
            }
            for pi in range pa, pb {
                base := k.at(li, I64(k.Table[row + pi]), h)
                so := (pi - pa) * PageSize
                stdtile.AddDot(a.s[so:], stride, 16, PageSize, a.q, hd, hd, k.K[base:base + span])!
            }
        } else {
            for j in range g {
                for i in range hd: a.qf[j * hd + i] = qkv[r * w3 + (h * g + j) * hd + i]
                for t in range n: a.s[j * stride + t] = 0.0
            }
            for pi in range pa, pb {
                base := k.at(li, I64(k.Table[row + pi]), h)
                for j in range g {
                    so := j * stride + (pi - pa) * PageSize
                    for i in range hd {
                        x := a.qf[j * hd + i]
                        ko := base + (i / 2) * PageSize * 2 + i % 2
                        if k.KF.Len() > 0 {
                            for t in range PageSize: a.s[so + t] += x * k.KF[ko + 2 * t]
                        } else {
                            for t in range PageSize: a.s[so + t] += x * F32(k.K[ko + 2 * t])
                        }
                    }
                }
            }
        }
        # the softmax of each query's scores over the run's positions to p (each pass a loop of lanes, the sums 8 at
        # a time)
        for j in range g {
            so := j * stride
            top := elem.MaxIn<F32, F32>(a.s, so + skip, valid - skip) * scale
            for t in range skip, valid: a.s[so + t] = elem.FastExp(a.s[so + t] * scale - top)
            total := elem.SumIn<F32, F32>(a.s, so + skip, valid - skip)
            for t in range skip: a.s[so + t] = 0.0
            for t in range valid, n: a.s[so + t] = 0.0
            a.ml[j] = top
            a.ml[16 + j] = total
        }
        if tile {
            for pi in range pa, pb {
                base := k.at(li, I64(k.Table[row + pi]), h)
                so := (pi - pa) * PageSize
                if k.Kv8 {
                    sc := base / hd
                    for j in range g {
                        for t in range PageSize: a.p[j * stride + so + t] = BF16(a.s[j * stride + so + t] * k.VS[sc + t])
                    }
                    widen(a.vb, k.V8, base, span)
                    stdtile.AddDot(a.o, hd, 16, hd, a.p[so:], stride, PageSize, a.vb)!
                } else {
                    for j in range g {
                        for t in range PageSize: a.p[j * stride + so + t] = BF16(a.s[j * stride + so + t])
                    }
                    stdtile.AddDot(a.o, hd, 16, hd, a.p[so:], stride, PageSize, k.V[base:base + span])!
                }
            }
        } else {
            for j in range g {
                for i in range hd: a.o[j * hd + i] = 0.0
            }
            for pi in range pa, pb {
                base := k.at(li, I64(k.Table[row + pi]), h)
                for j in range g {
                    for t in range PageSize {
                        x := a.s[j * stride + (pi - pa) * PageSize + t]
                        vo := base + (t / 2) * hd * 2 + t % 2
                        if k.VF.Len() > 0 {
                            for i in range hd: a.o[j * hd + i] += x * k.VF[vo + 2 * i]
                        } else if k.Kv8 {
                            xs := x * k.VS[base / hd + t]
                            for i in range hd: a.o[j * hd + i] += xs * F32(k.V8[vo + 2 * i])
                        } else {
                            for i in range hd: a.o[j * hd + i] += x * F32(k.V[vo + 2 * i])
                        }
                    }
                }
            }
        }
        if chunks == 1 {
            for j in range g {
                inv := 1.0 / a.ml[16 + j]
                for i in range hd: att[r * c.Heads * hd + (h * g + j) * hd + i] = a.o[j * hd + i] * inv
            }
        } else {
            for j in range g {
                part[u * pw + j] = a.ml[j]
                part[u * pw + g + j] = a.ml[16 + j]
                for i in range hd: part[u * pw + 2 * g + j * hd + i] = a.o[j * hd + i]
            }
        }
    }
}

# ---- tests ----

import "std/rand"
import "../tensor"

# the step's allocations: none (a step's buffers are State's, the cache's pages Cache's)
fn stepOf(m Model&, s mut State&, k mut Cache&) { m.Step(s, k) }
assert not stepOf.Allocates, "a step allocates"

# a small model of random weights (Tiny) written as a Hugging Face checkpoint to a new directory: Qwen3's (QK-norm, tied) or
# Qwen2's (biases, a head of its own)
fn Tiny(qwen3 Bool, seed U64) String { return TinyTied(qwen3, seed, qwen3) }

# Tiny with the head tied to the embedding or not
fn TinyTied(qwen3 Bool, seed U64, tied Bool, vocab I64 = 96) String {
    dir :~ os.MkTemp("", "llm")!
    dim, heads, kvHeads, hd, ffn, layers := 64, 4, 2, 32, 96, 2
    cfg := "{\"model_type\": \"" + ("qwen3" if qwen3 else "qwen2") + "\", \"vocab_size\": " + $vocab + ", \"hidden_size\": " + $dim +
        ", \"num_hidden_layers\": " + $layers + ", \"num_attention_heads\": " + $heads + ", \"num_key_value_heads\": " + $kvHeads +
        ", \"head_dim\": " + $hd + ", \"intermediate_size\": " + $ffn + ", \"rope_theta\": 10000.0, \"rms_norm_eps\": 1e-6, " +
        "\"tie_word_embeddings\": " + ("true" if tied else "false") + ", \"max_position_embeddings\": 4096}"
    os.WriteFile(dir + "/config.json", cfg)!
    r := rand.Rand(seed)
    w := checkpoint.Writer()
    put(w, r, "model.embed_tokens.weight", vocab, dim, 1.0, 0.0)
    if not tied: put(w, r, "lm_head.weight", vocab, dim, 0.3, 0.0)
    put(w, r, "model.norm.weight", 1, dim, 0.1, 1.0)
    q, kv := heads * hd, kvHeads * hd
    for i in range layers {
        p := "model.layers." + $i + "."
        put(w, r, p + "self_attn.q_proj.weight", q, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.k_proj.weight", kv, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.v_proj.weight", kv, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.o_proj.weight", dim, q, 0.1, 0.0)
        put(w, r, p + "mlp.gate_proj.weight", ffn, dim, 0.15, 0.0)
        put(w, r, p + "mlp.up_proj.weight", ffn, dim, 0.15, 0.0)
        put(w, r, p + "mlp.down_proj.weight", dim, ffn, 0.1, 0.0)
        put(w, r, p + "input_layernorm.weight", 1, dim, 0.1, 1.0)
        put(w, r, p + "post_attention_layernorm.weight", 1, dim, 0.1, 1.0)
        if qwen3 {
            put(w, r, p + "self_attn.q_norm.weight", 1, hd, 0.1, 1.0)
            put(w, r, p + "self_attn.k_norm.weight", 1, hd, 0.1, 1.0)
        } else {
            put(w, r, p + "self_attn.q_proj.bias", 1, q, 0.5, 0.0)
            put(w, r, p + "self_attn.k_proj.bias", 1, kv, 0.5, 0.0)
            put(w, r, p + "self_attn.v_proj.bias", 1, kv, 0.5, 0.0)
        }
    }
    w.Save(dir + "/model.safetensors")!
    return dir
}

# a small Llama-shaped model of random weights (no biases, no QK-norm, a head of its own) of architecture arch, the
# config's other keys "extra" (",\"key\": value" ...), written as a Hugging Face checkpoint to a new directory
fn TinyArch(arch String&, extra String&, seed U64) String {
    dir :~ os.MkTemp("", "llm")!
    vocab, dim, heads, kvHeads, hd, ffn, layers := 96, 64, 4, 2, 32, 96, 3
    cfg := "{\"model_type\": \"" + arch + "\", \"vocab_size\": " + $vocab + ", \"hidden_size\": " + $dim +
        ", \"num_hidden_layers\": " + $layers + ", \"num_attention_heads\": " + $heads + ", \"num_key_value_heads\": " + $kvHeads +
        ", \"head_dim\": " + $hd + ", \"intermediate_size\": " + $ffn + ", \"rope_theta\": 10000.0, \"rms_norm_eps\": 1e-6, " +
        "\"tie_word_embeddings\": false, \"max_position_embeddings\": 4096" + extra + "}"
    os.WriteFile(dir + "/config.json", cfg)!
    r := rand.Rand(seed)
    w := checkpoint.Writer()
    put(w, r, "model.embed_tokens.weight", vocab, dim, 1.0, 0.0)
    put(w, r, "lm_head.weight", vocab, dim, 0.3, 0.0)
    put(w, r, "model.norm.weight", 1, dim, 0.1, 1.0)
    q, kv := heads * hd, kvHeads * hd
    for i in range layers {
        p := "model.layers." + $i + "."
        put(w, r, p + "self_attn.q_proj.weight", q, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.k_proj.weight", kv, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.v_proj.weight", kv, dim, 0.15, 0.0)
        put(w, r, p + "self_attn.o_proj.weight", dim, q, 0.1, 0.0)
        put(w, r, p + "mlp.gate_proj.weight", ffn, dim, 0.15, 0.0)
        put(w, r, p + "mlp.up_proj.weight", ffn, dim, 0.15, 0.0)
        put(w, r, p + "mlp.down_proj.weight", dim, ffn, 0.1, 0.0)
        put(w, r, p + "input_layernorm.weight", 1, dim, 0.1, 1.0)
        put(w, r, p + "post_attention_layernorm.weight", 1, dim, 0.1, 1.0)
    }
    w.Save(dir + "/model.safetensors")!
    return dir
}

# a random tensor of rows x cols (a vector where rows is 1), each element base + scale N(0, 1), into w in BF16
fn put(w mut checkpoint.Writer&, r mut rand.Rand&, name String&, rows I64, cols I64, scale F64, base F64) {
    vals := Array<F32>[F32(base + scale * r.Normal()) for _ in range rows * cols]
    t := tensor.Tensor<F32>.Of(vals, rows, cols)! if rows > 1 else tensor.Tensor<F32>.Of(vals, cols)!
    w.AddAs(name, t, checkpoint.Dtype.BF16)!
}

# the logits of decoding toks a token a step (after the first), in a cache of its own: 8-bit keys and values or not
fn decode(m Model&, toks Array<I32>&, kv8 Bool) Array<F32> {
    k := Cache(m.C, 8, 1, 8, Kv8 = kv8)
    for i in range 8: k.Table[i] = k.Take()
    s := State(m, 1, 1, 512)
    got := Array<F32>(toks.Len() * m.C.Vocab)
    for i, t in toks {
        s.Reset()
        s.Add(t, I64(i), 0, true)
        m.Step(s, k)
        for v in range m.C.Vocab: got[i * m.C.Vocab + v] = s.Logits[v]
    }
    return got
}

# a cache with pages for "slots" sequences of up to 256 positions, its pages handed out in a scattered order
fn Cache.scattered(m Model&, slots I64, exact Bool) Cache {
    k := Cache(m.C, slots * 4 + 3, slots, 4, exact)
    k.Take()
    for i in range slots * 4: k.Table[(i * 5) % (slots * 4)] = k.Take()
    return k
}

# the logits of a prompt's every position, all at once, in a cache of its own
fn prefill(m Model&, toks Array<I32>&, exact Bool) Array<F32> {
    k := Cache.scattered(m, 1, exact)
    s := State(m, toks.Len(), toks.Len(), 256)
    for i, t in toks: s.Add(t, I64(i), 0, true)
    m.Step(s, k)
    return s.Logits[:toks.Len() * m.C.Vocab].Copy()
}

fn tokens(n I64, seed U64) Array<I32> {
    r := rand.Rand(seed)
    return Array<I32>[I32(r.Below(96)) for _ in range n]
}

fn worst(a Array<F32>&, b Array<F32>&) F64 {
    w F64 = 0.0
    for i in range a.Len(): w = w.Max((F64(a[i]) - F64(b[i])).Abs())
    return w
}

fn biggest(a Array<F32>&) F64 {
    w F64 = 0.0
    for x in a: w = w.Max(F64(x).Abs())
    return w
}

test Model "loads Qwen2's and Qwen3's checkpoints: the AMX path's logits are the exact path's to BF16's rounding" {
    for qwen3 in [false, true] {
        dir := Tiny(qwen3, 3)
        exact := Model.Load(dir, true)!
        fast := Model.Load(dir)!
        assert exact.C.QkNorm == qwen3 and exact.C.Bias == not qwen3 and exact.C.Tied == qwen3
        assert not exact.Tile and fast.Tile == TargetHasTileDot
        toks := tokens(70, 5)
        a := prefill(exact, toks, true)
        b := prefill(fast, toks, false)
        assert biggest(a) > 1.0
        assert worst(a, b) < 0.03 * biggest(a), "qwen3 " + $qwen3 + ": " + $worst(a, b) + " of " + $biggest(a)
        os.RemoveAll(dir)!
    }
}

test Model "8-bit weights, a scale per 32 inputs: the logits within a few percent of the BF16 weights' (where AMX runs them)" {
    dir := Tiny(false, 13)
    bf := Model.Load(dir)!
    q := Model.Load(dir, false, true)!
    assert q.Int8 == TargetHasTileDot and q.Bytes() < bf.Bytes() * 7 / 10 or not TargetHasTileDot
    toks := tokens(40, 3)
    a := prefill(bf, toks, false)
    b := prefill(q, toks, false)
    assert worst(a, b) < 0.06 * biggest(a), $worst(a, b) + " of " + $biggest(a)
    os.RemoveAll(dir)!
}

test Model "decoding through the cache a token a step gives the logits of reading the prompt at once, over three pages" {
    dir := Tiny(true, 7)
    for exact in [true, false] {
        m := Model.Load(dir, exact)!
        toks := tokens(150, 9)
        want := prefill(m, toks, exact)
        k := Cache.scattered(m, 1, exact)
        s := State(m, 1, 1, 256)
        got := Array<F32>(toks.Len() * m.C.Vocab)
        for i, t in toks {
            s.Reset()
            s.Add(t, I64(i), 0, true)
            m.Step(s, k)
            for v in range m.C.Vocab: got[i * m.C.Vocab + v] = s.Logits[v]
        }
        assert worst(want, got) < (1e-4 if exact else 0.01) * biggest(want), "exact " + $exact + ": " + $worst(want, got)
    }
    os.RemoveAll(dir)!
}

test Model "attention split into runs of pages over the tasks gives the logits of one run, to rounding, the same tokens" {
    dir := Tiny(true, 17)
    m := Model.Load(dir)!
    toks := tokens(300, 4)
    ChunkPages = 64
    whole := decode(m, toks, false)
    ChunkPages = 1
    split := decode(m, toks, false)
    ChunkPages = 16
    assert worst(whole, split) < 0.01 * biggest(whole), $worst(whole, split)
    v := m.C.Vocab
    for i in range toks.Len() {
        a, b := I64(0), I64(0)
        for x in range v {
            if whole[i * v + x] > whole[i * v + a]: a = x
            if split[i * v + x] > split[i * v + b]: b = x
        }
        assert a == b, "position " + $i
    }
    os.RemoveAll(dir)!
}

test Model "8-bit values, a scale per position and head: the logits within a few percent of BF16's" {
    dir := Tiny(false, 19)
    toks := tokens(200, 6)
    # the AMX path where the target has it, and the F32 one (a target without AMX)
    for exact in [false, true] {
        m := Model.Load(dir, exact)!
        a := decode(m, toks, false)
        b := decode(m, toks, true)
        assert worst(a, b) < 0.05 * biggest(a), "exact " + $exact + ": " + $worst(a, b) + " of " + $biggest(a)
        assert PageBytes(m.C, true) * 10 < PageBytes(m.C) * 8
    }
    os.RemoveAll(dir)!
}

test Model "a row's logits do not depend on the other rows of its step: two sequences at once are each alone, bit for bit" {
    dir := Tiny(false, 11)
    m := Model.Load(dir)!
    a := tokens(40, 1)
    b := tokens(25, 2)
    alone := prefill(m, a, false)
    k := Cache.scattered(m, 2, false)
    s := State(m, 65, 65, 256)
    for i in range 40 {
        s.Add(a[i], I64(i), 1, true)
        if i < 25: s.Add(b[i], I64(i), 0, false)
    }
    m.Step(s, k)
    for i in range 40 {
        for v in range m.C.Vocab: assert s.Logits[i * m.C.Vocab + v] == alone[i * m.C.Vocab + v], "row " + $i
    }
    os.RemoveAll(dir)!
}

test Config "reads the Llama, Mistral, Granite and SmolLM3 configs: rope scaling, multipliers, windows, layers without rotation" {
    c := Config.Parse("{\"model_type\": \"llama\", \"vocab_size\": 96, \"hidden_size\": 64, \"num_hidden_layers\": 2, \"num_attention_heads\": 2, " +
        "\"intermediate_size\": 64, \"rope_theta\": 500000.0, \"rope_scaling\": {\"rope_type\": \"llama3\", \"factor\": 32.0, " +
        "\"low_freq_factor\": 1.0, \"high_freq_factor\": 4.0, \"original_max_position_embeddings\": 8192}}")!
    assert c.Rope == "llama3" and c.RopeFactor == 32.0 and c.RopeOld == 8192 and not c.Bias and not c.QkNorm
    f := c.Freqs()
    assert f[0] == 1.0 and f[f.Len() - 1] < 500000.0.Pow(-2.0 * F64(f.Len() - 1) / 32.0) / 31.0
    y := Config.Parse("{\"model_type\": \"qwen3\", \"vocab_size\": 96, \"hidden_size\": 64, \"num_hidden_layers\": 2, \"num_attention_heads\": 2, " +
        "\"intermediate_size\": 64, \"rope_scaling\": {\"rope_type\": \"yarn\", \"factor\": 4.0, \"original_max_position_embeddings\": 32768}, " +
        "\"sliding_window\": 4096, \"use_sliding_window\": false}")!
    assert y.Rope == "yarn" and (y.RopeAttn - (0.1 * 4.0.Log() + 1.0)).Abs() < 1e-12 and y.Window.Len() == 0
    g := Config.Parse("{\"model_type\": \"granite\", \"vocab_size\": 96, \"hidden_size\": 64, \"num_hidden_layers\": 2, \"num_attention_heads\": 2, " +
        "\"intermediate_size\": 64, \"embedding_multiplier\": 12.0, \"residual_multiplier\": 0.22, \"attention_multiplier\": 0.0078125, \"logits_scaling\": 8.0}")!
    assert g.EmbedScale == 12.0 and g.ResScale == 0.22 and g.Scale() == 0.0078125 and g.LogitScale == 8.0
    m := Config.Parse("{\"model_type\": \"mistral\", \"vocab_size\": 96, \"hidden_size\": 64, \"num_hidden_layers\": 2, \"num_attention_heads\": 2, " +
        "\"intermediate_size\": 64, \"sliding_window\": 4096}")!
    assert m.WindowOf(0) == 4096 and m.WindowOf(1) == 4096
    n := Config.Parse("{\"model_type\": \"smollm3\", \"vocab_size\": 96, \"hidden_size\": 64, \"num_hidden_layers\": 4, \"num_attention_heads\": 2, " +
        "\"intermediate_size\": 64, \"no_rope_layers\": [1, 1, 1, 0]}")!
    assert n.Rotates(0) and not n.Rotates(3)
    bad := try Config.Parse("{\"model_type\": \"gpt_neox\", \"vocab_size\": 96}") catch default Config()
    assert bad.Arch == ""
}

test Model "a sliding window: decoding a token a step and in runs of one page give the logits of reading the prompt at once" {
    dir := TinyArch("mistral", ", \"sliding_window\": 100", 23)
    whole := TinyArch("mistral", "", 23)
    for exact in [true, false] {
        m := Model.Load(dir, exact)!
        full := Model.Load(whole, exact)!
        assert m.C.WindowOf(2) == 100
        toks := tokens(250, 8)
        want := prefill(m, toks, exact)
        other := prefill(full, toks, exact)
        v := m.C.Vocab
        # the same until the window first leaves a position out, different after
        assert worst(want[:100 * v], other[:100 * v]) < 1e-5 * biggest(want) and worst(want[200 * v:], other[200 * v:]) > 0.01 * biggest(want)
        ChunkPages = 1
        got := decode(m, toks, false) if not exact else want
        ChunkPages = 16
        assert worst(want, got) < 0.01 * biggest(want), "exact " + $exact + ": " + $worst(want, got)
    }
    os.RemoveAll(dir)!
    os.RemoveAll(whole)!
}

# the directory of a Hugging Face model under $OANN_MODELS, "" where it is not there
fn reference(name String&) String {
    root :~ try os.Env("OANN_MODELS") catch default ""
    dir := root + "/" + name
    return dir if root.Len() > 0 and os.Exists(dir + "/config.json") else ""
}

# greedy tokens after a prompt, and the last position's logits at four ids
fn greedy(m Model&, prompt Array<I32>&, n I64) Array<I32>, Array<F32> {
    k := Cache(m.C, 8, 1, 8, not m.Tile)
    for i in range 8: k.Table[i] = k.Take()
    s := State(m, prompt.Len(), prompt.Len(), 256)
    for i, t in prompt: s.Add(t, I64(i), 0, true)
    m.Step(s, k)
    v := m.C.Vocab
    lg :~ s.LogitsOf(prompt.Len() - 1, v)
    seen := Array<F32>[lg[12095], lg[0], lg[1], lg[100]]
    out := Array<I32>(n)
    for j in range n {
        best I64 = 0
        lg2 :~ s.LogitsOf(s.NOut - 1, v)
        for x in range v {
            if lg2[x] > lg2[best]: best = x
        }
        out[j] = I32(best)
        s.Reset()
        s.Add(I32(best), I64(prompt.Len() + j), 0, true)
        m.Step(s, k)
    }
    return out, seen
}

# Hugging Face transformers 5 in F32 (torch 2, CPU) on "The capital of France is" (785 6722 315 9625 374): the logits
# of the last position at ids 12095 (" Paris"), 0, 1 and 100, and the greedy continuation
test Model "matches the reference implementation on Qwen3-0.6B and DeepSeek-R1-Distill-Qwen-1.5B, where $OANN_MODELS has them" {
    prompt := Array<I32>[785, 6722, 315, 9625, 374]
    for which in range 2 {
        dir := reference("Qwen--Qwen3-0.6B" if which == 0 else "deepseek-ai--DeepSeek-R1-Distill-Qwen-1.5B")
        if dir.Len() == 0: continue
        want := Array<F64>[17.49884796142578, 5.13115119934082, 8.212902069091797, -1.2866663932800293] if which == 0 else
            Array<F64>[11.376786231994629, -0.4765464663505554, 2.3971149921417236, -6.262055397033691]
        cont := Array<I32>[12095, 13, 576, 6722, 315, 15344, 374, 21718, 13, 576] if which == 0 else
            Array<I32>[12095, 11, 323, 279, 6722, 315, 9856, 374, 19846, 13]
        exact := Model.Load(dir, true)!
        toks, seen := greedy(exact, prompt, 10)
        assert toks == cont, dir + ": " + $toks
        for i in range 4: assert (F64(seen[i]) - want[i]).Abs() < 1e-3, dir + ": logit " + $i + " is " + $seen[i] + ", not " + $want[i]
        fast := Model.Load(dir)!
        toks2, seen2 := greedy(fast, prompt, 10)
        assert toks2 == cont, dir + " (AMX): " + $toks2
        for i in range 4: assert (F64(seen2[i]) - want[i]).Abs() < 0.3, dir + " (AMX): logit " + $i + " is " + $seen2[i]
    }
}

# llm/tools/reference.py's small models (Hugging Face transformers, F32): the logits of every position of 150 tokens
test Model "matches transformers on small models of each architecture and option, where $OANN_MODELS has them (llm/tools/reference.py)" {
    for name in ["llama3", "yarn", "granite", "smollm3", "mistral", "qwen3moe", "granitemoe", "olmoe", "gemma3", "phi3"] {
        dir := reference("oann-tiny-" + name)
        if dir.Len() == 0 or not os.Exists(dir + "/ref.json"): continue
        j :~ json.Json.Parse(os.ReadFile(dir + "/ref.json")!)!
        tj :~ j["tokens"]!.AsArr()!
        lj :~ j["logits"]!.AsArr()!
        toks := Array<I32>[I32(t.AsInt()!) for t in tj]
        want := Array<F32>[F32(x.AsNum()!) for x in lj]
        for exact in [true, false] {
            m := Model.Load(dir, exact)!
            got := prefill(m, toks, exact)
            if exact {
                assert worst(want, got) < 1e-4 * biggest(want), name + ": " + $worst(want, got) + " of " + $biggest(want)
                continue
            }
            # BF16 activations: a mixture's router may pick another expert at a near tie, so the AMX path is held to
            # the mean difference and the greedy token at nearly every position (random small models have many near
            # ties: Gemma's, 140 of 150)
            v := m.C.Vocab
            same I64 = 0
            diff F64 = 0.0
            for i in range toks.Len() {
                a, b := I64(0), I64(0)
                for x in range v {
                    if want[i * v + x] > want[i * v + a]: a = x
                    if got[i * v + x] > got[i * v + b]: b = x
                    diff += (F64(want[i * v + x]) - F64(got[i * v + x])).Abs()
                }
                if a == b: same++
            }
            mean := diff / F64(want.Len())
            assert mean < 0.01 * biggest(want) and same * 100 >= 90 * toks.Len(), name + " (AMX): mean " + $mean + ", argmax same at " + $same
        }
    }
}

# real checkpoints with a ref.json of llm/tools/reference.py --real (transformers, F32): the last position's logits
# over the whole vocabulary and ten greedy tokens
test Model "matches transformers on SmolLM2, Llama 3.2, Granite 3.3 and Granite 3.1 1B-A400M (experts) checkpoints, where $OANN_MODELS has them" {
    for name in ["HuggingFaceTB--SmolLM2-135M-Instruct", "unsloth--Llama-3.2-1B-Instruct", "ibm-granite--granite-3.3-2b-instruct", "ibm-granite--granite-3.1-1b-a400m-instruct", "unsloth--gemma-3-270m-it", "unsloth--gemma-3-1b-it"] {
        dir := reference(name)
        if dir.Len() == 0 or not os.Exists(dir + "/ref.json"): continue
        j :~ json.Json.Parse(os.ReadFile(dir + "/ref.json")!)!
        prompt := Array<I32>[I32(t.AsInt()!) for t in j["tokens"]!.AsArr()!]
        last := Array<F32>[F32(x.AsNum()!) for x in j["last"]!.AsArr()!]
        cont := Array<I32>[I32(t.AsInt()!) for t in j["greedy"]!.AsArr()!]
        for exact in [true, false] {
            m := Model.Load(dir, exact)!
            k := Cache(m.C, 8, 1, 8, exact)
            for i in range 8: k.Table[i] = k.Take()
            s := State(m, prompt.Len(), prompt.Len(), 256)
            for i, t in prompt: s.Add(t, I64(i), 0, true)
            m.Step(s, k)
            lg :~ s.LogitsOf(prompt.Len() - 1, m.C.Vocab)
            if exact: assert worst(last, lg) < 1e-3 * biggest(last), name + ": " + $worst(last, lg) + " of " + $biggest(last)
            toks, _ := greedy(m, prompt, 10)
            # Granite's sixth token is a near tie (14.567 and 14.555; transformers in BF16 takes the other): the AMX
            # path is held to the first five
            n := 10 if exact else 5
            assert toks[:n] == cont[:n], name + " exact " + $exact + ": " + $toks + ", not " + $cont
        }
    }
}

# GGUF files under $OANN_MODELS/gguf with a FILE.ref.json of llm/tools/ggufref.py (transformers reading the file,
# dequantized to F32): the weights here are the dequantized ones rounded to BF16, so the logits are held to a mean
# difference of 1% of the largest and the greedy tokens to the first five
test Model "loads GGUF files (Q8_0, Q4_0, Q4_1, the k-quants): the logits and greedy tokens of transformers reading them, where $OANN_MODELS/gguf has them" {
    root :~ try os.Env("OANN_MODELS") catch default ""
    if root.Len() == 0 or not os.Exists(root + "/gguf"): return
    for name in os.ReadDir(root + "/gguf")! {
        path := root + "/gguf/" + name
        if not name.EndsWith(".gguf") or not os.Exists(path + ".ref.json"): continue
        j :~ json.Json.Parse(os.ReadFile(path + ".ref.json")!)!
        prompt := Array<I32>[I32(t.AsInt()!) for t in j["tokens"]!.AsArr()!]
        last := Array<F32>[F32(x.AsNum()!) for x in j["last"]!.AsArr()!]
        cont := Array<I32>[I32(t.AsInt()!) for t in j["greedy"]!.AsArr()!]
        for exact in [true, false] {
            m := Model.Load(path, exact)!
            toks, _ := greedy(m, prompt, 5)
            k := Cache(m.C, 8, 1, 8, exact)
            for i in range 8: k.Table[i] = k.Take()
            s := State(m, prompt.Len(), prompt.Len(), 256)
            for i, t in prompt: s.Add(t, I64(i), 0, true)
            m.Step(s, k)
            lg :~ s.LogitsOf(prompt.Len() - 1, m.C.Vocab)
            diff F64 = 0.0
            for i in range last.Len(): diff += F64((lg[i] - last[i]).Abs())
            mean := diff / F64(last.Len())
            assert mean < 0.01 * biggest(last), name + " exact " + $exact + ": mean " + $mean + " of " + $biggest(last) + ", worst " + $worst(last, lg)
            assert toks == cont[:5], name + " exact " + $exact + ": " + $toks + ", not " + $cont
        }
    }
}

# 4-bit weights against transformers' F32 logits on the real checkpoints and GGUF files under $OANN_MODELS: the mean
# difference within 10% of the largest logit (SmolLM2-135M: 8%, as PyTorch quantizing it the same way gives) and the
# first greedy token the same, or the reference's within 1 of it (4 bits a weight move near ties)
test Model "4-bit weights: the logits near transformers' and the first greedy token the same, where $OANN_MODELS has the checkpoints" {
    if not TargetHasTileDot: return
    root :~ try os.Env("OANN_MODELS") catch default ""
    if root.Len() == 0: return
    paths := Vec<String>()
    for name in ["HuggingFaceTB--SmolLM2-135M-Instruct", "unsloth--Llama-3.2-1B-Instruct", "ibm-granite--granite-3.3-2b-instruct", "ibm-granite--granite-3.1-1b-a400m-instruct", "unsloth--gemma-3-1b-it"] {
        if os.Exists(root + "/" + name + "/ref.json"): paths.Push(root + "/" + name)
    }
    for name in ["Qwen3-0.6B-Q4_K_M.gguf", "Llama-3.2-1B-Instruct-Q4_K_M.gguf"] {
        if os.Exists(root + "/gguf/" + name + ".ref.json"): paths.Push(root + "/gguf/" + name)
    }
    for path in paths.View() {
        refPath := path + (".ref.json" if path.EndsWith(".gguf") else "/ref.json")
        j :~ json.Json.Parse(os.ReadFile(refPath)!)!
        prompt := Array<I32>[I32(t.AsInt()!) for t in j["tokens"]!.AsArr()!]
        last := Array<F32>[F32(x.AsNum()!) for x in j["last"]!.AsArr()!]
        cont := Array<I32>[I32(t.AsInt()!) for t in j["greedy"]!.AsArr()!]
        m := Model.Load(path, false, false, true)!
        assert m.Int4
        k := Cache(m.C, 8, 1, 8)
        for i in range 8: k.Table[i] = k.Take()
        s := State(m, prompt.Len(), prompt.Len(), 256)
        for i, t in prompt: s.Add(t, I64(i), 0, true)
        m.Step(s, k)
        lg :~ s.LogitsOf(prompt.Len() - 1, m.C.Vocab)
        diff F64 = 0.0
        for i in range last.Len(): diff += F64((lg[i] - last[i]).Abs())
        mean := diff / F64(last.Len())
        toks, _ := greedy(m, prompt, 3)
        # Gemma 3 1B's answer is a near tie in 4 bits: PyTorch with the same weights and 8-bit activations has it at
        # 18.67 against 18.16 for another (13.46 in F32); the reference's token is held to within 1 of the top
        assert mean < 0.1 * biggest(last) and (toks[0] == cont[0] or lg[I64(cont[0])] > lg[I64(toks[0])] - 1.0), path + ": mean " + $mean + " of " + $biggest(last) + ", " + $toks + ", not " + $cont
    }
}

# 4-bit weights' products: byte dots (one row, a few) and the widened AddDot against the weights read one by one (Get),
# activations with outliers
test Linear "4-bit products by byte dots and by widening agree with the weights read one by one" {
    if not TargetHasTileDot: return
    r := rand.Rand(7)
    for shape in [[1152, 64], [6912, 32], [256, 48]] {
        w := Linear(shape[0], shape[1], 16, true, Int4 = true)
        row := Array<F32>(w.In)
        for o in range w.Out {
            for i in range w.In: row[i] = F32(r.Normal() * 0.05 + (0.02 if o % 3 == 0 else 0.0))
            for g0 in range 0, w.In, 32: w.put4(o, g0, row, g0)
        }
        for rows in [1, 5, 20] {
            rp := roundUp(rows, 16)
            x := Array<BF16>(rp * w.In)
            xf := Array<F32>(rows * w.In)
            for i in range rows * w.In {
                v := r.Normal() * (40.0 if i % 97 == 0 else 1.0)
                x[i] = BF16(v)
                xf[i] = F32(x[i])
            }
            dst := Array<F32>(rp * w.Out)
            deq := Array<BF16>(w.In * 64)
            sc := Array<F32>(256 + 2 * Gemv4 * w.In / 32)
            qx := Array<U8>(Gemv4 * w.In)
            mmBlocks(dst, x, w, rp, 0, w.Out / w.Nb, deq, sc, qx, rows)
            for k in range rows {
                for o in range w.Out {
                    want F64 = 0.0
                    size F64 = 0.0
                    for i in range w.In {
                        want += F64(xf[k * w.In + i]) * F64(w.Get(o, i))
                        size += (F64(xf[k * w.In + i]) * F64(w.Get(o, i))).Abs()
                    }
                    got := F64(dst[k * w.Out + o])
                    assert (got - want).Abs() < 0.02 * size + 1e-3, $shape + " rows " + $rows + " (" + $k + ", " + $o + "): " + $got + ", not " + $want
                }
            }
        }
    }
}
