# llm/gen - oann-gen, completions of many prompts by an open-weight model, as one long job:
#
#     oann-gen MODEL prompts.jsonl out.jsonl [--n K] [--temp T] [--top-p P] [--top-k K] [--max-tokens M] [--batch B]
#              [--ctx C] [--seed S] [--system TEXT] [--no-think] [--kv-gb G] [--int8] [--int4] [--kv8] [--exact]
#              [--device gpu|vulkan]
#
# MODEL is a directory holding a Hugging Face checkpoint (config.json, tokenizer.json, model.safetensors or its shards),
# a GGUF file (llm/gguf: its weights widened to BF16, or requantized to INT8, as they load),
# or a repository's name ("Qwen/Qwen3-4B"), fetched once into $OANN_MODELS (by default ~/.cache/oann/models). Each line
# of prompts.jsonl is an object: "prompt" (one user turn, put through the model's chat template, with "system" if
# given) or "text" (read as it is), and an "id" (the line's number where it has none). K completions of each are
# written to out.jsonl as they finish, a line each:
#     {"id": ..., "sample": k, "text": "<think>...</think>...", "prompt_tokens": n, "tokens": m, "finish": "stop"}
# finish is "stop" (a stop token) or "length" (--max-tokens, or the context). A vision-language model's line (Gemma 3)
# may name image files (PNG or JPEG): "image" (a path) or "images" (a list of paths), seen by llm/vision. A "prompt"
# gets the images before its text, as the chat template puts an image part before a text part; a "text" places each
# where it writes <start_of_image>. The job resumes: completions already in
# out.jsonl are not made again, and each completion draws from a generator seeded by --seed, its id and its sample,
# so a resumed job writes what an uninterrupted one would. Sampling defaults are the model's generation_config.json.
# Progress goes to standard error.
#
# --device gpu runs the model on the CUDA device (llm/gpu: the weights in BF16 and the cache on the device, sampling
# here), where oann-gen was built with -define Gpu=true (make oanngen does where the CUDA toolkit is installed). The
# cache takes the device's memory left after the weights, less 1.5 GB for the display and the step's buffers; --kv-gb
# says otherwise.
#
# --device vulkan runs it on any GPU with a Vulkan driver - AMD, Intel, NVIDIA, an integrated one (llm/vk: the same
# split), where oann-gen was built with -define Vulkan=true (make oanngen does where Vulkan's headers are, libvulkan-dev).
# OANN_VK_DEVICE=N picks one of several devices. The cache takes the device's memory left after the weights, less 1 GB.

import "std/flags"
import "std/io"
import "std/json"
import "std/os"
import "std/time"
import "bpe"
import "chat"
import "engine"
import "gguf"
import "model"
import "vision"

Gpu Bool = false

if Gpu {
    import "gpu"
    import gdev "../kernels/gpu/device"

    theDev mut gdev.Device?& = null
    theDec mut gpu.Decoder?& = null

    # the device opened, for m: the bytes of its memory left for the cache
    fn gpuOpen(m model.Model&) I64 {
        why := gpu.Refusal(m)
        if why != "": fail("--device gpu does not run this model: " + why)
        theDev ~ try gdev.Device.Open() catch e { fail("--device gpu: " + $e) }
        say("device: " + theDev!.Str() + ", weights " + $(gpu.WeightBytes(m) / 1048576) + " MB")
        return theDev!.MiB * 1048576 - gpu.WeightBytes(m) - 1536 * 1048576
    }

    # m on the device, for e's steps
    fn gpuLoad(m model.Model&, e engine.Engine&, maxCtx I64) {
        t0 := time.Now()
        theDec ~ try gpu.Decoder.Make(theDev!, m, e.State.Rows, e.Batch, e.Cache, maxCtx) catch err { fail("--device gpu: " + $err + " (a smaller --kv-gb, --batch or --ctx may fit)") }
        say("on the device: " + $(theDec!.Bytes / 1048576) + " MB, " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    }

    fn gpuStep(m model.Model&, e mut engine.Engine&) {
        try theDec!.Step(m, e.State, e.Cache) catch err { fail("--device gpu: " + $err) }
    }
} else {
    fn gpuOpen(m model.Model&) I64 { fail("--device gpu: this oann-gen was built without the GPU (build it with -define Gpu=true: make oanngen where the CUDA toolkit is installed)") }
    fn gpuLoad(m model.Model&, e engine.Engine&, maxCtx I64) { }
    fn gpuStep(m model.Model&, e mut engine.Engine&) { }
}

Vulkan Bool = false

if Vulkan {
    import "vk"
    import vdev "../kernels/vk/device"

    vkDev mut vdev.Device?& = null
    vkDec mut vk.Decoder?& = null

    # the Vulkan device opened, for m: the bytes of its memory left for the cache
    fn vkOpen(m model.Model&) I64 {
        why := vk.Refusal(m)
        if why != "": fail("--device vulkan does not run this model: " + why)
        vkDev ~ try vdev.Device.Open() catch e { fail("--device vulkan: " + $e + " (no Vulkan driver here?)") }
        say("device: " + vkDev!.Str() + ", weights " + $(vk.WeightBytes(m) / 1048576) + " MB")
        # (a layer's keys are one buffer, its values another: no more pages than one buffer of the device binds)
        return (vkDev!.MiB * 1048576 - vk.WeightBytes(m) - 1024 * 1048576).Min(vkDev!.MaxBufMiB * 1048576 * 2 * m.C.Layers)
    }

    # m on the device, for e's steps
    fn vkLoad(m model.Model&, e engine.Engine&, maxCtx I64) {
        t0 := time.Now()
        vkDec ~ try vk.Decoder.Make(vkDev!, m, e.State.Rows, e.Batch, e.Cache, maxCtx) catch err { fail("--device vulkan: " + $err + " (a smaller --kv-gb, --batch or --ctx may fit)") }
        say("on the device: " + $(vkDec!.Bytes / 1048576) + " MB, " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    }

    fn vkStep(m model.Model&, e mut engine.Engine&) {
        try vkDec!.Step(m, e.State, e.Cache) catch err { fail("--device vulkan: " + $err) }
    }
} else {
    fn vkOpen(m model.Model&) I64 { fail("--device vulkan: this oann-gen was built without Vulkan (build it with -define Vulkan=true: make oanngen where Vulkan's headers are, libvulkan-dev)") }
    fn vkLoad(m model.Model&, e engine.Engine&, maxCtx I64) { }
    fn vkStep(m model.Model&, e mut engine.Engine&) { }
}

type job struct(id String&, sample I64, prompt Array<I32>&, images Array<F32>&) {
    id                  # the id as JSON text
    sample
    prompt
    images              # the embeddings of the prompt's image tokens (empty without images)
}

# FNV-1a of text
fn hash(t String&) U64 {
    h U64 = 0xcbf29ce484222325
    for c in t {
        h = (h ^ U64(U8(c))) * 0x100000001b3
    }
    return h
}

fn mix(x U64) U64 {
    z := x + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    return z ^ (z >> 31)
}

# MemAvailable in bytes (0 if unknown)
fn available() I64 {
    text :~ try os.ReadFile("/proc/meminfo") catch default ""
    for line in text.Lines() {
        if not line.StartsWith("MemAvailable:"): continue
        kb := try line[13:].Trim().Split(" ")[0].ParseInt() catch default 0
        return kb * 1024
    }
    return 0
}

# the peak resident memory in MB (VmHWM)
fn peak() I64 {
    status :~ try os.ReadFile("/proc/self/status") catch default ""
    for line in status.Lines() {
        if not line.StartsWith("VmHWM:"): continue
        return (try line[6:].Trim().Split(" ")[0].ParseInt() catch default 0) / 1024
    }
    return 0
}

fn fail(msg String&) noreturn {
    try io.PutErrLn("oann-gen: " + msg) catch { }
    os.Exit(1)
}

fn say(msg String&) { try io.PutErrLn("oann-gen: " + msg) catch { } }

# the model's directory: MODEL itself, or the repository fetched
fn modelDir(name String&) String {
    if os.IsDir(name) or (name.EndsWith(".gguf") and os.Exists(name)): return name
    if not name.Contains("/"): fail("no model directory " + name)
    root :~ try os.Env("OANN_MODELS") catch default ""
    if root.Len() == 0: root ~ (try os.Env("HOME") catch default "/tmp") + "/.cache/oann/models"
    dir := root + "/" + name.Replace("/", "--")
    try chat.Fetch(name, dir) catch { fail("could not fetch " + name + " from Hugging Face") }
    return dir
}

# the tokenizer of a model directory, or of a GGUF file's metadata
fn tokenizer(dir String&) bpe.Bpe ? bpe.BpeError, json.Error, os.Error, gguf.GgufError {
    if not dir.EndsWith(".gguf"): return try bpe.Bpe.Load(dir + "/tokenizer.json")
    return try bpe.Bpe.Parse(try (try gguf.File.Open(dir)).TokenizerJson())
}

# the image paths of a prompts.jsonl line: "image" or "images"
fn imagePaths(j json.Json&, where String&) Vec<String> {
    out := Vec<String>()
    if j.Has("image") {
        out.Push(try (try j["image"] catch { fail(where + ": image") }).AsStr() catch { fail(where + ": image is not a string") })
    }
    if not j.Has("images"): return out
    list :~ try (try j["images"] catch { fail(where + ": images") }).AsArr() catch { fail(where + ": images is not a list") }
    for x in list: out.Push(try x.AsStr() catch { fail(where + ": an image is not a string") })
    return out
}

# the embeddings of the images at paths, one after another
fn embedImages(v vision.Vision&, e mut vision.Seeing&, c model.Config&, paths Vec<String>&, where String&) Array<F32> {
    per := c.ImageTokens * c.Dim
    out := Array<F32>(paths.Len() * per)
    for i, path in paths {
        rgb, w, h := try vision.ReadRgb(path) catch { fail(where + ": cannot read the image " + path) }
        one := Array<F32>(per)
        v.Embed(e, v.Pixels(rgb, w, h), one)
        for x in range per: out[i * per + x] = one[x]
    }
    return out
}

fn main() {
    p := flags.Flags("oann-gen", "completions of prompts.jsonl by MODEL, written to out.jsonl as they finish")
    n := p.Int("n", 'n', 1, "completions of each prompt")
    temp := p.Float("temp", 't', -1.0, "temperature (0: greedy; default the model's)")
    topP := p.Float("top-p", 0, -1.0, "nucleus mass kept (default the model's)")
    topK := p.Int("top-k", 0, -1, "most likely tokens kept, 0 all (default the model's)")
    maxNew := p.Int("max-tokens", 'm', 4096, "tokens a completion may have")
    batch := p.Int("batch", 'b', 64, "sequences decoded at once")
    ctx := p.Int("ctx", 0, 0, "positions a sequence may have (default: the longest prompt and --max-tokens)")
    seed := p.Int("seed", 0, 1, "seed of every completion's generator")
    system := p.Text("system", 0, "", "system prompt")
    noThink := p.Bool("no-think", 0, "Qwen3: answer without thinking")
    kvGb := p.Float("kv-gb", 0, 0.0, "memory for the key-value cache (default: most of what is free)")
    exact := p.Bool("exact", 0, "F32 activations and cache (slow; to check against a reference)")
    kv8 := p.Bool("kv8", 0, "keys and values in 8 bits, a scale per position and head: about half the cache (AMX)")
    int8 := p.Bool("int8", 0, "8-bit weights, a scale per 32 inputs (the head stays BF16): about 0.56 of the memory; needs AMX")
    int4 := p.Bool("int4", 0, "4-bit weights, a scale per 32 inputs (the head stays BF16): about a third of the memory, faster decoding; needs AMX")
    deviceName := p.Text("device", 0, "cpu", "cpu; gpu: the model on the CUDA device (BF16; a build with -define Gpu=true); vulkan: on any GPU with a Vulkan driver (BF16; a build with -define Vulkan=true)")
    try p.Parse(os.Args()) catch flags.Error.Help {
        try io.Put(p.Help()) catch { }
        return
    } catch flags.Error {
        fail(p.Message())
    }
    args := p.Args()
    if args.Len() != 3: fail("usage: oann-gen MODEL prompts.jsonl out.jsonl [flags] (--help)")
    dir := modelDir(args[0])
    outPath :~ args[2]
    t0 := time.Now()
    tok := try tokenizer(dir) catch { fail("cannot read the tokenizer of " + dir) }
    ch := chat.Chat.Load(dir, tok)
    onGpu := deviceName.Get() == "gpu"
    onVk := deviceName.Get() == "vulkan"
    onDev := onGpu or onVk
    if not onDev and deviceName.Get() != "cpu": fail("--device is cpu, gpu or vulkan")
    if onDev and (int8.Get() or int4.Get() or kv8.Get() or exact.Get()): fail("--device " + deviceName.Get() + " runs BF16 alone: not with --int8, --int4, --kv8 or --exact")
    # (the device reads the weights row-major: loaded as --exact loads them, without AMX's packing)
    m := try model.Model.Load(dir, exact.Get() or onDev, int8.Get(), int4.Get()) catch { fail("cannot load the model in " + dir) }
    say("loaded " + dir + ": " + $(m.C.Params() / 1000000) + "M parameters, " + $(m.Bytes() / 1048576) + " MB" + (" (INT8)" if m.Int8 else (" (INT4)" if m.Int4 else "")) + ", " +
        ("AMX tiles" if m.Tile else "F32 products") + ", " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    # what is done already
    finished := Map<String, Bool>()
    if os.Exists(outPath) {
        text :~ try os.ReadFile(outPath) catch { fail("cannot read " + outPath) }
        for line in text.Lines() {
            if line.Trim().Len() == 0: continue
            j :~ try json.Json.Parse(line) catch { continue }
            id :~ try j["id"] catch { continue }
            k := try (try j["sample"] catch { continue }).AsInt() catch { continue }
            finished.Put(json.Encode(id) + "#" + $k, true)
        }
    }
    # the eyes, loaded at the first image
    sees := m.C.ImageToken >= 0 and not dir.EndsWith(".gguf")
    eyes := Vec<vision.Vision>()
    seeing := Vec<vision.Seeing>()
    images I64 = 0
    # the jobs
    text :~ try os.ReadFile(args[1]) catch { fail("cannot read " + args[1]) }
    jobs := Vec<job>()
    longest I64 = 0
    skipped I64 = 0
    for li, line in text.Lines() {
        if line.Trim().Len() == 0: continue
        j :~ try json.Json.Parse(line) catch { fail(args[1] + ":" + $(li + 1) + ": not JSON") }
        id :~ json.Encode(try j["id"] catch default json.Json.Num(F64(li)))
        where := args[1] + ":" + $(li + 1)
        paths := imagePaths(j, where)
        if paths.Len() > 0 and not sees: fail(where + ": images, but " + dir + " is not a vision-language model oann reads (Gemma 3)")
        lead := ""
        for _ in paths: lead += "<start_of_image>"
        prompt String& = ""
        if j.Has("text") {
            prompt ~ try (try j["text"] catch { fail("text") }).AsStr() catch { fail(args[1] + ":" + $(li + 1) + ": text is not a string") }
        } else {
            user :~ try (try j["prompt"] catch { fail(args[1] + ":" + $(li + 1) + ": no prompt or text") }).AsStr() catch { fail(args[1] + ":" + $(li + 1) + ": prompt is not a string") }
            sys :~ system.Get()
            if j.Has("system"): sys ~ try (try j["system"] catch { fail("system") }).AsStr() catch { fail("system is not a string") }
            prompt ~ ch.Prompt(lead + user.Trim(), sys, not noThink.Get())
        }
        embeds := Array<F32>(0)
        if paths.Len() > 0 {
            if eyes.Len() == 0 {
                t1 := time.Now()
                eyes.Push(try vision.Vision.Load(dir, exact.Get()) catch { fail("cannot load the vision encoder in " + dir) })
                seeing.Push(vision.Seeing(eyes[0]))
                say("loaded the vision encoder, " + (F64(time.Since(t1)) / 1e9).Fixed(1) + " s")
            }
            embeds = embedImages(eyes[0], seeing.RefMut(0), m.C, paths, where)
            images += paths.Len()
            prompt ~ vision.ImageText(prompt, m.C.ImageTokens)
        }
        ids := tok.Encode(prompt)
        for k in range n.Get() {
            if finished.Has(id + "#" + $k) {
                skipped++
                continue
            }
            jobs.Push(job(id, k, ids, embeds))
            longest = longest.Max(ids.Len())
        }
    }
    if skipped > 0: say($skipped + " completions already in " + outPath)
    if images > 0: say($images + " images seen")
    if jobs.Len() == 0 {
        say("nothing to do")
        return
    }
    maxCtx := ctx.Get() if ctx.Get() > 0 else longest + maxNew.Get()
    maxCtx = maxCtx.Min(m.C.MaxPos)
    budget := (available() - 1073741824) * 9 / 10
    if onGpu: budget = gpuOpen(m)
    if onVk: budget = vkOpen(m)
    if kvGb.Get() > 0.0: budget = I64(kvGb.Get() * 1073741824.0)
    pages := engine.PagesFor(m.C, budget, kv8.Get() and m.Tile).Min(batch.Get() * (maxCtx / model.PageSize + 1))
    if pages < maxCtx / model.PageSize + 1: fail("no room for one sequence of " + $maxCtx + " positions in " + $(budget / 1048576) + " MB")
    e := engine.Engine(m, batch.Get(), maxCtx, pages, Exact = exact.Get(), Kv8 = kv8.Get(), Device = onDev)
    if onGpu: gpuLoad(m, e, maxCtx)
    if onVk: vkLoad(m, e, maxCtx)
    tt := ch.Temp if temp.Get() < 0.0 else temp.Get()
    tp := ch.TopP if topP.Get() < 0.0 else topP.Get()
    tk := ch.TopK if topK.Get() < 0 else topK.Get()
    e.Sampling = engine.Sampler(tt, tp, tk)
    for t in ch.Stops: e.Stops.Push(t)
    say($jobs.Len() + " completions, batch " + $batch.Get() + ", context " + $maxCtx + ", cache " + $pages + " pages (" +
        $(pages * model.PageBytes(m.C, kv8.Get() and m.Tile) / 1048576) + " MB), temperature " + $e.Sampling.Temp + ", top-p " + $e.Sampling.TopP +
        ", top-k " + $e.Sampling.TopK)
    for i, jb in jobs.View() {
        s := mix(U64(seed.Get()) ^ mix(hash(jb.id)) ^ mix(U64(jb.sample) + 0x51ED))
        e.Submit(engine.Request(i, jb.prompt, maxNew.Get(), s, Images = jb.images))
    }
    out := try os.File.Append(outPath) catch { fail("cannot write " + outPath) }
    opening := ch.Opening()
    start := time.Now()
    last := start
    done I64 = 0
    for not e.Idle() {
        if e.Begin() {
            if onGpu: gpuStep(m, e)
            else if onVk: vkStep(m, e)
            else: m.Step(e.State, e.Cache)
        }
        for d in e.End() {
            jb := jobs[d.Id]
            body := try tok.Decode(d.Tokens) catch default ""
            line := "{\"id\": " + jb.id + ", \"sample\": " + $jb.sample + ", \"text\": " + json.Encode(opening + body) +
                ", \"prompt_tokens\": " + $d.PromptLen + ", \"tokens\": " + $d.Tokens.Len() + ", \"finish\": \"" +
                ("stop" if d.Stopped else "length") + "\"}\n"
            try out.Write(line) catch { fail("cannot write " + outPath) }
            done++
        }
        if time.Since(last) > 30000000000 or e.Idle() {
            last = time.Now()
            secs := F64(time.Since(start)) / 1e9
            say($done + "/" + $jobs.Len() + " done, " + $e.Running() + " running, " + $e.Waiting() + " waiting, " +
                $e.Tokens + " tokens in " + secs.Fixed(0) + " s: " + (F64(e.Tokens) / secs).Fixed(1) + " tokens/s, peak " + $peak() + " MB" +
                (", " + $e.Preempted + " preempted" if e.Preempted > 0 else ""))
        }
    }
}
