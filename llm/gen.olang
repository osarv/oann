# llm/gen - oann-gen, completions of many prompts by an open-weight model, as one long job:
#
#     oann-gen MODEL prompts.jsonl out.jsonl [--n K] [--temp T] [--top-p P] [--top-k K] [--max-tokens M] [--batch B]
#              [--ctx C] [--seed S] [--system TEXT] [--no-think] [--kv-gb G] [--int8] [--int4] [--kv8] [--exact]
#
# MODEL is a directory holding a Hugging Face checkpoint (config.json, tokenizer.json, model.safetensors or its shards),
# a GGUF file (llm/gguf: its weights widened to BF16, or requantized to INT8, as they load),
# or a repository's name ("Qwen/Qwen3-4B"), fetched once into $OANN_MODELS (by default ~/.cache/oann/models). Each line
# of prompts.jsonl is an object: "prompt" (one user turn, put through the model's chat template, with "system" if
# given) or "text" (read as it is), and an "id" (the line's number where it has none). K completions of each are
# written to out.jsonl as they finish, a line each:
#     {"id": ..., "sample": k, "text": "<think>...</think>...", "prompt_tokens": n, "tokens": m, "finish": "stop"}
# finish is "stop" (a stop token) or "length" (--max-tokens, or the context). The job resumes: completions already in
# out.jsonl are not made again, and each completion draws from a generator seeded by --seed, its id and its sample,
# so a resumed job writes what an uninterrupted one would. Sampling defaults are the model's generation_config.json.
# Progress goes to standard error.

import "std/flags"
import "std/io"
import "std/json"
import "std/os"
import "std/time"
import "bpe"
import "chat"
import "engine"
import "gguf"
import "model"

type job struct(id String&, sample I64, prompt Array<I32>&) {
    id                  # the id as JSON text
    sample
    prompt
}

# FNV-1a of text
fn hash(t String&) U64 {
    h U64 = 0xcbf29ce484222325
    for c in t {
        h = (h ^ U64(U8(c))) * 0x100000001b3
    }
    return h
}

fn mix(x U64) U64 {
    z := x + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    return z ^ (z >> 31)
}

# MemAvailable in bytes (0 if unknown)
fn available() I64 {
    text :~ try os.ReadFile("/proc/meminfo") catch default ""
    for line in text.Lines() {
        if not line.StartsWith("MemAvailable:"): continue
        kb := try line[13:].Trim().Split(" ")[0].ParseInt() catch default 0
        return kb * 1024
    }
    return 0
}

# the peak resident memory in MB (VmHWM)
fn peak() I64 {
    status :~ try os.ReadFile("/proc/self/status") catch default ""
    for line in status.Lines() {
        if not line.StartsWith("VmHWM:"): continue
        return (try line[6:].Trim().Split(" ")[0].ParseInt() catch default 0) / 1024
    }
    return 0
}

fn fail(msg String&) noreturn {
    try io.PutErrLn("oann-gen: " + msg) catch { }
    os.Exit(1)
}

fn say(msg String&) { try io.PutErrLn("oann-gen: " + msg) catch { } }

# the model's directory: MODEL itself, or the repository fetched
fn modelDir(name String&) String {
    if os.IsDir(name) or (name.EndsWith(".gguf") and os.Exists(name)): return name
    if not name.Contains("/"): fail("no model directory " + name)
    root :~ try os.Env("OANN_MODELS") catch default ""
    if root.Len() == 0: root ~ (try os.Env("HOME") catch default "/tmp") + "/.cache/oann/models"
    dir := root + "/" + name.Replace("/", "--")
    try chat.Fetch(name, dir) catch { fail("could not fetch " + name + " from Hugging Face") }
    return dir
}

# the tokenizer of a model directory, or of a GGUF file's metadata
fn tokenizer(dir String&) bpe.Bpe ? bpe.BpeError, json.Error, os.Error, gguf.GgufError {
    if not dir.EndsWith(".gguf"): return try bpe.Bpe.Load(dir + "/tokenizer.json")
    return try bpe.Bpe.Parse(try (try gguf.File.Open(dir)).TokenizerJson())
}

fn main() {
    p := flags.Flags("oann-gen", "completions of prompts.jsonl by MODEL, written to out.jsonl as they finish")
    n := p.Int("n", 'n', 1, "completions of each prompt")
    temp := p.Float("temp", 't', -1.0, "temperature (0: greedy; default the model's)")
    topP := p.Float("top-p", 0, -1.0, "nucleus mass kept (default the model's)")
    topK := p.Int("top-k", 0, -1, "most likely tokens kept, 0 all (default the model's)")
    maxNew := p.Int("max-tokens", 'm', 4096, "tokens a completion may have")
    batch := p.Int("batch", 'b', 64, "sequences decoded at once")
    ctx := p.Int("ctx", 0, 0, "positions a sequence may have (default: the longest prompt and --max-tokens)")
    seed := p.Int("seed", 0, 1, "seed of every completion's generator")
    system := p.Text("system", 0, "", "system prompt")
    noThink := p.Bool("no-think", 0, "Qwen3: answer without thinking")
    kvGb := p.Float("kv-gb", 0, 0.0, "memory for the key-value cache (default: most of what is free)")
    exact := p.Bool("exact", 0, "F32 activations and cache (slow; to check against a reference)")
    kv8 := p.Bool("kv8", 0, "keys and values in 8 bits, a scale per position and head: about half the cache (AMX)")
    int8 := p.Bool("int8", 0, "8-bit weights, a scale per 32 inputs (the head stays BF16): about 0.56 of the memory; needs AMX")
    int4 := p.Bool("int4", 0, "4-bit weights, a scale per 32 inputs (the head stays BF16): about a third of the memory, faster decoding; needs AMX")
    try p.Parse(os.Args()) catch flags.Error.Help {
        try io.Put(p.Help()) catch { }
        return
    } catch flags.Error {
        fail(p.Message())
    }
    args := p.Args()
    if args.Len() != 3: fail("usage: oann-gen MODEL prompts.jsonl out.jsonl [flags] (--help)")
    dir := modelDir(args[0])
    outPath :~ args[2]
    t0 := time.Now()
    tok := try tokenizer(dir) catch { fail("cannot read the tokenizer of " + dir) }
    ch := chat.Chat.Load(dir, tok)
    m := try model.Model.Load(dir, exact.Get(), int8.Get(), int4.Get()) catch { fail("cannot load the model in " + dir) }
    say("loaded " + dir + ": " + $(m.C.Params() / 1000000) + "M parameters, " + $(m.Bytes() / 1048576) + " MB" + (" (INT8)" if m.Int8 else (" (INT4)" if m.Int4 else "")) + ", " +
        ("AMX tiles" if m.Tile else "F32 products") + ", " + (F64(time.Since(t0)) / 1e9).Fixed(1) + " s")
    # what is done already
    finished := Map<String, Bool>()
    if os.Exists(outPath) {
        text :~ try os.ReadFile(outPath) catch { fail("cannot read " + outPath) }
        for line in text.Lines() {
            if line.Trim().Len() == 0: continue
            j :~ try json.Json.Parse(line) catch { continue }
            id :~ try j["id"] catch { continue }
            k := try (try j["sample"] catch { continue }).AsInt() catch { continue }
            finished.Put(json.Encode(id) + "#" + $k, true)
        }
    }
    # the jobs
    text :~ try os.ReadFile(args[1]) catch { fail("cannot read " + args[1]) }
    jobs := Vec<job>()
    longest I64 = 0
    skipped I64 = 0
    for li, line in text.Lines() {
        if line.Trim().Len() == 0: continue
        j :~ try json.Json.Parse(line) catch { fail(args[1] + ":" + $(li + 1) + ": not JSON") }
        id :~ json.Encode(try j["id"] catch default json.Json.Num(F64(li)))
        prompt String& = ""
        if j.Has("text") {
            prompt ~ try (try j["text"] catch { fail("text") }).AsStr() catch { fail(args[1] + ":" + $(li + 1) + ": text is not a string") }
        } else {
            user :~ try (try j["prompt"] catch { fail(args[1] + ":" + $(li + 1) + ": no prompt or text") }).AsStr() catch { fail(args[1] + ":" + $(li + 1) + ": prompt is not a string") }
            sys :~ system.Get()
            if j.Has("system"): sys ~ try (try j["system"] catch { fail("system") }).AsStr() catch { fail("system is not a string") }
            prompt ~ ch.Prompt(user, sys, not noThink.Get())
        }
        ids := tok.Encode(prompt)
        for k in range n.Get() {
            if finished.Has(id + "#" + $k) {
                skipped++
                continue
            }
            jobs.Push(job(id, k, ids))
            longest = longest.Max(ids.Len())
        }
    }
    if skipped > 0: say($skipped + " completions already in " + outPath)
    if jobs.Len() == 0 {
        say("nothing to do")
        return
    }
    maxCtx := ctx.Get() if ctx.Get() > 0 else longest + maxNew.Get()
    maxCtx = maxCtx.Min(m.C.MaxPos)
    budget := I64(kvGb.Get() * 1073741824.0) if kvGb.Get() > 0.0 else (available() - 1073741824) * 9 / 10
    pages := engine.PagesFor(m.C, budget, kv8.Get() and m.Tile).Min(batch.Get() * (maxCtx / model.PageSize + 1))
    if pages < maxCtx / model.PageSize + 1: fail("no room for one sequence of " + $maxCtx + " positions in " + $(budget / 1048576) + " MB")
    e := engine.Engine(m, batch.Get(), maxCtx, pages, Exact = exact.Get(), Kv8 = kv8.Get())
    tt := ch.Temp if temp.Get() < 0.0 else temp.Get()
    tp := ch.TopP if topP.Get() < 0.0 else topP.Get()
    tk := ch.TopK if topK.Get() < 0 else topK.Get()
    e.Sampling = engine.Sampler(tt, tp, tk)
    for t in ch.Stops: e.Stops.Push(t)
    say($jobs.Len() + " completions, batch " + $batch.Get() + ", context " + $maxCtx + ", cache " + $pages + " pages (" +
        $(pages * model.PageBytes(m.C, kv8.Get() and m.Tile) / 1048576) + " MB), temperature " + $e.Sampling.Temp + ", top-p " + $e.Sampling.TopP +
        ", top-k " + $e.Sampling.TopK)
    for i, jb in jobs.View() {
        s := mix(U64(seed.Get()) ^ mix(hash(jb.id)) ^ mix(U64(jb.sample) + 0x51ED))
        e.Submit(engine.Request(i, jb.prompt, maxNew.Get(), s))
    }
    out := try os.File.Append(outPath) catch { fail("cannot write " + outPath) }
    opening := ch.Opening()
    start := time.Now()
    last := start
    done I64 = 0
    for not e.Idle() {
        for d in e.Step() {
            jb := jobs[d.Id]
            body := try tok.Decode(d.Tokens) catch default ""
            line := "{\"id\": " + jb.id + ", \"sample\": " + $jb.sample + ", \"text\": " + json.Encode(opening + body) +
                ", \"prompt_tokens\": " + $d.PromptLen + ", \"tokens\": " + $d.Tokens.Len() + ", \"finish\": \"" +
                ("stop" if d.Stopped else "length") + "\"}\n"
            try out.Write(line) catch { fail("cannot write " + outPath) }
            done++
        }
        if time.Since(last) > 30000000000 or e.Idle() {
            last = time.Now()
            secs := F64(time.Since(start)) / 1e9
            say($done + "/" + $jobs.Len() + " done, " + $e.Running() + " running, " + $e.Waiting() + " waiting, " +
                $e.Tokens + " tokens in " + secs.Fixed(0) + " s: " + (F64(e.Tokens) / secs).Fixed(1) + " tokens/s, peak " + $peak() + " MB" +
                (", " + $e.Preempted + " preempted" if e.Preempted > 0 else ""))
        }
    }
}
