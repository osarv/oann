type tile struct() {
    v Array<I32> = Array<I32>(192)
}

# B as [k/2][32][2] I16, A as [k/2][6][2] I16
fn micro(depth I64, pa Array<I16>&, qb Array<I16>&, t mut tile&) {
    for p in range depth {
        b I64 = p * 64
        comptime for i in range 6 {
            a0, a1 := I32(pa[p * 12 + 2 * i]), I32(pa[p * 12 + 2 * i + 1])
            for j in range 32: t.v[i * 32 + j] = t.v[i * 32 + j] + (a0 * I32(qb[b + 2 * j]) + a1 * I32(qb[b + 2 * j + 1]))
        }
    }
}

fn main() {
    pa := Array<I16>(12 * 64)
    qb := Array<I16>(64 * 64)
    for i in range pa.Len(): pa[i] = I16(i % 251)
    for i in range qb.Len(): qb[i] = I16(i % 255 - 127)
    t := tile()
    micro(64, pa, qb, t)
    Println($t.v[5])
}
