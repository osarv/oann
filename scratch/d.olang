fn dot(a Array<U8>&, ao I64, b Array<I8>&, bo I64, k I64) I32 {
    return (a[ao:ao + k] * b[bo:bo + k]).Sum<I32>()
}

fn main() {
    a := Array<U8>(1024)
    b := Array<I8>(1024 * 64)
    for i in range a.Len(): a[i] = U8(i % 251)
    for i in range b.Len(): b[i] = I8(i % 255 - 127)
    s I32 = 0
    for j in range 64: s = s + dot(a, 0, b, j * 1024, 1024)
    Println($s)
}
