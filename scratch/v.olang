type tile struct() {
    v Array<I32> = Array<I32>(96)
}

fn micro(depth I64, pa Array<U8>&, qb Array<I8>&, t mut tile&) {
    for p in range depth {
        comptime for i in range 6 {
            a0, a1, a2, a3 := I32(pa[p * 24 + 4 * i]), I32(pa[p * 24 + 4 * i + 1]), I32(pa[p * 24 + 4 * i + 2]), I32(pa[p * 24 + 4 * i + 3])
            b I64 = p * 64
            for j in range 16: t.v[i * 16 + j] = t.v[i * 16 + j] + a0 * I32(qb[b + 4 * j]) + a1 * I32(qb[b + 4 * j + 1]) + a2 * I32(qb[b + 4 * j + 2]) + a3 * I32(qb[b + 4 * j + 3])
        }
    }
}

fn main() {
    pa := Array<U8>(24 * 64)
    qb := Array<I8>(64 * 64)
    for i in range pa.Len(): pa[i] = U8(i % 251)
    for i in range qb.Len(): qb[i] = I8(i % 127)
    t := tile()
    micro(64, pa, qb, t)
    Println($t.v[5])
}
