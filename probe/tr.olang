type Fn trait {
    mut Go(x mut Array<F32>&) noalloc
}
type Box struct(n I64) { n }
fn (b mut Box&) Go(x mut Array<F32>&) { x[0] = 1.0 }
fn call(f mut any Fn&, x mut Array<F32>&) { f.Go(x) }
assert not call.Allocates, "through any"
test Box "goes" {
    b := Box(1)
    x := Array<F32>(2)
    call(b, x)
}
