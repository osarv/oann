import "../kernels/attention"
import "../kernels/conv"
import "../kernels/scan"
import "../kernels/gemm"
assert not attention.Attention<F32, F32>.Allocates, "Attention"
assert not attention.AttentionGrad<F32, F32>.Allocates, "AttentionGrad"
assert not attention.AttentionStep<F32, F32>.Allocates, "AttentionStep"
assert not conv.Conv2d<F32, F32>.Allocates, "Conv2d"
assert not conv.Conv2dBackward<F32, F32>.Allocates, "Conv2dBackward"
assert not conv.MaxPool2d<F32>.Allocates, "MaxPool2d"
assert not scan.GatedScan<F32, F32>.Allocates, "GatedScan"
assert not scan.GatedScanGrad<F32, F32>.Allocates, "GatedScanGrad"
assert not scan.SelectiveScan<F32, F32>.Allocates, "SelectiveScan"
assert not scan.SelectiveScanGrad<F32, F32>.Allocates, "SelectiveScanGrad"
assert not scan.DeltaRule<F32, F32>.Allocates, "DeltaRule"
assert not scan.DeltaRuleGrad<F32, F32>.Allocates, "DeltaRuleGrad"
assert not gemm.GemmLeft<conv.Patches<F32>, F32, F32>.Allocates, "GemmLeft"
