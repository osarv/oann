import "../tensor"
fn st1(t tensor.Tensor<F32>&) mut Array<F32>& {
    u := t
    for u.Rank() > 2: u = u.Select(0, 0)!
    m := u.Mat()!
    return m.Data
}
fn st2(t tensor.Tensor<F32>&) mut Array<F32>& {
    m := t.Mat()!
    return m.Data
}
fn st3(t tensor.Tensor<F32>&) I64 {
    u := t
    for u.Rank() > 2: u = u.Select(0, 0)!
    return u.Rank()
}
fn st4(t tensor.Tensor<F32>&) I64 {
    u := t.Select(0, 0)!
    return u.Rank()
}
assert not st1.Allocates, "st1"
assert not st2.Allocates, "st2"
assert not st3.Allocates, "st3"
assert not st4.Allocates, "st4"
