import "../tensor"
import "../kernels/mat"
fn sel(t mut tensor.Tensor<F32>&) tensor.Tensor<F32> { return t.Select(0, 0)! }
fn mt(t mut tensor.Tensor<F32>&) mat.Mat<F32> { return t.Mat()! }
fn rw(t mut tensor.Tensor<F32>&) tensor.Tensor<F32> { return t.Rows()! }
fn cv(t mut tensor.Tensor<F32>&, s tensor.Tensor<F32>&) { try t.Convert(s) catch { unreachable } }
assert not sel.Allocates, "Select"
assert not mt.Allocates, "Mat"
assert not rw.Allocates, "Rows"
assert not cv.Allocates, "Convert"
