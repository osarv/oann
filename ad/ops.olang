# ad/ops - the forward and backward of every operation the recorded graph (ad/graph.olang) runs, on N-d tensors over
# the kernels. Each is a function of tensors the graph has already laid out and viewed: values, gradients and what a
# backward keeps. Nothing here allocates, records or checks a shape - the graph checks shapes once, where an operation
# is recorded (docs/redesign.md, section 3, decision 1) - and a tensor whose layout a kernel cannot read is a mistake of
# the graph's, ended by `!`.
#
# Storage and computation. S is the storage (F64, F32, BF16, F16), A the type computed in: S itself for F64 and F32,
# F32 for the narrower ones (the kernels' rule). Every element is read up to A once and rounded to S once.
#
# Gradients. A backward is given, for each input, the input's gradient as a tensor and whether to add to it (`add`):
# the first operation contributing to a gradient writes it and the rest add, so nothing is zeroed between steps. A
# gradient not wanted is an empty tensor (Count 0). The vector-Jacobian products are hand-written and each is checked
# against central differences in F64 (tools/gradcheck.olang).

import "../tensor"
import "../kernels/mat"
import "../kernels/gemm"
import "../kernels/elem"
import "../kernels/attention"
import "../kernels/scan"
import "../kernels/conv"
import "std/rand"

# ---- operands ----

# t's elements in order, t contiguous (the graph's invariant for what an elementwise kernel reads)
fn flat<S>(t tensor.Tensor<S>&) mut Array<S>& { return t.Flat()! }

# t as the kernels' operand: its leading axes folded into rows, the last contiguous
fn rows<S>(t tensor.Tensor<S>&) mat.Mat<S> { return t.Mat()! }

# a matrix with no rows: a gradient not wanted
fn none<S>(t tensor.Tensor<S>&) mat.Mat<S> { return mat.Mat<S>(t.Flat()!, 0, 0, 0, 0) }

# the operand of a gradient: its rows, or none where it is not wanted
fn gradRows<S>(t tensor.Tensor<S>&) mat.Mat<S> { return none(t) if t.Count() == 0 else rows(t) }

# whether a gradient is wanted
fn Wanted<S>(t tensor.Tensor<S>) Bool { return t.Count() > 0 }

# 1 where add, else 0: a product's beta
fn betaOf<A>(add Bool) A { return A(1.0) if add else A(0.0) }

# ---- lane loops: y = a op b, dx (+)= k dy ----

# Each loop is split into up to `threads` runs of the elements under one join (parts below says when a split pays);
# every element is computed as one run would compute it, so the values are the same whatever the count.

# dx = k dy, or dx += k dy where add (dx a gradient, of dy's length)
fn Put<S, A>(dx mut Array<S>&, dy Array<S>&, k A, add Bool, threads I64 = 1) {
    n := dx.Len()
    t := parts(threads, n)
    if t == 1 {
        putRun<S, A>(dx, dy, k, add)
        return
    }
    share := (n + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(n, (j + 1) * share)
            if lo < hi: spawn putRun<S, A>(dx[lo:hi], dy[lo:hi], k, add)
        }
    }
}

fn putRun<S, A>(dx mut Array<S>&, dy Array<S>&, k A, add Bool) {
    n := dx.Len()
    if add {
        for i in range n: dx[i] = S(A(dx[i]) + k * A(dy[i]))
        return
    }
    for i in range n: dx[i] = S(k * A(dy[i]))
}

# dx = k dy b, or dx += that where add
fn putTimes<S, A>(dx mut Array<S>&, dy Array<S>&, b Array<S>&, k A, add Bool, threads I64 = 1) {
    n := dx.Len()
    t := parts(threads, n)
    if t == 1 {
        putTimesRun<S, A>(dx, dy, b, k, add)
        return
    }
    share := (n + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(n, (j + 1) * share)
            if lo < hi: spawn putTimesRun<S, A>(dx[lo:hi], dy[lo:hi], b[lo:hi], k, add)
        }
    }
}

fn putTimesRun<S, A>(dx mut Array<S>&, dy Array<S>&, b Array<S>&, k A, add Bool) {
    n := dx.Len()
    if add {
        for i in range n: dx[i] = S(A(dx[i]) + k * A(dy[i]) * A(b[i]))
        return
    }
    for i in range n: dx[i] = S(k * A(dy[i]) * A(b[i]))
}

# y = a + k b: Add (k 1) and Sub (k -1)
fn Combine<S, A>(y mut tensor.Tensor<S>&, a tensor.Tensor<S>, b tensor.Tensor<S>, k A, threads I64 = 1) {
    yd, ad, bd := flat(y), flat(a), flat(b)
    n := yd.Len()
    t := parts(threads, n)
    if t == 1 {
        combineRun<S, A>(yd, ad, bd, k)
        return
    }
    share := (n + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(n, (j + 1) * share)
            if lo < hi: spawn combineRun<S, A>(yd[lo:hi], ad[lo:hi], bd[lo:hi], k)
        }
    }
}

fn combineRun<S, A>(yd mut Array<S>&, ad Array<S>&, bd Array<S>&, k A) {
    for i in range yd.Len(): yd[i] = S(A(ad[i]) + k * A(bd[i]))
}

fn CombineBackward<S, A>(dy tensor.Tensor<S>, k A, da mut tensor.Tensor<S>&, addA Bool, db mut tensor.Tensor<S>&, addB Bool, threads I64 = 1) {
    g :~ flat(dy)
    if Wanted(da): Put<S, A>(flat(da), g, A(1.0), addA, threads)
    if Wanted(db): Put<S, A>(flat(db), g, k, addB, threads)
}

# y = a b, element by element
fn Mul<S, A>(y mut tensor.Tensor<S>&, a tensor.Tensor<S>, b tensor.Tensor<S>, threads I64 = 1) {
    yd, ad, bd := flat(y), flat(a), flat(b)
    n := yd.Len()
    t := parts(threads, n)
    if t == 1 {
        mulRun<S, A>(yd, ad, bd)
        return
    }
    share := (n + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(n, (j + 1) * share)
            if lo < hi: spawn mulRun<S, A>(yd[lo:hi], ad[lo:hi], bd[lo:hi])
        }
    }
}

fn mulRun<S, A>(yd mut Array<S>&, ad Array<S>&, bd Array<S>&) {
    for i in range yd.Len(): yd[i] = S(A(ad[i]) * A(bd[i]))
}

fn MulBackward<S, A>(dy tensor.Tensor<S>, a tensor.Tensor<S>, b tensor.Tensor<S>, da mut tensor.Tensor<S>&, addA Bool, db mut tensor.Tensor<S>&, addB Bool, threads I64 = 1) {
    g :~ flat(dy)
    if Wanted(da): putTimes<S, A>(flat(da), g, flat(b), A(1.0), addA, threads)
    if Wanted(db): putTimes<S, A>(flat(db), g, flat(a), A(1.0), addB, threads)
}

# y = k x
fn Scale<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, k A, threads I64 = 1) {
    Put<S, A>(flat(y), flat(x), k, false, threads)
}

# ---- products ----

# y = x w^T + b over the last axis: x [..., in], w [out, in], b [out] or empty. An F32 bias is added in the product's
# epilogue, as each block is summed; another type's after it. p: w^T packed ahead for the tile path (Graph's
# PackConstants), or an empty TilePacked
fn Linear<S, A>(ws mut gemm.Workspace<A>&, y mut tensor.Tensor<S>&, x tensor.Tensor<S>, w tensor.Tensor<S>, b tensor.Tensor<S>, p gemm.TilePacked&) {
    ym, xm, wm := rows(y), rows(x), rows(w)
    if b.Count() == 0 {
        gemm.GemmTilePacked(ws, ym, xm, wm, true, p)
        return
    }
    match S {
        case F32 {
            bias := gemm.Epilogue.Bias(flat(b))
            gemm.GemmTilePacked(ws, ym, xm, wm, true, p, 1.0, 0.0, bias)
        }
        case _ {
            gemm.GemmTilePacked(ws, ym, xm, wm, true, p)
            addBias<S, A>(ym, flat(b))
        }
    }
}

# every row of y plus b
fn addBias<S, A>(y mut mat.Mat<S>&, b Array<S>&) {
    for r in range y.Rows {
        o := y.Off + r * y.Ld
        for c in range y.Cols: y.Data[o + c] = S(A(y.Data[o + c]) + A(b[c]))
    }
}

# dx (+)= dy w, dw (+)= dy^T x, db (+)= the column sums of dy. p: w packed ahead for the tile path, or empty
fn LinearBackward<S, A>(ws mut gemm.Workspace<A>&, dy tensor.Tensor<S>, x tensor.Tensor<S>, w tensor.Tensor<S>, dx mut tensor.Tensor<S>&, addX Bool, dw mut tensor.Tensor<S>&, addW Bool, db mut tensor.Tensor<S>&, addB Bool, p gemm.TilePacked&) {
    g, xm, wm := rows(dy), rows(x), rows(w)
    if Wanted(dx) {
        d := rows(dx)
        gemm.GemmTilePacked(ws, d, g, wm, false, p, A(1.0), betaOf<A>(addX))
    }
    if Wanted(dw) {
        d := rows(dw)
        gemm.Gemm(ws, d, g, true, xm, false, A(1.0), betaOf<A>(addW))
    }
    if Wanted(db): elem.ColumnSums(flat(db), g, S(1.0) if addB else S(0.0))
}

# the matrices of a batched product's operand: its last two axes a matrix, its leading ones (at most two, any strides)
# the groups and members. A rank 2 operand shared by a batch of `groups` x `members` (stride 0)
fn batchOf<S>(t tensor.Tensor<S>&, groups I64, members I64) gemm.Batch<S> {
    r := t.Rank()
    m := r - 2
    data :~ storageOf(t)
    off := t.Offset
    if r == 2: return gemm.Batch<S>(data, off, t.Dim(0), t.Dim(1), t.Strides[0], groups, 0, members, 0)
    if r == 3: return gemm.Batch<S>(data, off, t.Dim(1), t.Dim(2), t.Strides[1], t.Dim(0), t.Strides[0], 1, 0)
    return gemm.Batch<S>(data, off, t.Dim(m), t.Dim(m + 1), t.Strides[m], t.Dim(0), t.Strides[0], t.Dim(1), t.Strides[1])
}

# the storage under a tensor whose last axis is contiguous (the whole array its Offset indexes): its first matrix's Mat
# holds it - a view of any leading strides, a permuted batch's included
fn storageOf<S>(t tensor.Tensor<S>&) mut Array<S>& {
    # unrolled for the two leading axes a batch has: a local reassigned from its own view reads as allocating
    # (repro/reassignfacts, fixed in olang and removed 2026-11-21)
    if t.Rank() == 2 {
        m := t.Mat()!
        return m.Data
    }
    u := t.Select(0, 0)!
    if u.Rank() == 2 {
        m := u.Mat()!
        return m.Data
    }
    v := u.Select(0, 0)!
    m := v.Mat()!
    return m.Data
}

# y = op(a) op(b): rank 2 operands, or batched over one or two leading axes (b may be rank 2, shared by the batch); a
# product of rank 2 operands, or of a batched a and a shared b not transposed, is one Gemm over the folded rows
fn MatMul<S, A>(ws mut gemm.Workspace<A>&, y mut tensor.Tensor<S>&, a tensor.Tensor<S>, ta Bool, b tensor.Tensor<S>, tb Bool) {
    if b.Rank() == 2 and (a.Rank() == 2 or not ta) {
        ym, am, bm := rows(y), rows(a), rows(b)
        gemm.Gemm(ws, ym, am, ta, bm, tb)
        return
    }
    g, m := leading(y)
    yb, ab, bb := batchOf(y, g, m), batchOf(a, g, m), batchOf(b, g, m)
    gemm.GemmBatch(ws, yb, ab, ta, bb, tb)
}

# the groups and members of a batched result: its leading axes
fn leading<S>(y tensor.Tensor<S>&) I64, I64 {
    r := y.Rank()
    if r == 3: return y.Dim(0), 1
    return y.Dim(0), y.Dim(1)
}

# C = op(A) op(B):  op(A)'s gradient dC op(B)^T,  op(B)'s op(A)^T dC - each transposed back where its operand was
fn MatMulBackward<S, A>(ws mut gemm.Workspace<A>&, dy tensor.Tensor<S>, a tensor.Tensor<S>, ta Bool, b tensor.Tensor<S>, tb Bool, da mut tensor.Tensor<S>&, addA Bool, db mut tensor.Tensor<S>&, addB Bool) {
    one A = 1.0
    if b.Rank() == 2 and (a.Rank() == 2 or not ta) {
        g, am, bm := rows(dy), rows(a), rows(b)
        if Wanted(da) {
            d := rows(da)
            if ta: gemm.Gemm(ws, d, bm, tb, g, true, one, betaOf<A>(addA))
            else: gemm.Gemm(ws, d, g, false, bm, not tb, one, betaOf<A>(addA))
        }
        if Wanted(db) {
            d := rows(db)
            if tb: gemm.Gemm(ws, d, g, true, am, ta, one, betaOf<A>(addB))
            else: gemm.Gemm(ws, d, am, not ta, g, false, one, betaOf<A>(addB))
        }
        return
    }
    gs, ms := leading(dy)
    g, ab, bb := batchOf(dy, gs, ms), batchOf(a, gs, ms), batchOf(b, gs, ms)
    if Wanted(da) {
        d := batchOf(da, gs, ms)
        if ta: gemm.GemmBatch(ws, d, bb, tb, g, true, one, betaOf<A>(addA))
        else: gemm.GemmBatch(ws, d, g, false, bb, not tb, one, betaOf<A>(addA))
    }
    if Wanted(db) {
        d := batchOf(db, gs, ms)
        if tb: gemm.GemmBatch(ws, d, g, true, ab, ta, one, betaOf<A>(addB))
        else: gemm.GemmBatch(ws, d, ab, not ta, g, false, one, betaOf<A>(addB))
    }
}

# ---- activations ----

# an elementwise pass over n elements split into this many tasks: one where it is too small to pay a spawn
fn parts(threads I64, n I64) I64 { return 1 if n < actSplitFrom else (threads if threads > 1 else 1) }
actSplitFrom I64 = 1 << 16

fn Act<S>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, a mat.Act, threads I64 = 1) {
    dst, src := flat(y), flat(x)
    n := src.Len()
    k := parts(threads, n)
    if k == 1 {
        elem.Act(dst, src, a)
        return
    }
    share := (n + k - 1) / k
    join {
        for t in range k {
            lo, hi := t * share, lesserOf(n, (t + 1) * share)
            if lo < hi: spawn elem.Act(dst[lo:hi], src[lo:hi], a)
        }
    }
}

fn lesserOf(a I64, b I64) I64 { return a if a < b else b }

# dx (+)= dy act'(x)
fn ActBackward<S>(dy tensor.Tensor<S>, x tensor.Tensor<S>, a mat.Act, dx mut tensor.Tensor<S>&, add Bool, threads I64 = 1) {
    d, g, v := flat(dx), flat(dy), flat(x)
    n := v.Len()
    k := parts(threads, n)
    if k == 1 {
        elem.ActGrad(d, g, v, a, add)
        return
    }
    share := (n + k - 1) / k
    join {
        for t in range k {
            lo, hi := t * share, lesserOf(n, (t + 1) * share)
            if lo < hi: spawn elem.ActGrad(d[lo:hi], g[lo:hi], v[lo:hi], a, add)
        }
    }
}

# dx (+)= dy act'(x), read from y = act(x) - for an activation whose slope is (elem.FromOutput)
fn ActBackwardOut<S>(dy tensor.Tensor<S>, y tensor.Tensor<S>, a mat.Act, dx mut tensor.Tensor<S>&, add Bool, threads I64 = 1) {
    d, g, v := flat(dx), flat(dy), flat(y)
    n := v.Len()
    k := parts(threads, n)
    if k == 1 {
        elem.ActGradOut(d, g, v, a, add)
        return
    }
    share := (n + k - 1) / k
    join {
        for t in range k {
            lo, hi := t * share, lesserOf(n, (t + 1) * share)
            if lo < hi: spawn elem.ActGradOut(d[lo:hi], g[lo:hi], v[lo:hi], a, add)
        }
    }
}

# whether an activation's backward reads its output rather than its input
fn ActFromOutput(a mat.Act) Bool { return elem.FromOutput(a) }

# y = x where x > 0, slope x elsewhere
fn LeakyRelu<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, slope A) {
    yd :~ flat(y)
    xd :~ flat(x)
    for i in range yd.Len() {
        v := A(xd[i])
        yd[i] = S(v if v > 0.0 else slope * v)
    }
}

fn LeakyReluBackward<S, A>(dy tensor.Tensor<S>, x tensor.Tensor<S>, slope A, dx mut tensor.Tensor<S>&, add Bool) {
    g :~ flat(dy)
    xd :~ flat(x)
    d :~ flat(dx)
    for i in range d.Len() {
        v := A(g[i]) * (A(1.0) if A(xd[i]) > 0.0 else slope)
        d[i] = S(A(d[i]) + v if add else v)
    }
}

# ---- softmax ----

# y = softmax over the last axis
fn Softmax<S>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>) {
    ym, xm := rows(y), rows(x)
    elem.RowSoftmax(ym, xm, S(1.0))
}

# dx = y (dy - <dy, y>) row by row
fn SoftmaxBackward<S, A>(dy tensor.Tensor<S>, y tensor.Tensor<S>, dx mut tensor.Tensor<S>&, add Bool) {
    g := rows(dy)
    p := rows(y)
    d := rows(dx)
    for r in range g.Rows {
        go := g.Off + r * g.Ld
        po := p.Off + r * p.Ld
        o := d.Off + r * d.Ld
        dot := elem.DotIn<S, A>(g.Data, go, p.Data, po, g.Cols)
        for c in range g.Cols {
            v := A(p.Data[po + c]) * (A(g.Data[go + c]) - dot)
            d.Data[o + c] = S(A(d.Data[o + c]) + v if add else v)
        }
    }
}

# y = x - log(sum exp x) over the last axis
fn LogSoftmax<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>) {
    xm := rows(x)
    ym := rows(y)
    for r in range xm.Rows {
        xo := xm.Off + r * xm.Ld
        yo := ym.Off + r * ym.Ld
        lse := logSumExp<S, A>(xm.Data, xo, xm.Cols)
        for c in range xm.Cols: ym.Data[yo + c] = S(A(xm.Data[xo + c]) - lse)
    }
}

# dx = dy - exp(y) sum(dy), row by row
fn LogSoftmaxBackward<S, A>(dy tensor.Tensor<S>, y tensor.Tensor<S>, dx mut tensor.Tensor<S>&, add Bool) {
    g := rows(dy)
    p := rows(y)
    d := rows(dx)
    for r in range g.Rows {
        go := g.Off + r * g.Ld
        po := p.Off + r * p.Ld
        o := d.Off + r * d.Ld
        total := elem.SumIn<S, A>(g.Data, go, g.Cols)
        for c in range g.Cols {
            v := A(g.Data[go + c]) - elem.FastExp(A(p.Data[po + c])) * total
            d.Data[o + c] = S(A(d.Data[o + c]) + v if add else v)
        }
    }
}

# ---- losses ----

# the mean over the rows whose class is not negative of -log softmax(logits)[class] - read off the row's softmax, or
# where that underflows the log-sum-exp less the class's logit, so nothing takes a log of zero - in F64; probs keeps
# each row's softmax for the backward
fn CrossEntropy<S, A>(logits tensor.Tensor<S>, classes Array<I32>&, probs mut tensor.Tensor<S>&, threads I64 = 1) F64 {
    z := rows(logits)
    p := rows(probs)
    k := parts(threads, z.Rows * z.Cols).Min(z.Rows).Max(1)
    if k == 1 {
        elem.RowSoftmax(p, z, S(1.0))
    } else {
        share := (z.Rows + k - 1) / k
        join {
            for t in range k {
                lo, hi := t * share, lesserOf(z.Rows, (t + 1) * share)
                if lo < hi: spawn softmaxRows<S, A>(p.Data, p.Off + lo * p.Ld, p.Ld, z.Data, z.Off + lo * z.Ld, z.Ld, hi - lo, z.Cols)
            }
        }
    }
    total F64 = 0.0
    counted I64 = 0
    for r in range z.Rows {
        c := I64(classes[r])
        if c < 0: continue
        # -log softmax[class] read off the probabilities just made; the log-sum-exp only where that underflows
        pc := F64(p.Data[p.Off + r * p.Ld + c])
        total += -pc.Log() if pc > 1e-30 else F64(logSumExp<S, A>(z.Data, z.Off + r * z.Ld, z.Cols) - A(z.Data[z.Off + r * z.Ld + c]))
        counted++
    }
    return total / F64(counted) if counted > 0 else 0.0
}

# rows of src's softmax into dst (a task's share of CrossEntropy's)
fn softmaxRows<S, A>(dst mut Array<S>&, d0 I64, dld I64, src Array<S>&, s0 I64, sld I64, nrows I64, cols I64) {
    for r in range nrows: elem.SoftmaxRunTo<S, A>(dst, d0 + r * dld, src, s0 + r * sld, cols, A(1.0))
}

# log(sum exp x) over a run, its largest element taken out first
fn logSumExp<S, A>(x Array<S>&, from I64, n I64) A { return elem.LogSumExpRun<S, A>(x, from, n) }

# dlogits (+)= dloss (probs - onehot(class)) / counted, zero for an ignored row
fn CrossEntropyBackward<S, A>(dloss A, classes Array<I32>&, probs tensor.Tensor<S>, dz mut tensor.Tensor<S>&, add Bool) {
    p := rows(probs)
    d := rows(dz)
    counted I64 = 0
    for r in range p.Rows {
        if classes[r] >= 0: counted++
    }
    k := dloss / A(counted if counted > 0 else 1)
    for r in range p.Rows {
        c := I64(classes[r])
        po := p.Off + r * p.Ld
        o := d.Off + r * d.Ld
        for j in range p.Cols {
            v A = 0.0 if c < 0 else k * (A(p.Data[po + j]) - (A(1.0) if j == c else A(0.0)))
            d.Data[o + j] = S(A(d.Data[o + j]) + v if add else v)
        }
    }
}

# the mean of (a - b)^2, in F64
fn Mse<S, A>(a tensor.Tensor<S>, b tensor.Tensor<S>) F64 {
    ad :~ flat(a)
    bd :~ flat(b)
    total F64 = 0.0
    for i in range ad.Len() {
        d := F64(A(ad[i]) - A(bd[i]))
        total += d * d
    }
    return total / F64(ad.Len())
}

# da (+)= 2 dloss (a - b) / n, db (+)= -that
fn MseBackward<S, A>(dloss A, a tensor.Tensor<S>, b tensor.Tensor<S>, da mut tensor.Tensor<S>&, addA Bool, db mut tensor.Tensor<S>&, addB Bool) {
    ad :~ flat(a)
    bd :~ flat(b)
    k := A(2.0) * dloss / A(ad.Len())
    if Wanted(da) {
        d :~ flat(da)
        for i in range d.Len() {
            v := k * (A(ad[i]) - A(bd[i]))
            d[i] = S(A(d[i]) + v if addA else v)
        }
    }
    if Wanted(db) {
        d :~ flat(db)
        for i in range d.Len() {
            v := k * (A(bd[i]) - A(ad[i]))
            d[i] = S(A(d[i]) + v if addB else v)
        }
    }
}

# ---- element functions: Sqrt, Log, Shift ----

# y = x + k
fn Shift<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, k A) {
    yd :~ flat(y)
    xd :~ flat(x)
    for i in range yd.Len(): yd[i] = S(A(xd[i]) + k)
}

# y = sqrt x (NaN below 0)
fn Sqrt<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>) {
    yd :~ flat(y)
    xd :~ flat(x)
    for i in range yd.Len(): yd[i] = S(A(xd[i]).Sqrt())
}

# dx (+)= dy / (2 y), read from y = sqrt x (infinite at 0)
fn SqrtBackward<S, A>(dy tensor.Tensor<S>, y tensor.Tensor<S>, dx mut tensor.Tensor<S>&, add Bool) {
    g :~ flat(dy)
    yd :~ flat(y)
    d :~ flat(dx)
    for i in range d.Len() {
        v := A(g[i]) / (A(2.0) * A(yd[i]))
        d[i] = S(A(d[i]) + v if add else v)
    }
}

# y = log x (-infinity at 0, NaN below)
fn Log<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>) {
    yd :~ flat(y)
    xd :~ flat(x)
    for i in range yd.Len(): yd[i] = S(A(xd[i]).Log())
}

# dx (+)= dy / x
fn LogBackward<S, A>(dy tensor.Tensor<S>, x tensor.Tensor<S>, dx mut tensor.Tensor<S>&, add Bool) {
    g :~ flat(dy)
    xd :~ flat(x)
    d :~ flat(dx)
    for i in range d.Len() {
        v := A(g[i]) / A(xd[i])
        d[i] = S(A(d[i]) + v if add else v)
    }
}

# ---- stablemax cross-entropy ----

# stablemax's s(x): x + 1 from 0 up, 1 / (1 - x) below - positive, increasing, and its slope 1 or s^2
fn Stable<A>(x A) A { return x + A(1.0) if x >= A(0.0) else A(1.0) / (A(1.0) - x) }

# the sum of s over a row's run
fn stableSum<S, A>(x Array<S>&, from I64, n I64) A {
    total A = 0.0
    for j in range n: total += Stable<A>(A(x[from + j]))
    return total
}

# the mean over the rows whose class is not negative of -log(s(logit[class]) / sum s(logit)), in F64
fn StablemaxCE<S, A>(logits tensor.Tensor<S>, classes Array<I32>&) F64 {
    z := rows(logits)
    total F64 = 0.0
    counted I64 = 0
    for r in range z.Rows {
        c := I64(classes[r])
        if c < 0: continue
        o := z.Off + r * z.Ld
        total += F64((stableSum<S, A>(z.Data, o, z.Cols) / Stable<A>(A(z.Data[o + c]))).Log())
        counted++
    }
    return total / F64(counted) if counted > 0 else 0.0
}

# dlogits (+)= dloss s'(x_j) (1 / sum s - [j = class] / s(x_class)) / counted, zero for an ignored row
fn StablemaxCEBackward<S, A>(dloss A, classes Array<I32>&, logits tensor.Tensor<S>, dz mut tensor.Tensor<S>&, add Bool) {
    z := rows(logits)
    d := rows(dz)
    counted I64 = 0
    for r in range z.Rows {
        if classes[r] >= 0: counted++
    }
    k := dloss / A(counted if counted > 0 else 1)
    for r in range z.Rows {
        c := I64(classes[r])
        o := z.Off + r * z.Ld
        out := d.Off + r * d.Ld
        total := stableSum<S, A>(z.Data, o, z.Cols) if c >= 0 else A(1.0)
        for j in range z.Cols {
            s := Stable<A>(A(z.Data[o + j]))
            slope := A(1.0) if s >= A(1.0) else s * s
            hit := A(1.0) / s if j == c else A(0.0)
            v A = 0.0 if c < 0 else k * slope * (A(1.0) / total - hit)
            d.Data[out + j] = S(A(d.Data[out + j]) + v if add else v)
        }
    }
}

# ---- normalization ----

# y = (x - mean) inv gain + bias over the last axis (rms: no mean taken out, no bias); stats keeps mean and inv, two
# rows of the rows' count. Runs of rows over up to `threads` tasks, each row as one task would make it
fn Norm<S>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, gain tensor.Tensor<S>, bias tensor.Tensor<S>, rms Bool, eps F64, stats mut Array<S>&, threads I64 = 1) {
    xm := rows(x)
    n := xm.Rows
    mean :~ stats[0:n]
    inv :~ stats[n:2 * n]
    ym := rows(y)
    bs :~ flat(bias) if bias.Count() > 0 else stats[0:0]
    t := rowParts(threads, n, xm.Cols)
    if t == 1 {
        elem.RowNormStats(mean, inv, xm, S(eps), rms)
        elem.RowNormApply(ym, xm, mean, inv, flat(gain), bs)
        return
    }
    share := (n + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(n, (j + 1) * share)
            if lo < hi: spawn normRows<S>(band(ym.Data, ym.Off, ym.Ld, lo, hi, ym.Cols), ym.Ld, band(xm.Data, xm.Off, xm.Ld, lo, hi, xm.Cols), xm.Ld, hi - lo, xm.Cols, mean[lo:hi], inv[lo:hi], flat(gain), bs, eps, rms)
        }
    }
}

# rows lo .. hi - 1 of a matrix (from off, ld apart, cols wide) as the run of its storage they lie in
fn band<S>(d mut Array<S>&, off I64, ld I64, lo I64, hi I64, cols I64) mut Array<S>& { return d[off + lo * ld:off + (hi - 1) * ld + cols] }

# a pass over the rows of a rows x cols matrix split into this many tasks
fn rowParts(threads I64, n I64, cols I64) I64 { return parts(threads, n * cols).Min(n).Max(1) }

# a task's rows of Norm: their statistics, then their values
fn normRows<S>(yd mut Array<S>&, yld I64, xd mut Array<S>&, xld I64, n I64, cols I64, mean mut Array<S>&, inv mut Array<S>&, gain Array<S>&, bias Array<S>&, eps F64, rms Bool) {
    xm := mat.Mat<S>(xd, 0, n, cols, xld)
    ym := mat.Mat<S>(yd, 0, n, cols, yld)
    elem.RowNormStats(mean, inv, xm, S(eps), rms)
    elem.RowNormApply(ym, xm, mean, inv, gain, bias)
}

# dx, dgain, dbias, each written or added to; dx's rows over up to `threads` tasks
fn NormBackward<S>(dy tensor.Tensor<S>, x tensor.Tensor<S>, gain tensor.Tensor<S>, rms Bool, stats Array<S>&, dx mut tensor.Tensor<S>&, addX Bool, dgain mut tensor.Tensor<S>&, addG Bool, dbias mut tensor.Tensor<S>&, addB Bool, threads I64 = 1) {
    g := rows(dy)
    xm := rows(x)
    n := xm.Rows
    mean :~ stats[0:n]
    inv :~ stats[n:2 * n]
    if Wanted(dx) {
        d := rows(dx)
        t := rowParts(threads, n, xm.Cols)
        if t == 1 {
            elem.RowNormGrad(d, g, xm, mean, inv, flat(gain), rms, addX)
        } else {
            share := (n + t - 1) / t
            join {
                for j in range t {
                    lo, hi := j * share, lesserOf(n, (j + 1) * share)
                    if lo < hi: spawn normGradRows<S>(band(d.Data, d.Off, d.Ld, lo, hi, d.Cols), d.Ld, band(g.Data, g.Off, g.Ld, lo, hi, g.Cols), g.Ld, band(xm.Data, xm.Off, xm.Ld, lo, hi, xm.Cols), xm.Ld, hi - lo, xm.Cols, mean[lo:hi], inv[lo:hi], flat(gain), rms, addX)
                }
            }
        }
    }
    if Wanted(dgain): elem.RowNormParamGrad(flat(dgain), flat(dgain)[0:0], g, xm, mean, inv, addG)
    if Wanted(dbias): elem.RowNormParamGrad(flat(dbias)[0:0], flat(dbias), g, xm, mean, inv, addB)
}

# a task's rows of dx
fn normGradRows<S>(dd mut Array<S>&, dld I64, gd mut Array<S>&, gld I64, xd mut Array<S>&, xld I64, n I64, cols I64, mean Array<S>&, inv Array<S>&, gain Array<S>&, rms Bool, add Bool) {
    d := mat.Mat<S>(dd, 0, n, cols, dld)
    g := mat.Mat<S>(gd, 0, n, cols, gld)
    xm := mat.Mat<S>(xd, 0, n, cols, xld)
    elem.RowNormGrad(d, g, xm, mean, inv, gain, rms, add)
}

# ---- lookups and positions ----

# row r of y: the table's row tokens[r]
fn Embedding<S>(y mut tensor.Tensor<S>&, tokens Array<I32>&, table tensor.Tensor<S>) {
    ym := rows(y)
    t := rows(table)
    for r in range ym.Rows {
        src := t.Off + I64(tokens[r]) * t.Ld
        dst := ym.Off + r * ym.Ld
        for c in range ym.Cols: ym.Data[dst + c] = t.Data[src + c]
    }
}

# dtable (+)= the rows of dy added at their tokens' rows
fn EmbeddingBackward<S, A>(dy tensor.Tensor<S>, tokens Array<I32>&, dtable mut tensor.Tensor<S>&, add Bool) {
    g := rows(dy)
    d := rows(dtable)
    if not add: dtable.Fill(S(0.0))
    for r in range g.Rows {
        dst := d.Off + I64(tokens[r]) * d.Ld
        src := g.Off + r * g.Ld
        for c in range g.Cols: d.Data[dst + c] = S(A(d.Data[dst + c]) + A(g.Data[src + c]))
    }
}

# the rows touched[0 .. count[0]] of a table's gradient zeroed, the list emptied and count[1] (the epoch) moved on
fn ClearRows<S>(dtable mut tensor.Tensor<S>&, touched Array<I32>&, count mut Array<I64>&) {
    d := rows(dtable)
    for k in range count[0] {
        at := d.Off + I64(touched[k]) * d.Ld
        for c in range d.Cols: d.Data[at + c] = S(0.0)
    }
    count[0] = 0
    count[1] += 1
}

# EmbeddingBackward for a sparse table (Graph.Sparse): each token's gradient row added to its table row, nothing else
# written, and each row reached recorded once a backward - in touched[0 .. count[0]], stamp[row] set to the backward's
# epoch count[1]
fn EmbeddingRows<S, A>(dy tensor.Tensor<S>, tokens Array<I32>&, dtable mut tensor.Tensor<S>&, touched mut Array<I32>&, count mut Array<I64>&, stamp mut Array<I64>&) {
    g := rows(dy)
    d := rows(dtable)
    epoch := count[1]
    for r in range g.Rows {
        t := I64(tokens[r])
        if stamp[t] != epoch {
            stamp[t] = epoch
            touched[count[0]] = I32(t)
            count[0] += 1
        }
        dst := d.Off + t * d.Ld
        src := g.Off + r * g.Ld
        for c in range g.Cols: d.Data[dst + c] = S(A(d.Data[dst + c]) + A(g.Data[src + c]))
    }
}

# x [b, t, ...] plus the table's row (first + t) mod T at every position t of every sequence (T the table's rows)
fn Positions<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, table tensor.Tensor<S>, ctx I64, first I64) {
    ym := rows(y)
    xm := rows(x)
    t := rows(table)
    n := y.Dim(1)               # the positions in use: a row's is first + its index among them
    for r in range ym.Rows {
        p := t.Off + (first + r % n) % t.Rows * t.Ld
        for c in range ym.Cols: ym.Data[ym.Off + r * ym.Ld + c] = S(A(xm.Data[xm.Off + r * xm.Ld + c]) + A(t.Data[p + c]))
    }
}

fn PositionsBackward<S, A>(dy tensor.Tensor<S>, ctx I64, first I64, dx mut tensor.Tensor<S>&, addX Bool, dtable mut tensor.Tensor<S>&, addT Bool) {
    g := rows(dy)
    if Wanted(dx): Put<S, A>(flat(dx), flat(dy), A(1.0), addX)
    if not Wanted(dtable): return
    d := rows(dtable)
    if not addT: dtable.Fill(S(0.0))
    for r in range g.Rows {
        p := d.Off + (first + r % ctx) % d.Rows * d.Ld
        for c in range g.Cols: d.Data[p + c] = S(A(d.Data[p + c]) + A(g.Data[g.Off + r * g.Ld + c]))
    }
}

# y = x rotated (Su et al.) at positions first + t of sequences of ctx
fn Rope<S>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, heads I64, ctx I64, first I64, base F64, threads I64 = 1) {
    try y.Convert(x) catch { unreachable }
    ym := rows(y)
    attention.RopeOver(ym, first, attention.Heads(heads, y.Dim(1)), base, 1.0, ropeTasks(threads, ym))
}

# Rope's tasks over m: one where too small to pay a spawn
fn ropeTasks<S>(threads I64, m mat.Mat<S>&) I64 { return rowParts(threads, m.Rows, m.Cols) }

# dx (+)= dy rotated back; tmp holds dy's elements while they are rotated, where dx is added to
fn RopeBackward<S, A>(dy tensor.Tensor<S>, heads I64, ctx I64, first I64, base F64, dx mut tensor.Tensor<S>&, add Bool, tmp mut tensor.Tensor<S>&, threads I64 = 1) {
    at := attention.Heads(heads, ctx)
    if not add {
        try dx.Convert(dy) catch { unreachable }
        dm := rows(dx)
        attention.RopeOver(dm, first, at, base, -1.0, ropeTasks(threads, dm))
        return
    }
    try tmp.Convert(dy) catch { unreachable }
    tm := rows(tmp)
    attention.RopeOver(tm, first, at, base, -1.0, ropeTasks(threads, tm))
    Put<S, A>(flat(dx), flat(tmp), A(1.0), true, threads)
}

# ---- attention ----

# out = attention(q, k, v) over sequences of ctx rows, probs keeping the weights
fn Attention<S, A>(ws mut gemm.Workspace<A>&, out mut tensor.Tensor<S>&, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, probs mut Array<S>&, heads I64, ctx I64, causal Bool, window I64, starts Array<I32>&) {
    om := rows(out)
    qm := rows(q)
    pm := mat.Mat<S>(probs, 0, qm.Rows * heads, ctx, ctx)
    km, vm := rows(k), rows(v)
    attention.Attention(ws, om, qm, km, vm, pm, attention.Heads(heads, ctx, causal, window), starts)
}

fn AttentionBackward<S, A>(ws mut gemm.Workspace<A>&, dout tensor.Tensor<S>, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, probs mut Array<S>&, scratch mut Array<S>&, heads I64, ctx I64, causal Bool, window I64, starts Array<I32>&, dq mut tensor.Tensor<S>&, addQ Bool, dk mut tensor.Tensor<S>&, addK Bool, dv mut tensor.Tensor<S>&, addV Bool) {
    qm := rows(q)
    pm := mat.Mat<S>(probs, 0, qm.Rows * heads, ctx, ctx)
    dqm := gradRows(dq)
    dkm := gradRows(dk)
    dvm := gradRows(dv)
    om, km, vm := rows(dout), rows(k), rows(v)
    attention.AttentionGrad(ws, dqm, dkm, dvm, om, qm, km, vm, pm, scratch, attention.Heads(heads, ctx, causal, window), addQ, addK, addV, starts)
}

# attention with no weights kept (kernels/attention's flash form): lse gets each row's log-sum-exp per head
fn FlashAttention<S, A>(f mut attention.Flash<A>&, out mut tensor.Tensor<S>&, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, lse mut Array<A>&, heads I64, ctx I64, causal Bool, window I64, starts Array<I32>&) {
    om := rows(out)
    qm, km, vm := rows(q), rows(k), rows(v)
    attention.FlashAttention(f, om, qm, km, vm, lse, attention.Heads(heads, ctx, causal, window), starts)
}

fn FlashAttentionBackward<S, A>(f mut attention.Flash<A>&, dout tensor.Tensor<S>, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, out tensor.Tensor<S>, lse mut Array<A>&, heads I64, ctx I64, causal Bool, window I64, starts Array<I32>&, dq mut tensor.Tensor<S>&, addQ Bool, dk mut tensor.Tensor<S>&, addK Bool, dv mut tensor.Tensor<S>&, addV Bool) {
    dqm := gradRows(dq)
    dkm := gradRows(dk)
    dvm := gradRows(dv)
    gm, qm, km, vm, om := rows(dout), rows(q), rows(k), rows(v), rows(out)
    attention.FlashAttentionGrad(f, dqm, dkm, dvm, gm, qm, km, vm, om, lse, attention.Heads(heads, ctx, causal, window), addQ, addK, addV, starts)
}

# causal attention while decoding: rows are positions first ... of each sequence - a sequence's n rows in a run (one
# sequence), or one row a sequence (a batch, one position a step) - its keys and values kept in its own part of the cache
fn AttentionStep<S, A>(out mut tensor.Tensor<S>&, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, cache mut Array<S>&, ctx I64, scores mut Array<A>&, first I64, heads I64, window I64 = 0) {
    qm := rows(q)
    d := qm.Cols
    om := rows(out)
    km, vm := rows(k), rows(v)
    n := q.Dim(1)
    for b in range q.Dim(0) {
        at := b * 2 * ctx * d
        keys := mat.Mat<S>(cache, at, ctx, d, d)
        values := mat.Mat<S>(cache, at + ctx * d, ctx, d, d)
        qb := mat.Mat<S>(qm.Data, qm.Off + b * n * qm.Ld, n, d, qm.Ld)
        kb := mat.Mat<S>(km.Data, km.Off + b * n * km.Ld, n, d, km.Ld)
        vb := mat.Mat<S>(vm.Data, vm.Off + b * n * vm.Ld, n, d, vm.Ld)
        ob := mat.Mat<S>(om.Data, om.Off + b * n * om.Ld, n, d, om.Ld)
        attention.AttentionStep(ob, qb, kb, vb, keys, values, scores, first, heads, window)
    }
}

# ---- dropout ----

# y = x mask / (1 - p), the mask drawn from r (each element kept with probability 1 - p) and kept
fn Dropout<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, mask mut Array<S>&, p F64, r mut rand.Rand&) {
    yd :~ flat(y)
    xd :~ flat(x)
    k := A(1.0 / (1.0 - p))
    for i in range yd.Len() {
        keep := r.Float() >= p
        mask[i] = S(1.0) if keep else S(0.0)
        yd[i] = S(A(xd[i]) * k) if keep else S(0.0)
    }
}

fn DropoutBackward<S, A>(dy tensor.Tensor<S>, mask Array<S>&, p F64, dx mut tensor.Tensor<S>&, add Bool) {
    putTimes<S, A>(flat(dx), flat(dy), mask[0:flat(dx).Len()], A(1.0 / (1.0 - p)), add)
}

# ---- convolution and pooling ----

# images [n, H, W, C] as the kernels' rows: one row per image
fn images<S>(t tensor.Tensor<S>&) mat.Mat<S> {
    n := t.Dim(0)
    per := t.Count() / n if n > 0 else 0
    return mat.Mat<S>(t.Flat()!, 0, n, per, per)
}

fn Conv2d<S, A>(ws mut gemm.Workspace<A>&, y mut tensor.Tensor<S>&, x tensor.Tensor<S>, w tensor.Tensor<S>, b tensor.Tensor<S>, s conv.Shape&) {
    ym := images(y)
    xm := images(x)
    wm := rows(w)
    match S {
        case F32 {
            if b.Count() > 0 {
                conv.Conv2d(ws, ym, xm, wm, s, gemm.Epilogue.Bias(flat(b)))
                return
            }
        }
        case _ { }
    }
    conv.Conv2d(ws, ym, xm, wm, s)
    if b.Count() == 0: return
    out := s.Rows(ym)
    addBias<S, A>(out, flat(b))
}

fn Conv2dBackward<S, A>(ws mut gemm.Workspace<A>&, dy tensor.Tensor<S>, x tensor.Tensor<S>, w tensor.Tensor<S>, s conv.Shape&, cols mut Array<S>&, threads I64, dx mut tensor.Tensor<S>&, addX Bool, dw mut tensor.Tensor<S>&, addW Bool, db mut tensor.Tensor<S>&, addB Bool) {
    n := dy.Dim(0)
    patches := mat.Mat<S>(cols, 0, n * s.Positions(), s.Patch(), s.Patch())
    dxm := images(dx) if Wanted(dx) else none(dx)
    dwm := gradRows(dw)
    dbd :~ flat(db) if Wanted(db) else cols[0:0]
    dym, xm, wm := images(dy), images(x), rows(w)
    conv.Conv2dBackward<S, A>(ws, dym, xm, wm, s, dxm, addX, dwm, addW, dbd, addB, patches, threads)
}

fn MaxPool2d<S>(y mut tensor.Tensor<S>&, where mut Array<I32>&, x tensor.Tensor<S>, p conv.Pool&, threads I64) {
    ym, xm := images(y), images(x)
    wm := mat.Mat<I32>(where, 0, ym.Rows, ym.Cols, ym.Cols)
    conv.MaxPool2d(ym, wm, xm, p, threads)
}

fn MaxPool2dBackward<S>(dy tensor.Tensor<S>, where mut Array<I32>&, p conv.Pool&, threads I64, dx mut tensor.Tensor<S>&, add Bool) {
    g := images(dy)
    wm := mat.Mat<I32>(where, 0, g.Rows, g.Cols, g.Cols)
    dxm := images(dx)
    conv.MaxPool2dBackward(dxm, g, wm, p, add, threads)
}

# ---- scans ----

# h = the gated scan h_t = a_t h_{t-1} + b_t x_t over sequences of ctx positions, from a zero state (state: seqs x D in
# A, left holding the last positions' states)
fn GatedScan<S, A>(work mut scan.Work<A>&, h mut tensor.Tensor<S>&, state mut mat.Mat<A>&, x tensor.Tensor<S>, a tensor.Tensor<S>, b tensor.Tensor<S>, ctx I64) {
    zero(state)
    hm, xm, am, bm := rows(h), rows(x), rows(a), rows(b)
    scan.GatedScan(work, hm, state, xm, am, bm, scan.Seq(ctx))
}

# every element of m zero
fn zero<A>(m mut mat.Mat<A>&) {
    for r in range m.Rows {
        for c in range m.Cols: m.Data[m.Off + r * m.Ld + c] = A(0.0)
    }
}

# dx, da, db (each wanted one written or added to; one not wanted given scratch to write into); init and dstate are
# seqs x D scratch in A
fn ScanBackward<S, A>(work mut scan.Work<A>&, dh tensor.Tensor<S>, h tensor.Tensor<S>, x tensor.Tensor<S>, a tensor.Tensor<S>, b tensor.Tensor<S>, ctx I64, init mut mat.Mat<A>&, dstate mut mat.Mat<A>&, dx mut tensor.Tensor<S>&, dxAdd Bool, da mut tensor.Tensor<S>&, daAdd Bool, db mut tensor.Tensor<S>&, dbAdd Bool) {
    zero(init)
    zero(dstate)
    freshZero(dx, dxAdd)
    freshZero(da, daAdd)
    freshZero(db, dbAdd)
    dxm := rows(dx)
    dam := rows(da)
    dbm := rows(db)
    dhm, hm, xm, am, bm := rows(dh), rows(h), rows(x), rows(a), rows(b)
    scan.GatedScanGrad(work, dxm, dam, dbm, dstate, dhm, hm, init, xm, am, bm, scan.Seq(ctx), true)
}

# a gradient about to be added to by a kernel with one add flag for several: zeroed first where it is written fresh
fn freshZero<S>(t mut tensor.Tensor<S>&, add Bool) {
    if not add: t.Fill(S(0.0))
}

# Mamba's selective scan (kernels/scan's SelectiveScan): x, delta [b, t, D], a [N, D], b and c [b, t, N], skip [D] or
# empty; keep receives the state at the start of every chunk
fn SelectiveScan<S, A>(work mut scan.Work<A>&, y mut tensor.Tensor<S>&, state mut mat.Mat<A>&, x tensor.Tensor<S>, delta tensor.Tensor<S>, a tensor.Tensor<S>, b tensor.Tensor<S>, c tensor.Tensor<S>, skip tensor.Tensor<S>, ctx I64, keep mut Array<A>&) {
    zero(state)
    ym := rows(y)
    sk :~ flat(skip) if skip.Count() > 0 else flat(y)[0:0]
    xm, dm, am, bm, cm := rows(x), rows(delta), rows(a), rows(b), rows(c)
    scan.SelectiveScan(work, ym, state, xm, dm, am, bm, cm, sk, scan.Seq(ctx), keep)
}

# the gradients (each written or added to; one not wanted given scratch to write into), dstate scratch in A
fn SelectiveScanBackward<S, A>(work mut scan.Work<A>&, dy tensor.Tensor<S>, x tensor.Tensor<S>, delta tensor.Tensor<S>, a tensor.Tensor<S>, b tensor.Tensor<S>, c tensor.Tensor<S>, skip tensor.Tensor<S>, ctx I64, keep Array<A>&, dstate mut mat.Mat<A>&, dx mut tensor.Tensor<S>&, addX Bool, ddelta mut tensor.Tensor<S>&, addD Bool, da mut tensor.Tensor<S>&, addA Bool, db mut tensor.Tensor<S>&, addB Bool, dc mut tensor.Tensor<S>&, addC Bool, dskip mut tensor.Tensor<S>&, addS Bool) {
    zero(dstate)
    freshZero(dx, addX)
    freshZero(ddelta, addD)
    freshZero(da, addA)
    freshZero(db, addB)
    freshZero(dc, addC)
    dxm := rows(dx)
    ddm := rows(ddelta)
    dam := rows(da)
    dbm := rows(db)
    dcm := rows(dc)
    empty :~ flat(dy)[0:0]
    if skip.Count() > 0: freshZero(dskip, addS)
    dsk :~ flat(dskip) if skip.Count() > 0 else empty
    sk :~ flat(skip) if skip.Count() > 0 else empty
    dym, xm, dm, am, bm, cm := rows(dy), rows(x), rows(delta), rows(a), rows(b), rows(c)
    scan.SelectiveScanGrad(work, dxm, ddm, dam, dbm, dcm, dsk, dstate, dym, xm, dm, am, bm, cm, sk, keep, scan.Seq(ctx), true)
}

# the delta rule (kernels/scan's DeltaRule): q, k [b, t, H dk], v [b, t, H dv], beta and gate [b, t, H]
fn DeltaRule<S, A>(work mut scan.Work<A>&, out mut tensor.Tensor<S>&, state mut mat.Mat<A>&, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, beta tensor.Tensor<S>, gate tensor.Tensor<S>, ctx I64, heads I64, keep mut Array<A>&) {
    zero(state)
    om := rows(out)
    qm, km, vm, bm, gm := rows(q), rows(k), rows(v), rows(beta), rows(gate)
    at := scan.Seq(ctx, 64, heads)
    # the chunked (WY) form where it is faster: heads of 128 or wider (measured, bench/scan; at 64 the forms tie)
    if qm.Cols / heads >= 128 and ctx >= 64 { scan.DeltaRuleChunked(work, om, state, qm, km, vm, bm, gm, at, keep) } else { scan.DeltaRule(work, om, state, qm, km, vm, bm, gm, at, keep) }
}

# the delta rule while decoding: n new positions of each sequence by the recurrent form, from the state the last call left
# (from zeros where fresh, the first positions), which holds the state after them on return
fn DeltaRuleStep<S, A>(work mut scan.Work<A>&, out mut tensor.Tensor<S>&, state mut mat.Mat<A>&, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, beta tensor.Tensor<S>, gate tensor.Tensor<S>, n I64, heads I64, fresh Bool) {
    if fresh: zero(state)
    om := rows(out)
    qm, km, vm, bm, gm := rows(q), rows(k), rows(v), rows(beta), rows(gate)
    scan.DeltaRule(work, om, state, qm, km, vm, bm, gm, scan.Seq(n, 64, heads), state.Data[0:0])
}

fn DeltaRuleBackward<S, A>(work mut scan.Work<A>&, dout tensor.Tensor<S>, q tensor.Tensor<S>, k tensor.Tensor<S>, v tensor.Tensor<S>, beta tensor.Tensor<S>, gate tensor.Tensor<S>, ctx I64, heads I64, keep Array<A>&, dstate mut mat.Mat<A>&, dq mut tensor.Tensor<S>&, addQ Bool, dk mut tensor.Tensor<S>&, addK Bool, dv mut tensor.Tensor<S>&, addV Bool, dbeta mut tensor.Tensor<S>&, addB Bool, dgate mut tensor.Tensor<S>&, addG Bool) {
    zero(dstate)
    freshZero(dq, addQ)
    freshZero(dk, addK)
    freshZero(dv, addV)
    freshZero(dbeta, addB)
    freshZero(dgate, addG)
    dqm := rows(dq)
    dkm := rows(dk)
    dvm := rows(dv)
    dbm := rows(dbeta)
    dgm := rows(dgate)
    om, qm, km, vm, bm, gm := rows(dout), rows(q), rows(k), rows(v), rows(beta), rows(gate)
    at := scan.Seq(ctx, 64, heads)
    # the chunked form: 1.6-2.7x the sequential one (bench/scan)
    if ctx >= 64 { scan.DeltaRuleGradChunked(work, dqm, dkm, dvm, dbm, dgm, dstate, om, qm, km, vm, bm, gm, keep, at, true) } else { scan.DeltaRuleGrad(work, dqm, dkm, dvm, dbm, dgm, dstate, om, qm, km, vm, bm, gm, keep, at, true) }
}

# ---- reductions ----

# y = the sum over x's last axis (mean: divided by its length)
fn SumLast<S, A>(y mut tensor.Tensor<S>&, x tensor.Tensor<S>, mean Bool) {
    xm := rows(x)
    yd :~ flat(y)
    k := A(1.0) / A(xm.Cols) if mean else A(1.0)
    for r in range xm.Rows: yd[r] = S(k * elem.SumIn<S, A>(xm.Data, xm.Off + r * xm.Ld, xm.Cols))
}

# dx (+)= dy spread over each row (divided by its length for the mean)
fn SumLastBackward<S, A>(dy tensor.Tensor<S>, mean Bool, dx mut tensor.Tensor<S>&, add Bool) {
    d := rows(dx)
    g :~ flat(dy)
    k := A(1.0) / A(d.Cols) if mean else A(1.0)
    for r in range d.Rows {
        v := k * A(g[r])
        o := d.Off + r * d.Ld
        for c in range d.Cols: d.Data[o + c] = S(A(d.Data[o + c]) + v if add else v)
    }
}

# ---- views ----

# dst += src, element by element, both of one shape and any strides, dd being dst's storage (written where not add):
# the backward of a view, through the view's strides over its base's gradient
fn AddInto<S, A>(dd mut Array<S>&, dst mut tensor.Tensor<S>&, src tensor.Tensor<S>, add Bool, threads I64 = 1) {
    if not add {
        try dst.Convert(src) catch { unreachable }
        return
    }
    lead := leadingRuns(dst)
    if lead == 0 or threads <= 1 or src.Count() < actSplitFrom {
        walkAdd<S, A>(dd, dst, src, 0, dst.Offset, src.Offset)
        return
    }
    # the leading axes' positions (one or two axes, merged) in runs: a position's elements of dst lie within one stride
    # of the last leading axis and no other position's do, so each element is added to by one task in walkAdd's order
    d1 := dst.Dim(1) if lead == 2 else 1
    count := dst.Dim(0) * d1
    step := dst.Strides[lead - 1]
    t := threads.Min(count)
    share := (count + t - 1) / t
    join {
        for j in range t {
            lo, hi := j * share, lesserOf(count, (j + 1) * share)
            if lo < hi: spawn addRuns<S, A>(dd[dst.Offset + lo * step:dst.Offset + hi * step], dst, src, lead, d1, lo, hi)
        }
    }
}

# how many leading axes of dst (0, 1 or 2) AddInto may split its work by: each has a stride other than 0, the second's
# positions run on from the first's (stride0 = dim1 stride1), and one position's elements lie within one stride of the
# last (the inner axes' reach is less than it)
fn leadingRuns<S>(dst tensor.Tensor<S>&) I64 {
    r := dst.Rank()
    if r < 2 or dst.Strides[0] <= 0: return 0
    lead := 2 if r >= 3 and dst.Strides[1] > 0 and dst.Strides[0] == dst.Dim(1) * dst.Strides[1] else 1
    reach I64 = 1
    for a in range lead, r: reach += (dst.Dim(a) - 1) * dst.Strides[a].Max(0)
    for a in range lead, r {
        if dst.Strides[a] < 0: return 0
    }
    return lead if reach <= dst.Strides[lead - 1] else 0
}

# a task's leading positions lo .. hi - 1 of AddInto, dd the run of dst's storage they reach (from position lo)
fn addRuns<S, A>(dd mut Array<S>&, dst tensor.Tensor<S>&, src tensor.Tensor<S>&, lead I64, d1 I64, lo I64, hi I64) {
    step := dst.Strides[lead - 1]
    for p in range lo, hi {
        i0, i1 := p / d1, p % d1
        s := src.Offset + i0 * src.Strides[0] + (i1 * src.Strides[1] if lead == 2 else 0)
        walkAdd<S, A>(dd, dst, src, lead, (p - lo) * step, s)
    }
}

# dst's elements from axis `axis` on, plus src's - a recursion over the axes, for strides of any kind, an Expand's 0
# included (an element read through a stride of 0 is added to as many times as it is read)
fn walkAdd<S, A>(dd mut Array<S>&, dst tensor.Tensor<S>&, src tensor.Tensor<S>&, axis I64, d I64, s I64) {
    sd :~ storageOf(src)
    if axis == dst.Rank() - 1 {
        for i in range dst.Dim(axis) {
            o := d + i * dst.Strides[axis]
            dd[o] = S(A(dd[o]) + A(sd[s + i * src.Strides[axis]]))
        }
        return
    }
    for i in range dst.Dim(axis): walkAdd<S, A>(dd, dst, src, axis + 1, d + i * dst.Strides[axis], s + i * src.Strides[axis])
}
