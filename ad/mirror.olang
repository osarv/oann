# ad/mirror - a planned graph on the GPU (docs/redesign.md 1.10, GP6): the device mirror of ad/graph's arena. The graph lays
# its parameters, gradients, inputs and activations out in one array (graph.olang, "Captured"); on the GPU the same
# array is one buffer of the same length and every node's value, gradient, kept tensors and scratch are at the same
# element offsets, so the plan is the CPU's - its liveness reuse included - and a step is a list of launches over it.
# Built only with -define Gpu=true (kernels/gpu asserts it); ad/graph imports it under `if Gpu`.
#
# The graph lowers each node to a `Step` (plain numbers: the operation, the offsets of its operands' values and
# gradients, its sizes) at Plan; the mirror runs step i's forward or backward at the entries in use. It knows nothing of
# graph.olang (which imports it), so the order, which gradients are added to rather than written (the graph's `acc`),
# and what a loss's backward starts from stay the graph's.
#
# What runs where. Products are cuBLAS (blas.Gemm; attention's per-head products cuBLASLt's batched `Product`, planned
# per batch size on first use); everything else is kernels/gpu/src/ad.cu, one launch an operation (softmax, norms,
# losses and sums reduce one block a row in a fixed order, no atomics, so a run is the same bit for bit every time on
# one GPU; the sums' order is not the CPU's, so results agree within rounding, not bit for bit). Attention's causal
# products are full (cuBLASLt has no triangular product) and its softmax kernel masks: the weights are zero above the
# diagonal and so is dS. The graph's step allocates nothing on the device or the host: every buffer is made at Plan.
#
# Who owns what: the device owns the arena while the loop runs; the graph (graph.olang) keeps one flag a side and
# brings the arena down where the host reads a value, a gradient or a parameter, and up where the host has written them
# (the parameters; inputs go up at every Forward).

import cu "../kernels/gpu/cuda.c"
import gdev "../kernels/gpu/device"
import "../kernels/gpu/kern"
import "../kernels/gpu/blas"

Gpu Bool = false

assert Gpu, "ad/mirror is the GPU's and is built only with -define Gpu=true: import it under if Gpu { ... }"

# the operations with a GPU form, and Unsupported for the rest (named by the graph)
type Work enum {
    Nothing
    Unsupported
    Linear
    MatMul
    Add
    Sub
    Mul
    Scale
    Act
    Leaky
    Softmax
    LogSoftmax
    Norm
    Embedding
    Positions
    Attention
    CrossEntropy
    Mse
    Copy
    Reshape
    Sum
    Gather          # GP8: a view read through its strides into a dense run (a Contiguous copy)
    ViewBack        # GP8: a Permute's, Slice's or Expand's gradient into its base's (nothing forward)
    Shift
    Sqrt
    Log
    Stablemax       # stablemax cross entropy
    Rope
    ChunkCE         # cross entropy of x w^T, the vocabulary a chunk at a time (ChunkedCE)
    Moe             # a mixture of experts (nn/moe's Experts, a Custom with Function.GpuSpec): see moeForward
}

# one node, lowered: offsets are elements of the arena (-1: none), ints those of the I32 region
type Step struct(Do Work) {
    Do
    Y I64 = -1              # its value
    A I64 = -1              # its inputs' values
    B I64 = -1
    C I64 = -1
    DY I64 = -1             # its gradient, and its inputs' (-1: not wanted)
    DA I64 = -1
    DB I64 = -1
    DC I64 = -1
    Saved I64 = -1
    Scratch I64 = -1
    IntA I64 = -1           # the tokens or classes it reads
    Rows I64 = 0            # the main operand's rows (its elements over its last axis) and last axis, at the planned batch
    Cols I64 = 0
    Inner I64 = 0           # a product's depth; a table's rows (Embedding, Positions); a loss's slot
    Batched Bool = false    # the main operand has the batch on its first axis: its rows are Rows / batch each entry
    BatchLast Bool = false  # ... and that axis is its only one ([batch]): one row of the entries in use (GP8)
    TA Bool = false
    TB Bool = false
    Flag Bool = false       # Norm: rms; Attention: causal; Sum: mean
    Code I64 = 0            # Act: mat.Act's number
    Heads I64 = 0
    Ctx I64 = 0
    Window I64 = 0          # Attention: the sliding window (0: none); its IntA the document starts (-1: none)
    K F64 = 0.0             # Scale's factor, LeakyRelu's slope, Norm's eps
    Geo I64 = -1            # Gather, ViewBack, a MatMul of stacks: its geometry's first element in the mirror's table
    Node I64 = -1           # the graph's node it is
    QCodes I64 = -1         # Linear of NF4 weights: their codes' first byte in the mirror's QCodes (-1: not NF4) ...
    QScales I64 = -1        # ... and their first scale in QScales; dequantized into B before each product reading B
    Vocab I64 = 0           # ChunkCE: w's rows, the chunk's columns, and its rows' state in the mirror's Side (3 Rows)
    Chunk I64 = 0
    Side I64 = -1
}

# A Moe step (nn/moe's Experts on the device): Rows the tokens (x's rows) at the planned batch, Cols the width D, Inner
# the experts' hidden width H, Heads the experts E, Ctx the experts a token takes K, Flag whether the gates are
# renormalized, K the balance loss's weight; Geo its 3 E + 2 inputs' value offsets (x, the router, E Gate, E Up, E Down
# matrices: separate parameters, anywhere in the arena) and then their gradients' (-1: not wanted); Saved its kept rows
# by expert (xg, h1, h3, act, yg: R D, R H, R H, R H, R D elements, R = Rows K), Scratch its backward's (dyg, da, dh1,
# dh3, dxg: the same sizes, then the logits' gradient, Rows E): graph.olang's customExtras

# a view's geometry, GeoSize numbers in the mirror's table: the rank, the window's axis (-1: none), its low and high
# bounds, the dims (6), the strides read at (6), dy's strides (6, an Expand's gradient), the kernel (0 gather, 1 unexpand).
# A MatMul of two stacks of matrices (both operands batched: GP8): the groups (the first axis) and members (the second
# of four, else 1), then a's group stride, member stride and row stride, then b's - each operand read through its own
# strides (a permuted view of heads as it is, with no copy)
GeoSize := 24

# rows of the main operand at n entries in use
fn (s Step&) RowsAt(n I64, batch I64) I64 {
    if s.BatchLast: return 1
    return s.Rows / batch * n if s.Batched else s.Rows
}

# the main operand's last axis at n entries in use: the entries themselves where it is the batch's
fn (s Step&) ColsAt(n I64) I64 { return n if s.BatchLast else s.Cols }

# kernel numbers: the order of Names
KAct := 0
KActGrad := 1
KLeaky := 2
KLeakyGrad := 3
KFill := 4
KCopy := 5
KPut := 6
KCombine := 7
KMul := 8
KMulGrad := 9
KScale := 10
KBias := 11
KColSum := 12
KSoftmax := 13
KSoftmaxGrad := 14
KLse := 15
KLogSoftmax := 16
KLogSoftmaxGrad := 17
KNormStats := 18
KNormApply := 19
KNormGrad := 20
KNormParam := 21
KEmbed := 22
KEmbedGrad := 23
KPositions := 24
KPositionsGrad := 25
KSumLast := 26
KSumLastGrad := 27
KCeRows := 28
KCeTotal := 29
KCeGrad := 30
KMse := 31
KMseGrad := 32
KSumsq := 33
KClip := 34
KAdamW := 35
KGather := 36
KUnexpand := 37
KShift := 38
KSqrt := 39
KSqrtGrad := 40
KLog := 41
KLogGrad := 42
KSmRows := 43
KSmGrad := 44
KRope := 45
KNf4 := 46
KCceRows := 47
KCceGrad := 48
KMoeRoute := 49
KMoeRows := 50
KMoeGather := 51
KMoeAct := 52
KMoeCombine := 53
KMoeScatter := 54
KMoeActGrad := 55
KMoeDx := 56
KMoeRouterGrad := 57

Names := Array<String>["oann_ad_act", "oann_ad_act_grad", "oann_ad_leaky", "oann_ad_leaky_grad", "oann_ad_fill", "oann_ad_copy", "oann_ad_put"
    "oann_ad_combine", "oann_ad_mul", "oann_ad_mul_grad", "oann_ad_scale", "oann_ad_bias", "oann_ad_colsum", "oann_ad_softmax"
    "oann_ad_softmax_grad", "oann_ad_lse", "oann_ad_logsoftmax", "oann_ad_logsoftmax_grad", "oann_ad_norm_stats", "oann_ad_norm_apply"
    "oann_ad_norm_grad", "oann_ad_norm_param_grad", "oann_ad_embed", "oann_ad_embed_grad", "oann_ad_positions", "oann_ad_positions_grad"
    "oann_ad_sumlast", "oann_ad_sumlast_grad", "oann_ad_ce_rows", "oann_ad_ce_total", "oann_ad_ce_grad", "oann_ad_mse", "oann_ad_mse_grad"
    "oann_ad_sumsq", "oann_ad_clip", "oann_ad_adamw", "oann_ad_gather", "oann_ad_unexpand", "oann_ad_shift", "oann_ad_sqrt"
    "oann_ad_sqrt_grad", "oann_ad_log", "oann_ad_log_grad", "oann_ad_sm_rows", "oann_ad_sm_grad", "oann_ad_rope", "oann_ad_nf4"
    "oann_ad_cce_rows", "oann_ad_cce_grad", "oann_moe_route", "oann_moe_rows", "oann_moe_gather", "oann_moe_act", "oann_moe_combine"
    "oann_moe_scatter", "oann_moe_act_grad", "oann_moe_dx", "oann_moe_router_grad"]

# the text of the kernels for real type T: the prelude, elem.cu, the typedef, ad.cu
fn Source<T>(like T) String {
    return kern.ElemSource() + "\n// ad/mirror.olang: the specialization\n" + storeText(like) + kern.AdText
}

# what ad.cu computes in (real) and the arena holds (store): the graph's type for F32 and F64; F32 over 16-bit words for
# BF16, rounded to nearest even as the CPU rounds a BF16 graph's values
fn storeText<T>(like T) String {
    match T {
        case BF16 {
            return "struct oann_bf16 {\n    unsigned short bits;\n    __device__ __forceinline__ oann_bf16() {}\n" +
                "    __device__ __forceinline__ oann_bf16(float f) {\n        unsigned int u = __float_as_uint(f);\n" +
                "        bits = (u & 0x7fffffffu) > 0x7f800000u ? (unsigned short)((u >> 16) | 0x40u) : (unsigned short)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);\n    }\n" +
                "    __device__ __forceinline__ operator float() const { return __uint_as_float((unsigned int)bits << 16); }\n};\n" +
                "typedef float real;\ntypedef oann_bf16 store;\n"
        }
        case _ { return "typedef " + kern.RealName(like) + " real;\ntypedef real store;\n" }
    }
}

# a real argument of the kernels: F64 for an F64 graph, else F32 (what a BF16 graph computes in)
fn rl<T>(x F64) U64 {
    return match T {
        case F64: kern.Arg(x)
        case _: kern.Arg(F32(x))
    }
}

# whether the graph's parameters have F32 masters (a BF16 graph), stepped on the device beside the arena
fn hasMasters<T>() Bool {
    return match T {
        case BF16: true
        case _: false
    }
}

# the bytes of a real
fn realSize<T>() I64 {
    return match T {
        case F64: 8
        case _: 4
    }
}

# attention's six products at one batch size, planned (an empty Product where a gradient is not wanted)
type AttnPlan<T> unique struct(dev gdev.Device&, node I64, n I64) {
    dev
    node
    n
    scores blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    pv blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    dp blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    dq blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    dk blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    dv blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
}

# a MatMul of two stacks' products at the planned batch: forward, and the two gradients (an empty Product where not wanted)
type MatPlan<T> unique struct(dev gdev.Device&, node I64) {
    dev
    node
    fwd blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    da blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
    db blas.Product<T, T, T> = blas.Product<T, T, T>(dev)
}

# a Moe step's routing on the device, made at Plan for its planned tokens: the router's logits and probabilities, each
# slot's expert, gate, gate's gradient and row, each row's token, the rows per expert and the counting block's runs
# (F32 and I32, whatever the arena holds), the selection bias; on the host the rows per expert of the last Forward
# (Counts, downloaded: the expert products' sizes), their starts, and the backward's adds by input (Adds, the graph's)
type MoePlan unique struct(node I64, e I64, logits gdev.Buf<F32>, probs gdev.Buf<F32>, gate gdev.Buf<F32>, dgate gdev.Buf<F32>, bias gdev.Buf<F32>, sel gdev.Buf<I32>, pos gdev.Buf<I32>, tok gdev.Buf<I32>, count gdev.Buf<I32>, part gdev.Buf<I32>) {
    node
    logits
    probs
    gate
    dgate
    bias
    sel
    pos
    tok
    count
    part
    hostCount mut Array<I32>& = Array<I32>(e)
    Counts mut Array<I64>& = Array<I64>(e)
    starts mut Array<I64>& = Array<I64>(e)
    Adds mut Array<Bool>& = Array<Bool>(3 * e + 2)
}

fn MoePlan.Make(d mut gdev.Device&, s Step&) MoePlan ? gdev.GpuError {
    n, e, k := s.Rows, s.Heads, s.Ctx
    p := MoePlan(s.Node, e, try gdev.Buf<F32>.Make(d, n * e), try gdev.Buf<F32>.Make(d, n * e), try gdev.Buf<F32>.Make(d, n * k), try gdev.Buf<F32>.Make(d, n * k), try gdev.Buf<F32>.Make(d, e), try gdev.Buf<I32>.Make(d, n * k), try gdev.Buf<I32>.Make(d, n * k), try gdev.Buf<I32>.Make(d, n * k), try gdev.Buf<I32>.Make(d, e), try gdev.Buf<I32>.Make(d, 257 * e))
    kern.Zero(d, p.bias.Addr(0), e * 4)
    return p
}

# AdamW's state on the device: the moments and the per-parameter decay mask, the steps taken
type AdamW<T> unique struct(m gdev.Buf<U8>, v gdev.Buf<U8>, mask gdev.Buf<U8>, hp gdev.Buf<F64>, rate F64, beta1 F64, beta2 F64, eps F64, decay F64) {
    M gdev.Buf<U8> = m                # the moments in real (F32 for a BF16 graph), as bytes
    V gdev.Buf<U8> = v
    mask
    Hp gdev.Buf<F64> = hp             # keep, step and root of the step in hand: the kernel reads them, so a CUDA graph's replay has each step's
    hostHp mut Array<F64>& = Array<F64>(3)
    Rate F64 = rate
    Beta1 F64 = beta1
    Beta2 F64 = beta2
    Eps F64 = eps
    Decay F64 = decay
    Steps I64 = 0
}

# a planned graph's mirror on dev: Mem the arena (size elements, the first params of them the parameters, the gradients
# the next params), Ints the tokens and classes, Stats two F64 a node (a loss's value and the entries it counted; two
# more at the end for the gradients' norm), RowLoss a cross entropy's rows' losses, Side ChunkCE's rows' state
type Mirror<T> unique struct(dev mut gdev.Device&, size I64, ints I64, nodes I64, params I64, batch I64, rowloss I64, kit kern.Kit, steps Array<Step>, geo Array<I64>, mem gdev.Buf<T>, intMem gdev.Buf<I32>, stats gdev.Buf<F64>, losses gdev.Buf<F64>, masters gdev.Buf<F32>, qcodes gdev.Buf<U8>, qscales gdev.Buf<F32>, side gdev.Buf<F64>) {
    dev
    geo
    Size I64 = size
    params
    batch
    kit
    steps
    Mem gdev.Buf<T> = mem
    Ints gdev.Buf<I32> = intMem
    Stats gdev.Buf<F64> = stats
    RowLoss gdev.Buf<F64> = losses
    Masters gdev.Buf<F32> = masters     # a BF16 graph's parameters in F32 (what AdamW steps), else one unused word
    QCodes gdev.Buf<U8> = qcodes        # the graph's NF4 weights (kernels/nf4): codes two a byte, at the host's offsets
    QScales gdev.Buf<F32> = qscales     # and their blocks' absmax
    Side gdev.Buf<F64> = side           # ChunkCE's running maxima, sums, class logits, then log-sum-exps (Step.Side)
    HasMasters Bool = hasMasters<T>()
    plans mut Vec<AttnPlan<T>>& = Vec<AttnPlan<T>>()
    mplans mut Vec<MatPlan<T>>& = Vec<MatPlan<T>>()
    moes mut Vec<MoePlan>& = Vec<MoePlan>()
    nodes
    Graphs mut gdev.Graphs& = gdev.Graphs(64)     # GP7: whole training steps captured once and replayed
    Key mut Array<U64>& = Array<U64>(8)
    Warm Bool = false
}

# ---- the plan ----

# the mirror of a graph of these steps, its arena of size elements (params of them parameters), ints I32s, planned for
# batch entries: the buffers allocated and the kernels compiled now. rowloss: the most rows a cross entropy takes; geo
# the views' geometries (Step.Geo); qcodes and qscales the NF4 weights' bytes of codes and scales (0: none); side the F64s of ChunkCE's rows' state (Step.Side)
fn Mirror<T>.Make(dev mut gdev.Device&, steps Array<Step>&, geo Array<I64>&, size I64, params I64, ints I64, batch I64, rowloss I64, qcodes I64 = 0, qscales I64 = 0, side I64 = 1) Mirror<T> ? gdev.GpuError {
    z T
    m := Mirror<T>(dev, size, ints, steps.Len(), params, batch, rowloss, try kern.Kit.Compile(dev, Source(z), Names), steps, geo, try gdev.Buf<T>.Make(dev, size), try gdev.Buf<I32>.Make(dev, ints), try gdev.Buf<F64>.Make(dev, 2 * steps.Len() + 4), try gdev.Buf<F64>.Make(dev, rowloss), try gdev.Buf<F32>.Make(dev, params if hasMasters<T>() else 1), try gdev.Buf<U8>.Make(dev, qcodes.Max(1)), try gdev.Buf<F32>.Make(dev, qscales.Max(1)), try gdev.Buf<F64>.Make(dev, side.Max(1)))
    try m.planAll()
    kern.Zero(dev, m.Mem.Addr(0), size * T.Size)
    kern.Zero(dev, m.Stats.Addr(0), (2 * steps.Len() + 4) * 8)
    try dev.Sync()
    return m
}

# ---- launching ----

fn (m Mirror<T>&) at(i I64) U64 { return m.Mem.Addr(i) }

# the threads of a row kernel's block for a row of cols elements: a power of two from 32 to 256
fn RowBlock(cols I64) I64 {
    b I64 = 32
    for b < cols and b < 256: b *= 2
    return b
}

fn mat<T>(m Mirror<T>&, off I64, rows I64, cols I64) gdev.DMat<T> { return gdev.DMat<T>(m.Mem, off, rows, cols, cols) }

# a failure of the device ends the program with CUDA's words (a step has no error to give back as)
fn (m mut Mirror<T>&) sync() {
    st := cu.oann_stream_sync(m.dev.Stream())
    if st != 0 or cu.oann_status_kind(m.dev.Status()) != 0 {
        try m.dev.Sync() catch gdev.GpuError err { unreachable "the GPU failed: " + $err }
        unreachable "the GPU failed: " + gdev.Text(cu.cudaGetErrorString(st))
    }
}

# waits for everything enqueued
fn (m mut Mirror<T>&) Sync() { m.sync() }

# kernel k over n elements, a grid-stride launch
fn (m mut Mirror<T>&) elems(k I64, n I64, args ...U64) {
    if n <= 0: return
    d := m.dev
    kern.LaunchKit(d, m.kit, k, kern.Blocks(n), kern.Block, ...args)
}

# kernel k, one block of `block` threads a row, rows of them
fn (m mut Mirror<T>&) rowk(k I64, rows I64, cols I64, args ...U64) {
    if rows <= 0: return
    d := m.dev
    kern.LaunchKit(d, m.kit, k, rows, RowBlock(cols), ...args)
}

# kernel k over cols columns in tiles: a block of 1024 threads a 32 columns (the column sums' kernels)
fn (m mut Mirror<T>&) tiles(k I64, cols I64, args ...U64) {
    if cols <= 0: return
    d := m.dev
    kern.LaunchKit(d, m.kit, k, (cols + 31) / 32, 1024, ...args)
}

# kernel k in one block (reductions over a whole array)
fn (m mut Mirror<T>&) once(k I64, args ...U64) {
    d := m.dev
    kern.LaunchKit(d, m.kit, k, 1, 256, ...args)
}

fn n64(x I64) U64 { return kern.Arg(x) }

# an attention's document starts on the device (packed documents), or 0 for none
fn (m Mirror<T>&) startsOf(s Step&) U64 { return 0 if s.IntA < 0 else m.Ints.Addr(s.IntA) }

fn flag(b Bool) U64 { return 1 if b else 0 }

# attention's operands as batches: the rows of x in sequences of ctx, its columns in heads; the weights stacked. A local
# between, never a call's value lent on (repro/tempfacts, fixed in olang and removed 2026-11-21)
fn headsOf<T>(m Mirror<T>&, off I64, rows I64, cols I64, ctx I64, heads I64) gdev.DBatch<T> {
    x := mat(m, off, rows, cols)
    return gdev.DBatch<T>.Heads(x, ctx, heads)
}

fn stackedOf<T>(m Mirror<T>&, off I64, rows I64, cols I64, ctx I64, heads I64) gdev.DBatch<T> {
    x := mat(m, off, rows, cols)
    return gdev.DBatch<T>.Stacked(x, ctx, heads)
}

# C = op(A) op(B) + beta C over views of the arena
fn (m mut Mirror<T>&) product(c I64, cr I64, cc I64, a I64, ar I64, ac I64, ta Bool, b I64, br I64, bc I64, tb Bool, add Bool) {
    cm := mat(m, c, cr, cc)
    am := mat(m, a, ar, ac)
    bm := mat(m, b, br, bc)
    blas.Gemm<T, F64>(m.dev, cm, am, ta, bm, tb, 1.0, 1.0 if add else 0.0)
}

# ---- crossing ----

# n elements of host from host[from] up to b from element to, on the compute stream: after every launch enqueued before
# it, which may still read what it overwrites (GP8: an input written between a Forward and its Backward went up on the
# copy stream, ordered before what came after but not after what came before - the Forward still in flight read the
# new value), and before every launch after it
fn upload<S>(d mut gdev.Device&, b gdev.Buf<S>&, host Array<S>&, from I64, to I64, n I64) {
    if n <= 0: return
    sz := U64(S.Size)
    cu.oann_upload(d.Status(), b.Addr(to), host, U64(from) * sz, U64(n) * sz, d.Stream(), d.Uploaded(), d.Stream())
}

# host[from ... from + n - 1] up to the arena at the same offsets
fn (m mut Mirror<T>&) Upload(host Array<T>&, from I64, n I64) {
    d := m.dev
    upload(d, m.Mem, host, from, from, n)
}

# a BF16 graph's masters up from the host's
fn (m mut Mirror<T>&) UploadMasters(host Array<F32>&) {
    d := m.dev
    upload(d, m.Masters, host, 0, 0, m.params)
}

# ... and down into the host's, and waits
fn (m mut Mirror<T>&) DownloadMasters(host mut Array<F32>&) {
    m.Masters.Download(host, 0, 0, m.params)
    m.sync()
}

# NF4 weights' codes (cn bytes from codes[c0]) and scales (sn from scales[s0]) up to the same offsets
fn (m mut Mirror<T>&) UploadQuant(codes Array<U8>&, c0 I64, cn I64, scales Array<F32>&, s0 I64, sn I64) {
    d := m.dev
    upload(d, m.QCodes, codes, c0, c0, cn)
    upload(d, m.QScales, scales, s0, s0, sn)
}

# a Linear's NF4 weights (s.QCodes >= 0) dequantized into its B, s.Inner x s.Cols, in the arena's type
fn (m mut Mirror<T>&) dequantize(s Step&) {
    if s.QCodes < 0: return
    n := s.Inner * s.Cols
    m.elems(KNf4, n, m.at(s.B), m.QCodes.Addr(s.QCodes), m.QScales.Addr(s.QScales), n64(n))
}

fn (m mut Mirror<T>&) UploadInts(host Array<I32>&, from I64, n I64) {
    d := m.dev
    upload(d, m.Ints, host, from, from, n)
}

# the whole arena down into host, and waits
fn (m mut Mirror<T>&) Download(host mut Array<T>&) {
    m.Mem.Download(host, 0, 0, m.Size)
    m.sync()
}

# n elements of the arena from `from` down into host's, and waits
fn (m mut Mirror<T>&) DownloadRange(host mut Array<T>&, from I64, n I64) {
    if n <= 0: return
    m.Mem.Download(host, from, from, n)
    m.sync()
}

# the value of loss slot i as F64: the F64 the kernel summed, not the T it was rounded to
fn (m mut Mirror<T>&) Loss(i I64) F64 {
    one := Array<F64>(1)
    m.Stats.Download(one, 2 * i, 0, 1)
    m.sync()
    return one[0]
}

# n elements from `at` set to v
fn (m mut Mirror<T>&) Fill(at I64, n I64, v F64) { m.elems(KFill, n, m.at(at), rl<T>(v), n64(n)) }

# ---- forward ----

# step s's forward at n entries in use, the first position of the step pos
fn (m mut Mirror<T>&) Forward(s Step&, n I64, pos I64) {
    rows := s.RowsAt(n, m.batch)
    cols := s.ColsAt(n)
    count := rows * cols
    match s.Do {
        case Work.Linear {
            m.dequantize(s)
            m.product(s.Y, rows, s.Inner, s.A, rows, cols, false, s.B, s.Inner, cols, true, false)
            if s.C >= 0: m.elems(KBias, count / cols * s.Inner, m.at(s.Y), m.at(s.C), n64(rows * s.Inner), n64(s.Inner))
        }
        case Work.MatMul {
            if s.Geo >= 0 {
                m.stacks(s, false, false, false)
                return
            }
            ar := s.Inner if s.TA else rows
            ac := rows if s.TA else s.Inner
            br := cols if s.TB else s.Inner
            bc := s.Inner if s.TB else cols
            m.product(s.Y, rows, cols, s.A, ar, ac, s.TA, s.B, br, bc, s.TB, false)
        }
        case Work.Add: m.elems(KCombine, count, m.at(s.Y), m.at(s.A), m.at(s.B), rl<T>(1.0), n64(count))
        case Work.Sub: m.elems(KCombine, count, m.at(s.Y), m.at(s.A), m.at(s.B), rl<T>(-1.0), n64(count))
        case Work.Mul: m.elems(KMul, count, m.at(s.Y), m.at(s.A), m.at(s.B), n64(count))
        case Work.Scale: m.elems(KScale, count, m.at(s.Y), m.at(s.A), rl<T>(s.K), n64(count))
        case Work.Act: m.elems(KAct, count, m.at(s.Y), m.at(s.A), n64(count), n64(s.Code))
        case Work.Leaky: m.elems(KLeaky, count, m.at(s.Y), m.at(s.A), n64(count), rl<T>(s.K))
        case Work.Copy: m.elems(KCopy, count, m.at(s.Y), m.at(s.A), n64(count))
        case Work.Softmax: m.rowk(KSoftmax, rows, cols, m.at(s.Y), m.at(s.A), n64(cols), n64(1), n64(0), n64(0), 0, n64(1))
        case Work.LogSoftmax: m.rowk(KLogSoftmax, rows, cols, m.at(s.Y), m.at(s.A), n64(cols))
        case Work.Norm {
            m.rowk(KNormStats, rows, cols, m.at(s.Saved), m.at(s.Saved + rows), m.at(s.A), n64(cols), rl<T>(s.K), flag(s.Flag))
            bias U64 = 0 if s.C < 0 else m.at(s.C)
            m.elems(KNormApply, count, m.at(s.Y), m.at(s.A), m.at(s.Saved), m.at(s.Saved + rows), m.at(s.B), bias, n64(count), n64(cols))
        }
        case Work.Embedding {
            m.elems(KEmbed, count, m.at(s.Y), m.Ints.Addr(s.IntA), m.at(s.B), n64(count), n64(cols))
        }
        case Work.Positions: m.elems(KPositions, count, m.at(s.Y), m.at(s.A), m.at(s.B), n64(count), n64(cols), n64(s.Ctx), n64(pos), n64(s.Inner))
        case Work.Attention: m.attentionForward(s, n, pos)
        case Work.CrossEntropy {
            m.rowk(KCeRows, rows, cols, m.at(s.Saved), m.RowLoss.Addr(0), m.at(s.A), m.Ints.Addr(s.IntA), n64(cols))
            m.once(KCeTotal, m.Stats.Addr(2 * s.Inner), m.at(s.Y), m.RowLoss.Addr(0), m.Ints.Addr(s.IntA), n64(rows))
        }
        case Work.Mse: m.once(KMse, m.Stats.Addr(2 * s.Inner), m.at(s.Y), m.at(s.A), m.at(s.B), n64(count))
        case Work.Sum {
            k T = T(1.0 / F64(cols)) if s.Flag else T(1.0)
            m.rowk(KSumLast, rows, cols, m.at(s.Y), m.at(s.A), n64(cols), kern.Arg(k))
        }
        case Work.Gather: m.view(s.Geo, s.Y, s.A, count, false)
        case Work.Shift: m.elems(KShift, count, m.at(s.Y), m.at(s.A), rl<T>(s.K), n64(count))
        case Work.Sqrt: m.elems(KSqrt, count, m.at(s.Y), m.at(s.A), n64(count))
        case Work.Log: m.elems(KLog, count, m.at(s.Y), m.at(s.A), n64(count))
        case Work.Stablemax {
            m.rowk(KSmRows, rows, cols, m.RowLoss.Addr(0), m.at(s.A), m.Ints.Addr(s.IntA), n64(cols))
            m.once(KCeTotal, m.Stats.Addr(2 * s.Inner), m.at(s.Y), m.RowLoss.Addr(0), m.Ints.Addr(s.IntA), n64(rows))
        }
        case Work.Rope: m.rope(s, s.Y, s.A, rows, cols, pos, 1.0, false)
        case Work.ChunkCE: m.chunkedForward(s, rows)
        case Work.Moe: m.moeForward(s, rows)
        case _ { }
    }
}

# ChunkCE's forward: each chunk's logits x w_c^T into the scratch, folded into the rows' state; the mean of the rows'
# losses after the last
fn (m mut Mirror<T>&) chunkedForward(s Step&, rows I64) {
    for q in range (s.Vocab + s.Chunk - 1) / s.Chunk {
        v0 := q * s.Chunk
        c := s.Chunk.Min(s.Vocab - v0)
        m.product(s.Scratch, rows, c, s.A, rows, s.Cols, false, s.B + v0 * s.Cols, c, s.Cols, true, false)
        m.rowk(KCceRows, rows, c, m.Side.Addr(s.Side), m.RowLoss.Addr(0), m.at(s.Scratch), m.Ints.Addr(s.IntA), n64(s.Rows), n64(c), n64(v0), flag(v0 + c >= s.Vocab))
    }
    m.once(KCeTotal, m.Stats.Addr(2 * s.Inner), m.at(s.Y), m.RowLoss.Addr(0), m.Ints.Addr(s.IntA), n64(rows))
}

# ChunkCE's backward: each chunk's logits again, made their gradient in place, then dx (+)= dz_c w_c and
# dw_c (+)= dz_c^T x
fn (m mut Mirror<T>&) chunkedBackward(s Step&, rows I64, add0 Bool, add1 Bool) {
    if s.DA < 0 and s.DB < 0: return
    for q in range (s.Vocab + s.Chunk - 1) / s.Chunk {
        v0 := q * s.Chunk
        c := s.Chunk.Min(s.Vocab - v0)
        m.product(s.Scratch, rows, c, s.A, rows, s.Cols, false, s.B + v0 * s.Cols, c, s.Cols, true, false)
        m.elems(KCceGrad, rows * c, m.at(s.Scratch), m.Side.Addr(s.Side), m.Ints.Addr(s.IntA), m.at(s.DY), m.Stats.Addr(2 * s.Inner), n64(rows * c), n64(c), n64(v0))
        if s.DA >= 0: m.product(s.DA, rows, s.Cols, s.Scratch, rows, c, false, s.B + v0 * s.Cols, c, s.Cols, false, add0 or v0 > 0)
        if s.DB >= 0: m.product(s.DB + v0 * s.Cols, c, s.Cols, s.Scratch, rows, c, true, s.A, rows, s.Cols, false, add1)
    }
}

# a view's kernel over n elements of y from x by the geometry at g (Step.Geo): a gather, or an Expand's gradient's sum
fn (m mut Mirror<T>&) view(g I64, y I64, x I64, n I64, add Bool) {
    if m.geo[g + 22] == 1 {
        m.elems(KUnexpand, n, m.at(y), m.at(x), n64(n), flag(add), n64(m.geo[g]), n64(m.geo[g + 4]), n64(m.geo[g + 5]), n64(m.geo[g + 6]), n64(m.geo[g + 7]), n64(m.geo[g + 8]), n64(m.geo[g + 9])
            n64(m.geo[g + 10]), n64(m.geo[g + 11]), n64(m.geo[g + 12]), n64(m.geo[g + 13]), n64(m.geo[g + 14]), n64(m.geo[g + 15]), n64(m.geo[g + 16]), n64(m.geo[g + 17]), n64(m.geo[g + 18]), n64(m.geo[g + 19]), n64(m.geo[g + 20]), n64(m.geo[g + 21]))
        return
    }
    m.elems(KGather, n, m.at(y), m.at(x), n64(n), flag(add), n64(m.geo[g]), n64(m.geo[g + 1]), n64(m.geo[g + 2]), n64(m.geo[g + 3]), n64(m.geo[g + 5]), n64(m.geo[g + 6]), n64(m.geo[g + 7]), n64(m.geo[g + 8]), n64(m.geo[g + 9])
        n64(m.geo[g + 10]), n64(m.geo[g + 11]), n64(m.geo[g + 12]), n64(m.geo[g + 13]), n64(m.geo[g + 14]), n64(m.geo[g + 15]))
}

# the attention plan of node s: made at Plan for the whole batch (Make) and used for any batch in use - a short batch runs
# the products of every sequence, the unused ones' results never read (sequences are independent, and the arena has the
# room), so no step plans, allocates or grows anything
fn (m Mirror<T>&) planFor(s Step&) I64 {
    for i in range m.plans.Len() {
        if m.plans[i].node == s.Inner: return i
    }
    unreachable "oann: an attention node with no plan"
}

fn (m mut Mirror<T>&) planAll() ? gdev.GpuError {
    for i in range m.steps.Len() {
        s := m.steps[i]
        if s.Do == Work.MatMul and s.Geo >= 0: m.mplans.Push(try m.planStacks(s))
        if s.Do == Work.Moe {
            d := m.dev
            m.moes.Push(try MoePlan.Make(d, s))
        }
        if s.Do != Work.Attention: continue
        qrows := m.batch * s.Ctx
        q := headsOf(m, s.A, qrows, s.Cols, s.Ctx, s.Heads)
        k := headsOf(m, s.B, qrows, s.Cols, s.Ctx, s.Heads)
        v := headsOf(m, s.C, qrows, s.Cols, s.Ctx, s.Heads)
        o := headsOf(m, s.Y, qrows, s.Cols, s.Ctx, s.Heads)
        p := stackedOf(m, s.Saved, qrows * s.Heads, s.Ctx, s.Ctx, s.Heads)
        m.plans.Push(try m.makePlan(s, m.batch, q, k, v, o, p))
    }
}

# ---- GP8: products of two stacks of matrices ----

# operand j's stack (0 a, 1 b, -1 dense: the product, the gradients) of the MatMul s: rows x cols matrices from off, as
# its geometry says. A short batch runs every matrix of the planned one, as attention does (the unused ones' results
# never read, within the buffers planned for them)
fn (m Mirror<T>&) stack(s Step&, off I64, rows I64, cols I64, j I64) gdev.DBatch<T> {
    g := s.Geo
    groups := m.geo[g]
    members := m.geo[g + 1]
    if j < 0: return gdev.DBatch<T>(m.Mem, off, rows, cols, cols, groups, members * rows * cols, members, rows * cols)
    o := g + 2 + 3 * j
    return gdev.DBatch<T>(m.Mem, off, rows, cols, m.geo[o + 2], groups, m.geo[o], members, m.geo[o + 1])
}

# the matrices' shapes: the product's rows m, depth k, columns n; a's and b's rows and columns as stored
fn (m Mirror<T>&) stackDims(s Step&) I64, I64, I64, I64, I64, I64, I64 {
    rows := s.Rows / (m.geo[s.Geo] * m.geo[s.Geo + 1])
    k := s.Inner
    n := s.Cols
    ar := k if s.TA else rows
    ac := rows if s.TA else k
    br := n if s.TB else k
    bc := k if s.TB else n
    return rows, k, n, ar, ac, br, bc
}

fn (m mut Mirror<T>&) planStacks(s Step&) MatPlan<T> ? gdev.GpuError {
    d := m.dev
    p := MatPlan<T>(d, s.Node)
    rows, _, n, ar, ac, br, bc := m.stackDims(s)
    y := m.stack(s, s.Y, rows, n, -1)
    a := m.stack(s, s.A, ar, ac, 0)
    b := m.stack(s, s.B, br, bc, 1)
    p.fwd = try blas.Product<T, T, T>.PlanBatch(d, y, a, s.TA, b, s.TB)
    if s.DY < 0: return p
    dy := m.stack(s, s.DY, rows, n, -1)
    if s.DA >= 0 {
        da := m.stack(s, s.DA, ar, ac, -1)
        if s.TA { p.da = try blas.Product<T, T, T>.PlanBatch(d, da, b, s.TB, dy, true) }
        else { p.da = try blas.Product<T, T, T>.PlanBatch(d, da, dy, false, b, not s.TB) }
    }
    if s.DB >= 0 {
        db := m.stack(s, s.DB, br, bc, -1)
        if s.TB { p.db = try blas.Product<T, T, T>.PlanBatch(d, db, dy, true, a, s.TA) }
        else { p.db = try blas.Product<T, T, T>.PlanBatch(d, db, a, not s.TA, dy, false) }
    }
    return p
}

fn (m Mirror<T>&) stacksFor(s Step&) I64 {
    for i in range m.mplans.Len() {
        if m.mplans[i].node == s.Node: return i
    }
    unreachable "oann: a product of stacks with no plan"
}

# the MatMul of two stacks s forward, or its backward (the gradients added to where add0, add1)
fn (m mut Mirror<T>&) stacks(s Step&, backward Bool, add0 Bool, add1 Bool) {
    i := m.stacksFor(s)
    d := m.dev
    rows, _, n, ar, ac, br, bc := m.stackDims(s)
    a := m.stack(s, s.A, ar, ac, 0)
    b := m.stack(s, s.B, br, bc, 1)
    if not backward {
        y := m.stack(s, s.Y, rows, n, -1)
        m.mplans[i].fwd.RunBatch(d, y, a, b)
        return
    }
    dy := m.stack(s, s.DY, rows, n, -1)
    if s.DA >= 0 {
        da := m.stack(s, s.DA, ar, ac, -1)
        if s.TA { m.mplans[i].da.RunBatch(d, da, b, dy, 1.0, 1.0 if add0 else 0.0) }
        else { m.mplans[i].da.RunBatch(d, da, dy, b, 1.0, 1.0 if add0 else 0.0) }
    }
    if s.DB >= 0 {
        db := m.stack(s, s.DB, br, bc, -1)
        if s.TB { m.mplans[i].db.RunBatch(d, db, dy, a, 1.0, 1.0 if add1 else 0.0) }
        else { m.mplans[i].db.RunBatch(d, db, a, dy, 1.0, 1.0 if add1 else 0.0) }
    }
}

fn (m mut Mirror<T>&) makePlan(s Step&, n I64, q gdev.DBatch<T>&, k gdev.DBatch<T>&, v gdev.DBatch<T>&, o gdev.DBatch<T>&, p gdev.DBatch<T>&) AttnPlan<T> ? gdev.GpuError {
    d := m.dev
    qrows := n * s.Ctx
    plan := AttnPlan<T>(d, s.Inner, n)
    plan.scores = try blas.Product<T, T, T>.PlanBatch(d, p, q, false, k, true)
    plan.pv = try blas.Product<T, T, T>.PlanBatch(d, o, p, false, v, false)
    if s.Scratch < 0: return plan
    ds := stackedOf(m, s.Scratch, qrows * s.Heads, s.Ctx, s.Ctx, s.Heads)
    plan.dp = try blas.Product<T, T, T>.PlanBatch(d, ds, o, false, v, true)
    if s.DA >= 0 {
        dq := headsOf(m, s.DA, qrows, s.Cols, s.Ctx, s.Heads)
        plan.dq = try blas.Product<T, T, T>.PlanBatch(d, dq, ds, false, k, false)
    }
    if s.DB >= 0 {
        dk := headsOf(m, s.DB, qrows, s.Cols, s.Ctx, s.Heads)
        plan.dk = try blas.Product<T, T, T>.PlanBatch(d, dk, ds, true, q, false)
    }
    if s.DC >= 0 {
        dv := headsOf(m, s.DC, qrows, s.Cols, s.Ctx, s.Heads)
        plan.dv = try blas.Product<T, T, T>.PlanBatch(d, dv, p, true, o, false)
    }
    return plan
}

fn (m mut Mirror<T>&) attentionForward(s Step&, n I64, pos I64) {
    i := m.planFor(s)
    qrows := m.batch * s.Ctx
    dm := s.Cols
    q := headsOf(m, s.A, qrows, dm, s.Ctx, s.Heads)
    k := headsOf(m, s.B, qrows, dm, s.Ctx, s.Heads)
    v := headsOf(m, s.C, qrows, dm, s.Ctx, s.Heads)
    o := headsOf(m, s.Y, qrows, dm, s.Ctx, s.Heads)
    p := stackedOf(m, s.Saved, qrows * s.Heads, s.Ctx, s.Ctx, s.Heads)
    scale := 1.0 / F64(dm / s.Heads).Sqrt()
    d := m.dev
    m.plans[i].scores.RunBatch(d, p, q, k, scale)
    m.rowk(KSoftmax, n * s.Ctx * s.Heads, s.Ctx, m.at(s.Saved), m.at(s.Saved), n64(s.Ctx), n64(s.Ctx), flag(s.Flag), n64(s.Window), m.startsOf(s), n64(s.Heads))
    m.plans[i].pv.RunBatch(d, o, p, v)
}

# y (+)= x rotated (dir 1) or rotated back (-1, the gradient) at positions pos + t: Rope's heads, its base in K
fn (m mut Mirror<T>&) rope(s Step&, y I64, x I64, rows I64, cols I64, pos I64, dir F64, add Bool) {
    pairs := rows * cols / 2
    m.elems(KRope, pairs, m.at(y), m.at(x), n64(pairs), n64(cols), n64(cols / s.Heads), n64(s.Ctx), n64(pos), kern.Arg(s.K.Log()), kern.Arg(dir), flag(add))
}

# ---- backward ----

# step s's backward at n entries: the gradients of its inputs from its own. add0, add1, add2: whether each of the
# inputs' gradients (in the order of A, B, C) is added to what is there
fn (m mut Mirror<T>&) Backward(s Step&, n I64, pos I64, add0 Bool, add1 Bool, add2 Bool) {
    rows := s.RowsAt(n, m.batch)
    cols := s.ColsAt(n)
    count := rows * cols
    match s.Do {
        case Work.Linear {
            out := s.Inner
            if s.DA >= 0: m.dequantize(s)
            if s.DA >= 0: m.product(s.DA, rows, cols, s.DY, rows, out, false, s.B, out, cols, false, add0)
            if s.DB >= 0: m.product(s.DB, out, cols, s.DY, rows, out, true, s.A, rows, cols, false, add1)
            if s.DC >= 0: m.tiles(KColSum, out, m.at(s.DC), m.at(s.DY), n64(rows), n64(out), flag(add2))
        }
        case Work.MatMul {
            if s.Geo >= 0 {
                m.stacks(s, true, add0, add1)
                return
            }
            k := s.Inner
            ar := k if s.TA else rows
            ac := rows if s.TA else k
            br := cols if s.TB else k
            bc := k if s.TB else cols
            if s.DA >= 0 {
                if s.TA: m.product(s.DA, ar, ac, s.B, br, bc, s.TB, s.DY, rows, cols, true, add0)
                else: m.product(s.DA, ar, ac, s.DY, rows, cols, false, s.B, br, bc, not s.TB, add0)
            }
            if s.DB >= 0 {
                if s.TB: m.product(s.DB, br, bc, s.DY, rows, cols, true, s.A, ar, ac, s.TA, add1)
                else: m.product(s.DB, br, bc, s.A, ar, ac, not s.TA, s.DY, rows, cols, false, add1)
            }
        }
        case Work.Add {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(1.0), n64(count), flag(add0))
            if s.DB >= 0: m.elems(KPut, count, m.at(s.DB), m.at(s.DY), rl<T>(1.0), n64(count), flag(add1))
        }
        case Work.Sub {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(1.0), n64(count), flag(add0))
            if s.DB >= 0: m.elems(KPut, count, m.at(s.DB), m.at(s.DY), rl<T>(-1.0), n64(count), flag(add1))
        }
        case Work.Mul {
            if s.DA >= 0: m.elems(KMulGrad, count, m.at(s.DA), m.at(s.DY), m.at(s.B), n64(count), flag(add0))
            if s.DB >= 0: m.elems(KMulGrad, count, m.at(s.DB), m.at(s.DY), m.at(s.A), n64(count), flag(add1))
        }
        case Work.Scale {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(s.K), n64(count), flag(add0))
        }
        case Work.Copy, Work.Reshape, Work.Gather {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(1.0), n64(count), flag(add0))
        }
        case Work.ViewBack {
            if s.DA >= 0: m.view(s.Geo, s.DA, s.DY, count, add0)
        }
        case Work.Act {
            if s.DA >= 0 {
                fromOut := s.Code == 0 or s.Code == 4 or s.Code == 5
                src := s.Y if fromOut else s.A
                m.elems(KActGrad, count, m.at(s.DA), m.at(s.DY), m.at(src), n64(count), n64(s.Code), flag(fromOut), flag(add0))
            }
        }
        case Work.Leaky {
            if s.DA >= 0: m.elems(KLeakyGrad, count, m.at(s.DA), m.at(s.DY), m.at(s.A), n64(count), rl<T>(s.K), flag(add0))
        }
        case Work.Softmax {
            if s.DA >= 0: m.rowk(KSoftmaxGrad, rows, cols, m.at(s.DA), m.at(s.DY), m.at(s.Y), n64(cols), n64(1), n64(0), n64(0), 0, n64(1), rl<T>(1.0), flag(add0))
        }
        case Work.LogSoftmax {
            if s.DA >= 0: m.rowk(KLogSoftmaxGrad, rows, cols, m.at(s.DA), m.at(s.DY), m.at(s.Y), n64(cols), flag(add0))
        }
        case Work.Norm {
            if s.DA >= 0: m.rowk(KNormGrad, rows, cols, m.at(s.DA), m.at(s.DY), m.at(s.A), m.at(s.Saved), m.at(s.Saved + rows), m.at(s.B), n64(cols), flag(s.Flag), flag(add0))
            dg U64 = 0 if s.DB < 0 else m.at(s.DB)
            db U64 = 0 if s.DC < 0 else m.at(s.DC)
            if s.DB >= 0 or s.DC >= 0: m.tiles(KNormParam, cols, dg, db, m.at(s.DY), m.at(s.A), m.at(s.Saved), m.at(s.Saved + rows), n64(rows), n64(cols), flag(add1), flag(add2))
        }
        case Work.Embedding {
            if s.DB >= 0: m.rowk(KEmbedGrad, s.Inner, cols, m.at(s.DB), m.at(s.DY), m.Ints.Addr(s.IntA), n64(rows), n64(cols), flag(add1))
        }
        case Work.Positions {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(1.0), n64(count), flag(add0))
            if s.DB >= 0: m.elems(KPositionsGrad, s.Inner * cols, m.at(s.DB), m.at(s.DY), n64(rows), n64(cols), n64(s.Ctx), n64(pos), n64(s.Inner), flag(add1))
        }
        case Work.Attention: m.attentionBackward(s, n, add0, add1, add2)
        case Work.Shift {
            if s.DA >= 0: m.elems(KPut, count, m.at(s.DA), m.at(s.DY), rl<T>(1.0), n64(count), flag(add0))
        }
        case Work.Sqrt {
            if s.DA >= 0: m.elems(KSqrtGrad, count, m.at(s.DA), m.at(s.DY), m.at(s.Y), n64(count), flag(add0))
        }
        case Work.Log {
            if s.DA >= 0: m.elems(KLogGrad, count, m.at(s.DA), m.at(s.DY), m.at(s.A), n64(count), flag(add0))
        }
        case Work.Stablemax {
            if s.DA >= 0: m.rowk(KSmGrad, rows, cols, m.at(s.DA), m.at(s.A), m.Ints.Addr(s.IntA), m.at(s.DY), m.Stats.Addr(2 * s.Inner), n64(cols), flag(add0))
        }
        case Work.Rope {
            if s.DA >= 0: m.rope(s, s.DA, s.DY, rows, cols, pos, -1.0, add0)
        }
        case Work.ChunkCE: m.chunkedBackward(s, rows, add0, add1)
        case Work.Moe: m.moeBackward(s, rows)
        case Work.CrossEntropy {
            if s.DA >= 0: m.elems(KCeGrad, count, m.at(s.DA), m.at(s.Saved), m.Ints.Addr(s.IntA), m.at(s.DY), m.Stats.Addr(2 * s.Inner), n64(count), n64(cols), flag(add0))
        }
        case Work.Mse {
            da U64 = 0 if s.DA < 0 else m.at(s.DA)
            db U64 = 0 if s.DB < 0 else m.at(s.DB)
            if s.DA >= 0 or s.DB >= 0: m.elems(KMseGrad, count, da, db, m.at(s.A), m.at(s.B), m.at(s.DY), n64(count), flag(add0), flag(add1))
        }
        case Work.Sum {
            k T = T(1.0 / F64(cols)) if s.Flag else T(1.0)
            if s.DA >= 0: m.elems(KSumLastGrad, count, m.at(s.DA), m.at(s.DY), n64(count), n64(cols), kern.Arg(k), flag(add0))
        }
        case _ { }
    }
}

fn (m mut Mirror<T>&) attentionBackward(s Step&, n I64, add0 Bool, add1 Bool, add2 Bool) {
    i := m.planFor(s)
    qrows := m.batch * s.Ctx
    dm := s.Cols
    d := m.dev
    q := headsOf(m, s.A, qrows, dm, s.Ctx, s.Heads)
    k := headsOf(m, s.B, qrows, dm, s.Ctx, s.Heads)
    v := headsOf(m, s.C, qrows, dm, s.Ctx, s.Heads)
    dout := headsOf(m, s.DY, qrows, dm, s.Ctx, s.Heads)
    p := stackedOf(m, s.Saved, qrows * s.Heads, s.Ctx, s.Ctx, s.Heads)
    ds := stackedOf(m, s.Scratch, qrows * s.Heads, s.Ctx, s.Ctx, s.Heads)
    scale := 1.0 / F64(dm / s.Heads).Sqrt()
    m.plans[i].dp.RunBatch(d, ds, dout, v)
    m.rowk(KSoftmaxGrad, n * s.Ctx * s.Heads, s.Ctx, m.at(s.Scratch), m.at(s.Scratch), m.at(s.Saved), n64(s.Ctx), n64(s.Ctx), flag(s.Flag), n64(s.Window), m.startsOf(s), n64(s.Heads), rl<T>(scale), n64(0))
    if s.DA >= 0 {
        dq := headsOf(m, s.DA, qrows, dm, s.Ctx, s.Heads)
        m.plans[i].dq.RunBatch(d, dq, ds, k, 1.0, 1.0 if add0 else 0.0)
    }
    if s.DB >= 0 {
        dk := headsOf(m, s.DB, qrows, dm, s.Ctx, s.Heads)
        m.plans[i].dk.RunBatch(d, dk, ds, q, 1.0, 1.0 if add1 else 0.0)
    }
    if s.DC >= 0 {
        dv := headsOf(m, s.DC, qrows, dm, s.Ctx, s.Heads)
        m.plans[i].dv.RunBatch(d, dv, p, dout, 1.0, 1.0 if add2 else 0.0)
    }
}



# ---- a mixture of experts (Work.Moe) ----

# cuBLAS's type for the arena's elements
fn storeType<T>(like T) I32 {
    return match T {
        case BF16: cu.CUDA_R_16BF
        case _: cu.CUDA_R_32F
    }
}

# rows x cols at c (ldc, of type ct) = op(A) op(B), added to where add: A and B at device addresses, both of type at,
# summed in F32 (cuBLAS's GemmEx, any alignment: an expert's rows start anywhere)
fn (m mut Mirror<T>&) gemmAt(c U64, ct I32, ldc I64, a U64, ta Bool, lda I64, b U64, tb Bool, ldb I64, rows I64, cols I64, k I64, at I32, add Bool) {
    if rows == 0 or cols == 0: return
    cu.oann_gemm(m.dev.Status(), m.dev.Blas(), tb, ta, I32(cols), I32(rows), I32(k), 1.0, b, at, I32(ldb), a, at, I32(lda), 1.0 if add else 0.0, c, ct, I32(ldc), cu.CUBLAS_COMPUTE_32F)
}

# rows x cols at arena offset c = op(arena at a) op(arena at b), in the arena's type
fn (m mut Mirror<T>&) gemmIn(c I64, ldc I64, a I64, ta Bool, lda I64, b I64, tb Bool, ldb I64, rows I64, cols I64, k I64, add Bool) {
    z T
    t := storeType(z)
    m.gemmAt(m.at(c), t, ldc, m.at(a), ta, lda, m.at(b), tb, ldb, rows, cols, k, t, add)
}

fn (m Mirror<T>&) moeFor(s Step&) I64 {
    for i in range m.moes.Len() {
        if m.moes[i].node == s.Node: return i
    }
    unreachable "oann: a mixture of experts with no plan"
}

# the Moe step of node `node`'s plan (MoeBias, MoeCounts, MoeAdds): -1 for none
fn (m Mirror<T>&) MoeOf(node I64) I64 {
    for i in range m.moes.Len() {
        if m.moes[i].node == node: return i
    }
    return -1
}

# plan i's selection bias up from the host's (E values; an empty array leaves it as it is)
fn (m mut Mirror<T>&) MoeBias(i I64, bias Array<F32>&) {
    if bias.Len() == 0: return
    d := m.dev
    upload(d, m.moes[i].bias, bias, 0, 0, bias.Len())
}

# plan i's rows per expert of its last Forward
fn (m Mirror<T>&) MoeCounts(i I64) Array<I64>& { return m.moes[i].Counts }

# plan i's adds by input for its next Backward (the graph's: whether each input's gradient is added to)
fn (m Mirror<T>&) MoeAdds(i I64) mut Array<Bool>& { return m.moes[i].Adds }

# input j's value (grad false) or gradient offset of the Moe step s
fn (m Mirror<T>&) moeIn(s Step&, j I64, grad Bool) I64 { return m.geo[s.Geo + j + (3 * s.Heads + 2 if grad else 0)] }

# the experts on `rows` tokens: the router's logits (F32) and its choices; the rows each expert takes, counted on the
# device and brought down (the products' sizes: the one wait of the step, so a graph with a Moe step is not captured
# whole); the tokens' rows gathered by expert, each expert's SwiGLU over its rows (cuBLAS), and the gated sum
fn (m mut Mirror<T>&) moeForward(s Step&, rows I64) {
    i := m.moeFor(s)
    d, h, e, k := s.Cols, s.Inner, s.Heads, s.Ctx
    big := s.Rows * k
    xg := s.Saved
    h1, h3, act, yg := xg + big * d, xg + big * (d + h), xg + big * (d + 2 * h), xg + big * (d + 3 * h)
    x, wr := m.moeIn(s, 0, false), m.moeIn(s, 1, false)
    z T
    t := storeType(z)
    m.gemmAt(m.moes[i].logits.Addr(0), cu.CUDA_R_32F, e, m.at(x), false, d, m.at(wr), true, d, rows, e, d, t, false)
    m.elems(KMoeRoute, rows, m.moes[i].probs.Addr(0), m.moes[i].sel.Addr(0), m.moes[i].gate.Addr(0), m.moes[i].logits.Addr(0), m.moes[i].bias.Addr(0), n64(rows), n64(e), n64(k), flag(s.Flag))
    m.once(KMoeRows, m.moes[i].pos.Addr(0), m.moes[i].tok.Addr(0), m.moes[i].count.Addr(0), m.moes[i].part.Addr(0), m.moes[i].sel.Addr(0), n64(rows * k), n64(e), n64(k))
    m.moes[i].count.Download(m.moes[i].hostCount, 0, 0, e)
    m.sync()
    at I64 = 0
    for j in range e {
        m.moes[i].starts[j] = at
        m.moes[i].Counts[j] = I64(m.moes[i].hostCount[j])
        at += m.moes[i].Counts[j]
    }
    m.elems(KMoeGather, rows * k * d, m.at(xg), m.at(x), m.moes[i].tok.Addr(0), n64(rows * k), n64(d))
    for j in range e {
        c, o := m.moes[i].Counts[j], m.moes[i].starts[j]
        if c == 0: continue
        m.gemmIn(h1 + o * h, h, xg + o * d, false, d, m.moeIn(s, 2 + j, false), true, d, c, h, d, false)
        m.gemmIn(h3 + o * h, h, xg + o * d, false, d, m.moeIn(s, 2 + e + j, false), true, d, c, h, d, false)
    }
    m.elems(KMoeAct, rows * k * h, m.at(act), m.at(h1), m.at(h3), n64(rows * k * h))
    for j in range e {
        c, o := m.moes[i].Counts[j], m.moes[i].starts[j]
        if c > 0: m.gemmIn(yg + o * d, d, act + o * h, false, h, m.moeIn(s, 2 + 2 * e + j, false), true, h, c, d, h, false)
    }
    m.elems(KMoeCombine, rows * d, m.at(s.Y), m.at(yg), m.moes[i].gate.Addr(0), m.moes[i].pos.Addr(0), n64(rows), n64(d), n64(k))
}

# the experts' backward on `rows` tokens, nn/moe's Backward step for step, from the rows the last Forward counted:
# each slot's output and gate gradients; each expert's weights' gradients and its rows' input gradient; x's from its
# slots' rows; the logits' (through the gates and the balance loss); the router's and its share of x's. Each input's
# gradient written or added as its plan's Adds say; one an expert with no rows writes is zero
fn (m mut Mirror<T>&) moeBackward(s Step&, rows I64) {
    i := m.moeFor(s)
    d, h, e, k := s.Cols, s.Inner, s.Heads, s.Ctx
    big := s.Rows * k
    xg := s.Saved
    h1, h3, act, yg := xg + big * d, xg + big * (d + h), xg + big * (d + 2 * h), xg + big * (d + 3 * h)
    dyg := s.Scratch
    da, dh1, dh3, dxg, dl := dyg + big * d, dyg + big * (d + h), dyg + big * (d + 2 * h), dyg + big * (d + 3 * h), dyg + big * (2 * d + 3 * h)
    x, wr := m.moeIn(s, 0, false), m.moeIn(s, 1, false)
    gx, gwr := m.moeIn(s, 0, true), m.moeIn(s, 1, true)
    m.rowk(KMoeScatter, rows * k, d, m.at(dyg), m.moes[i].dgate.Addr(0), m.at(s.DY), m.at(yg), m.moes[i].gate.Addr(0), m.moes[i].pos.Addr(0), n64(d), n64(k))
    for j in range e: m.expertBackward(s, i, j, act, dyg, da)
    m.elems(KMoeActGrad, rows * k * h, m.at(dh1), m.at(dh3), m.at(da), m.at(h1), m.at(h3), n64(rows * k * h))
    for j in range e: m.expertInputs(s, i, j, xg, dh1, dh3, dxg, gx >= 0)
    if gx >= 0: m.elems(KMoeDx, rows * d, m.at(gx), m.at(dxg), m.moes[i].pos.Addr(0), n64(rows), n64(d), n64(k), flag(m.moes[i].Adds[0]))
    if gx < 0 and gwr < 0: return
    scale := F32(s.K * F64(e) / (F64(rows) * F64(rows * k)))
    m.elems(KMoeRouterGrad, rows, m.at(dl), m.moes[i].probs.Addr(0), m.moes[i].gate.Addr(0), m.moes[i].dgate.Addr(0), m.moes[i].sel.Addr(0), m.moes[i].count.Addr(0), n64(rows), n64(e), n64(k), flag(s.Flag), rl<T>(F64(scale)))
    if gwr >= 0: m.gemmIn(gwr, d, dl, true, e, x, false, d, e, d, rows, m.moes[i].Adds[1])
    if gx >= 0: m.gemmIn(gx, d, dl, false, e, wr, false, d, rows, d, e, true)
}

# expert j's Down gradient (dyg^T act) and its act's gradient (dyg Down) over its rows; an expert with no rows writes
# zero into its three gradients (where they are written, not added to)
fn (m mut Mirror<T>&) expertBackward(s Step&, i I64, j I64, act I64, dyg I64, da I64) {
    d, h, e := s.Cols, s.Inner, s.Heads
    c, o := m.moes[i].Counts[j], m.moes[i].starts[j]
    if c == 0 {
        for w in range 3 {
            at := 2 + w * e + j
            g := m.moeIn(s, at, true)
            if g >= 0 and not m.moes[i].Adds[at]: m.Fill(g, h * d, 0.0)
        }
        return
    }
    down := 2 + 2 * e + j
    m.gemmIn(da + o * h, h, dyg + o * d, false, d, m.moeIn(s, down, false), false, h, c, h, d, false)
    g := m.moeIn(s, down, true)
    if g >= 0: m.gemmIn(g, h, dyg + o * d, true, d, act + o * h, false, h, d, h, c, m.moes[i].Adds[down])
}

# expert j's Gate and Up gradients (dh^T xg) and, where x's is wanted, its rows' input gradient dh1 Gate + dh3 Up
fn (m mut Mirror<T>&) expertInputs(s Step&, i I64, j I64, xg I64, dh1 I64, dh3 I64, dxg I64, wantX Bool) {
    d, h, e := s.Cols, s.Inner, s.Heads
    c, o := m.moes[i].Counts[j], m.moes[i].starts[j]
    if c == 0: return
    for w in range 2 {
        at := 2 + w * e + j
        g := m.moeIn(s, at, true)
        dh := dh1 if w == 0 else dh3
        if g >= 0: m.gemmIn(g, d, dh + o * h, true, h, xg + o * d, false, d, h, d, c, m.moes[i].Adds[at])
    }
    if not wantX: return
    m.gemmIn(dxg + o * d, d, dh1 + o * h, false, h, m.moeIn(s, 2 + j, false), false, d, c, d, h, false)
    m.gemmIn(dxg + o * d, d, dh3 + o * h, false, h, m.moeIn(s, 2 + e + j, false), false, d, c, d, h, true)
}

# ---- the optimizer ----

# AdamW over the graph's parameters on the device, nn/optim's step for step and bit for bit: its moments zero, decaying
# where decays (a byte a parameter, 1 for decay) says
fn (m mut Mirror<T>&) AdamW(decays Array<U8>&, rate F64, beta1 F64, beta2 F64, eps F64, decay F64) AdamW<T> ? gdev.GpuError {
    n := m.params
    d := m.dev
    bytes := n * realSize<T>()
    o := AdamW<T>(try gdev.Buf<U8>.Make(d, bytes), try gdev.Buf<U8>.Make(d, bytes), try gdev.Buf<U8>.Make(d, n), try gdev.Buf<F64>.Make(d, 3), rate, beta1, beta2, eps, decay)
    kern.Zero(d, o.M.Addr(0), bytes)
    kern.Zero(d, o.V.Addr(0), bytes)
    o.mask.UploadAll(decays)
    try d.Sync()
    return o
}

# the step's scalars, computed on the host as nn/optim computes them and put on the device (a copy staged at once)
fn (m mut Mirror<T>&) AdamScalars(o mut AdamW<T>&) {
    o.Steps++
    corr1 F64 = 1.0 - o.Beta1.Pow(F64(o.Steps))
    corr2 F64 = 1.0 - o.Beta2.Pow(F64(o.Steps))
    o.hostHp[0], o.hostHp[1], o.hostHp[2] = 1.0 - o.Rate * o.Decay, o.Rate / corr1, 1.0 / corr2.Sqrt()
    d := m.dev
    upload(d, o.Hp, o.hostHp, 0, 0, 3)
}

# the step's launch (the scalars already on the device)
fn (m mut Mirror<T>&) AdamLaunch(o mut AdamW<T>&) {
    n := m.params
    w := m.Masters.Addr(0) if m.HasMasters else m.at(0)
    m.elems(KAdamW, n, w, m.at(0), m.at(n), o.M.Addr(0), o.V.Addr(0), o.mask.Addr(0), n64(n), rl<T>(o.Beta1), rl<T>(o.Beta2), rl<T>(1.0 - o.Beta1), rl<T>(1.0 - o.Beta2)
        o.Hp.Addr(0), rl<T>(o.Eps))
}

fn (m mut Mirror<T>&) AdamStep(o mut AdamW<T>&) {
    m.AdamScalars(o)
    m.AdamLaunch(o)
}

# the gradients scaled so that their Euclidean norm is at most max (optim.ClipNorm's rule); GradNorm reads the norm after
fn (m mut Mirror<T>&) ClipNorm(max F64) {
    n := m.params
    slot := m.Stats.Addr(2 * m.nodes)
    m.once(KSumsq, slot, m.at(n), n64(n))
    m.elems(KClip, n, m.at(n), slot, n64(n), kern.Arg(max))
}

# the gradients times k (accumulated batches made their mean, nn/tune)
fn (m mut Mirror<T>&) ScaleGrads(k F64) {
    n := m.params
    m.elems(KScale, n, m.at(n), m.at(n), rl<T>(k), n64(n))
}

# the norm the last ClipNorm measured (before clipping)
fn (m mut Mirror<T>&) GradNorm() F64 {
    one := Array<F64>(1)
    m.Stats.Download(one, 2 * m.nodes, 0, 1)
    m.sync()
    return one[0].Sqrt()
}

# ---- GP7: where the device's time goes ----

# microseconds a run of step s takes back to back on the device (reps runs between two events), forward or backward: the
# profile of a step by node (Graph.GpuProfile). Backward's gradients are written and added as given, the values are
# whatever the arena holds
fn (m mut Mirror<T>&) TimeStep(s Step&, n I64, pos I64, backward Bool, add0 Bool, add1 Bool, add2 Bool, reps I64) F64 {
    d := m.dev
    t := try kern.Timer.Make(d) catch gdev.GpuError err { unreachable "the GPU failed: " + $err }
    if backward { m.Backward(s, n, pos, add0, add1, add2) } else { m.Forward(s, n, pos) }
    m.sync()
    t.Start(d)
    for _ in range reps {
        if backward { m.Backward(s, n, pos, add0, add1, add2) } else { m.Forward(s, n, pos) }
    }
    t.Stop(d)
    ms := try t.Ms() catch gdev.GpuError err { unreachable "the GPU failed: " + $err }
    return 1000.0 * ms / F64(reps)
}

# ---- what must not allocate, decided while compiling (S17a, G42) ----

fn forwardOf(m mut Mirror<F32>&, s Step&) { m.Forward(s, 1, 0) }
fn backwardOf(m mut Mirror<F32>&, s Step&) { m.Backward(s, 1, 0, false, false, false) }
fn elemsOf(m mut Mirror<F32>&) { m.elems(KAct, 5, 1, 2) }
fn productOf(m mut Mirror<F32>&) { m.product(0, 1, 1, 0, 1, 1, false, 0, 1, 1, false, false) }
fn attnOf(m mut Mirror<F32>&, s Step&) { m.attentionForward(s, 1, 0) }
fn attnBOf(m mut Mirror<F32>&, s Step&) { m.attentionBackward(s, 1, false, false, false) }
fn adamOf(m mut Mirror<F32>&, o mut AdamW<F32>&) { m.AdamStep(o) }
assert not elemsOf.Allocates, "a launch allocates"
assert not productOf.Allocates, "a product allocates"
assert not attnOf.Allocates, "attention's forward allocates"
assert not attnBOf.Allocates, "attention's backward allocates"
assert not adamOf.Allocates, "AdamW's step allocates"
assert not forwardOf.Allocates, "a forward step allocates"
assert not backwardOf.Allocates, "a backward step allocates"
