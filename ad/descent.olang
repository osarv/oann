# ad/descent - a state settled by gradient descent on an energy written on the graph, and the network's parameters
# trained three ways through that settle.
#
# The graph holds an energy E(x, theta) - a scalar node - over a state x (an Input given to Watch) and the parameters
# theta, and a cost C(x) beside it (a scalar reading the state and data, not the parameters: the loss of the settled
# state). A settle runs x <- x - Rate (dE/dx + beta dC/dx) from the state's current value until the largest |step
# direction| is below Tol (or Steps run out); each step is one Forward and the graph's ordinary Backward from E (and,
# nudged, from C). Every row of the batch settles at once: E is a sum over the rows.
#
# The gradient of the cost at the free fixed point, dL/dtheta for L = C(x*(theta)), three ways (Trainer):
# - Unrolled(h): backpropagation through the last h steps of the settle - lambda = dC/dx at the last state, then back
#   through each step x' = x - Rate g(x): dL/dtheta -= Rate (d g/dtheta)^T lambda, lambda -= Rate H lambda;
# - Implicit(tol, iterations): the exact gradient at the fixed point, dL/dtheta = -(d g/dtheta)^T lambda where
#   H lambda = dC/dx (H = d2E/dx2, solved by conjugate gradients: H symmetric positive definite at a strict minimum);
# - Ep(beta, centered): equilibrium propagation - the free settle, then a nudged one from it (E + beta C; centered, also
#   one at -beta), dL/dtheta = (dE/dtheta(x+beta) - dE/dtheta(x-beta)) / (2 beta) (uncentered: x* for x-beta, beta for
#   2 beta). Only first derivatives, each dE/dtheta by the graph's Backward;
# - Margin(m): a contrastive step from two starts - the state settled from where it is (the free fixed point) and from
#   the caller's target (SetTarget); every row whose two fixed points differ (by more than Apart) and whose energies
#   are not yet m apart, E_r(target's) + m > E_r(free), takes the hinge's gradient dE_r/dtheta(target's) -
#   dE_r/dtheta(free), averaged over the batch: the answer reached from the target pushed down, the one reached from the
#   other start pushed up, until the target's basin is the deeper by m. It needs the energy row by row (RowEnergy: a
#   node of one value a row summing to E), and no cost; Active says how many rows took the step.
# The same contrast between two settled states as a term added to any trainer's gradient: AddMargin(m, weight, start,
# right) settles a second time from start, asks right which of each row's two settled states answers it, and where
# exactly one does and the right one's energy is not m below the wrong one's, adds weight (dE/dtheta(right) -
# dE/dtheta(wrong)) to ParamGrads - a fine-tuning term beside Unrolled, Implicit or EP.
# The first two need second derivatives the graph does not record: H v and (d g/dtheta)^T v are central differences of
# the first derivatives along v, (dE/dx, dE/dtheta)(x +- eps v) / (2 eps) with eps = Eps / |v| - two Forward and
# Backward passes per product, exact for an energy quadratic in x up to rounding, O(Eps^2) otherwise.
#
# A trainer leaves the state at the free fixed point (C's value the free cost) and dL/dtheta in the graph's
# ParamGrads(), so an optimizer over Params() steps it as after any Backward. Nothing is allocated after the Descent is
# made but Unrolled's trail of h states, laid out at the first Train that needs it.

import "graph"
import "std/rand"

type Trainer enum { Unrolled(h I64), Implicit(tol F64, iterations I64), Ep(beta F64, centered Bool), Margin(m F64) }

# how a settle (or the adjoint's solve) ended: the steps taken, the last residual (the largest |step direction|, or the
# solve's residual norm) and whether it got below the tolerance
type Settled struct(Steps I64 = 0, Residual F64 = 0, Converged Bool = false) {
    Steps
    Residual
    Converged
}

# descent on g's energy over the state: a graph planned with state given to Watch, energy and cost scalar nodes
type Descent<T> struct(g mut graph.Graph<T>&, state graph.Var, energy graph.Var, cost graph.Var) {
    G mut graph.Graph<T>& = g
    X graph.Var = state
    E graph.Var = energy
    C graph.Var = cost
    Rate F64 = 0.1                  # the step: below 2 / (the largest curvature of E in x) for the descent to settle
    Tol F64 = 1e-10                 # a settle stops once every |dE/dx + beta dC/dx| is below it
    Steps I64 = 100000              # and after this many steps at most
    NudgedSteps I64 = 0             # a nudged settle's cap where above 0 (it starts at the free fixed point, nearby)
    Adaptive Bool = false           # a settle's step is undone and halved when it overshot - the new gradient opposes
                                    # the step, or E (+ beta C) rose by more than rounding - and grows by a tenth after
                                    # each kept step, up to 8 Rate: the fixed point is the same, so EP and Implicit
                                    # allow it; Unrolled, which differentiates the steps, refuses it
    Sphere I64 = 0                  # above 0: the state is groups of Sphere elements, each kept at unit RMS - every step
                                    # is followed by the projection and the residual is the gradient's part tangent to
                                    # the sphere. EP allows it (its fixed points are minima under a constraint theta
                                    # does not move); Unrolled and Implicit, which differentiate the steps, refuse it
    Grow F64 = 8.0                  # Adaptive: the step grows to at most Grow Rate (1: it only shrinks from Rate)
    Jitter F64 = 0.0                # above 0: after every settle step each state element moves by uniform noise in
                                    # [-Jitter, Jitter] (a quantizer's error at training time; Unrolled treats it as a
                                    # constant, straight through). 0: no noise, the settle unchanged
    Temperature F64 = 0.0           # above 0: Langevin steps - after every settle step each state element moves by
                                    # Gaussian noise of variance 2 rate T, T starting at Temperature and multiplied by
                                    # Cooling every step (annealing); a sample of exp(-E / T) at a fixed T. 0: none
    Cooling F64 = 1.0
    StateBits I64 = 0               # above 0: a low-bit state - after every settle step it is rounded to this many bits,
                                    # per block of StateBlock elements (0: a batch row) with a scale of its own (1 bit:
                                    # sign times the block's mean |x|; 2: -s, 0, s past 0.7 mean |x|; else symmetric
                                    # levels, the scale min(max |x|, StateClip rms) / (2^(bits-1) - 1)); straight
                                    # through: the unrolled gradient ignores the rounding
    StateClip F64 = 3.0
    StateBlock I64 = 0
    StateStochastic Bool = false    # stochastic rounding (from the noise generator)
    ReadRounded Bool = false        # the state kept exact, the energy reading it rounded (a wide accumulator, a low-bit message)
    xq mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())    # ReadRounded's rounded copy
    Ds F64 = 0.0                    # Unrolled's deep supervision: each unrolled step's state adds Ds C(x) to the cost
                                    # differentiated - the gradient of C(x_T) + Ds (C(x_T-1) + ... + C(x_T-h)). 0: none
    jit U64 = U64(0x9E3779B97F4A7C15)   # the jitter's and the Langevin noise's generator (xorshift)
    Eps F64 = 1e-4                  # the central differences' step, in the state's units (1e-2 or so for F32)
    Last Settled = Settled()        # the last settle (the free one, after a trainer)
    RowEnergy graph.Var = graph.None    # Margin: a node of the energy row by row (Batch values summing to E), kept
    Apart F64 = 1e-6                # Margin: two fixed points of a row differ where some element differs by more
    Active I64 = 0                  # Margin: the rows that took its last step
    Adjoint Settled = Settled()     # the last implicit solve
    Nudged Settled = Settled()      # EP's last nudged settle
    Forwards I64 = 0                # the graph's Forward and Backward passes run so far, the compute a caller counts
    Backwards I64 = 0
    n I64 = g.Info(state).Dims.Count()
    p I64 = g.ParamCount
    x mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())      # the state being settled
    free mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())   # the free fixed point
    gx mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())     # dE/dx (+ beta dC/dx) at the last point
    cx mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())     # dC/dx there
    lam mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())    # the adjoint
    dir mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())    # conjugate gradients' direction and residual
    res mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())
    hv mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())     # H v
    up mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())     # a difference's two sides
    down mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())
    gp mut Array<F64>& = Array<F64>(g.ParamCount)                   # dE/dtheta at the last point
    mv mut Array<F64>& = Array<F64>(g.ParamCount)                   # (d g/dtheta)^T v
    acc mut Array<F64>& = Array<F64>(g.ParamCount)                  # the gradient being assembled
    trail mut Array<F64>& = Array<F64>(0)                           # Unrolled's last h states, a ring
    prev mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())   # Adaptive: the last accepted point and its step
    prevStep mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())
    target mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())     # Margin's second start
    other mut Array<F64>& = Array<F64>(g.Info(state).Dims.Count())      # and its two fixed points' mix
    eT mut Array<F64>& = Array<F64>(g.Batch)                            # each row's energy at the target's fixed point
    eF mut Array<F64>& = Array<F64>(g.Batch)                            # and at the free one
}

# Margin's second start: the state the target answer is (as the state is laid out)
fn (d mut Descent<T>&) SetTarget(t Array<F64>&) {
    for i in range d.n: d.target[i] = t[i]
}

# ---- the graph at a point ----

# x into the state, a Forward, a Backward from E: gx = dE/dx (+ beta dC/dx, a second Backward from C where beta is not
# 0), gp = dE/dtheta (params: a settle's steps leave it out - the graph's Backward computes the state's gradient
# alone - and a trainer asks for it at the fixed point it needs it at); the largest |gx|. Of two Backwards after one Forward, the one from the node recorded later runs
# first: the plan places buffers by a backward from the last node, so that one's gradients never overwrite a value the
# other's backward reads
fn (d mut Descent<T>&) at(x Array<F64>&, beta F64, params Bool = true) F64 {
    g := d.G
    s := g.Value(d.X).Flat()!
    for i in range d.n: s[i] = T(x[i])
    g.Forward(g.Batch)
    d.Forwards++
    nudged := beta != 0.0
    if nudged and d.C > d.E: d.fromCost()
    g.Backward(d.E, false, params)
    d.Backwards++
    dx := g.Grad(d.X).Flat()!
    for i in range d.n: d.gx[i] = F64(dx[i])
    if params {
        pg := g.ParamGrads().Flat()!
        for i in range d.p: d.gp[i] = F64(pg[i])
    }
    if nudged and d.C < d.E: d.fromCost()
    for i in range d.n: d.gx[i] += beta * d.cx[i]
    worst := 0.0
    if d.Sphere > 0: return d.tangent(x)
    for i in range d.n: worst = worst.Max(d.gx[i].Abs())
    return worst
}

# a Backward from C after the Forward: dC/dx into cx
fn (d mut Descent<T>&) fromCost() {
    d.G.Backward(d.C)
    d.Backwards++
    cx := d.G.Grad(d.X).Flat()!
    for i in range d.n: d.cx[i] = F64(cx[i])
}

# dC/dx at x into out
fn (d mut Descent<T>&) costGrad(x Array<F64>&, out mut Array<F64>&) {
    g := d.G
    s := g.Value(d.X).Flat()!
    for i in range d.n: s[i] = T(x[i])
    g.Forward(g.Batch)
    g.Backward(d.C)
    d.Forwards++
    d.Backwards++
    cx := g.Grad(d.X).Flat()!
    for i in range d.n: out[i] = F64(cx[i])
}

# H v into hv and (d g/dtheta)^T v into mv, by central differences of (dE/dx, dE/dtheta) at x +- eps v
fn (d mut Descent<T>&) along(x Array<F64>&, v Array<F64>&) {
    size := norm(v)
    if size == 0.0 {
        for i in range d.n: d.hv[i] = 0.0
        for i in range d.p: d.mv[i] = 0.0
        return
    }
    eps := d.Eps / size
    for i in range d.n: d.up[i] = x[i] + eps * v[i]
    d.at(d.up, 0.0)
    for i in range d.n: d.hv[i] = d.gx[i]
    for i in range d.p: d.mv[i] = d.gp[i]
    for i in range d.n: d.down[i] = x[i] - eps * v[i]
    d.at(d.down, 0.0)
    for i in range d.n: d.hv[i] = (d.hv[i] - d.gx[i]) / (2.0 * eps)
    for i in range d.p: d.mv[i] = (d.mv[i] - d.gp[i]) / (2.0 * eps)
}

# ---- settling ----

# the state settled from its current value, nudged by beta toward the cost (0: the free phase); the state and C's value
# are the settled ones after it. Its steps compute the state's gradient alone: the graph's ParamGrads is left as it was
fn (d mut Descent<T>&) Settle(beta F64 = 0.0) Settled {
    s := d.G.Value(d.X).Flat()!
    for i in range d.n: d.x[i] = F64(s[i])
    return d.settle(beta, 0)
}

# the settle from d.x; with keep > 0, the last keep states before the last are kept in the trail
fn (d mut Descent<T>&) settle(beta F64, keep I64) Settled {
    out := Settled()
    most := d.NudgedSteps if beta != 0.0 and d.NudgedSteps > 0 else d.Steps
    if d.Sphere > 0: d.project()
    rate := d.Rate
    last := 0.0
    for k in range most + 1 {
        res := d.at(d.rounded(), beta, false)
        out.Steps = k
        if d.Adaptive {
            now := d.objective(beta)
            if k > 0 and (dot(d.gx, d.prevStep) < 0.0 or now > last + 1e-6 * last.Abs()) {
                rate *= 0.5
                for i in range d.n: d.x[i] = d.prev[i] - rate * d.prevStep[i]
                if d.Sphere > 0: d.project()
                if k < most: continue
                for i in range d.n: d.x[i] = d.prev[i]
                out.Residual = d.at(d.x, beta, false)
                break
            }
            last = now
        }
        out.Residual = res
        if res < d.Tol {
            out.Converged = true
            break
        }
        if k == most: break
        if keep > 0: d.record(k % keep)
        if d.Adaptive {
            for i in range d.n: d.prev[i] = d.x[i]
            for i in range d.n: d.prevStep[i] = d.gx[i]
            rate = (rate * 1.1).Min(d.Grow * d.Rate)
        }
        for i in range d.n: d.x[i] -= rate * d.gx[i]
        if d.Jitter > 0.0 {
            for i in range d.n: d.x[i] += d.Jitter * (2.0 * d.uniform() - 1.0)
        }
        if d.Temperature > 0.0 {
            sd := (2.0 * rate * d.Temperature * d.Cooling.Pow(F64(k))).Sqrt()
            for i in range d.n: d.x[i] += sd * d.gauss()
        }
        if d.Sphere > 0: d.project()
        if d.StateBits > 0 and not d.ReadRounded: d.quantize(d.x)
    }
    return out
}

# the state the energy reads: d.x, or its rounded copy where ReadRounded
fn (d mut Descent<T>&) rounded() mut Array<F64>& {
    if d.StateBits <= 0 or not d.ReadRounded: return d.x
    for i in range d.n: d.xq[i] = d.x[i]
    d.quantize(d.xq)
    return d.xq
}

# x rounded in place as StateBits, StateBlock, StateClip and StateStochastic say
fn (d mut Descent<T>&) quantize(x mut Array<F64>&) {
    per := d.StateBlock if d.StateBlock > 0 else d.n / d.G.Batch
    for b in range x.Len() / per: d.block(x, b * per, per)
}

fn (d mut Descent<T>&) block(x mut Array<F64>&, o I64, per I64) {
    bits := d.StateBits
    mx, sq, ab := 0.0, 0.0, 0.0
    for i in range o, o + per {
        mx = mx.Max(x[i].Abs())
        sq += x[i] * x[i]
        ab += x[i].Abs()
    }
    if mx == 0.0: return
    ab /= F64(per)
    if bits == 1 {
        for i in range o, o + per: x[i] = ab if x[i] >= 0.0 else -ab
        return
    }
    if bits == 2 {
        t := 0.7 * ab
        s, c := 0.0, 0.0
        for i in range o, o + per {
            if x[i].Abs() <= t: continue
            s += x[i].Abs()
            c += 1.0
        }
        s = s / c if c > 0.0 else ab
        for i in range o, o + per: x[i] = (s if x[i] > 0.0 else -s) if x[i].Abs() > t else 0.0
        return
    }
    lv := F64((1 << (bits - 1)) - 1)
    sc := mx.Min(d.StateClip * (sq / F64(per)).Sqrt()) / lv
    for i in range o, o + per {
        q := x[i] / sc
        if d.StateStochastic {
            fl := q.Floor()
            q = fl + 1.0 if d.uniform() < q - fl else fl
        } else {
            q = q.Round()
        }
        x[i] = q.Max(-lv).Min(lv) * sc
    }
}

# the noise generator's next uniform in (0, 1)
fn (d mut Descent<T>&) uniform() F64 {
    d.jit ^= d.jit << 13
    d.jit ^= d.jit >> 7
    d.jit ^= d.jit << 17
    return (F64(d.jit >> 11) + 0.5) / 9007199254740992.0
}

# a standard normal (Box-Muller)
fn (d mut Descent<T>&) gauss() F64 {
    u, v := d.uniform(), d.uniform()
    return (-2.0 * u.Log()).Sqrt() * (6.283185307179586 * v).Cos()
}

# every group of Sphere elements of d.x scaled to unit RMS
fn (d mut Descent<T>&) project() {
    k := d.Sphere
    for g in range d.n / k {
        sq := 0.0
        for i in range k: sq += d.x[g * k + i] * d.x[g * k + i]
        f := 1.0 / (sq / F64(k) + 1e-12).Sqrt()
        for i in range k: d.x[g * k + i] *= f
    }
}

# the largest |entry| of gx's part tangent to the sphere at x, group by group
fn (d Descent<T>&) tangent(x Array<F64>&) F64 {
    k := d.Sphere
    worst := 0.0
    for g in range d.n / k {
        gx, xx := 0.0, 0.0
        for i in range k {
            gx += d.gx[g * k + i] * x[g * k + i]
            xx += x[g * k + i] * x[g * k + i]
        }
        r := gx / (xx + 1e-30)
        for i in range k: worst = worst.Max((d.gx[g * k + i] - r * x[g * k + i]).Abs())
    }
    return worst
}

# what a settle descends at the point of the last Forward: E + beta C
fn (d Descent<T>&) objective(beta F64) F64 {
    e := d.G.Scalar(d.E)
    return e + beta * d.G.Scalar(d.C) if beta != 0.0 else e
}

fn (d mut Descent<T>&) record(slot I64) {
    for i in range d.n: d.trail[slot * d.n + i] = d.x[i]
}

# the state at x, a Forward: C's and E's values are x's
fn (d mut Descent<T>&) put(x Array<F64>&) {
    s := d.G.Value(d.X).Flat()!
    for i in range d.n: s[i] = T(x[i])
    d.G.Forward(d.G.Batch)
    d.Forwards++
}

# ---- training ----

# dL/dtheta into the graph's ParamGrads() by how, from a free settle starting at the state's current value; the state is
# left at the free fixed point. The free settle's outcome
fn (d mut Descent<T>&) Train(how Trainer) Settled {
    s := d.G.Value(d.X).Flat()!
    for i in range d.n: d.x[i] = F64(s[i])
    keep := match how {
        case Trainer.Unrolled(h): h.Max(1)
        case _: 0
    }
    ep := match how {
        case Trainer.Ep(_, _): true
        case Trainer.Margin(_): true
        case _: false
    }
    if d.Sphere > 0 and not ep: unreachable "oann: Descent.Train Unrolled or Implicit with a Sphere state - they differentiate the steps"
    if keep > 0 and d.Adaptive: unreachable "oann: Descent.Train Unrolled with Adaptive steps - it differentiates the steps"
    if d.trail.Len() < keep * d.n: d.trail = Array<F64>(keep * d.n)
    d.Last = d.settle(0.0, keep)
    for i in range d.n: d.free[i] = d.x[i]
    match how {
        case Trainer.Unrolled(h): d.unrolled(h.Max(1).Min(d.Last.Steps))
        case Trainer.Implicit(tol, iterations): d.implicit(tol, iterations)
        case Trainer.Ep(beta, centered): d.ep(beta, centered)
        case Trainer.Margin(m): d.margin(m)
    }
    d.put(d.free)
    pg := d.G.ParamGrads().Flat()!
    for i in range d.p: pg[i] = T(d.acc[i])
    return d.Last
}

# back through the last h steps: lambda from dC/dx at the last state
fn (d mut Descent<T>&) unrolled(h I64) {
    d.costGrad(d.free, d.lam)
    for i in range d.p: d.acc[i] = 0.0
    keep := d.trail.Len() / d.n
    for j in range h {
        slot := (d.Last.Steps - 1 - j) % keep
        for i in range d.n: d.res[i] = d.trail[slot * d.n + i]
        d.along(d.res, d.lam)
        for i in range d.p: d.acc[i] -= d.Rate * d.mv[i]
        for i in range d.n: d.lam[i] -= d.Rate * d.hv[i]
        if d.Ds > 0.0 {
            d.costGrad(d.res, d.cx)
            for i in range d.n: d.lam[i] += d.Ds * d.cx[i]
        }
    }
}

# H lambda = dC/dx by conjugate gradients from 0, then -(d g/dtheta)^T lambda
fn (d mut Descent<T>&) implicit(tol F64, iterations I64) {
    d.costGrad(d.free, d.res)
    for i in range d.n {
        d.lam[i] = 0.0
        d.dir[i] = d.res[i]
    }
    rr := dot(d.res, d.res)
    out := Settled(0, rr.Sqrt(), rr.Sqrt() < tol)
    for k in range iterations {
        if out.Converged: break
        d.along(d.free, d.dir)
        curve := dot(d.dir, d.hv)
        if curve <= 0.0: break
        a := rr / curve
        for i in range d.n {
            d.lam[i] += a * d.dir[i]
            d.res[i] -= a * d.hv[i]
        }
        next := dot(d.res, d.res)
        for i in range d.n: d.dir[i] = d.res[i] + next / rr * d.dir[i]
        rr = next
        out = Settled(k + 1, rr.Sqrt(), rr.Sqrt() < tol)
    }
    d.Adjoint = out
    d.along(d.free, d.lam)
    for i in range d.p: d.acc[i] = -d.mv[i]
}

# the nudged settles from the free fixed point and their contrast
fn (d mut Descent<T>&) ep(beta F64, centered Bool) {
    d.Nudged = d.settle(beta, 0)
    d.at(d.x, beta)
    for i in range d.p: d.acc[i] = d.gp[i]
    if not centered {
        d.at(d.free, 0.0)
        for i in range d.p: d.acc[i] = (d.acc[i] - d.gp[i]) / beta
        return
    }
    for i in range d.n: d.x[i] = d.free[i]
    d.Nudged = d.settle(-beta, 0)
    d.at(d.x, -beta)
    for i in range d.p: d.acc[i] = (d.acc[i] - d.gp[i]) / (2.0 * beta)
}

# the settle from the target, the rows' energies at both fixed points, and the hinge's gradient over the rows that take
# it: the state at the target's fixed point against the state with those rows at the free fixed point (every other
# row the same in both, so it cancels)
fn (d mut Descent<T>&) margin(m F64) {
    if d.RowEnergy == graph.None: unreachable "oann: Descent.Train Margin needs RowEnergy, the energy row by row"
    for i in range d.n: d.x[i] = d.target[i]
    d.Nudged = d.settle(0.0, 0)
    d.rowsAt(d.x, d.eT)
    d.rowsAt(d.free, d.eF)
    rows := d.G.Batch
    per := d.n / rows
    d.Active = 0
    for r in range rows {
        apart := false
        for i in range r * per, (r + 1) * per: apart = apart or (d.x[i] - d.free[i]).Abs() > d.Apart
        take := apart and d.eT[r] + m > d.eF[r]
        if take: d.Active++
        for i in range r * per, (r + 1) * per: d.other[i] = d.free[i] if take else d.x[i]
    }
    d.at(d.x, 0.0)
    for i in range d.p: d.acc[i] = d.gp[i]
    d.at(d.other, 0.0)
    for i in range d.p: d.acc[i] = (d.acc[i] - d.gp[i]) / F64(rows)
}

# the settled-pair margin, added to ParamGrads (after a Train or any Backward): the state as it is (the first settled
# state) against a second settle from start; right(z, row) tells whether row's part of state z answers it. A row with
# one right and one wrong settled state, E_r(right) > E_r(wrong) - m, adds weight (dE/dtheta(right) - dE/dtheta(wrong));
# rows that do not are given the same state in both passes and cancel. The state is left as it was. The rows that added
fn (d mut Descent<T>&) AddMargin(m F64, weight F64, start Array<F64>&, right fn&(z Array<F64>&, row I64) Bool) I64 {
    if d.RowEnergy == graph.None: unreachable "oann: Descent.AddMargin needs RowEnergy, the energy row by row"
    g := d.G
    s := g.Value(d.X).Flat()!
    for i in range d.n: d.free[i] = F64(s[i])
    pg := g.ParamGrads().Flat()!
    for i in range d.p: d.acc[i] = F64(pg[i])
    d.rowsAt(d.free, d.eF)
    for i in range d.n: d.x[i] = start[i]
    d.Nudged = d.settle(0.0, 0)
    d.rowsAt(d.x, d.eT)
    rows := g.Batch
    per := d.n / rows
    d.Active = 0
    for r in range rows {
        a, b := right(d.free, r), right(d.x, r)
        aRight, bRight := a and not b, b and not a
        on := (aRight and d.eF[r] > d.eT[r] - m) or (bRight and d.eT[r] > d.eF[r] - m)
        if on: d.Active++
        # up: the right state (or, off, the first state in both), other: the wrong one
        for i in range r * per, (r + 1) * per {
            d.up[i] = d.free[i] if aRight or not on else d.x[i]
            d.down[i] = d.x[i] if aRight and on else (d.free[i] if on else d.up[i])
        }
    }
    if d.Active > 0 {
        d.at(d.up, 0.0)
        for i in range d.p: d.acc[i] += weight * d.gp[i]
        d.at(d.down, 0.0)
        for i in range d.p: d.acc[i] -= weight * d.gp[i]
    }
    d.put(d.free)
    for i in range d.p: pg[i] = T(d.acc[i])
    return d.Active
}

# each row's energy at the state x (a Forward) into out
fn (d mut Descent<T>&) rowsAt(x Array<F64>&, out mut Array<F64>&) {
    g := d.G
    s := g.Value(d.X).Flat()!
    for i in range d.n: s[i] = T(x[i])
    g.Forward(g.Batch)
    d.Forwards++
    e := g.Value(d.RowEnergy).Flat()!
    for r in range g.Batch: out[r] = F64(e[r])
}

fn dot(a Array<F64>&, b Array<F64>&) F64 {
    total F64 = 0.0
    for i in range a.Len(): total += a[i] * b[i]
    return total
}

fn norm(a Array<F64>&) F64 { return dot(a, a).Sqrt() }

# ---- tests ----

# a small convex energy on a graph of 2 rows: E = 1/2 |x|^2 + 1/2 |W x + b - u|^2 + q/4 sum x^4 (q 0 or 0.4), the cost
# C = 1/2 |x - y|^2; u and y data
fn convex(q F64) graph.Graph<F64>, graph.Var, graph.Var, graph.Var {
    g := graph.Graph<F64>(2)
    x := g.Input(4)
    g.Watch(x)
    u := g.Input(3)
    y := g.Input(4)
    w := g.Param(graph.Init.Normal(0.0, 0.5), true, 3, 4)
    b := g.Param(graph.Init.Normal(0.0, 0.5), false, 3)
    r := g.Sub(g.Linear(x, w, b), u)
    xx := g.Mul(x, x)
    e := g.Add(g.Scale(summed(g, xx), 0.5), g.Scale(summed(g, g.Mul(r, r)), 0.5))
    if q != 0.0: e = g.Add(e, g.Scale(summed(g, g.Mul(xx, xx)), q / 4.0))
    c0 := g.Sub(x, y)
    c := g.Scale(summed(g, g.Mul(c0, c0)), 0.5)
    g.Keep(e)
    g.Keep(c)
    g.Plan(rand.Rand(3))!
    fill(g, u, rand.Rand(4), 1.0)
    fill(g, y, rand.Rand(5), 1.0)
    return g, x, e, c
}

# every element summed: over the last axis, then over the rows
fn summed(g mut graph.Graph<F64>&, v graph.Var) graph.Var { return g.Sum(g.Sum(v)) }

fn fill(g mut graph.Graph<F64>&, v graph.Var, r rand.Rand, k F64) {
    t := g.Value(v)
    t.FillUniform(r, -k, k)
}

# the cost at the free fixed point, settled from 0
fn costAt(d mut Descent<F64>&) F64 {
    s := d.G.Value(d.X).Flat()!
    for i in range s.Len(): s[i] = 0.0
    d.Settle()
    return d.G.Scalar(d.C)
}

# dL/dtheta by central differences of the settled cost
fn differences(d mut Descent<F64>&) Array<F64> {
    ps := d.G.Params().Flat()!
    out := Array<F64>(ps.Len())
    h := 1e-5
    for i in range ps.Len() {
        old := ps[i]
        ps[i] = old + h
        up := costAt(d)
        ps[i] = old - h
        down := costAt(d)
        ps[i] = old
        out[i] = (up - down) / (2.0 * h)
    }
    return out
}

fn gradOf(d mut Descent<F64>&, how Trainer) Array<F64> {
    s := d.G.Value(d.X).Flat()!
    for i in range s.Len(): s[i] = 0.0
    d.Train(how)
    pg := d.G.ParamGrads().Flat()!
    out := Array<F64>(pg.Len())
    for i in range pg.Len(): out[i] = pg[i]
    return out
}

fn relative(a Array<F64>&, b Array<F64>&) F64 {
    worst, top := 0.0, 0.0
    for i in range a.Len() {
        worst = worst.Max((a[i] - b[i]).Abs())
        top = top.Max(b[i].Abs())
    }
    return worst / top
}

test Descent.Train "unrolled, implicit and EP gradients against each other and central differences, quadratic and quartic energies" {
    for q in Array<F64>[0.0, 0.4] {
        g, x, e, c := convex(q)
        d := Descent<F64>(g, x, e, c)
        d.Rate = 0.2
        d.Tol = 1e-12
        want := differences(d)
        im := gradOf(d, Trainer.Implicit(1e-12, 100))
        assert d.Last.Converged and d.Adjoint.Converged and relative(im, want) < 1e-6, "q " + $q + ": implicit " + $relative(im, want)
        un := gradOf(d, Trainer.Unrolled(400))
        assert relative(un, im) < 1e-6, "q " + $q + ": unrolled(400) " + $relative(un, im)
        short := gradOf(d, Trainer.Unrolled(3))
        assert relative(short, im) > 1e-3, "q " + $q + ": unrolled(3) " + $relative(short, im)
        ep := gradOf(d, Trainer.Ep(1e-3, true))
        assert relative(ep, im) < 1e-5, "q " + $q + ": EP centered " + $relative(ep, im)
        one := gradOf(d, Trainer.Ep(1e-3, false))
        assert relative(one, im) < 1e-2 and relative(one, im) > relative(ep, im), "q " + $q + ": EP one-sided " + $relative(one, im)
        # the state is left at the free fixed point
        assert (g.Scalar(c) - costAt(d)).Abs() < 1e-12
        # every pass counted: a free settle of n steps alone is n + 1 of each
        f0, b0 := d.Forwards, d.Backwards
        n := d.Settle().Steps
        assert d.Forwards - f0 == n + 1 and d.Backwards - b0 == n + 1
        # the nudged settles' own cap
        d.NudgedSteps = 3
        gradOf(d, Trainer.Ep(1e-3, true))
        assert d.Nudged.Steps <= 3 and d.Last.Steps > 3
        d.NudgedSteps = 0
    }
}

test Descent.Settle "adaptive steps settle where a fixed step diverges, to the same fixed point and EP gradient" {
    g, x, e, c := convex(0.4)
    d := Descent<F64>(g, x, e, c)
    d.Rate = 0.2
    d.Tol = 1e-12
    want := gradOf(d, Trainer.Implicit(1e-12, 100))
    d.Rate = 3.0
    d.Steps = 200
    s := g.Value(x).Flat()!
    for i in range s.Len(): s[i] = 0.0
    assert not d.Settle().Converged, "a fixed step of 3 should not settle"
    d.Adaptive = true
    d.Steps = 100000
    ep := gradOf(d, Trainer.Ep(1e-3, true))
    assert d.Last.Converged and relative(ep, want) < 1e-5, "adaptive EP " + $relative(ep, want)
    # and from the fixed step that settles, in fewer steps
    adaptive := d.Last.Steps
    d.Adaptive = false
    d.Rate = 0.2
    gradOf(d, Trainer.Ep(1e-3, true))
    assert adaptive < d.Last.Steps, $adaptive + " adaptive steps, " + $d.Last.Steps + " fixed"
    Println("  adaptive from 3: " + $adaptive + " steps; fixed 0.2: " + $d.Last.Steps)
}

# the settled cost from a state of ones, and its central differences in the parameters (Sphere states)
fn onesCost(d mut Descent<F64>&) F64 {
    s := d.G.Value(d.X).Flat()!
    for i in range s.Len(): s[i] = 1.0
    d.Settle()
    return d.G.Scalar(d.C)
}

test Descent.Train "EP on a sphere state against central differences of the settled cost" {
    g, x, e, c := convex(0.4)
    d := Descent<F64>(g, x, e, c)
    d.Rate = 0.05
    d.Tol = 1e-12
    d.Sphere = 4
    ps := g.Params().Flat()!
    want := Array<F64>(ps.Len())
    for i in range ps.Len() {
        old := ps[i]
        ps[i] = old + 1e-5
        up := onesCost(d)
        ps[i] = old - 1e-5
        down := onesCost(d)
        ps[i] = old
        want[i] = (up - down) / 2e-5
    }
    s := g.Value(x).Flat()!
    for i in range s.Len(): s[i] = 1.0
    d.Train(Trainer.Ep(1e-4, true))
    pg := g.ParamGrads().Flat()!
    got := Array<F64>(pg.Len())
    for i in range pg.Len(): got[i] = pg[i]
    assert d.Last.Converged and relative(got, want) < 1e-4, "sphere EP " + $relative(got, want)
    # the settled state is on the sphere
    sq := 0.0
    for i in range 4: sq += s[i] * s[i]
    assert (sq / 4.0 - 1.0).Abs() < 1e-9
}

test Descent.Train "a few steps of gradient descent on the parameters by EP lower the settled cost" {
    g, x, e, c := convex(0.4)
    d := Descent<F64>(g, x, e, c)
    d.Rate = 0.2
    before := costAt(d)
    ps := g.Params().Flat()!
    for _ in range 30 {
        gradOf(d, Trainer.Ep(1e-2, true))
        pg := g.ParamGrads().Flat()!
        for i in range ps.Len(): ps[i] -= 0.1 * pg[i]
    }
    after := costAt(d)
    assert after < 0.5 * before, $before + " -> " + $after
}

# a double well a row, tilted by w u: E_r = (x_r^2 - 1)^2 - w u_r x_r, the state's start in the well opposite to the
# sign of u, the target the well u points to. Gives the graph, the state, the row energies and the energy
fn wells(rows I64, w0 F64) graph.Graph<F64>, graph.Var, graph.Var, graph.Var, graph.Var {
    g := graph.Graph<F64>(rows)
    x := g.Input(1)
    g.Watch(x)
    u := g.Input(1)
    w := g.Param(graph.Init.Uniform(w0, w0), false, 1, 1)
    a := g.AddScalar(g.Mul(x, x), -1.0)
    rowE := g.Sum(g.Sub(g.Mul(a, a), g.Mul(g.Linear(u, w), x)))
    e := g.Sum(rowE)
    c := g.Sum(g.Sum(g.Mul(x, x)))
    g.Keep(rowE)
    g.Keep(e)
    g.Keep(c)
    g.Plan(rand.Rand(1))!
    us := g.Value(u).Flat()!
    xs := g.Value(x).Flat()!
    for r in range rows {
        us[r] = 1.0 if r % 2 == 0 else -1.0
        xs[r] = -us[r]
    }
    return g, x, rowE, e, c
}

# the batch's mean hinge max(0, m + E_r(yt) - E_r(yf)) at the parameters as they are
fn hingeAt(d mut Descent<F64>&, yt Array<F64>&, yf Array<F64>&, m F64) F64 {
    d.rowsAt(yt, d.eT)
    d.rowsAt(yf, d.eF)
    total F64 = 0.0
    for r in range d.G.Batch: total += (m + d.eT[r] - d.eF[r]).Max(0.0)
    return total / F64(d.G.Batch)
}

test Descent.Train "Margin: the hinge between the target's well and the other start's is the gradient of the batch's mean hinge, and steps of it deepen the target's well until every row is m apart" {
    rows, m := 8, 0.5
    g, x, rowE, e, c := wells(rows, 0.05)
    d := Descent<F64>(g, x, e, c)
    d.RowEnergy = rowE
    d.Rate = 0.05
    t := Array<F64>(rows)
    for r in range rows: t[r] = 1.0 if r % 2 == 0 else -1.0
    d.SetTarget(t)
    out := d.Train(Trainer.Margin(m))
    assert out.Converged and d.Nudged.Converged and d.Active == rows
    got := g.ParamGrads().Flat()![0]
    # the hinge's derivative in w at the two fixed points (stationary in x, so re-settling adds nothing to first order)
    yt := Array<F64>(rows)
    for r in range rows: yt[r] = d.x[r]
    yf := Array<F64>(rows)
    for r in range rows: yf[r] = d.free[r]
    ws := g.Params().Flat()!
    w := ws[0]
    ws[0] = w + 1e-6
    up := hingeAt(d, yt, yf, m)
    ws[0] = w - 1e-6
    want := (up - hingeAt(d, yt, yf, m)) / 2e-6
    ws[0] = w
    assert (got - want).Abs() < 1e-6 * (1.0 + want.Abs()), "Margin's gradient " + $got + " against " + $want
    # descending the hinge: w grows until the target's well is the deeper by m in every row
    steps I64 = 0
    for d.Active > 0 and steps < 500 {
        for r in range rows: g.Value(x).Flat()![r] = -t[r]
        d.Train(Trainer.Margin(m))
        ws[0] -= 0.1 * g.ParamGrads().Flat()![0]
        steps++
    }
    assert d.Active == 0 and steps < 500, $steps + " steps, " + $d.Active + " rows still within the margin"
    for r in range rows: assert d.eT[r] + m <= d.eF[r] + 1e-9 or (d.x[r] - d.free[r]).Abs() <= d.Apart
}


test Descent.AddMargin "the settled-pair margin: two settles, the right one judged by the caller; the term added is weight times the gradient of the summed hinge, on top of what ParamGrads held, and its steps put every right state m below the wrong one" {
    rows, m, weight := 8, 1.0, 0.3
    g, x, rowE, e, c := wells(rows, 0.05)
    d := Descent<F64>(g, x, e, c)
    d.RowEnergy = rowE
    d.Rate = 0.05
    t := Array<F64>(rows)
    for r in range rows: t[r] = 1.0 if r % 2 == 0 else -1.0
    right := fn(z Array<F64>&, row I64) Bool { return z[row] * t[row] > 0.0 }
    d.Settle(0.0)                                   # the first settled state: every row in the wrong well
    first := Array<F64>(rows)
    for r in range rows: first[r] = d.x[r]
    pg := g.ParamGrads().Flat()!
    pg[0] = 0.25                                    # what a trainer left there
    active := d.AddMargin(m, weight, t, right)
    assert active == rows and g.Value(x).Flat()![0] == first[0], "the state is left as it was"
    yr := Array<F64>(rows)
    for r in range rows: yr[r] = d.x[r]
    ws := g.Params().Flat()!
    w := ws[0]
    ws[0] = w + 1e-6
    up := hingeAt(d, yr, first, m)
    ws[0] = w - 1e-6
    want := 0.25 + weight * F64(rows) * (up - hingeAt(d, yr, first, m)) / 2e-6
    ws[0] = w
    got := g.ParamGrads().Flat()![0]
    assert (got - want).Abs() < 1e-6 * (1.0 + want.Abs()), "AddMargin's gradient " + $got + " against " + $want
    steps I64 = 0
    for d.Active > 0 and steps < 500 {
        for r in range rows: g.Value(x).Flat()![r] = first[r]
        g.ParamGrads().Flat()![0] = 0.0
        d.AddMargin(m, weight, t, right)
        ws[0] -= 0.1 * g.ParamGrads().Flat()![0]
        steps++
    }
    assert d.Active == 0 and steps < 500, $steps + " steps"
}

test Descent.Settle "Langevin steps sample exp(-E / T): on E = |x|^2 / 2 each element's variance is about T, and cooling brings the state back to the minimum" {
    g := graph.Graph<F64>(1)
    x := g.Input(400)
    g.Watch(x)
    e := g.Scale(summed(g, g.Mul(x, x)), 0.5)
    g.Keep(e)
    g.Plan(rand.Rand(3))!
    d := Descent<F64>(g, x, e, e)
    d.Rate = 0.05
    d.Tol = 0.0
    d.Steps = 2000
    d.Temperature = 0.1
    d.Settle()
    s := g.Value(x).Flat()!
    sq F64 = 0.0
    for i in range 400: sq += s[i] * s[i]
    variance := sq / 400.0
    # the discretized chain's variance is T / (1 - rate / 2)
    assert (variance / (0.1 / 0.975) - 1.0).Abs() < 0.2, $variance
    d.Cooling = 0.99
    d.Settle()
    sq = 0.0
    for i in range 400: sq += s[i] * s[i]
    assert sq / 400.0 < 1e-3, $(sq / 400.0)
}

test Descent.Train "deep supervision: Unrolled with Ds is the gradient of the last state's cost plus Ds times each unrolled state's" {
    g, x, e, c := convex(0.4)
    d := Descent<F64>(g, x, e, c)
    d.Rate = 0.2
    d.Tol = 0.0
    n := 12
    d.Steps = n
    d.Ds = 0.5
    got := gradOf(d, Trainer.Unrolled(n))
    ps := g.Params().Flat()!
    h := 1e-5
    for i in range ps.Len() {
        old := ps[i]
        js := Array<F64>(2)
        for side in range 2 {
            ps[i] = old + (h if side == 0 else -h)
            total F64 = 0.0
            for t in range n + 1 {
                d.Steps = t
                total += costAt(d) * (1.0 if t == n else d.Ds)
            }
            js[side] = total
        }
        ps[i] = old
        d.Steps = n
        want := (js[0] - js[1]) / (2.0 * h)
        assert (got[i] - want).Abs() < 1e-5 * (1.0 + want.Abs()), $i + ": " + $got[i] + " against " + $want
    }
}

test Descent.Settle "a low-bit state: after a settle every block's values lie on its own levels (4 bits: at most 15; 1 bit: +- one value), and read-rounded keeps the state exact" {
    g, x, e, c := convex(0.4)
    d := Descent<F64>(g, x, e, c)
    d.Rate = 0.2
    d.Tol = 0.0
    d.Steps = 30
    s := g.Value(x).Flat()!
    for bits in Array<I64>[4, 1] {
        d.StateBits = bits
        for i in range s.Len(): s[i] = 0.3 * F64(i % 5) - 0.6
        d.Settle()
        for row in range 2 {
            levels := Vec<F64>()
            for j in range 4 {
                v := s[row * 4 + j]
                seen := false
                for l in levels: seen = seen or (l - v).Abs() < 1e-12
                if not seen: levels.Push(v)
            }
            top F64 = 0.0
            for l in levels: top = top.Max(l.Abs())
            if bits == 1: assert levels.Len() <= 2 and (levels.Len() < 2 or (levels[0] + levels[1]).Abs() < 1e-12)
            # 4 bits: every value an integer multiple (|q| <= 7) of the block's step
            if bits == 4 and top > 0.0 {
                step := top / 7.0
                for l in levels: assert ((l / step) - (l / step).Round()).Abs() < 1e-6, $l + " on steps of " + $step
            }
        }
    }
    d.StateBits = 4
    d.ReadRounded = true
    for i in range s.Len(): s[i] = 0.3 * F64(i % 5) - 0.6
    d.Settle()
    distinct I64 = 0
    for i in range s.Len() {
        for j in range i: distinct += 1 if (s[i] - s[j]).Abs() > 1e-9 else 0
    }
    assert distinct > 0
}
