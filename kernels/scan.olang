# kernels/scan - linear recurrences over a sequence, forward and backward, each as a sequential scan and as a chunked
# form that spreads one sequence over tasks (and, for the delta rule, over gemm's products), on `mat.Mat` operands.
#
# n rows are `seqs` sequences of `at.Len` rows (row r is position r % Len of sequence r / Len, as attention's); the
# columns of a row are channels, each an independent recurrence - except the delta rule's heads. A state is kept in the
# accumulator A (F32, or F64 for F64), whatever the storage S (F32, BF16, F16 or F64) of the inputs and outputs: the
# running state is never rounded to S, only the outputs written are, once each. A state is passed in and comes back
# changed (the state after the last position), so a sequence may be run in pieces - decoding one position at a time is
# the same call with Len 1 - and a caller who wants a fresh sequence passes zeros. Kernels check nothing: shapes are the
# caller's, checked once where the operands are made.
#
#   GatedScan        h_t = a_t h_{t-1} + b_t x_t                        elementwise: the consolidator's slow part
#                    (l, (1 - l) z), a state-space model after discretization, QRNN's f-pooling
#   SelectiveScan    h_t = exp(delta_t A) h_{t-1} + delta_t B_t x_t,    Mamba's selective state-space scan (Gu and Dao 2023):
#                    y_t = C_t h_t + D x_t                              N states per channel, the readout in the same pass
#   DeltaRule        S_t = alpha_t S_{t-1} (I - beta_t k_t k_t^T) + beta_t v_t k_t^T,   o_t = S_t q_t
#                    DeltaNet (Yang et al. 2024) at alpha 1, Gated DeltaNet's gate otherwise (Yang, Kautz, Hatamizadeh 2024)
#
# Every kernel here has a sequential form (the loop the equation is) and a chunked one that computes the same numbers in
# another order. The diagonal recurrences are chunked as a scan is - a pass over the chunks (in tasks) for what each
# leaves behind (the product of its a's and its end state from nothing), a short pass over those in order for the state
# each chunk starts from, a pass over the chunks (in tasks) from their starts - so the time axis is parallel: twice the
# work, the span of a chunk and a pass over the chunks. The delta rule is chunked in the WY form (DeltaNet's chunkwise
# parallel algorithm): the state's changes within a chunk are solved for at once by a triangular system, and everything
# else is gemm's products - a chunk costs a few matrix products of the chunk's size instead of one rank-1 update per
# position. Both forms are exact reorderings, so they agree to rounding (the tests hold F32 to 1e-5).
#
# Work is split over tasks by sequence, channel block or head - never across a sum - so a result is the same for every
# thread count. The work object holds the thread count and the scratch; it grows on the first call and then allocates
# nothing.

import "mat"
import "gemm"

# how n rows are cut: sequences of Len rows, a chunk of Chunk positions (the chunked forms), the delta rule's Heads
type Seq struct(Len I64, Chunk I64 = 64, Heads I64 = 1) {
    Len
    Chunk
    Heads
}

# the thread count and the scratch the kernels need, grown on the first call
type Work<A> struct(threads I64) {
    Threads I64 = threads if threads > 0 else 1
    buf mut Array<A>& = Array<A>(0)
}

fn (w mut Work<A>&) scratch(n I64) mut Array<A>& {
    if w.buf.Len() < n: w.buf = Array<A>(n if n > w.buf.Len() * 2 else w.buf.Len() * 2)
    return w.buf
}

# ---- tasks ----

# runs the job's units lo ... hi - 1 in at most `threads` runs of consecutive units (run's third argument is the run's
# number, for the scratch each has); with one run, on the calling thread. Units do not overlap, so a task writes only its own
fn spread<J>(j J&, units I64, threads I64) {
    tasks := threads if threads < units else units
    if tasks <= 1 {
        j.run(0, units, 0)
        return
    }
    share := (units + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo := t * share
            hi := lo + share if lo + share < units else units
            if lo < hi: spawn j.run(lo, hi, t)
        }
    }
}

# the columns a unit takes: a block this wide (a row of a block is a few vectors long, and its state stays in cache)
scanWidth I64 = 512

fn blocksOf(cols I64) I64 { return (cols + scanWidth - 1) / scanWidth }

fn lesser(a I64, b I64) I64 { return a if a < b else b }

fn chunksOf(at Seq) I64 { return (at.Len + at.Chunk - 1) / at.Chunk }

# ---- GatedScan ----

# h_t = a_t h_{t-1} + b_t x_t, per channel: positions r0 ... r1 - 1 (rows) and channels c0 ... c1 - 1, from the state in
# sd[so ...] (indexed by channel), which is left holding the state after row r1 - 1
fn scanSteps<S, A>(h mat.Mat<S>&, x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, sd mut Array<A>&, so I64, r0 I64, r1 I64, c0 I64, c1 I64) {
    hd := h.Data
    for r in range r0, r1 {
        ho := h.Off + r * h.Ld
        xo := x.Off + r * x.Ld
        ao := a.Off + r * a.Ld
        bo := b.Off + r * b.Ld
        for c in range c0, c1 {
            v := A(a.Data[ao + c]) * sd[so + c] + A(b.Data[bo + c]) * A(x.Data[xo + c])
            sd[so + c] = v
            hd[ho + c] = S(v)
        }
    }
}

# what rows r0 ... r1 - 1 leave behind over channels c0 ... c1 - 1: ps their a's product and es the state they end in from
# a state of zero, both at [o + c ...]
fn scanSummary<S, A>(x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, ps mut Array<A>&, es mut Array<A>&, o I64, r0 I64, r1 I64, c0 I64, c1 I64) {
    for c in range c0, c1 {
        ps[o + c] = 1.0
        es[o + c] = 0.0
    }
    for r in range r0, r1 {
        xo := x.Off + r * x.Ld
        ao := a.Off + r * a.Ld
        bo := b.Off + r * b.Ld
        for c in range c0, c1 {
            av := A(a.Data[ao + c])
            ps[o + c] = av * ps[o + c]
            es[o + c] = av * es[o + c] + A(b.Data[bo + c]) * A(x.Data[xo + c])
        }
    }
}

type scanJob<S, A> struct(h mat.Mat<S>, st mat.Mat<A>, x mat.Mat<S>, a mat.Mat<S>, b mat.Mat<S>, at Seq) {
    h
    st
    x
    a
    b
    at
}

# unit u: sequence u / blocks, channel block u % blocks
fn (j scanJob<S, A>&) run(lo I64, hi I64, task I64) {
    blocks := blocksOf(j.h.Cols)
    for u in range lo, hi {
        s := u / blocks
        c0 := u % blocks * scanWidth
        scanSteps<S, A>(j.h, j.x, j.a, j.b, j.st.Data, j.st.Off + s * j.st.Ld, s * j.at.Len, (s + 1) * j.at.Len, c0, lesser(c0 + scanWidth, j.h.Cols))
    }
}

# h = the scan of x with gates a and inputs b from state (seqs x D, in the accumulator), the sequential form: one pass
# over each sequence, the sequences and channel blocks in tasks. state holds the last position's state afterwards
fn GatedScan<S, A>(ws mut Work<A>&, h mut mat.Mat<S>&, state mut mat.Mat<A>&, x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, at Seq) {
    seqs := h.Rows / at.Len
    spread(scanJob<S, A>(h, state, x, a, b, at), seqs * blocksOf(h.Cols), ws.Threads)
}

# the summaries (pass 1) of chunks: unit u = (sequence s, chunk k, channel block), at ps and es [(s chunks + k) D ...]
type scanSummaryJob<S, A> struct(x mat.Mat<S>, a mat.Mat<S>, b mat.Mat<S>, ps mut Array<A>&, es mut Array<A>&, at Seq) {
    x
    a
    b
    ps
    es
    at
}

fn (j scanSummaryJob<S, A>&) run(lo I64, hi I64, task I64) {
    cols := j.x.Cols
    blocks := blocksOf(cols)
    chunks := chunksOf(j.at)
    for u in range lo, hi {
        sk := u / blocks
        c0 := u % blocks * scanWidth
        s := sk / chunks
        r0 := s * j.at.Len + sk % chunks * j.at.Chunk
        r1 := lesser(r0 + j.at.Chunk, (s + 1) * j.at.Len)
        scanSummary<S, A>(j.x, j.a, j.b, j.ps, j.es, sk * cols, r0, r1, c0, lesser(c0 + scanWidth, cols))
    }
}

# the carry (pass 2) of the forward scan runs the chunks first to last, the backward one last to first: per (sequence,
# channel block) the chunks' start (or, backward, incoming) states in order, written over es; st takes the end
type scanCarryJob<A> struct(st mat.Mat<A>, ps mut Array<A>&, es mut Array<A>&, cols I64, chunks I64, backward Bool) {
    st
    ps
    es
    cols
    chunks
    backward
}

# the chunks' starts, backward the chunks' incoming gradients: es (what chunk k leaves from nothing) replaced by the state
# it starts from, st the state after the last chunk
fn (j scanCarryJob<A>&) run(lo I64, hi I64, task I64) {
    blocks := blocksOf(j.cols)
    for u in range lo, hi {
        s := u / blocks
        c0 := u % blocks * scanWidth
        c1 := lesser(c0 + scanWidth, j.cols)
        so := j.st.Off + s * j.st.Ld
        for i in range j.chunks {
            k := j.chunks - 1 - i if j.backward else i
            o := (s * j.chunks + k) * j.cols
            for c in range c0, c1 {
                cur := j.st.Data[so + c]
                j.st.Data[so + c] = j.ps[o + c] * cur + j.es[o + c]
                j.es[o + c] = cur
            }
        }
    }
}

# pass 3: each chunk from its start state, which it leaves changed in es
type scanChunkJob<S, A> struct(h mat.Mat<S>, x mat.Mat<S>, a mat.Mat<S>, b mat.Mat<S>, es mut Array<A>&, at Seq) {
    h
    x
    a
    b
    es
    at
}

fn (j scanChunkJob<S, A>&) run(lo I64, hi I64, task I64) {
    cols := j.h.Cols
    blocks := blocksOf(cols)
    chunks := chunksOf(j.at)
    for u in range lo, hi {
        sk := u / blocks
        c0 := u % blocks * scanWidth
        s := sk / chunks
        r0 := s * j.at.Len + sk % chunks * j.at.Chunk
        r1 := lesser(r0 + j.at.Chunk, (s + 1) * j.at.Len)
        scanSteps<S, A>(j.h, j.x, j.a, j.b, j.es, sk * cols, r0, r1, c0, lesser(c0 + scanWidth, cols))
    }
}

# GatedScan's chunked form, the same result in another order: the time axis in tasks too. Scratch: 2 seqs chunks D
fn GatedScanChunked<S, A>(ws mut Work<A>&, h mut mat.Mat<S>&, state mut mat.Mat<A>&, x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, at Seq) {
    cols := h.Cols
    seqs := h.Rows / at.Len
    chunks := chunksOf(at)
    size := seqs * chunks * cols
    buf := ws.scratch(2 * size)
    ps := buf[0:size]
    es := buf[size:2 * size]
    spread(scanSummaryJob<S, A>(x, a, b, ps, es, at), seqs * chunks * blocksOf(cols), ws.Threads)
    spread(scanCarryJob<A>(state, ps, es, cols, chunks, false), seqs * blocksOf(cols), ws.Threads)
    spread(scanChunkJob<S, A>(h, x, a, b, es, at), seqs * chunks * blocksOf(cols), ws.Threads)
}

# ---- GatedScan's gradients ----

# With g_t the gradient of the loss in the state after position t, g_t = dh_t + a_{t+1} g_{t+1} (dh_t the gradient of the
# output h_t, and the gradient of the final state added at the end), the gradients are
#   dx_t = b_t g_t,   db_t = x_t g_t,   da_t = h_{t-1} g_t,   and the initial state's  a_0 g_0
# - a scan again, backward in time, which the chunked form runs as it runs the forward one.
type scanGradJob<S, A> struct(dx mat.Mat<S>, da mat.Mat<S>, db mat.Mat<S>, dh mat.Mat<S>, h mat.Mat<S>, init mat.Mat<A>, x mat.Mat<S>, a mat.Mat<S>, b mat.Mat<S>, st mat.Mat<A>, es mut Array<A>&, at Seq, chunked Bool, add Bool) {
    dx
    da
    db
    dh
    h
    init
    x
    a
    b
    st
    es
    at
    chunked
    add
}

# one row r, channels c0 ... c1 - 1, g (in gd[go ...]) the gradient reaching its position from later ones; hp the previous
# state, h's row before r or the initial state
fn (j scanGradJob<S, A>&) row<P>(r I64, hp Array<P>&, ho I64, gd mut Array<A>&, go I64, c0 I64, c1 I64) {
    dho := j.dh.Off + r * j.dh.Ld
    xo := j.x.Off + r * j.x.Ld
    ao := j.a.Off + r * j.a.Ld
    bo := j.b.Off + r * j.b.Ld
    dxo := j.dx.Off + r * j.dx.Ld
    dao := j.da.Off + r * j.da.Ld
    dbo := j.db.Off + r * j.db.Ld
    for c in range c0, c1 {
        g := gd[go + c] + A(j.dh.Data[dho + c])
        nx := A(j.b.Data[bo + c]) * g
        nb := A(j.x.Data[xo + c]) * g
        na := A(hp[ho + c]) * g
        j.dx.Data[dxo + c] = S(nx + A(j.dx.Data[dxo + c]) if j.add else nx)
        j.db.Data[dbo + c] = S(nb + A(j.db.Data[dbo + c]) if j.add else nb)
        j.da.Data[dao + c] = S(na + A(j.da.Data[dao + c]) if j.add else na)
        gd[go + c] = A(j.a.Data[ao + c]) * g
    }
}

# rows r0 ... r1 - 1 of one sequence last to first, the incoming gradient in gd[go ...], left holding what flows on
fn (j scanGradJob<S, A>&) steps(gd mut Array<A>&, go I64, r0 I64, r1 I64, c0 I64, c1 I64) {
    first := r0 / j.at.Len * j.at.Len
    s := r0 / j.at.Len
    for i in range r1 - r0 {
        r := r1 - 1 - i
        if r == first: j.row<A>(r, j.init.Data, j.init.Off + s * j.init.Ld, gd, go, c0, c1)
        else: j.row<S>(r, j.h.Data, j.h.Off + (r - 1) * j.h.Ld, gd, go, c0, c1)
    }
}

fn (j scanGradJob<S, A>&) run(lo I64, hi I64, task I64) {
    cols := j.h.Cols
    blocks := blocksOf(cols)
    chunks := chunksOf(j.at)
    for u in range lo, hi {
        c0 := u % blocks * scanWidth
        c1 := lesser(c0 + scanWidth, cols)
        if not j.chunked {
            s := u / blocks
            j.steps(j.st.Data, j.st.Off + s * j.st.Ld, s * j.at.Len, (s + 1) * j.at.Len, c0, c1)
            continue
        }
        sk := u / blocks
        s := sk / chunks
        r0 := s * j.at.Len + sk % chunks * j.at.Chunk
        r1 := lesser(r0 + j.at.Chunk, (s + 1) * j.at.Len)
        j.steps(j.es, sk * cols, r0, r1, c0, c1)
    }
}

# pass 1 backward: what rows r0 ... r1 - 1 pass on to earlier ones from a gradient of zero (es) and their a's product (ps)
type scanGradSummaryJob<S, A> struct(dh mat.Mat<S>, a mat.Mat<S>, ps mut Array<A>&, es mut Array<A>&, at Seq) {
    dh
    a
    ps
    es
    at
}

fn (j scanGradSummaryJob<S, A>&) run(lo I64, hi I64, task I64) {
    cols := j.dh.Cols
    blocks := blocksOf(cols)
    chunks := chunksOf(j.at)
    for u in range lo, hi {
        sk := u / blocks
        c0 := u % blocks * scanWidth
        c1 := lesser(c0 + scanWidth, cols)
        s := sk / chunks
        r0 := s * j.at.Len + sk % chunks * j.at.Chunk
        r1 := lesser(r0 + j.at.Chunk, (s + 1) * j.at.Len)
        for c in range c0, c1 {
            j.ps[sk * cols + c] = 1.0
            j.es[sk * cols + c] = 0.0
        }
        for i in range r1 - r0 {
            r := r1 - 1 - i
            ao := j.a.Off + r * j.a.Ld
            dho := j.dh.Off + r * j.dh.Ld
            for c in range c0, c1 {
                av := A(j.a.Data[ao + c])
                j.ps[sk * cols + c] = av * j.ps[sk * cols + c]
                j.es[sk * cols + c] = av * (j.es[sk * cols + c] + A(j.dh.Data[dho + c]))
            }
        }
    }
}

# dx, da and db (written, or added to where add is set) for a loss whose gradient in the outputs h is dh; h, x, a and b
# are the forward's, init the state it started from (seqs x D). dstate holds on entry the gradient in the state after
# the last position (zeros when nothing reads it) and on return the gradient in the initial state. Sequential
fn GatedScanGrad<S, A>(ws mut Work<A>&, dx mut mat.Mat<S>&, da mut mat.Mat<S>&, db mut mat.Mat<S>&, dstate mut mat.Mat<A>&, dh mat.Mat<S>&, h mat.Mat<S>&, init mat.Mat<A>&, x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, at Seq, add Bool = false) {
    seqs := h.Rows / at.Len
    job := scanGradJob<S, A>(dx, da, db, dh, h, init, x, a, b, dstate, Array<A>(0), at, false, add)
    spread(job, seqs * blocksOf(h.Cols), ws.Threads)
}

# GatedScanGrad's chunked form: the backward scan as the forward one is chunked. Scratch: 2 seqs chunks D
fn GatedScanGradChunked<S, A>(ws mut Work<A>&, dx mut mat.Mat<S>&, da mut mat.Mat<S>&, db mut mat.Mat<S>&, dstate mut mat.Mat<A>&, dh mat.Mat<S>&, h mat.Mat<S>&, init mat.Mat<A>&, x mat.Mat<S>&, a mat.Mat<S>&, b mat.Mat<S>&, at Seq, add Bool = false) {
    cols := h.Cols
    seqs := h.Rows / at.Len
    chunks := chunksOf(at)
    size := seqs * chunks * cols
    buf := ws.scratch(2 * size)
    ps := buf[0:size]
    es := buf[size:2 * size]
    units := seqs * chunks * blocksOf(cols)
    spread(scanGradSummaryJob<S, A>(dh, a, ps, es, at), units, ws.Threads)
    spread(scanCarryJob<A>(dstate, ps, es, cols, chunks, true), seqs * blocksOf(cols), ws.Threads)
    spread(scanGradJob<S, A>(dx, da, db, dh, h, init, x, a, b, dstate, es, at, true, add), units, ws.Threads)
}

# ---- the delta rule ----

# S_t = alpha_t S_{t-1} (I - beta_t k_t k_t^T) + beta_t v_t k_t^T,  o_t = S_t q_t - an associative memory of values by key
# that, given a key, first takes away what it holds there (S k) and writes the difference from the value wanted, at rate
# beta (the delta rule, Widrow and Hoff; DeltaNet's linear attention), the whole thing leaking by alpha (Gated DeltaNet).
# alpha = 1 is DeltaNet's. Per head h, S is dv x dk; it is KEPT TRANSPOSED, dk x dv - row c of a head's state is
# S[:, c], so that every step is a pass of axpys along contiguous rows - and held in `state`, a Mat<A> of
# seqs Heads dk rows and dv columns: row ((s Heads + h) dk + c), column i, is S_t[i, c] of sequence s, head h.
# q and k are n x (Heads dk), v and out n x (Heads dv); head h of a row is columns h dk ... of q and k and h dv ... of v and
# out. beta and gate are n x Heads (a scalar per position and head) - a gate of ones is the plain delta rule. Scale q (by
# 1 / sqrt(dk)) and normalize k (to unit length, which keeps beta in (0, 1] stable) before: a kernel does neither.
#
# `keep`, when it has elements, receives the state at the start of every chunk of at.Chunk positions (seqs Heads chunks
# dk dv elements, the chunks of a head one after another) - what the backward needs; of a kernel run in pieces, a piece
# must begin at a chunk.

type deltaArgs<S> struct(q mat.Mat<S>, k mat.Mat<S>, v mat.Mat<S>, beta mat.Mat<S>, gate mat.Mat<S>, at Seq) {
    q
    k
    v
    beta
    gate
    at
}

fn (a deltaArgs<S>&) dk() I64 { return a.q.Cols / a.at.Heads }

fn (a deltaArgs<S>&) dv() I64 { return a.v.Cols / a.at.Heads }

# the number of A's of scratch a task needs: the sequential form's vectors, the chunked form's matrices
fn deltaScratch(sequential Bool, at Seq, dk I64, dv I64) I64 {
    c := at.Chunk
    if sequential: return 6 * dv
    return 3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + 3 * c
}

# ---- sequential ----

# one head of one sequence, position by position: a = S^T k, e = beta (v - alpha a), S <- alpha S + k e^T, o = S^T q
fn deltaSteps<S, A>(a deltaArgs<S>&, out mat.Mat<S>&, st mat.Mat<A>&, keep mut Array<A>&, w mut Array<A>&, s I64, h I64) {
    dk := a.dk()
    dv := a.dv()
    base := st.Off + (s * a.at.Heads + h) * dk * st.Ld
    sd := st.Data
    chunks := chunksOf(a.at)
    av := w[0:dv]
    ev := w[dv:2 * dv]
    ov := w[2 * dv:3 * dv]
    for t in range a.at.Len {
        if t % a.at.Chunk == 0 and keep.Len() > 0: saveState(keep, ((s * a.at.Heads + h) * chunks + t / a.at.Chunk) * dk * dv, st, base, dk, dv)
        r := s * a.at.Len + t
        bt := A(a.beta.Data[a.beta.Off + r * a.beta.Ld + h])
        al := A(a.gate.Data[a.gate.Off + r * a.gate.Ld + h])
        qo := a.q.Off + r * a.q.Ld + h * dk
        ko := a.k.Off + r * a.k.Ld + h * dk
        vo := a.v.Off + r * a.v.Ld + h * dv
        for i in range dv: av[i] = 0.0
        for c in range dk {
            kc := A(a.k.Data[ko + c])
            row := base + c * st.Ld
            for i in range dv: av[i] += kc * sd[row + i]
        }
        for i in range dv: ev[i] = bt * (A(a.v.Data[vo + i]) - al * av[i])
        for i in range dv: ov[i] = 0.0
        for c in range dk {
            kc := A(a.k.Data[ko + c])
            qc := A(a.q.Data[qo + c])
            row := base + c * st.Ld
            for i in range dv {
                p := al * sd[row + i] + kc * ev[i]
                sd[row + i] = p
                ov[i] += qc * p
            }
        }
        oo := out.Off + r * out.Ld + h * dv
        for i in range dv: out.Data[oo + i] = S(ov[i])
    }
}

# the state of one head (dk rows of dv from st[base ...]) copied to keep[at ...]
fn saveState<A>(keep mut Array<A>&, at I64, st mat.Mat<A>&, base I64, dk I64, dv I64) {
    for c in range dk {
        for i in range dv: keep[at + c * dv + i] = st.Data[base + c * st.Ld + i]
    }
}

# ---- chunked ----

# a chunk's matrices, slices of one task's scratch (C = at.Chunk; "rows" of a chunk is its length, at most C). Matrices
# of C columns have row stride C, the others their width: x is C x (dv + dk), its left dv columns the pseudo-values U and
# the rest W (the WY form's)
type deltaBuf<A> struct(z mut Array<A>&, c I64, dk I64, dv I64) {
    c
    dk
    dv
    qc mut Array<A>& = z[0:c * dk]
    kc mut Array<A>& = z[c * dk:2 * c * dk]
    kg mut Array<A>& = z[2 * c * dk:3 * c * dk]
    kk mut Array<A>& = z[3 * c * dk:3 * c * dk + c * c]
    gm mut Array<A>& = z[3 * c * dk + c * c:3 * c * dk + 2 * c * c]
    ag mut Array<A>& = z[3 * c * dk + 2 * c * c:3 * c * dk + 3 * c * c]
    x mut Array<A>& = z[3 * c * dk + 3 * c * c:3 * c * dk + 3 * c * c + c * (dv + dk)]
    d mut Array<A>& = z[3 * c * dk + 3 * c * c + c * (dv + dk):3 * c * dk + 3 * c * c + c * (dv + dk) + c * dv]
    oc mut Array<A>& = z[3 * c * dk + 3 * c * c + c * (dv + dk) + c * dv:3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv]
    bet mut Array<A>& = z[3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv:3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + c]
    alp mut Array<A>& = z[3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + c:3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + 2 * c]
    gam mut Array<A>& = z[3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + 2 * c:3 * c * dk + 3 * c * c + c * (dv + dk) + 2 * c * dv + 3 * c]
}

fn view<A>(a mut Array<A>&, off I64, rows I64, cols I64, ld I64) mat.Mat<A> { return mat.Mat<A>(a, off, rows, cols, ld) }

# q, k of head h for the chunk's `rows` positions from row r0 into qc and kc; v into x's left columns scaled for the
# triangular system's right-hand side; beta and gate; the products of the gate (gam) and its ratios (gm: gm[i, j] =
# gate_{j+1} ... gate_i, 1 on the diagonal, 0 above)
fn deltaLoad<S, A>(a deltaArgs<S>&, b deltaBuf<A>&, r0 I64, rows I64, h I64) {
    dk := b.dk
    dv := b.dv
    wd := dv + dk
    for i in range rows {
        r := r0 + i
        qo := a.q.Off + r * a.q.Ld + h * dk
        ko := a.k.Off + r * a.k.Ld + h * dk
        vo := a.v.Off + r * a.v.Ld + h * dv
        b.bet[i] = A(a.beta.Data[a.beta.Off + r * a.beta.Ld + h])
        b.alp[i] = A(a.gate.Data[a.gate.Off + r * a.gate.Ld + h])
        b.gam[i] = b.alp[i] * (b.gam[i - 1] if i > 0 else 1.0)
        for c in range dk {
            b.qc[i * dk + c] = A(a.q.Data[qo + c])
            b.kc[i * dk + c] = A(a.k.Data[ko + c])
        }
        for c in range dv: b.x[i * wd + c] = A(a.v.Data[vo + c])
        for c in range dk: b.x[i * wd + dv + c] = b.gam[i] * b.kc[i * dk + c]
        for j in range i: b.gm[i * b.c + j] = b.gm[(i - 1) * b.c + j] * b.alp[i]
        b.gm[i * b.c + i] = 1.0
    }
}

# the products of a chunk that do not depend on the state it starts from: x solved from the triangular system
#   x_i = beta_i (x_i - sum over j < i of gm[i, j] (k_i . k_j) x_j)       (x_i = (v_i, gam_i k_i) before),
# i.e. U = T V and W = T diag(gam) K with T = (I + diag(beta) tril(gm * K K^T, -1))^-1 diag(beta); ag the causal weights
# gm * (Q K^T) on and below the diagonal; qc scaled by gam (the state's decay to each position); kg the keys scaled by
# the decay to the chunk's end
fn deltaPrepare<A>(ws mut gemm.Workspace<A>&, b deltaBuf<A>&, rows I64) {
    dk := b.dk
    dv := b.dv
    wd := dv + dk
    c := b.c
    km := view(b.kc, 0, rows, dk, dk)
    gemm.Gemm(ws, view(b.kk, 0, rows, rows, c), km, false, km, true)
    gemm.Gemm(ws, view(b.ag, 0, rows, rows, c), view(b.qc, 0, rows, dk, dk), false, km, true)
    for i in range rows {
        xi := b.x[i * wd:(i + 1) * wd]
        for j in range i {
            coef := b.gm[i * c + j] * b.kk[i * c + j]
            xj := b.x[j * wd:(j + 1) * wd]
            for e in range wd: xi[e] -= coef * xj[e]
        }
        for e in range wd: xi[e] = b.bet[i] * xi[e]
        for j in range i + 1: b.ag[i * c + j] = b.gm[i * c + j] * b.ag[i * c + j]
        for j in range i + 1, rows: b.ag[i * c + j] = 0.0
        for e in range dk {
            b.kg[i * dk + e] = b.gm[(rows - 1) * c + i] * b.kc[i * dk + e]
            b.qc[i * dk + e] = b.gam[i] * b.qc[i * dk + e]
        }
    }
}

# one head of one sequence by chunks: per chunk D = U - W S (the new values), O = (gam Q) S + ag D, then S <- gam_end S +
# kg^T D - three products of the chunk's size by the head's, beside the chunk's own
fn deltaChunks<S, A>(a deltaArgs<S>&, out mat.Mat<S>&, st mat.Mat<A>&, keep mut Array<A>&, ws mut gemm.Workspace<A>&, b deltaBuf<A>&, s I64, h I64) {
    dk := b.dk
    dv := b.dv
    wd := dv + dk
    chunks := chunksOf(a.at)
    base := st.Off + (s * a.at.Heads + h) * dk * st.Ld
    state := mat.Mat<A>(st.Data, base, dk, dv, st.Ld)
    for k in range chunks {
        if keep.Len() > 0: saveState(keep, ((s * a.at.Heads + h) * chunks + k) * dk * dv, st, base, dk, dv)
        r0 := s * a.at.Len + k * a.at.Chunk
        rows := lesser(a.at.Chunk, (s + 1) * a.at.Len - r0)
        deltaLoad(a, b, r0, rows, h)
        deltaPrepare(ws, b, rows)
        for i in range rows {
            for c in range dv: b.d[i * dv + c] = b.x[i * wd + c]
        }
        dm := view(b.d, 0, rows, dv, dv)
        om := view(b.oc, 0, rows, dv, dv)
        gemm.Gemm(ws, dm, view(b.x, dv, rows, dk, wd), false, state, false, -1.0, 1.0)
        gemm.Gemm(ws, om, view(b.qc, 0, rows, dk, dk), false, state, false)
        gemm.Gemm(ws, om, view(b.ag, 0, rows, rows, b.c), false, dm, false, 1.0, 1.0)
        for i in range rows {
            oo := out.Off + (r0 + i) * out.Ld + h * dv
            for c in range dv: out.Data[oo + c] = S(b.oc[i * dv + c])
        }
        gemm.Gemm(ws, state, view(b.kg, 0, rows, dk, dk), true, dm, false, 1.0, b.gam[rows - 1])
    }
}

type deltaJob<S, A> struct(args deltaArgs<S>, out mat.Mat<S>, st mat.Mat<A>, keep mut Array<A>&, z mut Array<A>&, per I64, chunked Bool) {
    args
    out
    st
    keep
    z
    per
    chunked
}

# unit u: sequence u / Heads, head u % Heads; task t works in z's t-th share
fn (j deltaJob<S, A>&) run(lo I64, hi I64, task I64) {
    mine := j.z[task * j.per:(task + 1) * j.per]
    if not j.chunked {
        for u in range lo, hi: deltaSteps<S, A>(j.args, j.out, j.st, j.keep, mine, u / j.args.at.Heads, u % j.args.at.Heads)
        return
    }
    products := gemm.Workspace<A>(1)
    b := deltaBuf<A>(mine, j.args.at.Chunk, j.args.dk(), j.args.dv())
    for u in range lo, hi: deltaChunks<S, A>(j.args, j.out, j.st, j.keep, products, b, u / j.args.at.Heads, u % j.args.at.Heads)
}

fn deltaRun<S, A>(ws mut Work<A>&, chunked Bool, out mut mat.Mat<S>&, state mut mat.Mat<A>&, q mat.Mat<S>&, k mat.Mat<S>&, v mat.Mat<S>&, beta mat.Mat<S>&, gate mat.Mat<S>&, at Seq, keep mut Array<A>&) {
    units := q.Rows / at.Len * at.Heads
    tasks := ws.Threads if ws.Threads < units else units
    per := deltaScratch(not chunked, at, q.Cols / at.Heads, v.Cols / at.Heads)
    z := ws.scratch(tasks * per)
    spread(deltaJob<S, A>(deltaArgs<S>(q, k, v, beta, gate, at), out, state, keep, z, per, chunked), units, ws.Threads)
}

# out = the delta rule over q, k, v, beta and gate from state, which holds the state after the last position on return.
# The sequential form: one pass over the positions per head and sequence, heads and sequences in tasks
fn DeltaRule<S, A>(ws mut Work<A>&, out mut mat.Mat<S>&, state mut mat.Mat<A>&, q mat.Mat<S>&, k mat.Mat<S>&, v mat.Mat<S>&, beta mat.Mat<S>&, gate mat.Mat<S>&, at Seq, keep mut Array<A>& = Array<A>(0)) {
    deltaRun(ws, false, out, state, q, k, v, beta, gate, at, keep)
}

# the chunked form (the WY form): the same result, a chunk at a time through gemm's products. Chunks of 32 to 64 are
# the useful sizes; scratch grows with Chunk squared
fn DeltaRuleChunked<S, A>(ws mut Work<A>&, out mut mat.Mat<S>&, state mut mat.Mat<A>&, q mat.Mat<S>&, k mat.Mat<S>&, v mat.Mat<S>&, beta mat.Mat<S>&, gate mat.Mat<S>&, at Seq, keep mut Array<A>& = Array<A>(0)) {
    deltaRun(ws, true, out, state, q, k, v, beta, gate, at, keep)
}

# ---- tests ----

import "std/rand"

fn fill<T>(a mut Array<T>&, r mut rand.Rand&, sd F64) {
    for i in range a.Len(): a[i] = T(r.Normal() * sd)
}

# gates in (lo, hi): a plausible decay
fn fillGates<T>(a mut Array<T>&, r mut rand.Rand&, lo F64, hi F64) {
    for i in range a.Len(): a[i] = T(lo + (hi - lo) * r.Float())
}

# the recurrence as written, in F64 on contiguous arrays; state is seqs x D and ends holding the last state
fn gatedReference(x Array<F64>&, a Array<F64>&, b Array<F64>&, state mut Array<F64>&, seqs I64, len I64, cols I64) Array<F64> {
    h := Array<F64>(seqs * len * cols)
    for s in range seqs {
        for t in range len {
            for c in range cols {
                r := (s * len + t) * cols + c
                state[s * cols + c] = a[r] * state[s * cols + c] + b[r] * x[r]
                h[r] = state[s * cols + c]
            }
        }
    }
    return h
}

fn maxRelDiff<T, U>(a Array<T>&, b Array<U>&) F64 {
    worst F64
    for i in range a.Len() {
        d := (F64(a[i]) - F64(b[i])).Abs() / F64(b[i]).Abs().Max(1.0)
        worst = worst.Max(d)
    }
    return worst
}

fn whole<S>(a mut Array<S>&, rows I64, cols I64) mat.Mat<S> { return mat.Mat<S>(a, 0, rows, cols, cols) }

# one run of GatedScan on the reference's inputs, in S storage: the outputs and the final states, in F64
fn gatedRun<S, A>(chunked Bool, threads I64, seqs I64, len I64, cols I64, chunk I64, seed I64) Array<F64>, Array<F64>, Array<F64>, Array<F64> {
    r := rand.Rand(U64(seed))
    n := seqs * len
    x := Array<S>(n * cols)
    a := Array<S>(n * cols)
    b := Array<S>(n * cols)
    fill(x, r, 1.0)
    fillGates(a, r, 0.5, 1.0)
    fill(b, r, 0.5)
    state := Array<A>(seqs * cols)
    fill(state, r, 1.0)
    # the F64 reference from the same stored numbers
    xr := Array<F64>(n * cols)
    ar := Array<F64>(n * cols)
    br := Array<F64>(n * cols)
    sr := Array<F64>(seqs * cols)
    for i in range n * cols {
        xr[i] = F64(x[i])
        ar[i] = F64(a[i])
        br[i] = F64(b[i])
    }
    for i in range seqs * cols: sr[i] = F64(state[i])
    want := gatedReference(xr, ar, br, sr, seqs, len, cols)
    h := Array<S>(n * cols)
    ws := Work<A>(threads)
    at := Seq(len, chunk)
    if chunked: GatedScanChunked(ws, whole(h, n, cols), whole(state, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    else: GatedScan(ws, whole(h, n, cols), whole(state, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    got := Array<F64>(n * cols)
    gs := Array<F64>(seqs * cols)
    for i in range n * cols: got[i] = F64(h[i])
    for i in range seqs * cols: gs[i] = F64(state[i])
    return got, want, gs, sr
}

test GatedScan "the sequential scan is the recurrence: F64 to 1e-13, F32 to 1e-5, BF16 stored and F32 carried to 2e-2" {
    g, w, gs, ws := gatedRun<F64, F64>(false, 1, 3, 37, 70, 8, 1)
    assert maxRelDiff(g, w) < 1.0e-13 and maxRelDiff(gs, ws) < 1.0e-13
    g2, w2, gs2, ws2 := gatedRun<F32, F32>(false, 1, 3, 37, 70, 8, 2)
    assert maxRelDiff(g2, w2) < 1.0e-5 and maxRelDiff(gs2, ws2) < 1.0e-5
    g3, w3, gs3, ws3 := gatedRun<BF16, F32>(false, 1, 3, 37, 70, 8, 3)
    assert maxRelDiff(g3, w3) < 2.0e-2 and maxRelDiff(gs3, ws3) < 1.0e-5
}

test GatedScanChunked "equals the sequential scan: F32 to 1e-5, one and four threads, chunks that do not divide the length, blocks of channels" {
    for chunk in Array<I64>[1, 7, 16, 100] {
        for threads in Array<I64>[1, 4] {
            g, w, gs, ws := gatedRun<F32, F32>(true, threads, 3, 37, 70, chunk, 4)
            assert maxRelDiff(g, w) < 1.0e-5, "chunk " $chunk
            assert maxRelDiff(gs, ws) < 1.0e-5
        }
    }
    g, w, _, _ := gatedRun<F64, F64>(true, 2, 2, 50, 1100, 9, 5)
    assert maxRelDiff(g, w) < 1.0e-13
    g2, w2, _, _ := gatedRun<BF16, F32>(true, 2, 2, 50, 100, 9, 6)
    assert maxRelDiff(g2, w2) < 2.0e-2
}

# the loss sum(w h) + sum(u final) of the recurrence, in F64
fn gatedLoss(x Array<F64>&, a Array<F64>&, b Array<F64>&, init Array<F64>&, w Array<F64>&, u Array<F64>&, seqs I64, len I64, cols I64) F64 {
    st := Array<F64>(init.Len())
    for i in range init.Len(): st[i] = init[i]
    h := gatedReference(x, a, b, st, seqs, len, cols)
    loss F64
    for i in range h.Len(): loss += w[i] * h[i]
    for i in range st.Len(): loss += u[i] * st[i]
    return loss
}

# the central difference of the loss in element i of arr
fn centralDifference(arr mut Array<F64>&, i I64, loss fn&() F64) F64 {
    keep := arr[i]
    step := 1.0e-6
    arr[i] = keep + step
    up := loss()
    arr[i] = keep - step
    down := loss()
    arr[i] = keep
    return (up - down) / (2.0 * step)
}

fn gradCase(chunked Bool, threads I64, add Bool) {
    r := rand.Rand(11)
    seqs := 2
    len := 13
    cols := 5
    n := seqs * len
    x := Array<F64>(n * cols)
    a := Array<F64>(n * cols)
    b := Array<F64>(n * cols)
    w := Array<F64>(n * cols)
    init := Array<F64>(seqs * cols)
    u := Array<F64>(seqs * cols)
    fill(x, r, 1.0)
    fillGates(a, r, 0.3, 1.1)
    fill(b, r, 1.0)
    fill(w, r, 1.0)
    fill(init, r, 1.0)
    fill(u, r, 1.0)
    # forward through the kernel
    h := Array<F64>(n * cols)
    state := Array<F64>(seqs * cols)
    for i in range seqs * cols: state[i] = init[i]
    ws := Work<F64>(threads)
    at := Seq(len, 4)
    GatedScan(ws, whole(h, n, cols), whole(state, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    dx := Array<F64>(n * cols)
    da := Array<F64>(n * cols)
    db := Array<F64>(n * cols)
    if add {
        for i in range n * cols {
            dx[i] = 1.0
            da[i] = 2.0
            db[i] = 3.0
        }
    }
    ds := Array<F64>(seqs * cols)
    for i in range seqs * cols: ds[i] = u[i]
    ini := Array<F64>(seqs * cols)
    for i in range seqs * cols: ini[i] = init[i]
    if chunked: GatedScanGradChunked(ws, whole(dx, n, cols), whole(da, n, cols), whole(db, n, cols), whole(ds, seqs, cols), whole(w, n, cols), whole(h, n, cols), whole(ini, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at, add)
    else: GatedScanGrad(ws, whole(dx, n, cols), whole(da, n, cols), whole(db, n, cols), whole(ds, seqs, cols), whole(w, n, cols), whole(h, n, cols), whole(ini, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at, add)
    loss := fn(): return gatedLoss(x, a, b, init, w, u, seqs, len, cols)
    extra := 1.0 if add else 0.0
    for i in range n * cols {
        assert (centralDifference(x, i, loss) + extra * 1.0 - dx[i]).Abs() < 1.0e-7, "dx[" $i "]"
        assert (centralDifference(a, i, loss) + extra * 2.0 - da[i]).Abs() < 1.0e-7, "da[" $i "]"
        assert (centralDifference(b, i, loss) + extra * 3.0 - db[i]).Abs() < 1.0e-7, "db[" $i "]"
    }
    for i in range seqs * cols: assert (centralDifference(init, i, loss) - ds[i]).Abs() < 1.0e-7, "dinit[" $i "]"
}

test GatedScanGrad "dx, da, db and the initial state's gradient equal the central differences in F64: sequential, chunked, one and three threads, adding" {
    for chunked in Array<Bool>[false, true] {
        for threads in Array<I64>[1, 3] {
            gradCase(chunked, threads, false)
            gradCase(chunked, threads, true)
        }
    }
}

# the gradients of one random problem through GatedScanGrad (sequential or chunked), in S storage: dx, da, db, dinit in F64
fn gradRun<S, A>(chunked Bool, threads I64, seqs I64, len I64, cols I64, chunk I64) Array<F64> {
    r := rand.Rand(12)
    n := seqs * len
    x := Array<S>(n * cols)
    a := Array<S>(n * cols)
    b := Array<S>(n * cols)
    w := Array<S>(n * cols)
    fill(x, r, 1.0)
    fillGates(a, r, 0.5, 1.0)
    fill(b, r, 0.5)
    fill(w, r, 1.0)
    init := Array<A>(seqs * cols)
    fill(init, r, 1.0)
    h := Array<S>(n * cols)
    state := Array<A>(seqs * cols)
    for i in range seqs * cols: state[i] = init[i]
    ws := Work<A>(threads)
    at := Seq(len, chunk)
    GatedScan(ws, whole(h, n, cols), whole(state, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    dx := Array<S>(n * cols)
    da := Array<S>(n * cols)
    db := Array<S>(n * cols)
    ds := Array<A>(seqs * cols)
    fill(ds, r, 1.0)
    if chunked: GatedScanGradChunked(ws, whole(dx, n, cols), whole(da, n, cols), whole(db, n, cols), whole(ds, seqs, cols), whole(w, n, cols), whole(h, n, cols), whole(init, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    else: GatedScanGrad(ws, whole(dx, n, cols), whole(da, n, cols), whole(db, n, cols), whole(ds, seqs, cols), whole(w, n, cols), whole(h, n, cols), whole(init, seqs, cols), whole(x, n, cols), whole(a, n, cols), whole(b, n, cols), at)
    out := Array<F64>(3 * n * cols + seqs * cols)
    for i in range n * cols {
        out[i] = F64(dx[i])
        out[n * cols + i] = F64(da[i])
        out[2 * n * cols + i] = F64(db[i])
    }
    for i in range seqs * cols: out[3 * n * cols + i] = F64(ds[i])
    return out
}

test GatedScanGradChunked "equals the sequential backward scan: F32 to 1e-5 for chunks of any size, and the same for every thread count" {
    want := gradRun<F32, F32>(false, 1, 3, 41, 70, 8)
    for chunk in Array<I64>[1, 5, 16, 64] {
        for threads in Array<I64>[1, 4] {
            got := gradRun<F32, F32>(true, threads, 3, 41, 70, chunk)
            assert maxRelDiff(got, want) < 1.0e-5, "chunk " $chunk
        }
    }
    again := gradRun<F32, F32>(false, 4, 3, 41, 70, 8)
    assert again == want
    bf := gradRun<BF16, F32>(true, 2, 2, 30, 40, 7)
    bw := gradRun<BF16, F32>(false, 1, 2, 30, 40, 7)
    assert maxRelDiff(bf, bw) < 3.0e-2
}

test GatedScan "the consolidator's recurrence h = l h_prev + (1 - l) z is a scan with a = l, b = 1 - l, x = z" {
    r := rand.Rand(13)
    len := 20
    cols := 6
    z := Array<F32>(len * cols)
    l := Array<F32>(len * cols)
    fill(z, r, 1.0)
    fillGates(l, r, 0.0, 1.0)
    one := Array<F32>(len * cols)
    for i in range len * cols: one[i] = 1.0 - l[i]
    h := Array<F32>(len * cols)
    state := Array<F32>(cols)
    ws := Work<F32>(1)
    GatedScan(ws, whole(h, len, cols), whole(state, 1, cols), whole(z, len, cols), whole(l, len, cols), whole(one, len, cols), Seq(len))
    prev := Array<F32>(cols)
    for t in range len {
        for c in range cols {
            prev[c] = l[t * cols + c] * prev[c] + (1.0 - l[t * cols + c]) * z[t * cols + c]
            assert (h[t * cols + c] - prev[c]).Abs() < 1.0e-6
        }
    }
    assert state == prev
}

# ---- the delta rule's tests ----

# the delta rule as the formula gives it, in F64 on contiguous arrays: S (dv x dk) per head and sequence, kept in the
# kernel's transposed layout state[((s heads + h) dk + c) dv + i] = S[i][c], updated by S <- alpha S (I - beta k k^T) +
# beta v k^T as a product with the matrix (I - beta k k^T), and o = S q
fn deltaReference(q Array<F64>&, k Array<F64>&, v Array<F64>&, beta Array<F64>&, gate Array<F64>&, state mut Array<F64>&, seqs I64, len I64, heads I64, dk I64, dv I64) Array<F64> {
    out := Array<F64>(seqs * len * heads * dv)
    for s in range seqs {
        for h in range heads {
            m := Array<F64>(dv * dk)
            for c in range dk {
                for i in range dv: m[i * dk + c] = state[((s * heads + h) * dk + c) * dv + i]
            }
            for t in range len {
                r := s * len + t
                bt := beta[r * heads + h]
                al := gate[r * heads + h]
                next := Array<F64>(dv * dk)
                for i in range dv {
                    for c in range dk {
                        total F64
                        for j in range dk {
                            kron := 1.0 if j == c else 0.0
                            total += m[i * dk + j] * (kron - bt * k[r * heads * dk + h * dk + j] * k[r * heads * dk + h * dk + c])
                        }
                        next[i * dk + c] = al * total + bt * v[r * heads * dv + h * dv + i] * k[r * heads * dk + h * dk + c]
                    }
                }
                for e in range dv * dk: m[e] = next[e]
                for i in range dv {
                    total F64
                    for c in range dk: total += m[i * dk + c] * q[r * heads * dk + h * dk + c]
                    out[r * heads * dv + h * dv + i] = total
                }
            }
            for c in range dk {
                for i in range dv: state[((s * heads + h) * dk + c) * dv + i] = m[i * dk + c]
            }
        }
    }
    return out
}

# one random problem: q, v normal, k unit length per head, beta in (0.1, 1), gate in (0.8, 1) or all ones
type deltaData<S, A> struct(seqs I64, len I64, heads I64, dk I64, dv I64, ones Bool, seed I64) {
    seqs
    len
    heads
    dk
    dv
    ones
    seed
    n I64 = seqs * len
    q mut Array<S>& = Array<S>(seqs * len * heads * dk)
    k mut Array<S>& = Array<S>(seqs * len * heads * dk)
    v mut Array<S>& = Array<S>(seqs * len * heads * dv)
    beta mut Array<S>& = Array<S>(seqs * len * heads)
    gate mut Array<S>& = Array<S>(seqs * len * heads)
    state mut Array<A>& = Array<A>(seqs * heads * dk * dv)
}

fn deltaData<S, A>.Random(seqs I64, len I64, heads I64, dk I64, dv I64, ones Bool, seed I64) deltaData<S, A> {
    d := deltaData<S, A>(seqs, len, heads, dk, dv, ones, seed)
    r := rand.Rand(U64(seed))
    fill(d.q, r, 0.5)
    fill(d.v, r, 1.0)
    fill(d.k, r, 1.0)
    for row in range seqs * len * heads {
        norm F64
        for c in range dk: norm += F64(d.k[row * dk + c]) * F64(d.k[row * dk + c])
        norm = norm.Sqrt()
        for c in range dk: d.k[row * dk + c] = S(F64(d.k[row * dk + c]) / norm)
    }
    fillGates(d.beta, r, 0.1, 1.0)
    fillGates(d.gate, r, 0.8, 1.0)
    if ones {
        for i in range d.gate.Len(): d.gate[i] = S(1.0)
    }
    fill(d.state, r, 0.3)
    return d
}

fn f64Of<T>(a Array<T>&) Array<F64> {
    out := Array<F64>(a.Len())
    for i in range a.Len(): out[i] = F64(a[i])
    return out
}

# the kernel's outputs and final state against the formula's, from the same stored numbers: got, want, gotState, wantState
fn deltaCase<S, A>(chunked Bool, threads I64, d deltaData<S, A>&, chunk I64) Array<F64>, Array<F64>, Array<F64>, Array<F64> {
    n := d.seqs * d.len
    start := f64Of(d.state)
    want := deltaReference(f64Of(d.q), f64Of(d.k), f64Of(d.v), f64Of(d.beta), f64Of(d.gate), start, d.seqs, d.len, d.heads, d.dk, d.dv)
    out := Array<S>(n * d.heads * d.dv)
    state := Array<A>(d.state.Len())
    for i in range state.Len(): state[i] = d.state[i]
    ws := Work<A>(threads)
    at := Seq(d.len, chunk, d.heads)
    qm := whole(d.q, n, d.heads * d.dk)
    km := whole(d.k, n, d.heads * d.dk)
    vm := whole(d.v, n, d.heads * d.dv)
    bm := whole(d.beta, n, d.heads)
    gm := whole(d.gate, n, d.heads)
    om := whole(out, n, d.heads * d.dv)
    sm := whole(state, d.seqs * d.heads * d.dk, d.dv)
    if chunked: DeltaRuleChunked(ws, om, sm, qm, km, vm, bm, gm, at)
    else: DeltaRule(ws, om, sm, qm, km, vm, bm, gm, at)
    return f64Of(out), want, f64Of(state), start
}

test DeltaRule "the sequential form is the formula S = alpha S (I - beta k k^T) + beta v k^T, o = S q: F64 to 1e-12, F32 to 1e-5, BF16 stored to 3e-2; gated and not, any thread count" {
    for ones in Array<Bool>[true, false] {
        for threads in Array<I64>[1, 3] {
            d64 := deltaData<F64, F64>.Random(2, 23, 3, 12, 10, ones, 1)
            g, w, gs, ws := deltaCase(false, threads, d64, 8)
            assert maxRelDiff(g, w) < 1.0e-12 and maxRelDiff(gs, ws) < 1.0e-12
            d32 := deltaData<F32, F32>.Random(2, 23, 3, 12, 10, ones, 2)
            g2, w2, gs2, ws2 := deltaCase(false, threads, d32, 8)
            assert maxRelDiff(g2, w2) < 1.0e-5 and maxRelDiff(gs2, ws2) < 1.0e-5
            db := deltaData<BF16, F32>.Random(2, 23, 3, 12, 10, ones, 3)
            g3, w3, gs3, ws3 := deltaCase(false, threads, db, 8)
            assert maxRelDiff(g3, w3) < 3.0e-2 and maxRelDiff(gs3, ws3) < 1.0e-5
        }
    }
}

test DeltaRuleChunked "equals the formula (F64 to 1e-11) and the sequential form (F32 to 1e-5): chunks of every size, the last short, gated and not, any thread count" {
    for ones in Array<Bool>[true, false] {
        for chunk in Array<I64>[1, 3, 8, 23, 64] {
            for threads in Array<I64>[1, 3] {
                d64 := deltaData<F64, F64>.Random(2, 23, 3, 12, 10, ones, 1)
                g, w, gs, ws := deltaCase(true, threads, d64, chunk)
                assert maxRelDiff(g, w) < 1.0e-11, "chunk " $chunk
                assert maxRelDiff(gs, ws) < 1.0e-11
                d32 := deltaData<F32, F32>.Random(2, 23, 3, 12, 10, ones, 2)
                g2, w2, gs2, ws2 := deltaCase(true, threads, d32, chunk)
                assert maxRelDiff(g2, w2) < 1.0e-5, "chunk " $chunk
                assert maxRelDiff(gs2, ws2) < 1.0e-5
            }
        }
    }
    db := deltaData<BF16, F32>.Random(2, 23, 3, 12, 10, false, 3)
    g, w, _, _ := deltaCase(true, 2, db, 8)
    assert maxRelDiff(g, w) < 3.0e-2
}
