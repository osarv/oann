# ---- IPA ----

asciiIpa := ["A \u{251}", ": \u{2D0}", "{ \u{E6}", "V \u{28C}", "O \u{254}", "E \u{25B}", "3 \u{25C}", "I \u{26A}"
    "U \u{28A}", "@ \u{259}", "R \u{25A}", "6 \u{250}", "X \u{1D7B}", "2 \u{F8}", "9 \u{153}", "} \u{289}", "8 \u{275}"
    "g \u{261}", "T \u{3B8}", "D \u{F0}", "S \u{283}", "Z \u{292}", "N \u{14B}", "4 \u{27E}", "? \u{294}", "C \u{255}"
    "Q \u{282}", "= \u{329}", "' \u{2C8}", ", \u{2CC}"]

# the ASCII alphabet made IPA (r is ɹ in English)
fn ipa(t String&, sv Bool) String {
    out := StringBuilder()
    for c in t {
        if c == 'r' and not sv {
            out.Push("\u{279}")
            continue
        }
        out.Push(ipaOf(c))
    }
    return out.ToString()
}

fn ipaOf(c Char) String {
    for m in asciiIpa {
        if m[0] == c: return m[2:]
    }
    return $c
}

# ---- checks against espeak (speech/tools/g2p_reference.py), where its files are ----

# code points, for the edit distance
fn points(t String&) Array<I64> {
    out := Vec<I64>()
    i I64 = 0
    for i < t.Len() {
        c := I64(t[i])
        n := 1 if c < 0x80 else 2 if c < 0xE0 else 3 if c < 0xF0 else 4
        cp := c if n == 1 else c & (0xFF >> (n + 1))
        for k in range 1, n: cp = (cp << 6) | (I64(t[i + k]) & 0x3F)
        out.Push(cp)
        i += n
    }
    return out.ToArray()
}

fn distance(a Array<I64>&, b Array<I64>&) I64 {
    row := Array<I64>[j for j in range b.Len() + 1]
    for i in range a.Len() {
        diag := row[0]
        row[0] = i + 1
        for j in range b.Len() {
            up := row[j + 1]
            row[j + 1] = (up + 1).Min(row[j] + 1).Min(diag + (0 if a[i] == b[j] else 1))
            diag = up
        }
    }
    return row[b.Len()]
}

# over a reference file (a line "text<TAB>espeak's IPA"): the share of lines exactly espeak's, and one less the edit
# distance over espeak's length (in code points: phonemes, stress and length marks, spaces, punctuation)
fn agreement(g G2p&, path String&, lang String&, show Bool) F64, F64 ? os.Error, G2pError {
    same I64 = 0
    lines I64 = 0
    dist I64 = 0
    total I64 = 0
    for line in (try os.ReadFile(path)).Lines() {
        tab := try line.FindByte('\t') catch { continue }
        got := try g.Phonemes(line[:tab], lang)
        want :~ line[tab + 1:]
        lines++
        total += points(want).Len()
        if got == want {
            same++
            continue
        }
        dist += distance(points(got), points(want))
        if show: Println(line[:tab] + "  " + got + "  " + want)
    }
    return F64(same) / F64(lines.Max(1)), 1.0 - F64(dist) / F64(total.Max(1))
}

fn refDir() String { return Cache() + "/ref/g2p" }

test G2p "Swedish numbers and punctuation as espeak reads them" {
    g := G2p.Parse("")
    assert g.Phonemes("Jag har 23 \u{E4}pplen.", "sv")! == "j\u{251}\u{2D0}\u{261} h\u{251}\u{2D0}r \u{255}\u{2CC}\u{289}\u{261}\u{254}tr\u{2C8}e\u{2D0} \u{2C8}\u{25B}pl\u{259}n."
    assert g.Phonemes("Sju sj\u{F6}sjuka sj\u{F6}m\u{E4}n", "sv")! == ipa("sx'} sx'9sx}k,a sx'2:mE:n", true)
    assert g.Phonemes("1999; 3,5 station!", "sv")! == ipa("n'ItOnh'8ndra n,ItIn'i:u:; tr'e: p'8Nkt f'Em stasx'u:n!", true)
    unknown := try g.Phonemes("x", "de") catch default "unknown"
    assert unknown == "unknown"
}

test G2p "English: words, words CMUdict lacks and sentences against espeak (where the reference files are)" {
    if not os.Exists(refDir() + "/en_words.tsv") {
        Println("skipped: no reference")
        return
    }
    g := try G2p.Load() catch {
        Println("skipped: no CMUdict")
        return
    }
    check(g, "en_words", "en", 0.90, 0.975)
    check(g, "en_oov", "en", 0.48, 0.84)
    check(g, "en_sentences", "en", 0.66, 0.99)
}

# a reference file's agreement printed and held to at least what was reached; a file "show" beside the references
# prints every line that differs
fn check(g G2p&, name String&, lang String&, exact F64, near F64) {
    e, n := agreement(g, refDir() + "/" + name + ".tsv", lang, os.Exists(refDir() + "/show"))!
    Println(name + ": " + $e + " exact, " + $n + " by edit distance")
    assert e >= exact and n >= near, name
}

test G2p "Swedish: words, held-out words and sentences against espeak (where the reference files are)" {
    if not os.Exists(refDir() + "/sv_words.tsv") {
        Println("skipped: no reference")
        return
    }
    g := G2p.Parse("")
    check(g, "sv_words", "sv", 0.88, 0.96)
    check(g, "sv_heldout", "sv", 0.81, 0.94)
    check(g, "sv_sentences", "sv", 0.58, 0.98)
}

test G2p "a clock time is read as hours and minutes, in both languages" {
    g := G2p.Parse("")
    assert g.Phonemes("Klockan är 23:31.", "sv")! == g.Phonemes("Klockan är 23 31.", "sv")!
    assert g.Phonemes("It is 11:45", "en")! == g.Phonemes("It is 11 45", "en")!
    assert clock("23:31, 1:05 och 10:3") == "23 31, 1 05 och 10:3"
}
