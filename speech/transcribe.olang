# speech/transcribe - speech to text by a Whisper model (speech/whisper): the language detected or given, greedy or
# beam decoding, timestamps, a clip longer than 30 s read window after window, and a Stream that takes sound as it
# comes. The decoding is Hugging Face transformers' generate for Whisper, step for step, so a transcript is the
# reference's token for token:
#
# - the prompt is <|startoftranscript|> <|lang|> <|transcribe|> (or <|translate|>), then <|notimestamps|> unless
#   timestamps are asked for; the language, when not given, is the language token the model finds likeliest after
#   <|startoftranscript|> alone;
# - every step suppresses generation_config's suppress_tokens, the first step also its begin_suppress_tokens (a blank,
#   the end); with timestamps, the timestamp rules: timestamps come in pairs (after a lone one, text cannot follow; after
#   a pair, a timestamp cannot), never go back, the first is at most max_initial_timestamp_index (1 s), and where the
#   timestamps together are likelier than any one text token the next token is a timestamp;
# - greedy takes the likeliest token; beam search (Beams > 1) is transformers' (length penalty 1, early stopping off):
#   2 Beams candidates a step from every beam's log-probabilities plus its score, the best Beams that do not end kept
#   running, those of the first Beams that end (or reach the length) offered to the finished set by their score over
#   their length, until no running beam can beat the worst finished one.
#
# Long clips (Transcribe): OpenAI's sequential reading - a window of 30 s from `seek`, decoded with timestamps, its
# segments the stretches between pairs of timestamps; the next window starts at the last pair's time, or after the
# whole window where it ends with a lone timestamp (the speech went on to its end) or has no pairs.

import "std/json"
import "std/os"
import "../llm/bpe"
import "mel"
import "whisper"

# ---- where the model runs ----

# the CPU; a Vulkan device (any GPU with a Vulkan driver: speech/whispervk) for the encoder and the decoder; or the
# device for the encoder alone, its positions brought back for the decoder on the CPU (the encoder is most of the
# arithmetic; a decoder's step of one row is small products, which a device may not run faster than the CPU)
type Backend enum { Cpu, Vulkan, VulkanEncoder }

type BackendError error {
    Unavailable(why String)     # this build has no Vulkan, the machine no device, the model's weights are not F32, or the device has not the room
}

# -define Vulkan=true builds the device in (it needs Vulkan's headers alone, and runs where there is no Vulkan)
Vulkan Bool = false

if Vulkan {
    import "whispervk"
    import vdev "../kernels/vk/device"

    # a process's one model on a device
    theDev mut vdev.Device?& = null
    theRun mut whispervk.Runner?& = null

    fn VulkanAvailable() Bool { return vdev.Devices().Len() > 0 }

    # m on the device OANN_VK_DEVICE names, else the best one here; the device's description
    fn devOpen(m whisper.Model&, slots I64, rows I64, outs I64) String ? BackendError {
        why := whispervk.Refusal(m)
        if why != "": error BackendError.Unavailable(why)
        if theRun is not null: error BackendError.Unavailable("a model is on the device already (one a process)")
        theDev ~ try vdev.Device.Open() catch e { error BackendError.Unavailable($e) }
        theRun ~ try whispervk.Runner.Make(theDev!, m, slots, rows, outs) catch e { error BackendError.Unavailable($e + " (the model takes " + $(whispervk.Needs(m, slots, rows, outs) >> 20) + " MiB of device memory)") }
        return theDev!.Str()
    }
    fn devEncode(spec Array<F32>&, n I64) { theRun!.Encode(spec, n) }
    fn devEncoded(host mut Array<F32>&) { theRun!.Encoded(host)! }
    fn devCross() { theRun!.Cross() }
    fn devCopy(from I64, to I64, n I64) { theRun!.Copy(from, to, n) }
    fn devStep(k mut whisper.Decoder&, out I64) { theRun!.Step(k, out)! }
} else {
    fn VulkanAvailable() Bool { return false }
    fn devOpen(m whisper.Model&, slots I64, rows I64, outs I64) String ? BackendError { error BackendError.Unavailable("built without -define Vulkan=true") }
    fn devEncode(spec Array<F32>&, n I64) { }
    fn devEncoded(host mut Array<F32>&) { }
    fn devCross() { }
    fn devCopy(from I64, to I64, n I64) { }
    fn devStep(k mut whisper.Decoder&, out I64) { }
}

# ---- the tokens ----

type Tokens struct(Bpe bpe.Bpe) {
    Bpe
    Sot I32 = 0                     # <|startoftranscript|>
    Prev I32 = -1                   # <|startofprev|>, -1 where the vocabulary has none
    Eot I32 = 0                     # <|endoftext|>
    Transcribe I32 = 0
    Translate I32 = 0
    NoTimestamps I32 = 0
    TsBegin I32 = 0                 # <|0.00|>; <|0.02|> after it, ...
    Langs mut Array<I32>& = Array<I32>(0)
    Names mut Array<String>& = Array<String>(0)   # the language codes, Langs' order
    Suppress mut Array<I32>& = Array<I32>(0)
    Begin mut Array<I32>& = Array<I32>(0)
    MaxInitial I64 = 50
}

fn intAt(j json.Json&, key String&) I32 ? whisper.ModelError {
    v :~ try j[key] catch { error whisper.ModelError.Malformed("generation_config.json has no " + key) }
    return I32(try v.AsInt() catch { error whisper.ModelError.Malformed(key) })
}

fn intsAt(j json.Json&, key String&) Array<I32> {
    v :~ try j[key] catch { return Array<I32>(0) }
    a :~ try v.AsArr() catch { return Array<I32>(0) }
    return Array<I32>[I32(try x.AsInt() catch default 0) for x in a]
}

# the tokens of a model directory: tokenizer.json and generation_config.json
fn Tokens.Load(dir String&) Tokens ? whisper.ModelError, os.Error {
    b := try bpe.Bpe.Load(dir + "/tokenizer.json") catch { error whisper.ModelError.Malformed(dir + "/tokenizer.json") }
    t := Tokens(b)
    j :~ try json.Json.Parse(try os.ReadFile(dir + "/generation_config.json")) catch json.Error { error whisper.ModelError.Malformed("generation_config.json") }
    t.Sot = try intAt(j, "decoder_start_token_id")
    t.Prev = t.Bpe.Find("<|startofprev|>")
    t.Eot = try intAt(j, "eos_token_id")
    t.NoTimestamps = try intAt(j, "no_timestamps_token_id")
    t.TsBegin = t.NoTimestamps + 1
    t.Suppress ~ intsAt(j, "suppress_tokens")
    t.Begin ~ intsAt(j, "begin_suppress_tokens")
    if j.Has("max_initial_timestamp_index"): t.MaxInitial = I64(try intAt(j, "max_initial_timestamp_index"))
    if j.Has("task_to_id") {
        tasks :~ try j["task_to_id"] catch { unreachable }
        t.Transcribe = try intAt(tasks, "transcribe")
        t.Translate = try intAt(tasks, "translate")
    }
    if j.Has("lang_to_id") {
        m :~ try (try j["lang_to_id"] catch { unreachable }).AsObj() catch { error whisper.ModelError.Malformed("lang_to_id") }
        t.Langs ~ Array<I32>[I32(try v.AsInt() catch default 0) for v in m.Values]
        t.Names ~ Array<String>[k[2:k.Len() - 2] for k in m.Keys]
    }
    return t
}

# the text of tokens, the special ones (the end and every token after it) left out
fn (t Tokens&) Text(ids Array<I32>&) String {
    keep := Array<I32>[i for i in ids if i < t.Eot]
    return try t.Bpe.Decode(keep) catch default ""
}

# the decoder's input before its first step: with a prompt (text; left to the end, at most ctx / 2 - 1 tokens of it, as
# OpenAI's whisper keeps it), <|startofprev|> and the tokens of " " + the text, then <|startoftranscript|>, lang (-1: none,
# an English-only model), the task, <|notimestamps|> unless timestamps are asked for. The prompt's tokens condition the
# decoder and are never part of what it writes
fn (t Tokens&) Layout(o Options&, lang I32, ctx I64) Array<I32> {
    p := Vec<I32>()
    text :~ o.Prompt.Trim()
    if text.Len() > 0 and t.Prev >= 0 {
        ids := t.Bpe.Encode(" " + text)
        keep := (ctx / 2 - 1).Min(ids.Len())
        p.Push(t.Prev)
        for i in range ids.Len() - keep, ids.Len(): p.Push(ids[i])
    }
    p.Push(t.Sot)
    if lang >= 0 {
        p.Push(lang)
        p.Push(t.Translate if o.Translate else t.Transcribe)
    }
    if not o.Timestamps: p.Push(t.NoTimestamps)
    return p.ToArray()
}

# a language's token, or -1
fn (t Tokens&) Lang(code String&) I32 {
    for i, n in t.Names {
        if n == code: return t.Langs[i]
    }
    return -1
}

# ---- options and results ----

type Options struct() {
    Language String = ""        # a code (en, de, sv, ...); detected where empty (multilingual models)
    Translate Bool = false      # to English
    Timestamps Bool = false
    Beams I64 = 1               # 1: greedy
    MaxTokens I64 = 224         # tokens a window may have after its prompt
    NoRepeat Bool = false       # greedy: stop where the last 1-30 tokens have come three times running (a loop)
    Prompt String = ""          # text the decoder is given as the text before the clip (a name's spelling, jargon, a style); "": none
    Positions I64 = 1500        # the encoder's positions (fewer: a shorter window, faster and not the reference)
}

type Segment struct(Start F64, End F64, Text String) {
    Start                       # seconds from the clip's start
    End
    Text
}

# ---- a model ready to transcribe ----

type Whisper struct(M whisper.Model, T Tokens, beams I64 = 5, where Backend = Backend.Cpu) {
    M
    T
    Where Backend = where                       # set by LoadOn alone: the device holds the model
    Device String = ""                        # the device's description, where there is one
    Mel mut mel.Mel& = mel.Mel(M.C.Mels, 1000, M.Threads)
    Enc mut whisper.Encoder& = whisper.Encoder(M, M.C.Positions if where != Backend.Vulkan else 1)
    Dec mut whisper.Decoder& = whisper.Decoder(M, 2 * beams, beams.Max(M.C.Text / 2 + 4), beams, where != Backend.Vulkan)
    Language I32 = -1                         # the last window's language token
    logp mut Array<F32>& = Array<F32>(M.C.Vocab)
}

# the code ("sv", "en", ...) of the last window's language, detected or given; "" for an English-only model
fn (w Whisper&) LanguageCode() String {
    for i, l in w.T.Langs {
        if l == w.Language: return w.T.Names[i]
    }
    return ""
}

# the model and tokens in dir, BF16 products where bf is set, INT8 decoder weights where q8 is; room for beam searches of up to `beams`; on `threads`
# threads (0: every core)
fn Whisper.Load(dir String&, bf Bool = false, beams I64 = 5, threads I64 = 0, q8 Bool = false) Whisper ? whisper.ModelError, os.Error {
    m := try whisper.Model.Load(dir, bf, q8)
    if threads > 0: m.Threads = threads
    t := try Tokens.Load(dir)
    return Whisper(m, t, beams.Max(1))
}

# the model and tokens in dir with its products at `where` (F32 weights): BackendError.Unavailable saying why where the
# device cannot take it - the caller loads on the CPU then. One model a process may be on a device
fn Whisper.LoadOn(dir String&, where Backend, beams I64 = 5, threads I64 = 0) Whisper ? whisper.ModelError, os.Error, BackendError {
    if where == Backend.Cpu: return try Whisper.Load(dir, false, beams, threads)
    m := try whisper.Model.Load(dir)
    if threads > 0: m.Threads = threads
    t := try Tokens.Load(dir)
    nb := beams.Max(1)
    name := try devOpen(m, 2 * nb if where == Backend.Vulkan else 0, nb.Max(m.C.Text / 2 + 4) if where == Backend.Vulkan else 0, nb if where == Backend.Vulkan else 0)
    if where == Backend.Vulkan: m.Forget()
    w := Whisper(m, t, nb, where)
    w.Device = name
    return w
}

# the step being made run where the model is, and a beam's cache copied there
fn (w mut Whisper&) step(out I64) {
    if w.Where == Backend.Vulkan {
        devStep(w.Dec, out)
        return
    }
    w.M.Step(w.Dec, out)
}

fn (w mut Whisper&) copy(from I64, to I64, n I64) {
    if w.Where == Backend.Vulkan {
        devCopy(from, to, n)
        return
    }
    w.Dec.Copy(from, to, n, w.M.C)
}

# the window of a clip's log-mel (mel.Clip's, `frames` long) from frame seek, `take` frames of it and zeros after, n
# positions (2n frames), encoded and crossed to
fn (w mut Whisper&) Window(clip Array<F32>&, frames I64, seek I64 = 0, take I64 = 3000, n I64 = 1500) {
    spec := mel.Slice(clip, w.M.C.Mels, frames, seek, take, 2 * n)
    if w.Where == Backend.Cpu: w.M.Encode(w.Enc, spec, n)
    if w.Where != Backend.Cpu: devEncode(spec, n)
    if w.Where == Backend.Vulkan {
        devCross()
        return
    }
    if w.Where == Backend.VulkanEncoder: devEncoded(w.Enc.Out)
    w.M.Cross(w.Dec, w.Enc.Out, n)
}

# the first window of samples x (at most 30 s of it); a window shortened to n positions keeps at least 3 s of silence
# after the sound (with none, the model never ends and repeats its last phrase)
fn (w mut Whisper&) Clip(x Array<F32>&, n I64 = 1500) {
    clip, frames := w.Mel.Clip(x[:x.Len().Min(30 * mel.Rate)])
    m := n.Max(x.Len() / (2 * mel.Hop) + 150).Min(w.M.C.Positions)
    w.Window(clip, frames, 0, 2 * m, m)
}

# the likeliest language token of the window
fn (w mut Whisper&) Detect() I32 {
    if w.T.Langs.Len() == 0: return -1
    w.Dec.Reset()
    w.Dec.Add(w.T.Sot, 0, 0)
    w.step(1)
    best := w.T.Langs[0]
    for l in w.T.Langs {
        if w.Dec.Logits[I64(l)] > w.Dec.Logits[I64(best)]: best = l
    }
    return best
}

# the prompt of a window under o
fn (w mut Whisper&) Prompt(o Options&) Array<I32> {
    lang I32 = -1
    if w.T.Langs.Len() > 0 {
        lang = w.T.Lang(o.Language) if o.Language.Len() > 0 else w.Detect()
        if lang < 0: lang = w.Detect()
        w.Language = lang
    }
    return w.T.Layout(o, lang, w.M.C.Text)
}

# the rules of a step applied to row (Vocab wide; logits or log-probabilities), gen the tokens decoded after the prompt
fn (w Whisper&) rules(row mut Array<F32>&, gen Array<I32>&, o Options&) {
    t := w.T
    v := w.M.C.Vocab
    ninf := F32(-1.0) / F32(0.0)
    if gen.Len() == 0 {
        for i in t.Begin: row[I64(i)] = ninf
    }
    for i in t.Suppress: row[I64(i)] = ninf
    if not o.Timestamps: return
    tb := I64(t.TsBegin)
    row[I64(t.NoTimestamps)] = ninf
    n := gen.Len()
    last := n >= 1 and gen[n - 1] >= t.TsBegin
    penult := n < 2 or gen[n - 2] >= t.TsBegin
    if last and penult {
        for i in range tb, v: row[i] = ninf
    } else if last {
        for i in range I64(t.Eot): row[i] = ninf
    }
    top I64 = -1
    for g in gen {
        if g >= t.TsBegin: top = I64(g)
    }
    if top >= 0 {
        upto := top if last and not penult else top + 1
        for i in range tb, upto: row[i] = ninf
    }
    if n == 0 {
        for i in range tb: row[i] = ninf
        for i in range tb + t.MaxInitial + 1, v: row[i] = ninf
    }
    # the timestamps' probability together against the likeliest text token's
    big := row[0]
    for i in range v: big = big.Max(row[i])
    sum F64 = 0.0
    for i in range v: sum += F64(row[i] - big).Exp()
    lse := F64(big) + sum.Log()
    tsTop F64 = -1e300
    for i in range tb, v: tsTop = tsTop.Max(F64(row[i]))
    ts F64 = 0.0
    if tsTop > -1e300 {
        for i in range tb, v: ts += (F64(row[i]) - tsTop).Exp()
    }
    tsLog := (tsTop + ts.Log() if tsTop > -1e300 else -1e300) - lse
    textTop F64 = -1e300
    for i in range tb: textTop = textTop.Max(F64(row[i]))
    if tsLog > textTop - lse {
        for i in range tb: row[i] = ninf
    }
}

# log_softmax of row in place, in F32 as torch computes it
fn logSoftmax(row mut Array<F32>&) {
    big := row[0]
    for x in row: big = big.Max(x)
    sum F64 = 0.0
    for x in row: sum += F64(x - big).Exp()
    l := F32(sum.Log())
    for i in range row.Len(): row[i] = row[i] - big - l
}

# the tokens of the window after prompt: greedy or by beam search
fn (w mut Whisper&) Decode(prompt Array<I32>&, o Options&) Array<I32> {
    if o.Beams > 1: return w.beam(prompt, o)
    k :~ w.Dec
    k.Reset()
    for i, t in prompt: k.Add(t, I64(i), 0)
    w.step(1)
    gen := Vec<I32>()
    limit := o.MaxTokens.Min(w.M.C.Text - prompt.Len())
    for gen.Len() < limit {
        row :~ k.Logits[:w.M.C.Vocab]
        w.rules(row, gen.ToArray(), o)
        best I64 = 0
        for i in range row.Len() {
            if row[i] > row[best]: best = i
        }
        gen.Push(I32(best))
        if I32(best) == w.T.Eot: break
        loop := loopOf(gen) if o.NoRepeat else 0
        if loop > 0 {
            for _ in range 2 * loop: try gen.Pop() catch { unreachable }
            gen.Push(w.T.Eot)
            break
        }
        k.Reset()
        k.Add(I32(best), I64(prompt.Len() + gen.Len() - 1), 0)
        w.step(1)
    }
    return gen.ToArray()
}

# the length k (1 .. 30) of a loop at gen's end - its last k tokens three times running - or 0
fn loopOf(gen Vec<I32>&) I64 {
    n := gen.Len()
    for k in range 1, (n / 3).Min(30) + 1 {
        same := true
        for i in range 2 * k {
            if gen[n - 1 - i] != gen[n - 1 - i - k]: same = false
        }
        if same: return k
    }
    return 0
}

# a candidate of a beam step: its score, the beam it extends, its token
type cand struct(Score F32, Beam I64, Tok I32) {
    Score
    Beam
    Tok
}

# transformers' beam search (length penalty 1, early_stopping false) over o.Beams beams in slots of half `half`
fn (w mut Whisper&) beam(prompt Array<I32>&, o Options&) Array<I32> {
    nb := o.Beams.Min(w.Dec.Slots / 2)
    v := w.M.C.Vocab
    pl := prompt.Len()
    limit := o.MaxTokens.Min(w.M.C.Text - pl)
    k :~ w.Dec
    k.Reset()
    for i, t in prompt: k.Add(t, I64(i), 0)
    w.step(1)
    for b in range 1, nb: w.copy(0, b, pl)
    # every beam's logits are the prompt's at first
    # the running beams' tokens: beam b's step tokens at b limit
    run := Array<I32>(nb * limit)
    next := Array<I32>(nb * limit)
    score := Array<F32>(nb, F32(-1e9))
    score[0] = 0.0
    done := Vec<Array<I32>>()
    doneScore := Vec<F32>()
    half I64 = 0
    rows := Array<I64>(nb, 0)
    from := Array<I64>(nb)
    cands := Vec<cand>()
    for step in range limit {
        cands.Clear()
        for b in range nb {
            row :~ w.logp
            for i in range v: row[i] = k.Logits[rows[b] * v + i]
            logSoftmax(row)
            w.rules(row, run[b * limit:b * limit + step], o)
            for i in range v: keepTop(cands, cand(row[i] + score[b], b, I32(i)), 2 * nb)
        }
        last := step + 1 == limit
        # the finished: those of the first nb that end, scored over their length
        for j, c in cands {
            if j >= nb or not (c.Tok == w.T.Eot or last): continue
            seq := Array<I32>(step + 1)
            for i in range step: seq[i] = run[c.Beam * limit + i]
            seq[step] = c.Tok
            offer(done, doneScore, seq, c.Score / F32(step + 1), nb)
        }
        if last: break
        # the running: the best nb that do not end
        got I64 = 0
        for c in cands {
            if got == nb or c.Tok == w.T.Eot: continue
            for i in range step: next[got * limit + i] = run[c.Beam * limit + i]
            next[got * limit + step] = c.Tok
            score[got] = c.Score
            from[got] = c.Beam
            got += 1
        }
        # can a running beam still beat the worst finished?
        if doneScore.Len() == nb {
            worst := doneScore[0]
            for x in doneScore: worst = worst.Min(x)
            if score[0] / F32(step + 1) <= worst: break
        }
        # the caches follow their beams into the other half of the slots
        other := nb - half
        k.Reset()
        for b in range nb {
            w.copy(half + from[b], other + b, pl + step)
            k.Add(next[b * limit + step], I64(pl + step), other + b)
            rows[b] = b
        }
        half = other
        run, next ~ next, run
        w.step(nb)
    }
    best I64 = 0
    for i in range doneScore.Len() {
        if doneScore[i] > doneScore[best]: best = i
    }
    return done[best] if done.Len() > 0 else run[:limit]
}

# c kept among the best n of cs, in order (an earlier equal stays first)
fn keepTop(cs mut Vec<cand>&, c cand, n I64) {
    if cs.Len() == n and c.Score <= cs[n - 1].Score: return
    if cs.Len() < n: cs.Push(c)
    i := cs.Len() - 1
    for i > 0 and cs[i - 1].Score < c.Score {
        cs[i] = cs[i - 1]
        i -= 1
    }
    cs[i] = c
}

# seq offered to the finished set of at most n by its score
fn offer(done mut Vec<Array<I32>>&, scores mut Vec<F32>&, seq Array<I32>&, s F32, n I64) {
    if done.Len() < n {
        done.Push(seq)
        scores.Push(s)
        return
    }
    worst I64 = 0
    for i in range scores.Len() {
        if scores[i] < scores[worst]: worst = i
    }
    if s <= scores[worst]: return
    done[worst] = seq
    scores[worst] = s
}

# ---- segments and long clips ----

# the segments of a window's tokens (offset: the window's start in seconds; frames: its length) and the frames the
# next window starts after it: segments run between pairs of timestamps, and the next window from the last pair; a
# window ending in a lone timestamp ends its last segment there and is read whole, as is one with no pairs (one
# segment, to its last timestamp or its end). Text after the last pair, unclosed, is read again by the next window
fn (w Whisper&) Cut(gen Array<I32>&, offset F64, frames I64) Array<Segment>, I64 {
    tb := w.T.TsBegin
    n := gen.Len()
    if n > 0 and gen[n - 1] == w.T.Eot: n -= 1
    lone := n >= 2 and gen[n - 1] >= tb and gen[n - 2] < tb
    out := Vec<Segment>()
    last I64 = 0
    for i in range 1, n + 1 {
        closes := (i < n and gen[i] >= tb and gen[i - 1] >= tb) or (i == n and lone and last > 0)
        if not closes: continue
        seg :~ gen[last:i]
        out.Push(Segment(offset + F64(seg[0] - tb) * 0.02, offset + F64(seg[seg.Len() - 1] - tb) * 0.02, w.T.Text(seg)))
        last = i
    }
    if last > 0: return out.ToArray(), (frames if lone else I64(gen[last - 1] - tb) * 2)
    span := F64(frames) / 100.0
    for i in range n {
        if gen[i] > tb: span = F64(gen[i] - tb) * 0.02
        else if gen[i] == tb: span = F64(frames) / 100.0
    }
    out.Push(Segment(offset, offset + span, w.T.Text(gen[:n])))
    return out.ToArray(), frames
}

# o with timestamps
fn (o Options&) timed() Options {
    t := Options()
    t.Language = o.Language
    t.Translate = o.Translate
    t.Timestamps = true
    t.Prompt = o.Prompt
    t.Beams = o.Beams
    t.MaxTokens = o.MaxTokens
    t.NoRepeat = o.NoRepeat
    t.Positions = o.Positions
    return t
}

test Options "timed() keeps every field and turns timestamps on" {
    o := Options()
    o.Language = "sv"
    o.Translate = true
    o.Beams = 5
    o.MaxTokens = 100
    o.NoRepeat = true
    o.Prompt = "Arvidsson"
    o.Positions = 200
    t := o.timed()
    assert t.Timestamps
    assert t.Language == "sv" and t.Translate and t.Beams == 5 and t.MaxTokens == 100
    assert t.NoRepeat and t.Prompt == "Arvidsson" and t.Positions == 200
    # and the defaults
    d := Options().timed()
    assert d.Timestamps and not d.NoRepeat and not d.Translate and d.Beams == 1 and d.MaxTokens == 224 and d.Positions == 1500
}

# every segment of a log-mel (mel.Clip's) from frame seek to `frames`, read window after window; the frame it stopped at
fn (w mut Whisper&) segments(clip Array<F32>&, frames I64, seek I64, o Options&, final Bool, out mut Vec<Segment>&, base F64) I64 {
    window := 2 * o.Positions
    at := seek
    for at < frames and (final or at + window <= frames) {
        take := window.Min(frames - at)
        w.Window(clip, frames, at, take, o.Positions)
        gen := w.Decode(w.Prompt(o), o)
        segs, adv := w.Cut(gen, base + F64(at) / 100.0, take)
        for g in segs {
            if g.Text.Trim().Len() > 0: out.Push(g)
        }
        at += adv.Max(1)
    }
    return at
}

# every segment of a clip of any length (with timestamps, whatever o says)
fn (w mut Whisper&) Transcribe(x Array<F32>&, given Options&) Array<Segment> {
    o := given.timed()
    clip, frames := w.Mel.Clip(x)
    out := Vec<Segment>()
    w.segments(clip, frames, 0, o, true, out, 0.0)
    return out.ToArray()
}

# the text of a clip of at most 30 s
fn (w mut Whisper&) Text(x Array<F32>&, o Options&) String {
    w.Clip(x, o.Positions)
    return w.T.Text(w.Decode(w.Prompt(o), o))
}

# ---- streaming ----

# sound taken as it comes (Push): each full window of 30 s from the last settled segment decoded as soon as it is there
# (Settled), and what is past the last settled point decoded on demand (Partial) - a dictation's running text, or a
# command once the speaker stops
type Stream struct(w mut Whisper&, o Options) {
    w
    o
    buf mut Vec<F32>& = Vec<F32>()
    seek I64 = 0                # samples of buf settled
    base I64 = 0                # samples dropped before buf[0]
}

fn (s mut Stream&) Push(x Array<F32>&) {
    for v in x: s.buf.Push(v)
}

# the segments of every full window now there, settled: the next window starts where the last pair of timestamps
# closed (final: the rest too, however short). Each window's log-mel is normalised on its own
fn (s mut Stream&) Settled(final Bool = false) Array<Segment> {
    out := Vec<Segment>()
    o := s.o.timed()
    window := 2 * o.Positions * mel.Hop
    for s.seek + window <= s.buf.Len() or (final and s.seek < s.buf.Len()) {
        x := Array<F32>[s.buf[i] for i in range s.seek, (s.seek + window).Min(s.buf.Len())]
        clip, frames := s.w.Mel.Clip(x)
        take := frames.Min(2 * o.Positions)
        s.w.Window(clip, frames, 0, take, o.Positions)
        gen := s.w.Decode(s.w.Prompt(o), o)
        segs, adv := s.w.Cut(gen, F64(s.base + s.seek) / F64(mel.Rate), take)
        for g in segs {
            if g.Text.Trim().Len() > 0: out.Push(g)
        }
        s.seek += adv.Max(1) * mel.Hop
    }
    s.drop()
    return out.ToArray()
}

# the text of what is past the last settled point, decoded now (unsettled: a later call may differ)
fn (s mut Stream&) Partial() String {
    if s.seek >= s.buf.Len(): return ""
    x := Array<F32>[s.buf[i] for i in range s.seek, s.buf.Len().Min(s.seek + 30 * mel.Rate)]
    return s.w.Text(x, s.o)
}

# the settled samples let go of
fn (s mut Stream&) drop() {
    if s.seek == 0: return
    rest := Vec<F32>()
    for i in range s.seek, s.buf.Len(): rest.Push(s.buf[i])
    s.base += s.seek.Min(s.buf.Len())
    s.seek = 0
    s.buf ~ rest
}

# ---- checks against the reference ----

# the reference's tokens of a decoding after its prompt, and its text
fn reference(name String&, clip String&, kind String&) Array<I32>, String {
    path := mel.Cache() + "/ref/" + name + "/" + clip + ".json"
    j :~ json.Json.Parse(os.ReadFile(path)!)!
    toks := whisper.Ints(path, kind, "tokens")!
    text :~ (j[kind]!)["text"]!.AsStr()!
    return toks, text
}

# the reference's segments of a clip
fn segmentsOf(name String&, clip String&) Array<Segment> {
    j :~ json.Json.Parse(os.ReadFile(mel.Cache() + "/ref/" + name + "/" + clip + ".json")!)!
    out := Vec<Segment>()
    for g in j["segments"]!.AsArr()! {
        out.Push(Segment(g["start"]!.AsNum()!, g["end"]!.AsNum()!, g["text"]!.AsStr()!))
    }
    return out.ToArray()
}

# whether segments are the reference's: their texts, and their times to the 20 ms of a timestamp
fn sameSegments(got Array<Segment>&, want Array<Segment>&) Bool {
    if got.Len() != want.Len(): return false
    for i, g in got {
        if g.Text != want[i].Text or (g.Start - want[i].Start).Abs() > 0.011 or (g.End - want[i].End).Abs() > 0.011: return false
    }
    return true
}

fn shown(ss Array<Segment>&) String {
    out := ""
    for g in ss: out = out + "\n  [" + $g.Start + " - " + $g.End + "]" + g.Text
    return out
}

# a model's transcripts of the clips held to the reference's: greedy and beam sequences token for token, segments
fn holds(name String&) {
    dir := mel.Cache() + "/models/openai--whisper-" + name
    if not os.Exists(mel.Cache() + "/ref/" + name + "/jfk.json") or not os.Exists(dir) {
        Println("skipped: no reference for " + name)
        return
    }
    w := Whisper.Load(dir)!
    for clip in ["jfk", "aesop1", "aesop2"] {
        x := mel.Wav(mel.Cache() + "/audio/" + clip + ".wav")!
        w.Clip(x)
        for kind in ["greedy", "beam"] {
            o := Options()
            o.MaxTokens = 200
            o.Beams = 5 if kind == "beam" else 1
            p := w.Prompt(o)
            got := w.Decode(p, o)
            want, text := reference(name, clip, kind)
            all := Vec<I32>()
            for t in p: all.Push(t)
            for t in got: all.Push(t)
            seq :~ all.ToArray()
            if seq.Len() > 0 and seq[seq.Len() - 1] == w.T.Eot and (want.Len() == 0 or want[want.Len() - 1] != w.T.Eot): seq ~ seq[:seq.Len() - 1]
            assert seq == want, name + " " + clip + " " + kind + ":\n got  " + $seq + "\n want " + $want
            assert w.T.Text(got) == text, w.T.Text(got)
        }
    }
    for clip in ["jfk", "aesop1", "aesop2", "aesop2_long"] {
        x := mel.Wav(mel.Cache() + "/audio/" + clip + ".wav")!
        o := Options()
        o.MaxTokens = 200
        got := w.Transcribe(x, o)
        want := segmentsOf(name, clip)
        assert sameSegments(got, want), name + " " + clip + ":\n got" + shown(got) + "\n want" + shown(want)
    }
}

test Whisper "tiny: greedy and beam transcripts the reference's token for token, segments the same (where the files are)" {
    holds("tiny")
}

test Whisper "base and small: greedy and beam transcripts the reference's token for token, segments the same (where the files are)" {
    for name in whisper.Larger(): holds(name)
}

test Whisper "BF16 products (AMX where there is): every model's greedy transcripts the F32 ones' (where the files are)" {
    for name in whisper.Models() {
        dir := mel.Cache() + "/models/openai--whisper-" + name
        if not os.Exists(dir) or not os.Exists(mel.Cache() + "/audio/jfk.wav"): continue
        f := Whisper.Load(dir)!
        b := Whisper.Load(dir, true)!
        for clip in ["jfk", "aesop1", "aesop2"] {
            x := mel.Wav(mel.Cache() + "/audio/" + clip + ".wav")!
            o := Options()
            assert f.Text(x, o) == b.Text(x, o), name + " " + clip + ": " + b.Text(x, o)
        }
    }
}

test Stream "sound pushed in half seconds: nothing settled before its end, the partial text the clip's, then its segments' text" {
    dir := mel.Cache() + "/models/openai--whisper-tiny"
    if not os.Exists(dir) or not os.Exists(mel.Cache() + "/audio/jfk.wav") {
        Println("skipped: no model or clip")
        return
    }
    w := Whisper.Load(dir)!
    x := mel.Wav(mel.Cache() + "/audio/jfk.wav")!
    whole := ""
    for g in w.Transcribe(x, Options()): whole = whole + g.Text
    st := Stream(w, Options())
    for c0 in range 0, x.Len(), 8000 {
        st.Push(x[c0:(c0 + 8000).Min(x.Len())])
        assert st.Settled().Len() == 0
    }
    assert st.Partial() == w.Text(x, Options()), st.Partial()
    assert w.LanguageCode() == "en", w.LanguageCode()
    # a window shortened below the clip keeps a margin of silence and ends
    o := Options()
    o.Positions = 200
    o.NoRepeat = true
    short := w.Text(x[:2 * mel.Rate], o)
    assert short.Len() > 0 and short.Len() < 80, short
    got := ""
    for g in st.Settled(true): got = got + g.Text
    assert got == whole, got + " | " + whole
}

# ---- decoder prompts ----

fn cat(a Array<I32>&, b Array<I32>&, c Array<I32>&) Array<I32> {
    v := Vec<I32>()
    for x in a: v.Push(x)
    for x in b: v.Push(x)
    for x in c: v.Push(x)
    return v.ToArray()
}

# the reference's prompt cases of a clip (reference.py ... --prompt): each case's prompt, prompt ids and greedy tokens
type promptCase struct(Prompt String, Ids Array<I32>, Toks Array<I32>) {
    Prompt
    Ids
    Toks
}

fn promptCases(name String&, clip String&) Array<promptCase> {
    j :~ json.Json.Parse(os.ReadFile(mel.Cache() + "/ref/" + name + "/" + clip + ".prompt.json")!)!
    out := Vec<promptCase>()
    for c in j["cases"]!.AsArr()! {
        ids := Array<I32>[I32(x.AsInt()!) for x in c["prompt_ids"]!.AsArr()!]
        toks := Array<I32>[I32(x.AsInt()!) for x in c["tokens"]!.AsArr()!]
        out.Push(promptCase(c["prompt"]!.AsStr()!, ids, toks))
    }
    return out.ToArray()
}

test Tokens "a prompt's layout: <|startofprev|>, the text's tokens after a space, then the old prompt; empty or blank: the old prompt; at most 223 tokens, the last ones" {
    dir := mel.Cache() + "/models/openai--whisper-tiny"
    if not os.Exists(dir + "/tokenizer.json") {
        Println("skipped: no tokenizer")
        return
    }
    t := Tokens.Load(dir)!
    assert t.Prev >= 0
    lang := t.Lang("sv")
    o := Options()
    old := Array<I32>[t.Sot, lang, t.Transcribe, t.NoTimestamps]
    assert t.Layout(o, lang, 448) == old
    o.Prompt = "  \n "
    assert t.Layout(o, lang, 448) == old
    o.Prompt = "Mitchell Gourley"
    ids := t.Bpe.Encode(" Mitchell Gourley")
    want := Vec<I32>()
    want.Push(t.Prev)
    for i in ids: want.Push(i)
    for i in old: want.Push(i)
    assert t.Layout(o, lang, 448) == want.ToArray()
    assert t.Text(t.Layout(o, lang, 448)[1:1 + ids.Len()]) == " Mitchell Gourley"
    o.Timestamps = true
    o.Translate = true
    assert t.Layout(o, lang, 448) == cat(Array<I32>[t.Prev], ids, Array<I32>[t.Sot, lang, t.Translate])
    # an English-only model: no language, no task
    assert t.Layout(o, -1, 448) == cat(Array<I32>[t.Prev], ids, Array<I32>[t.Sot])
    # a long prompt keeps its last ctx / 2 - 1 tokens
    long := ""
    for i in range 400: long = long + " word" + $i
    o.Prompt = long
    all := t.Bpe.Encode(" " + long.Trim())
    assert all.Len() > 223
    p := t.Layout(o, lang, 448)
    assert p.Len() == 1 + 223 + 3
    assert p[1:224] == all[all.Len() - 223:]
    assert p[0] == t.Prev and p[224] == t.Sot
}

# the stream with a prompt: Partial is the prompted Text, and the settled segments' text the prompted transcript's
fn streamHolds(w mut Whisper&, x Array<F32>&, given Options&) {
    o := given.timed()
    o.Beams = 1
    st := Stream(w, o)
    st.Push(x)
    assert st.Partial() == w.Text(x, o)
    whole := ""
    for g in w.Transcribe(x, o): whole = whole + g.Text
    got := ""
    for g in st.Settled(true): got = got + g.Text
    assert got == whole and whole.Len() > 0, got + " | " + whole
}

test Whisper "a prompt of the longest length decodes (the decoder's first step holds all its rows), greedy and beams (where the files are)" {
    dir := mel.Cache() + "/models/openai--whisper-tiny"
    if not os.Exists(dir) or not os.Exists(mel.Cache() + "/audio/jfk.wav") {
        Println("skipped: no model")
        return
    }
    w := Whisper.Load(dir)!
    x := mel.Wav(mel.Cache() + "/audio/jfk.wav")!
    w.Clip(x)
    long := ""
    for i in range 400: long = long + " word" + $i
    for beams in [1, 3] {
        o := Options()
        o.Language = "en"
        o.MaxTokens = 20
        o.Beams = beams
        o.Prompt = long
        p := w.Prompt(o)
        assert p.Len() > 100, $p.Len()
        got := w.Decode(p, o)
        assert got.Len() > 0 and not got.Has(w.T.Prev) and not got.Has(w.T.Sot)
    }
}

test Whisper "prompt: greedy tokens the reference's (prompt_ids), the empty prompt the old decoding, beams and the stream with a prompt (where the files are)" {
    dir := mel.Cache() + "/models/openai--whisper-tiny"
    clips := ["jfk", "sv1"]
    langs := ["en", "sv"]
    for ci, clip in clips {
        lang := langs[ci]
        if not os.Exists(dir) or not os.Exists(mel.Cache() + "/ref/tiny/" + clip + ".prompt.json") {
            Println("skipped: no prompt reference for " + clip)
            continue
        }
        w := Whisper.Load(dir)!
        x := mel.Wav(mel.Cache() + "/audio/" + clip + ".wav")!
        w.Clip(x)
        plain := Options()
        plain.Language = lang
        plain.MaxTokens = 200
        base := w.Decode(w.Prompt(plain), plain)
        changed := 0
        for c in promptCases("tiny", clip) {
            o := Options()
            o.Language = lang
            o.MaxTokens = 200
            o.Prompt = c.Prompt
            p := w.Prompt(o)
            assert p.Len() == c.Ids.Len() + 4, $p
            assert p[:c.Ids.Len()] == c.Ids, clip + ": prompt ids " + $p[:c.Ids.Len()] + " want " + $c.Ids
            got := w.Decode(p, o)
            if got.Len() > 0 and got[got.Len() - 1] == w.T.Eot and (c.Toks.Len() == 0 or c.Toks[c.Toks.Len() - 1] != w.T.Eot): got = got[:got.Len() - 1]
            assert got == c.Toks, clip + " " + c.Prompt + ":\n got  " + $got + "\n want " + $c.Toks
            if c.Prompt.Len() == 0: assert got == base[:got.Len()] and got.Len() > 0
            else if got != base: changed += 1
            # the prompt's tokens are never in the output
            assert got.Len() > 0 and not got.Has(w.T.Prev) and not got.Has(w.T.Sot)
        }
        assert changed > 0, clip + ": no prompt changed the output"
        # beams: a prompt gives a transcript without its tokens
        o := Options()
        o.Language = lang
        o.MaxTokens = 200
        o.Beams = 3
        o.Prompt = promptCases("tiny", clip)[1].Prompt
        b := w.Decode(w.Prompt(o), o)
        assert b.Len() > 0 and not b.Has(w.T.Prev) and not b.Has(w.T.Sot)
        if ci == 0: streamHolds(w, x, o)
    }
}
