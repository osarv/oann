fn same<S, A>(s S, z A) Bool {
    return match S {
        case A: true
        case _: false
    }
}

type M<S> struct(Data mut Array<S>&, Off I64) {
    Data
    Off
}

type B<S> struct(Data mut Array<S>&, N I64) {
    Data
    N
}

fn (b B<S>&) At(i I64) M<S> { return M<S>(b.Data, i) }
fn B<S>.Of(m M<S>&, n I64) B<S> { return B<S>(m.Data, n) }

type Tri enum {
    Full
    Result(diag I64)
}

fn diagOf(t Tri) I64 {
    return match t {
        case Tri.Full: 0
        case Tri.Result(d): d
    }
}

fn f(t Tri = Tri.Full) I64 { return diagOf(t) }

test "x" {
    s F32 = 0
    z F64 = 0
    assert not same(s, z) and same(s, s)
    m := M<F32>(Array<F32>(4), 0)
    b := B<F32>.Of(m, 2)
    b.At(1).Data[1] = 3.0
    assert m.Data[1] == 3.0
    assert f() == 0 and f(Tri.Result(3)) == 3
    x F32 = 2.0
    assert x.Log1p() > 1.0
}
