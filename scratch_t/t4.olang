import "std/time"
import "../kernels/mat"
import "../kernels/gemm"

fn main() {
    rows, cols := 256, 512
    a := mat.Mat<F32>(Array<F32>(rows * cols), 0, rows, cols, cols)
    x := Array<F32>(cols)
    y := Array<F32>(rows)
    for i in range rows * cols: a.Data[i] = F32(i % 7) * 0.25
    for i in range cols: x[i] = F32(i % 5) * 0.5
    for _ in range 3 {
        t0 := time.Now()
        for _ in range 1000: gemm.Gemv(y, a, false, x)
        Println("Gemv " $(F64(time.Since(t0)) / 1000.0) " " $y[3])
    }
}
