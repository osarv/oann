# nn/potts - a pairwise (Potts) energy over a sparse graph of cells, each taking one of K values, learned by
# pseudolikelihood and searched by many annealed chains at once.
#
#     E(x) = sum over edges u -> v of w_uv W[x_v, x_u] / 2  +  sum over cells i of sum_f F[i, f] B[f, x_i]
#
# Beyond pairs: `Factors` - k-ary factors, each a table of K^k energies over its cells (a not-all-equal clause, a
# parity) - and `Hidden` - binary hidden units, each joined to a few cells with a table per slot, summed out in the
# energy (-softplus of its input) and drawn as a block before the cells in every sweep (block Gibbs). Attach them by
# setting the model's Fac and Hid; every part - local energies, energy, pseudolikelihood and its gradients, the
# sampler - takes them in. Cells sharing a factor are coloured apart (ColourFor).
#
# The graph is message.Edges (each undirected edge given both ways, so every pair is counted once through the half;
# a batch of graphs laid out as one graph whose parts share no edge, as there). W is a K x K table shared by every edge,
# symmetric when fitted with `Symmetric`; the unary term is linear in each cell's features F (a clue one-hot, a degree,
# a bias - whatever describes a cell), B a features x K table. A cell's local energy - what it adds with each value, its
# neighbours held - is L_i[c] = sum_f F[i, f] B[f, c] + sum over its edges w W[c, x_u].
#
# Learning: `PseudoGrad` - each cell's conditional over its K values given its neighbours at an answer is exact
# (softmax of -L_i), so the loss is the mean cross-entropy of those conditionals at known answers: no sampling, no
# relaxation, a gradient for W and B in one pass (Besag 1975).
#
# Search: `Sampler` - Chains chains over the same graph, each a full assignment. A sweep visits the cells by colour
# class (a greedy colouring of the graph: no two cells of a class are neighbours, so a class's cells are conditionally
# independent - chromatic Gibbs), each cell drawing its value from softmax(-L_i / T), its pair energies kept as a field
# updated only where a neighbour moves. Sixteen chains are swept in step, one to a vector lane (F32), and groups of
# them run on tasks; T falls geometrically from
# T0 to T1 over the annealing sweeps, then zero-temperature sweeps (each cell its lowest-energy value) until no cell
# moves. A chain stops on its own once a sweep at T <= Tstop moves nothing. Chains run on up to Threads tasks, each
# chain with its own generator, so a result does not depend on the thread count. `Focus` is the focused counterpart:
# each move picks a violated factor or edge (above its table's minimum) and heat-baths one change of its cells, with
# optional constraint weights that grow where the search sits and decay (breakout). `Langevin` is the continuous
# counterpart: each cell's values relaxed to softmax(theta_i), theta descended on the relaxed energy with noise of
# temperature T (annealed), the answer each cell's largest.

import "message"
import "../kernels/elem"
import "std/rand"

# the energy's tables: W (K x K, row the cell's value, column the neighbour's), B (features x K)
type Potts struct(k I64, features I64) {
    K I64 = k
    Features I64 = features
    W mut Array<F64>& = Array<F64>(k * k)
    B mut Array<F64>& = Array<F64>(features * k)
    Fac mut Factors?& = null        # k-ary factors over the cells (Attach), or none
    Hid mut Hidden?& = null         # binary hidden units over the cells (Attach), or none
}

# ---- factors over several cells ----

# Count factors of Arity cells each (cells of a K-valued model of Cells cells), factor q's cells At[q Arity ..], its
# table Table[q] of Tables tables, each K^Arity energies indexed by the cells' values in order (the first the most
# significant): a not-all-equal clause, a parity, any rule over a few cells. Index() after At and Table are set; G is
# PseudoGrad's gradient for T
type Factors struct(k I64, arity I64, tables I64, count I64, cells I64) {
    K I64 = k
    Arity I64 = arity
    Tables I64 = tables
    Count I64 = count
    Cells I64 = cells
    Size I64 = powOf(k, arity)
    At mut Array<I64>& = Array<I64>(count * arity)
    Table mut Array<I64>& = Array<I64>(count)
    T mut Array<F64>& = Array<F64>(tables * powOf(k, arity))
    G mut Array<F64>& = Array<F64>(tables * powOf(k, arity))
    ptr mut Array<I64>& = Array<I64>(cells + 1)     # cell i's (factor, slot)s: fid / slot[ptr[i] .. ptr[i + 1]]
    fid mut Array<I64>& = Array<I64>(count * arity)
    slot mut Array<I64>& = Array<I64>(count * arity)
}

fn powOf(k I64, n I64) I64 {
    p I64 = 1
    for _ in range n: p *= k
    return p
}

# each cell's factors and its slot in each (after At is set)
fn (f mut Factors&) Index() {
    for i in range f.Cells + 1: f.ptr[i] = 0
    for e in range f.Count * f.Arity: f.ptr[f.At[e] + 1] += 1
    for i in range f.Cells: f.ptr[i + 1] += f.ptr[i]
    next := Array<I64>(f.Cells)
    for i in range f.Cells: next[i] = f.ptr[i]
    for q in range f.Count {
        for a in range f.Arity {
            c := f.At[q * f.Arity + a]
            f.fid[next[c]] = q
            f.slot[next[c]] = a
            next[c] += 1
        }
    }
}

# factor q's table entry with its cells at x[xo ..] but slot a's set to v
fn (f Factors&) entry(q I64, a I64, v I64, x Array<I32>&, xo I64) I64 {
    idx I64 = 0
    for b in range f.Arity: idx = idx * f.K + (v if b == a else I64(x[xo + f.At[q * f.Arity + b]]))
    return f.Table[q] * f.Size + idx
}

# ---- hidden units ----

# Units binary hidden units, each joined to Arity cells (unit j's at At[j Arity ..]) and of one of Types types: with
# h_j in {0, 1} the energy adds -h_j a_j, a_j = C[t] + sum over its slots s of H[(t Arity + s) K + x_cell]. Given the
# cells the units are independent (P(h_j = 1) = sigmoid(a_j / T)); given the units the cells couple only through the
# pairs and factors - so a sweep draws every unit, then the cells (block Gibbs). Summed out (T 1), a unit adds
# -softplus(a_j) to the cells' energy: what Energy and PseudoGrad use. Index() after At is set; GH and GC PseudoGrad's
# gradients
type Hidden struct(k I64, arity I64, types I64, units I64, cells I64) {
    K I64 = k
    Arity I64 = arity
    Types I64 = types
    Units I64 = units
    Cells I64 = cells
    At mut Array<I64>& = Array<I64>(units * arity)
    Type mut Array<I64>& = Array<I64>(units)
    H mut Array<F64>& = Array<F64>(types * arity * k)
    C mut Array<F64>& = Array<F64>(types)
    GH mut Array<F64>& = Array<F64>(types * arity * k)
    GC mut Array<F64>& = Array<F64>(types)
    ptr mut Array<I64>& = Array<I64>(cells + 1)
    uid mut Array<I64>& = Array<I64>(units * arity)
    slot mut Array<I64>& = Array<I64>(units * arity)
}

fn (h mut Hidden&) Index() {
    for i in range h.Cells + 1: h.ptr[i] = 0
    for e in range h.Units * h.Arity: h.ptr[h.At[e] + 1] += 1
    for i in range h.Cells: h.ptr[i + 1] += h.ptr[i]
    next := Array<I64>(h.Cells)
    for i in range h.Cells: next[i] = h.ptr[i]
    for j in range h.Units {
        for a in range h.Arity {
            c := h.At[j * h.Arity + a]
            h.uid[next[c]] = j
            h.slot[next[c]] = a
            next[c] += 1
        }
    }
}

# unit j's input a_j with its cells at x[xo ..]
fn (h Hidden&) input(j I64, x Array<I32>&, xo I64) F64 {
    t := h.Type[j]
    a := h.C[t]
    for s in range h.Arity: a += h.H[(t * h.Arity + s) * h.K + I64(x[xo + h.At[j * h.Arity + s]])]
    return a
}

fn softplus(a F64) F64 { return a + (-a).Exp().Log1p() if a > 0.0 else a.Exp().Log1p() }

fn sigmoid(a F64) F64 { return 1.0 / (1.0 + (-a).Exp()) }

# the graph-colouring rule as an energy (no features): an edge of equal values costs 1
fn Potts.Colouring(k I64) Potts {
    m := Potts(k, 1)
    for a in range k: m.W[a * k + a] = 1.0
    return m
}

# cell i's local energies into L[lo .. lo + K]: its unary term and its edges' pairs, the neighbours at x[xo + u]
fn (m Potts&) Local(e message.Edges&, f Array<F64>&, x Array<I32>&, xo I64, i I64, L mut Array<F64>&, lo I64) {
    k := m.K
    for c in range k: L[lo + c] = 0.0
    for q in range m.Features {
        v := f[i * m.Features + q]
        if v == 0.0: continue
        for c in range k: L[lo + c] += v * m.B[q * k + c]
    }
    for a in range e.First(i), e.First(i + 1) {
        w := F64(e.Weight(a))
        col := I64(x[xo + e.Source(a)])
        for c in range k: L[lo + c] += w * m.W[c * k + col]
    }
    if m.Fac != null {
        fc := m.Fac!
        for r in range fc.ptr[i], fc.ptr[i + 1] {
            for c in range k: L[lo + c] += fc.T[fc.entry(fc.fid[r], fc.slot[r], c, x, xo)]
        }
    }
    if m.Hid != null {
        h := m.Hid!
        for r in range h.ptr[i], h.ptr[i + 1] {
            j, sl := h.uid[r], h.slot[r]
            row := (h.Type[j] * h.Arity + sl) * k
            rest := h.input(j, x, xo) - h.H[row + I64(x[xo + i])]
            for c in range k: L[lo + c] -= softplus(rest + h.H[row + c])
        }
    }
}

# the energy of the assignment x[xo .. xo + cells] (with hidden units, its free energy: the units summed out at T 1)
fn (m Potts&) Energy(e message.Edges&, f Array<F64>&, x Array<I32>&, xo I64) F64 {
    k := m.K
    total F64 = 0.0
    for i in range e.Nodes {
        xi := I64(x[xo + i])
        for q in range m.Features: total += f[i * m.Features + q] * m.B[q * k + xi]
        for a in range e.First(i), e.First(i + 1): total += 0.5 * F64(e.Weight(a)) * m.W[xi * k + I64(x[xo + e.Source(a)])]
    }
    if m.Fac != null {
        fc := m.Fac!
        for q in range fc.Count: total += fc.T[fc.entry(q, -1, 0, x, xo)]
    }
    if m.Hid != null {
        h := m.Hid!
        for j in range h.Units: total -= softplus(h.input(j, x, xo))
    }
    return total
}

# the pseudolikelihood's negative log at the answer y (cells long): summed over the cells, returned; its gradient
# added to gw (K x K) and gb (features x K). L is scratch of K
fn (m Potts&) PseudoGrad(e message.Edges&, f Array<F64>&, y Array<I32>&, gw mut Array<F64>&, gb mut Array<F64>&, L mut Array<F64>&) F64 {
    k := m.K
    nll F64 = 0.0
    for i in range e.Nodes {
        m.Local(e, f, y, 0, i, L, 0)
        low := L[0]
        for c in range 1, k: low = low.Min(L[c])
        z F64 = 0.0
        for c in range k: z += (low - L[c]).Exp()
        yi := I64(y[i])
        nll += L[yi] - low + z.Log()
        for c in range k: L[c] = (1.0 if c == yi else 0.0) - (low - L[c]).Exp() / z      # dNLL / dL_c
        for q in range m.Features {
            fv := f[i * m.Features + q]
            if fv == 0.0: continue
            for c in range k: gb[q * k + c] += L[c] * fv
        }
        for a in range e.First(i), e.First(i + 1) {
            w := F64(e.Weight(a))
            col := I64(y[e.Source(a)])
            for c in range k: gw[c * k + col] += L[c] * w
        }
        if m.Fac != null {
            fc := m.Fac!
            for r in range fc.ptr[i], fc.ptr[i + 1] {
                for c in range k: fc.G[fc.entry(fc.fid[r], fc.slot[r], c, y, 0)] += L[c]
            }
        }
        if m.Hid != null: m.hiddenGrad(m.Hid!, y, i, L)
    }
    return nll
}

# cell i's hidden units' part of the gradient, g (in L) dNLL / dL_c: L_c holds -softplus(a_j(c)) for each unit j
# of the cell, a_j(c) its input with the cell at c - so each of a_j(c)'s terms gets -g_c sigmoid(a_j(c))
fn (m Potts&) hiddenGrad(h mut Hidden&, y Array<I32>&, i I64, g Array<F64>&) {
    k := m.K
    for r in range h.ptr[i], h.ptr[i + 1] {
        j, sl := h.uid[r], h.slot[r]
        t := h.Type[j]
        row := (t * h.Arity + sl) * k
        rest := h.input(j, y, 0) - h.H[row + I64(y[i])]
        for c in range k {
            d := -g[c] * sigmoid(rest + h.H[row + c])
            h.GC[t] += d
            h.GH[row + c] += d
            for s2 in range h.Arity {
                if s2 == sl: continue
                h.GH[(t * h.Arity + s2) * k + I64(y[h.At[j * h.Arity + s2]])] += d
            }
        }
    }
}

# a gradient of W made symmetric: each pair's two entries replaced by their mean (a W kept symmetric stays so)
fn Symmetric(gw mut Array<F64>&, k I64) {
    for a in range k {
        for b in range a + 1, k {
            s := 0.5 * (gw[a * k + b] + gw[b * k + a])
            gw[a * k + b] = s
            gw[b * k + a] = s
        }
    }
}

# the common cell features of a constraint problem, k + 2 a cell into out: a one-hot of the cell's clue (its value,
# or the slot k where clues[i] < 0: none), then its degree / 4 (a cell's neighbours' weight in its energy). A Potts
# of ClueFeatureCount(k) features over them has B's rows k + 1 per-clue unary tables and a per-value degree term
fn ClueFeatures(e message.Edges&, clues Array<I32>&, k I64, out mut Array<F64>&) {
    w := k + 2
    for i in range e.Nodes {
        for q in range w: out[i * w + q] = 0.0
        c := I64(clues[i])
        out[i * w + (c if c >= 0 else k)] = 1.0
        out[i * w + k + 1] = F64(e.Degree(i)) / 4.0
    }
}

fn ClueFeatureCount(k I64) I64 { return k + 2 }

# pseudolikelihood fitting by Adam: Add each example of a batch (a graph, its cells' features, a known answer), then
# Step - the mean gradient over the batch's cells taken, W's made symmetric where Symmetrize, one Adam step at rate;
# Loss the batch's mean negative log-pseudolikelihood a cell. The factor tables and hidden units the model has when
# the Fitter is made are fitted too
type Fitter struct(m mut Potts&) {
    M mut Potts& = m
    Symmetrize Bool = true
    Loss F64 = 0.0
    Steps I64 = 0
    gw mut Array<F64>& = Array<F64>(m.K * m.K)
    gb mut Array<F64>& = Array<F64>(m.Features * m.K)
    mw mut Array<F64>& = Array<F64>(m.K * m.K)
    vw mut Array<F64>& = Array<F64>(m.K * m.K)
    mb mut Array<F64>& = Array<F64>(m.Features * m.K)
    vb mut Array<F64>& = Array<F64>(m.Features * m.K)
    L mut Array<F64>& = Array<F64>(m.K)
    mt mut Array<F64>& = Array<F64>(m.Fac!.T.Len() if m.Fac != null else 0)    # Adam's moments of the factor tables
    vt mut Array<F64>& = Array<F64>(m.Fac!.T.Len() if m.Fac != null else 0)
    mh mut Array<F64>& = Array<F64>(m.Hid!.H.Len() if m.Hid != null else 0)    # and of the hidden units' tables
    vh mut Array<F64>& = Array<F64>(m.Hid!.H.Len() if m.Hid != null else 0)
    mc mut Array<F64>& = Array<F64>(m.Hid!.C.Len() if m.Hid != null else 0)
    vc mut Array<F64>& = Array<F64>(m.Hid!.C.Len() if m.Hid != null else 0)
    nll F64 = 0.0
    cells I64 = 0
}

fn (t mut Fitter&) Add(e message.Edges&, f Array<F64>&, y Array<I32>&) {
    t.nll += t.M.PseudoGrad(e, f, y, t.gw, t.gb, t.L)
    t.cells += e.Nodes
}

# a contrast of statistics: the mean over the chains of a (chains a, cells e.Nodes each, from x a's 0) less the mean
# over the chains of b, times scale - the gradient a contrastive rule steps along (data less samples, or a nudged phase
# less another). Counted as e's cells, as Add's examples are
fn (t mut Fitter&) AddContrast(e message.Edges&, f Array<F64>&, xa Array<I32>&, a I64, xb Array<I32>&, b I64, scale F64) {
    n := e.Nodes
    for c in range a: t.M.Stats(e, f, xa, c * n, scale / F64(a), t.gw, t.gb)
    for c in range b: t.M.Stats(e, f, xb, c * n, -scale / F64(b), t.gw, t.gb)
    t.cells += n
}

# contrastive divergence on one example (graph, features, answer y): every chain of s started at y (fromData) or
# uniformly at random, k Gibbs sweeps at T 1 (block Gibbs with hidden units), the answer's statistics less the chains'.
# With persist the chains go on from where the last call left them (persistent CD: s kept a graph's own, Start once)
fn (t mut Fitter&) CD(e message.Edges&, f Array<F64>&, y Array<I32>&, s mut Sampler&, k I64, fromData Bool = true, persist Bool = false, r mut rand.Rand& = rand.Rand(1)) {
    n := e.Nodes
    if not persist {
        if fromData {
            for c in range s.Chains {
                for i in range n: s.X[c * n + i] = y[i]
            }
        } else {
            s.Start(r)
        }
    }
    s.Anneal(t.M, e, f, Schedule(k, 1.0, 1.0, -1.0, 0))
    t.AddContrast(e, f, y, 1, s.X, s.Chains, 1.0)
}

# equilibrium propagation's contrast on one example: a free phase of k sweeps at T 1 from random starts, then from
# its end two nudged phases of kn sweeps each with every cell's energy lowered by beta at its answer's value (+beta)
# and raised by it (-beta); the gradient is the two nudged phases' statistics' difference over 2 beta. s.Bias is used
# and left empty
fn (t mut Fitter&) EP(e message.Edges&, f Array<F64>&, y Array<I32>&, s mut Sampler&, k I64, kn I64, beta F64, r mut rand.Rand&) {
    n, kk := e.Nodes, t.M.K
    s.Start(r)
    s.Bias = Array<F64>(0)
    s.Anneal(t.M, e, f, Schedule(k, 1.0, 1.0, -1.0, 0))
    free := Array<I32>(s.X.Len())
    for i in range free.Len(): free[i] = s.X[i]
    plus := Array<I32>(s.X.Len())
    s.Bias = Array<F64>(n * kk)
    for sign in Array<F64>[1.0, -1.0] {
        for i in range n: s.Bias[i * kk + I64(y[i])] = -sign * beta
        for i in range free.Len(): s.X[i] = free[i]
        s.Anneal(t.M, e, f, Schedule(kn, 1.0, 1.0, -1.0, 0))
        if sign > 0.0 {
            for i in range plus.Len(): plus[i] = s.X[i]
        }
    }
    s.Bias = Array<F64>(0)
    t.AddContrast(e, f, plus, s.Chains, s.X, s.Chains, 1.0 / (2.0 * beta))
}

fn (t mut Fitter&) Step(rate F64) F64 {
    if t.cells == 0: return 0.0
    if t.Symmetrize: Symmetric(t.gw, t.M.K)
    t.Steps++
    n := F64(t.cells)
    adam(t.M.W, t.gw, t.mw, t.vw, n, rate, t.Steps)
    adam(t.M.B, t.gb, t.mb, t.vb, n, rate, t.Steps)
    if t.M.Fac != null: adam(t.M.Fac!.T, t.M.Fac!.G, t.mt, t.vt, n, rate, t.Steps)
    if t.M.Hid != null {
        adam(t.M.Hid!.H, t.M.Hid!.GH, t.mh, t.vh, n, rate, t.Steps)
        adam(t.M.Hid!.C, t.M.Hid!.GC, t.mc, t.vc, n, rate, t.Steps)
    }
    t.Loss = t.nll / n
    t.nll, t.cells = 0.0, 0
    return t.Loss
}

# one Adam step on p from the summed gradient g over n cells (g cleared)
fn adam(p mut Array<F64>&, g mut Array<F64>&, m mut Array<F64>&, v mut Array<F64>&, n F64, rate F64, step I64) {
    c1 := 1.0 - 0.9.Pow(F64(step))
    c2 := 1.0 - 0.999.Pow(F64(step))
    for i in range p.Len() {
        gi := g[i] / n
        m[i] = 0.9 * m[i] + 0.1 * gi
        v[i] = 0.999 * v[i] + 0.001 * gi * gi
        p[i] -= rate * (m[i] / c1) / ((v[i] / c2).Sqrt() + 1e-8)
        g[i] = 0.0
    }
}

# ---- local learning: statistics at assignments ----

# the energy's derivative for every table at the assignment x[xo ..] (the hidden units summed out), added times scale
# into gw, gb and the factors' and units' gradients (G, GH, GC): for the pairs half an edge's weight at its two values
# (each pair's edges come both ways), for B the cell's features at its value, for a factor 1 at its entry, for a unit
# -sigmoid(a) at C and at each of its slots' values. A table entry sees only the cells it joins: contrasting this at
# data against it at samples is a local rule (contrastive Hebbian or Boltzmann learning)
fn (m Potts&) Stats(e message.Edges&, f Array<F64>&, x Array<I32>&, xo I64, scale F64, gw mut Array<F64>&, gb mut Array<F64>&) {
    k := m.K
    for i in range e.Nodes {
        xi := I64(x[xo + i])
        for q in range m.Features {
            fv := f[i * m.Features + q]
            if fv != 0.0: gb[q * k + xi] += scale * fv
        }
        for a in range e.First(i), e.First(i + 1): gw[xi * k + I64(x[xo + e.Source(a)])] += scale * 0.5 * F64(e.Weight(a))
    }
    if m.Fac != null {
        fc := m.Fac!
        for q in range fc.Count: fc.G[fc.entry(q, -1, 0, x, xo)] += scale
    }
    if m.Hid != null {
        h := m.Hid!
        for j in range h.Units {
            t := h.Type[j]
            d := -scale * sigmoid(h.input(j, x, xo))
            h.GC[t] += d
            for sl in range h.Arity: h.GH[(t * h.Arity + sl) * k + I64(x[xo + h.At[j * h.Arity + sl]])] += d
        }
    }
}

# how a search anneals: Sweeps sweeps at T falling geometrically from T0 to T1, then zero-temperature sweeps until
# no cell moves (at most Polish); a chain stops once a sweep at T <= Tstop moves nothing
type Schedule struct(Sweeps I64 = 200, T0 F64 = 2.0, T1 F64 = 0.05, Tstop F64 = 0.1, Polish I64 = 50) {
    Sweeps
    T0
    T1
    Tstop
    Polish
}

# sweep s's temperature (0 past the annealing)
fn (s Schedule&) At(sweep I64) F64 {
    if sweep >= s.Sweeps: return 0.0
    return s.T0 * (s.T1 / s.T0).Pow(F64(sweep) / F64((s.Sweeps - 1).Max(1)))
}

# Chains chains over a graph of cells cells: their assignments X (chain c's at c cells), each chain's sweeps run and
# energy at its end, the graph's colour classes
type Sampler struct(cells I64, chains I64, k I64, threads I64 = 1) {
    Cells I64 = cells
    Chains I64 = chains
    K I64 = k
    Threads I64 = threads if threads > 0 else 1
    X mut Array<I32>& = Array<I32>(chains * cells)
    Bias mut Array<F64>& = Array<F64>(0)               # cells x K energies added to every chain's unary terms (empty: none) - a nudge
    Sweeps mut Array<I64>& = Array<I64>(chains)
    Energies mut Array<F64>& = Array<F64>(chains)
    Left mut Array<I64>& = Array<I64>(chains)          # Focus: each chain's constraints left above their lowest energy
    order mut Array<I64>& = Array<I64>(cells)          # the cells by colour class
    classes mut Array<I64>& = Array<I64>(cells + 1)    # class q's cells: order[classes[q] .. classes[q + 1]]
    Colours I64 = 0
    seeds mut Array<U64>& = Array<U64>(chains)         # each chain's generator (xorshift)
    theta mut Array<F64>& = Array<F64>(0)              # Langevin's logits, chains x cells x K
    unary mut Array<F64>& = Array<F64>(cells * k)      # each cell's unary energies, made once a search
    lfield mut Array<F32>& = Array<F32>((chains + Lanes - 1) / Lanes * Lanes * cells * k)   # the same, chains in lanes
    lx mut Array<I32>& = Array<I32>((chains + Lanes - 1) / Lanes * Lanes * cells)         # the assignments, chains in lanes
    lscratch mut Array<F32>& = Array<F32>((chains + Lanes - 1) / Lanes * k * Lanes)
    w32 mut Array<F32>& = Array<F32>(k * k)
}

# a greedy colouring of e's graph (each cell the lowest colour no neighbour has, in order of falling degree): the
# classes a sweep takes in turn
fn (s mut Sampler&) Colour(e message.Edges&) { s.ColourFor(e, Potts(1, 0)) }

# the same where m has factors: cells sharing a factor are neighbours too (they must not be drawn at once)
fn (s mut Sampler&) ColourFor(e message.Edges&, m Potts&) {
    n := s.Cells
    colour := Array<I64>(n, -1)
    byDegree := Array<I64>(n)
    for i in range n: byDegree[i] = i
    byDegree.Sort(fn(a, b): return e.Degree(a) > e.Degree(b) or (e.Degree(a) == e.Degree(b) and a < b))
    used := Array<Bool>(n + 1)
    most I64 = 0
    for i in byDegree {
        mark(e, m, i, colour, used, true)
        c I64 = 0
        for used[c]: c++
        colour[i] = c
        most = most.Max(c + 1)
        mark(e, m, i, colour, used, false)
    }
    s.Colours = most
    for q in range most + 1: s.classes[q] = 0
    for i in range n: s.classes[colour[i] + 1] += 1
    for q in range most: s.classes[q + 1] += s.classes[q]
    next := Array<I64>(most)
    for q in range most: next[q] = s.classes[q]
    for i in range n {
        s.order[next[colour[i]]] = i
        next[colour[i]] += 1
    }
}

# the colours of cell i's neighbours (by edge, and by a shared factor) set in used, or cleared
fn mark(e message.Edges&, m Potts&, i I64, colour Array<I64>&, used mut Array<Bool>&, on Bool) {
    for a in range e.First(i), e.First(i + 1) {
        c := colour[e.Source(a)]
        if c >= 0: used[c] = on
    }
    if m.Fac == null: return
    f := m.Fac!
    for r in range f.ptr[i], f.ptr[i + 1] {
        q := f.fid[r]
        for b in range f.Arity {
            c := colour[f.At[q * f.Arity + b]]
            if c >= 0: used[c] = on
        }
    }
}

# every chain's generator seeded from r, and its assignment drawn uniformly
fn (s mut Sampler&) Start(r mut rand.Rand&) {
    for c in range s.Chains: s.seeds[c] = r.Next() | 1
    for c in range s.Chains {
        for i in range s.Cells: s.X[c * s.Cells + i] = I32(nextBelow(s.seeds, c, s.K))
    }
}

# chain c's generator: xorshift64*, a uniform in [0, 1)
fn nextUniform(seeds mut Array<U64>&, c I64) F64 {
    x := seeds[c]
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    seeds[c] = x
    return F64((x * 2685821657736338717) >> 11) / 9007199254740992.0
}

fn nextBelow(seeds mut Array<U64>&, c I64, n I64) I64 { return I64(nextUniform(seeds, c) * F64(n)).Min(n - 1) }

# every chain annealed by Gibbs sweeps over the colour classes as sched says (after Colour and Start): X holds each
# chain's answer, Energies its energy, Sweeps its sweeps. The edges must come both ways with one weight
fn (s mut Sampler&) Anneal(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule) {
    k := s.K
    for i in range s.Cells {
        for v in range k: s.unary[i * k + v] = 0.0
        for q in range m.Features {
            fv := f[i * m.Features + q]
            if fv == 0.0: continue
            for v in range k: s.unary[i * k + v] += fv * m.B[q * k + v]
        }
        if s.Bias.Len() > 0 {
            for v in range k: s.unary[i * k + v] += s.Bias[i * k + v]
        }
    }
    for i in range k * k: s.w32[i] = F32(m.W[i])
    groups := (s.Chains + Lanes - 1) / Lanes
    tasks := s.Threads.Min(groups)
    if tasks <= 1 {
        for g in range groups: s.group(m, e, f, sched, g)
        return
    }
    share := (groups + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo := t * share
            hi := (lo + share).Min(groups)
            if lo < hi: spawn s.groups(m, e, f, sched, lo, hi)
        }
    }
}

fn (s mut Sampler&) groups(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule, g0 I64, g1 I64) {
    for g in range g0, g1: s.group(m, e, f, sched, g)
}

# the chains a sweep takes in step, one to a vector lane
Lanes I64 = 16

# chains g Lanes .. (g + 1) Lanes - 1 swept in step: every cell's local energies, draws and moves computed for all of
# them at once, a lane each (F32), a stopped chain's lane left as it is; a group's chains past Chains are run and
# dropped. Each chain draws from its own generator, so its answer does not depend on how the chains are grouped
# over tasks
fn (s mut Sampler&) group(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule, g I64) {
    k, n := s.K, s.Cells
    fo := g * n * k * Lanes
    xo := g * n * Lanes
    lo := g * k * Lanes
    field, X, L, unary, order, W := s.lfield, s.lx, s.lscratch, s.unary, s.order, s.w32
    seeds := Array<U64>(Lanes)
    for l in range Lanes: seeds[l] = s.seeds[(g * Lanes + l).Min(s.Chains - 1)] ^ U64(l + 1)
    for l in range Lanes {
        c := g * Lanes + l
        for i in range n: X[xo + i * Lanes + l] = s.X[c * n + i] if c < s.Chains else I32(0)
    }
    for x in range n * k * Lanes: field[fo + x] = 0.0
    for i in range n {
        for a in range e.First(i), e.First(i + 1) {
            w := F32(e.Weight(a))
            u := e.Source(a)
            for v in range k {
                at := fo + (i * k + v) * Lanes
                for l in range Lanes: field[at + l] += w * W[v * k + I64(X[xo + u * Lanes + l])]
            }
        }
    }
    stopped := Array<Bool>(Lanes)
    moved := Array<I64>(Lanes)
    pick := Array<I64>(Lanes)
    low, z, u := Array<F32>(Lanes), Array<F32>(Lanes), Array<F32>(Lanes)
    D := Array<F32>(k * Lanes)
    sweeps := Array<I64>(Lanes, sched.Sweeps + sched.Polish)
    part := Array<I64>(Lanes)
    units := m.Hid!.Units if m.Hid != null else 0
    hl := Array<F32>(units * Lanes)
    for sweep in range sched.Sweeps + sched.Polish {
        t := sched.At(sweep)
        for l in range Lanes: moved[l] = 0
        if units > 0: drawUnits(m.Hid!, X, xo, hl, F32(t), u, seeds)
        for at in range n {
            i := order[at]
            for v in range k {
                for l in range Lanes: L[lo + v * Lanes + l] = F32(unary[i * k + v]) + field[fo + (i * k + v) * Lanes + l]
            }
            if m.Fac != null: factorLanes(m.Fac!, i, X, xo, L, lo, part)
            if units > 0: unitLanes(m.Hid!, i, hl, L, lo)
            if t > 0.0 { drawLanes(L, lo, k, F32(1.0 / t), low, z, u, pick, seeds) } else { lowestLanes(L, lo, k, low, pick) }
            some := false
            for l in range Lanes {
                old := I64(X[xo + i * Lanes + l])
                if stopped[l]: pick[l] = old
                if pick[l] == old: continue
                some = true
                moved[l] += 1
            }
            if not some: continue
            # each lane's change of W's row, gathered once: D[x, l] = W[x, new] - W[x, old]
            for x in range k {
                for l in range Lanes: D[x * Lanes + l] = W[x * k + pick[l]] - W[x * k + I64(X[xo + i * Lanes + l])]
            }
            for a in range e.First(i), e.First(i + 1) {
                w := F32(e.Weight(a))
                at2 := fo + e.Source(a) * k * Lanes
                for x in range k * Lanes: field[at2 + x] += w * D[x]
            }
            for l in range Lanes: X[xo + i * Lanes + l] = I32(pick[l])
        }
        all := true
        for l in range Lanes {
            if not stopped[l] and moved[l] == 0 and t <= sched.Tstop {
                stopped[l] = true
                sweeps[l] = sweep + 1
            }
            all = all and stopped[l]
        }
        if all: break
    }
    for l in range Lanes {
        c := g * Lanes + l
        if c >= s.Chains: continue
        for i in range n: s.X[c * n + i] = X[xo + i * Lanes + l]
        s.Sweeps[c] = sweeps[l]
        s.Energies[c] = m.Energy(e, f, s.X, c * n)
    }
}

# cell i's factors' energies added to every lane's: each factor's table row for the lane's other cells, one entry a value
fn factorLanes(f Factors&, i I64, X Array<I32>&, xo I64, L mut Array<F32>&, lo I64, part mut Array<I64>&) {
    k := f.K
    for r in range f.ptr[i], f.ptr[i + 1] {
        q, a := f.fid[r], f.slot[r]
        stride := powOf(k, f.Arity - 1 - a)
        for l in range Lanes: part[l] = f.Table[q] * f.Size
        for b in range f.Arity {
            if b == a: continue
            sb := powOf(k, f.Arity - 1 - b)
            cell := f.At[q * f.Arity + b]
            for l in range Lanes: part[l] += I64(X[xo + cell * Lanes + l]) * sb
        }
        for v in range k {
            for l in range Lanes: L[lo + v * Lanes + l] += F32(f.T[part[l] + v * stride])
        }
    }
}

# every unit's state drawn for every lane given the lanes' cells: 1 with probability sigmoid(a / t) (t > 0), or where
# a > 0 (t = 0)
fn drawUnits(h Hidden&, X Array<I32>&, xo I64, hl mut Array<F32>&, t F32, u mut Array<F32>&, seeds mut Array<U64>&) {
    k := h.K
    for j in range h.Units {
        ty := h.Type[j]
        for l in range Lanes: hl[j * Lanes + l] = F32(h.C[ty])
        for s2 in range h.Arity {
            row := (ty * h.Arity + s2) * k
            cell := h.At[j * h.Arity + s2]
            for l in range Lanes: hl[j * Lanes + l] += F32(h.H[row + I64(X[xo + cell * Lanes + l])])
        }
        if t <= 0.0 {
            for l in range Lanes: hl[j * Lanes + l] = F32(1.0) if hl[j * Lanes + l] > 0.0 else F32(0.0)
            continue
        }
        uniformLanes(u, seeds)
        for l in range Lanes: hl[j * Lanes + l] = F32(1.0) if u[l] < 1.0 / (1.0 + elem.FastExp(-hl[j * Lanes + l] / t)) else F32(0.0)
    }
}

# the drawn units' part of cell i's energies: -h_j H[slot row, v] for each of its units
fn unitLanes(h Hidden&, i I64, hl Array<F32>&, L mut Array<F32>&, lo I64) {
    k := h.K
    for r in range h.ptr[i], h.ptr[i + 1] {
        j := h.uid[r]
        row := (h.Type[j] * h.Arity + h.slot[r]) * k
        for v in range k {
            w := F32(h.H[row + v])
            for l in range Lanes: L[lo + v * Lanes + l] -= hl[j * Lanes + l] * w
        }
    }
}

# a uniform in [0, 1) a lane, each lane's generator stepped
fn uniformLanes(u mut Array<F32>&, seeds mut Array<U64>&) {
    for l in range Lanes {
        x := seeds[l]
        x ^= x >> 12
        x ^= x << 25
        x ^= x >> 27
        seeds[l] = x
        u[l] = F32((x * 2685821657736338717) >> 40) * F32(5.9604645e-08)
    }
}

# every lane's value drawn from softmax(-L / t) (inv = 1 / t): L[lo + v Lanes + l] lane l's energies
fn drawLanes(L mut Array<F32>&, lo I64, k I64, inv F32, low mut Array<F32>&, z mut Array<F32>&, u mut Array<F32>&, pick mut Array<I64>&, seeds mut Array<U64>&) {
    for l in range Lanes: low[l] = L[lo + l]
    for v in range 1, k {
        for l in range Lanes: low[l] = low[l].Min(L[lo + v * Lanes + l])
    }
    for l in range Lanes: z[l] = 0.0
    for v in range k {
        for l in range Lanes {
            w := elem.FastExp((low[l] - L[lo + v * Lanes + l]) * inv)
            L[lo + v * Lanes + l] = w
            z[l] += w
        }
    }
    for l in range Lanes {
        x := seeds[l]
        x ^= x >> 12
        x ^= x << 25
        x ^= x >> 27
        seeds[l] = x
        u[l] = F32((x * 2685821657736338717) >> 40) * F32(5.9604645e-08) * z[l]
        pick[l] = k - 1
    }
    for v in range k - 1 {
        for l in range Lanes {
            u[l] -= L[lo + v * Lanes + l]
            pick[l] = v if u[l] <= 0.0 and pick[l] == k - 1 and v < k - 1 else pick[l]
        }
    }
}

# every lane's lowest-energy value (the first of equals)
fn lowestLanes(L Array<F32>&, lo I64, k I64, low mut Array<F32>&, pick mut Array<I64>&) {
    for l in range Lanes {
        low[l] = L[lo + l]
        pick[l] = 0
    }
    for v in range 1, k {
        for l in range Lanes {
            x := L[lo + v * Lanes + l]
            pick[l] = v if x < low[l] else pick[l]
            low[l] = x if x < low[l] else low[l]
        }
    }
}

# the value of largest theta (the first of equals)
fn largest(L Array<F64>&, lo I64, k I64) I64 {
    best I64 = 0
    for v in range 1, k {
        if L[lo + v] > L[lo + best]: best = v
    }
    return best
}

# the chain of lowest energy
fn (s Sampler&) Best() I64 {
    best I64 = 0
    for c in range 1, s.Chains {
        if s.Energies[c] < s.Energies[best]: best = c
    }
    return best
}

# how a focused search runs: at most Moves moves a chain at temperature T; with Bump > 0 every constraint (a factor, an
# edge) has a weight, 1 at the start, that grows by Bump each time the constraint is picked, and every Every moves each
# weight w becomes 1 + Decay (w - 1) (breakout / clause weighting: the energy reshaped where the search sits)
type FocusSchedule struct(Moves I64 = 100000, T F64 = 0.5, Bump F64 = 0.0, Decay F64 = 1.0, Every I64 = 1000) {
    Moves
    T
    Bump
    Decay
    Every
}

# the constraints a focused search picks from: the factors (ids 0 .. Fac.Count) and the undirected edges (ids after
# them), each cell's edge slots mapped to their edge, and each constraint's lowest energy (its table's minimum; an
# edge's W times its weight)
type focusIndex struct(nf I64, slots I64) {
    nf
    ne I64 = 0
    eid mut Array<I64>& = Array<I64>(slots)         # edge slot -> undirected edge
    eu mut Array<I64>& = Array<I64>(slots / 2 + 1)
    ev mut Array<I64>& = Array<I64>(slots / 2 + 1)
    ew mut Array<F64>& = Array<F64>(slots / 2 + 1)  # the edge's weight (its slots')
    tmin mut Array<F64>& = Array<F64>(0)            # each factor table's minimum
    wmin F64 = 0.0
    wmax F64 = 0.0
}

fn focusIndex.of(m Potts&, e message.Edges&) focusIndex {
    nf := m.Fac!.Count if m.Fac != null else 0
    x := focusIndex(nf, e.First(e.Nodes))
    for v in range e.Nodes {
        for a in range e.First(v), e.First(v + 1) {
            u := e.Source(a)
            if u >= v: continue
            x.eu[x.ne], x.ev[x.ne], x.ew[x.ne] = u, v, F64(e.Weight(a))
            x.eid[a] = x.ne
            for b in range e.First(u), e.First(u + 1) {
                if e.Source(b) == v: x.eid[b] = x.ne
            }
            x.ne++
        }
    }
    x.wmin, x.wmax = m.W[0], m.W[0]
    for i in range m.K * m.K {
        x.wmin = x.wmin.Min(m.W[i])
        x.wmax = x.wmax.Max(m.W[i])
    }
    if m.Fac != null {
        f := m.Fac!
        x.tmin = Array<F64>(f.Tables, 1e300)
        for t in range f.Tables {
            for i in range f.Size: x.tmin[t] = x.tmin[t].Min(f.T[t * f.Size + i])
        }
    }
    return x
}

# a focused heat bath on every chain (after Start; Colour is not needed): a move picks a constraint above its lowest
# energy (a violated factor or edge) at random, and draws one change of one of its cells - (cell, new value), over all
# of its cells and values - with probability ~ exp(-dE / T), dE the change of the (weighted) energy. Only cells where
# the energy can fall are touched, as WalkSAT / probSAT pick an unsatisfied clause and min-conflicts a vertex in
# conflict. A chain stops once no constraint is violated (every factor and edge at its table's minimum: for a rule
# energy, a solution) or after sched.Moves moves. Sweeps holds each chain's moves, Left its violated constraints at
# the end, Energies its (unweighted) energy. No hidden units
fn (s mut Sampler&) Focus(m Potts&, e message.Edges&, f Array<F64>&, sched FocusSchedule) {
    if m.Hid != null: unreachable "potts.Sampler.Focus: hidden units are not supported"
    k := s.K
    for i in range s.Cells {
        for v in range k: s.unary[i * k + v] = 0.0
        for q in range m.Features {
            fv := f[i * m.Features + q]
            if fv == 0.0: continue
            for v in range k: s.unary[i * k + v] += fv * m.B[q * k + v]
        }
        if s.Bias.Len() > 0 {
            for v in range k: s.unary[i * k + v] += s.Bias[i * k + v]
        }
    }
    x := focusIndex.of(m, e)
    tasks := s.Threads.Min(s.Chains)
    if tasks <= 1 {
        for c in range s.Chains: s.focusChain(m, e, f, sched, x, c)
        return
    }
    share := (s.Chains + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo := t * share
            hi := (lo + share).Min(s.Chains)
            if lo < hi: spawn s.focusChains(m, e, f, sched, x, lo, hi)
        }
    }
}

fn (s mut Sampler&) focusChains(m Potts&, e message.Edges&, f Array<F64>&, sched FocusSchedule, x focusIndex&, c0 I64, c1 I64) {
    for c in range c0, c1: s.focusChain(m, e, f, sched, x, c)
}

# constraint q's energy above its lowest, with chain c's cells at X[xo ..]; base[q A + a] is factor q's table index
# with slot a at value 0 (the other slots at their cells' values), stride[a] slot a's step - kept by focusMoved
fn focusExcess(m Potts&, x focusIndex&, base Array<I64>&, stride Array<I64>&, q I64, X Array<I32>&, xo I64) F64 {
    k := m.K
    if q < x.nf {
        fc := m.Fac!
        o := q * fc.Arity
        return fc.T[base[o] + I64(X[xo + fc.At[o]]) * stride[0]] - x.tmin[fc.Table[q]]
    }
    d := q - x.nf
    w := x.ew[d]
    low := w * x.wmin if w >= 0.0 else w * x.wmax
    return w * m.W[I64(X[xo + x.ev[d]]) * k + I64(X[xo + x.eu[d]])] - low
}

# cell i's local energies into L[lo ..] with each constraint's energy times its weight wt
fn focusLocal(m Potts&, e message.Edges&, x focusIndex&, base Array<I64>&, stride Array<I64>&, unary Array<F64>&, wt Array<F64>&, X Array<I32>&, xo I64, i I64, L mut Array<F64>&, lo I64) {
    k := m.K
    for c in range k: L[lo + c] = unary[i * k + c]
    for a in range e.First(i), e.First(i + 1) {
        w := wt[x.nf + x.eid[a]] * F64(e.Weight(a))
        col := I64(X[xo + e.Source(a)])
        for c in range k: L[lo + c] += w * m.W[c * k + col]
    }
    if m.Fac != null {
        fc := m.Fac!
        for r in range fc.ptr[i], fc.ptr[i + 1] {
            q, a := fc.fid[r], fc.slot[r]
            o, st := base[q * fc.Arity + a], stride[a]
            for c in range k: L[lo + c] += wt[q] * fc.T[o + c * st]
        }
    }
}

fn (s mut Sampler&) focusChain(m Potts&, e message.Edges&, f Array<F64>&, sched FocusSchedule, x focusIndex&, c I64) {
    n, k := s.Cells, s.K
    xo := c * n
    X := s.X
    nc := x.nf + x.ne
    eps := 1e-9
    wt := Array<F64>(nc, 1.0)
    base, stride := focusBase(m, X, xo)
    viol := Array<I64>(nc)
    pos := Array<I64>(nc, -1)
    nv I64 = 0
    for q in range nc {
        if focusExcess(m, x, base, stride, q, X, xo) > eps {
            pos[q] = nv
            viol[nv] = q
            nv++
        }
    }
    arity := m.Fac!.Arity if m.Fac != null else 2
    cells := Array<I64>(arity.Max(2))
    L := Array<F64>(arity.Max(2) * k)
    ci, cv := Array<I64>(arity.Max(2) * k), Array<I64>(arity.Max(2) * k)
    cw := Array<F64>(arity.Max(2) * k)
    moves I64 = 0
    for moves < sched.Moves and nv > 0 {
        if sched.Bump > 0.0 and sched.Decay < 1.0 and moves > 0 and moves % sched.Every == 0 {
            for q in range nc: wt[q] = 1.0 + sched.Decay * (wt[q] - 1.0)
        }
        q := viol[nextBelow(s.seeds, c, nv)]
        if sched.Bump > 0.0: wt[q] += sched.Bump
        nq I64 = 0
        if q < x.nf {
            fc := m.Fac!
            for a in range fc.Arity: cells[a] = fc.At[q * fc.Arity + a]
            nq = fc.Arity
        } else {
            cells[0], cells[1] = x.eu[q - x.nf], x.ev[q - x.nf]
            nq = 2
        }
        # every (cell, new value) of the constraint, weighted exp(-dE / T)
        cand I64 = 0
        low := 1e300
        for a in range nq {
            i := cells[a]
            focusLocal(m, e, x, base, stride, s.unary, wt, X, xo, i, L, a * k)
            old := I64(X[xo + i])
            for v in range k {
                if v == old: continue
                ci[cand], cv[cand], cw[cand] = i, v, L[a * k + v] - L[a * k + old]
                low = low.Min(cw[cand])
                cand++
            }
        }
        z F64 = 0.0
        for j in range cand {
            cw[j] = ((low - cw[j]) / sched.T).Exp()
            z += cw[j]
        }
        u := nextUniform(s.seeds, c) * z
        pick := cand - 1
        for j in range cand - 1 {
            u -= cw[j]
            if u <= 0.0 {
                pick = j
                break
            }
        }
        i := ci[pick]
        focusMoved(m, base, stride, i, cv[pick] - I64(X[xo + i]))
        X[xo + i] = I32(cv[pick])
        moves++
        # the constraints of the moved cell: in or out of the violated set
        for a in range e.First(i), e.First(i + 1) {
            r := x.nf + x.eid[a]
            nv = focusRecheck(m, x, base, stride, r, X, xo, viol, pos, nv, eps)
        }
        if m.Fac != null {
            fc := m.Fac!
            for r in range fc.ptr[i], fc.ptr[i + 1]: nv = focusRecheck(m, x, base, stride, fc.fid[r], X, xo, viol, pos, nv, eps)
        }
    }
    s.Sweeps[c] = moves
    s.Left[c] = nv
    s.Energies[c] = m.Energy(e, f, X, xo)
}

# every factor's table index with each slot open (base) and the slots' steps (stride), at chain X[xo ..]: a cell's
# local energies then read one entry a value, with no walk over the factor's other cells
fn focusBase(m Potts&, X Array<I32>&, xo I64) Array<I64>, Array<I64> {
    if m.Fac == null: return Array<I64>(0), Array<I64>(0)
    fc := m.Fac!
    base, stride := Array<I64>(fc.Count * fc.Arity), Array<I64>(fc.Arity)
    for a in range fc.Arity: stride[a] = powOf(fc.K, fc.Arity - 1 - a)
    for q in range fc.Count {
        for a in range fc.Arity: base[q * fc.Arity + a] = fc.entry(q, a, 0, X, xo)
    }
    return base, stride
}

# cell i moved by d values: its factors' open indices for the other slots shift by d steps of i's slot
fn focusMoved(m Potts&, base mut Array<I64>&, stride Array<I64>&, i I64, d I64) {
    if m.Fac == null: return
    fc := m.Fac!
    for r in range fc.ptr[i], fc.ptr[i + 1] {
        o, a := fc.fid[r] * fc.Arity, fc.slot[r]
        step := d * stride[a]
        for b in range fc.Arity: base[o + b] += step if b != a else 0
    }
}

fn focusRecheck(m Potts&, x focusIndex&, base Array<I64>&, stride Array<I64>&, q I64, X Array<I32>&, xo I64, viol mut Array<I64>&, pos mut Array<I64>&, nv I64, eps F64) I64 {
    bad := focusExcess(m, x, base, stride, q, X, xo) > eps
    if bad and pos[q] < 0 {
        pos[q] = nv
        viol[nv] = q
        return nv + 1
    }
    if not bad and pos[q] >= 0 {
        last := viol[nv - 1]
        viol[pos[q]] = last
        pos[last] = pos[q]
        pos[q] = -1
        return nv - 1
    }
    return nv
}

# the relaxed search: each chain's cells as softmax(theta) over their K values (theta drawn small at random), steps
# steps of theta -= rate dE/dtheta + sqrt(2 rate T) noise on the relaxed energy (each cell's expected local energy
# against its neighbours' distributions), T annealed by sched's first Sweeps; X then each cell's most likely value,
# Energies its energy (after Colour and Start)
fn (s mut Sampler&) Langevin(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule, rate F64) {
    k := s.K
    n := s.Cells
    if s.theta.Len() < s.Chains * n * k: s.theta = Array<F64>(s.Chains * n * k)
    tasks := s.Threads.Min(s.Chains)
    share := (s.Chains + tasks - 1) / tasks
    join {
        for t in range tasks {
            lo := t * share
            hi := (lo + share).Min(s.Chains)
            if lo < hi: spawn s.relaxChains(m, e, f, sched, rate, lo, hi)
        }
    }
}

fn (s mut Sampler&) relaxChains(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule, rate F64, c0 I64, c1 I64) {
    for c in range c0, c1: s.relax(m, e, f, sched, rate, c)
}

fn (s mut Sampler&) relax(m Potts&, e message.Edges&, f Array<F64>&, sched Schedule, rate F64, c I64) {
    k := s.K
    n := s.Cells
    base := c * n * k
    for i in range n * k: s.theta[base + i] = 0.1 * (nextUniform(s.seeds, c) - 0.5)
    p := Array<F64>(n * k)
    g := Array<F64>(k)
    for step in range sched.Sweeps {
        t := sched.At(step)
        softmaxAll(s.theta, base, p, n, k)
        for at in range n {
            i := s.order[at]
            # dE/dp_i: the unary term and each edge's neighbour distribution through W
            for v in range k: g[v] = 0.0
            for q in range m.Features {
                fv := f[i * m.Features + q]
                if fv == 0.0: continue
                for v in range k: g[v] += fv * m.B[q * k + v]
            }
            for a in range e.First(i), e.First(i + 1) {
                w := F64(e.Weight(a))
                u := e.Source(a)
                for v in range k {
                    sum F64 = 0.0
                    for x in range k: sum += m.W[v * k + x] * p[u * k + x]
                    g[v] += w * sum
                }
            }
            # through the softmax: dE/dtheta_v = p_v (g_v - p . g)
            mean F64 = 0.0
            for v in range k: mean += p[i * k + v] * g[v]
            noise := (2.0 * rate * t).Sqrt()
            for v in range k {
                gauss := (nextUniform(s.seeds, c) + nextUniform(s.seeds, c) + nextUniform(s.seeds, c) - 1.5) * 2.0
                s.theta[base + i * k + v] -= rate * p[i * k + v] * (g[v] - mean) - noise * gauss
            }
        }
    }
    for i in range n: s.X[c * n + i] = I32(largest(s.theta, base + i * k, k))
    s.Sweeps[c] = sched.Sweeps
    s.Energies[c] = m.Energy(e, f, s.X, c * n)
}

# each cell's softmax of theta[base + i K ..] into p
fn softmaxAll(theta Array<F64>&, base I64, p mut Array<F64>&, n I64, k I64) {
    for i in range n {
        top := theta[base + i * k]
        for v in range 1, k: top = top.Max(theta[base + i * k + v])
        z F64 = 0.0
        for v in range k {
            p[i * k + v] = (theta[base + i * k + v] - top).Exp()
            z += p[i * k + v]
        }
        for v in range k: p[i * k + v] /= z
    }
}

assert not Potts.PseudoGrad.Allocates, "a pseudolikelihood gradient allocates"

# ---- tests ----

# a planted k-colourable graph of n cells: each cell joined to `links` others of another colour, both ways; its
# planted colours
fn planted(n I64, k I64, links I64, r mut rand.Rand&) message.Edges, Array<I32> {
    colour := Array<I32>(n)
    for i in range n: colour[i] = I32(r.Below(k))
    src, dst := Array<I32>(2 * n * links), Array<I32>(2 * n * links)
    count I64 = 0
    for i in range n {
        for _ in range links {
            j := r.Below(n)
            if j == i or colour[j] == colour[i]: continue
            src[count], dst[count] = I32(i), I32(j)
            src[count + 1], dst[count + 1] = I32(j), I32(i)
            count += 2
        }
    }
    e := message.Edges(n, 2 * n * links)
    e.Set(src, dst, count)
    return e, colour
}

test Sampler.Anneal "annealed chromatic Gibbs over many chains finds a proper colouring of a planted 3-colourable graph; the chains do not depend on the thread count" {
    r := rand.Rand(7)
    e, _ := planted(120, 3, 2, r)
    m := Potts.Colouring(3)
    f := Array<F64>(120)
    answers := Vec<Array<I32>>()
    for threads in Array<I64>[1, 3] {
        s := Sampler(120, 16, 3, threads)
        s.Colour(e)
        s.Start(rand.Rand(9))
        s.Anneal(m, e, f, Schedule(300, 2.0, 0.05))
        assert s.Energies[s.Best()] == 0.0, "best energy " + $s.Energies[s.Best()]
        answers.Push(s.X)
    }
    assert answers[0] == answers[1]
}

test Sampler.Colour "no two cells of a colour class are neighbours, and the classes cover every cell once" {
    r := rand.Rand(3)
    e, _ := planted(200, 4, 3, r)
    s := Sampler(200, 1, 4)
    s.Colour(e)
    seen := Array<I64>(200, -1)
    for q in range s.Colours {
        for at in range s.classes[q], s.classes[q + 1] {
            assert seen[s.order[at]] < 0
            seen[s.order[at]] = q
        }
    }
    for i in range 200 {
        assert seen[i] >= 0
        for a in range e.First(i), e.First(i + 1): assert seen[e.Source(a)] != seen[i]
    }
}

test Potts.PseudoGrad "the pseudolikelihood's gradient equals its central differences, for W and B" {
    r := rand.Rand(4)
    e, y := planted(30, 3, 2, r)
    m := Potts(3, 2)
    for i in range 9: m.W[i] = r.Uniform(-1.0, 1.0)
    for i in range 6: m.B[i] = r.Uniform(-1.0, 1.0)
    f := Array<F64>(60)
    for i in range 60: f[i] = r.Uniform(0.0, 1.0)
    gw, gb, L := Array<F64>(9), Array<F64>(6), Array<F64>(3)
    m.PseudoGrad(e, f, y, gw, gb, L)
    h := 1e-6
    sw, sb := Array<F64>(9), Array<F64>(6)
    for i in range 15 {
        tab := m.W if i < 9 else m.B
        j := i if i < 9 else i - 9
        keep := tab[j]
        tab[j] = keep + h
        up := m.PseudoGrad(e, f, y, sw, sb, L)
        tab[j] = keep - h
        down := m.PseudoGrad(e, f, y, sw, sb, L)
        tab[j] = keep
        want := (up - down) / (2.0 * h)
        got := gw[j] if i < 9 else gb[j]
        assert (got - want).Abs() < 1e-5 * (1.0 + want.Abs()), $i + ": " + $got + " against " + $want
    }
}

test Sampler.Langevin "the relaxed annealed search reaches a colouring with few conflicts, its energies the assignments'" {
    r := rand.Rand(11)
    e, _ := planted(60, 3, 2, r)
    m := Potts.Colouring(3)
    f := Array<F64>(60)
    s := Sampler(60, 8, 3, 2)
    s.Colour(e)
    s.Start(rand.Rand(5))
    s.Langevin(m, e, f, Schedule(400, 0.3, 0.001), 1.0)
    best := s.Best()
    assert s.Energies[best] <= 2.0, "best energy " + $s.Energies[best]
    assert s.Energies[best] == m.Energy(e, f, s.X, best * 60)
}

test Fitter "pseudolikelihood fitting learns the colouring rule from planted answers: the fitted energy's chains find proper colourings" {
    r := rand.Rand(12)
    m := Potts(3, 1)
    t := Fitter(m)
    first F64 = 0.0
    for step in range 150 {
        for _ in range 4 {
            e, y := planted(60, 3, 2, r)
            t.Add(e, Array<F64>(60), y)
        }
        loss := t.Step(0.05)
        if step == 0: first = loss
    }
    assert t.Loss < 0.7 * first, $first + " -> " + $t.Loss
    e, _ := planted(120, 3, 2, r)
    s := Sampler(120, 16, 3)
    s.Colour(e)
    s.Start(r)
    s.Anneal(m, e, Array<F64>(120), Schedule(300, 2.0, 0.05))
    assert Potts.Colouring(3).Energy(e, Array<F64>(120), s.X, s.Best() * 120) == 0.0
}

test ClueFeatures "a cell's clue one-hot (or the no-clue slot) and its degree / 4; a Potts over them adds the clue's row and the degree term" {
    r := rand.Rand(2)
    e, y := planted(30, 3, 2, r)
    clues := Array<I32>(30, -1)
    clues[4], clues[9] = y[4], y[9]
    f := Array<F64>(30 * ClueFeatureCount(3))
    ClueFeatures(e, clues, 3, f)
    m := Potts(3, ClueFeatureCount(3))
    for i in range m.B.Len(): m.B[i] = r.Uniform(-1.0, 1.0)
    L := Array<F64>(3)
    zeros := Array<I32>(30)
    for i in range 30 {
        m.Local(e, f, zeros, 0, i, L, 0)
        row := I64(clues[i]) if clues[i] >= 0 else 3
        for c in range 3 {
            want := m.B[row * 3 + c] + m.B[4 * 3 + c] * F64(e.Degree(i)) / 4.0 + F64(e.Degree(i)) * m.W[c * 3]
            assert (L[c] - want).Abs() < 1e-12
        }
    }
}

# a planted not-all-equal instance: n two-valued cells, count clauses of 3 distinct cells, none all equal under the
# planted answer; the factors (one table: all equal costs 1) and the answer
fn naeCase(n I64, count I64, r mut rand.Rand&) Factors, Array<I32> {
    y := Array<I32>(n)
    for i in range n: y[i] = I32(r.Below(2))
    f := Factors(2, 3, 1, count, n)
    q I64 = 0
    for q < count {
        a, b, c := r.Below(n), r.Below(n), r.Below(n)
        if a == b or b == c or a == c or (y[a] == y[b] and y[b] == y[c]): continue
        f.At[3 * q], f.At[3 * q + 1], f.At[3 * q + 2] = a, b, c
        q++
    }
    f.T[0], f.T[7] = 1.0, 1.0
    f.Index()
    return f, y
}

test Factors "annealed chromatic Gibbs over 3-cell factors satisfies a planted not-all-equal instance; no colour class holds two cells of a factor" {
    r := rand.Rand(21)
    f, _ := naeCase(80, 160, r)
    m := Potts(2, 1)
    m.Fac = f
    e := message.Edges(80, 1)
    e.Set(Array<I32>(0), Array<I32>(0), 0)
    s := Sampler(80, 16, 2, 2)
    s.ColourFor(e, m)
    for q in range 160 {
        for a in range 3 {
            for b in range a + 1, 3: assert colourOf(s, f.At[3 * q + a]) != colourOf(s, f.At[3 * q + b])
        }
    }
    s.Start(rand.Rand(4))
    s.Anneal(m, e, Array<F64>(80), Schedule(300, 1.0, 0.03))
    assert s.Energies[s.Best()] == 0.0, $s.Energies[s.Best()]
}

fn colourOf(s Sampler&, i I64) I64 {
    for q in range s.Colours {
        for at in range s.classes[q], s.classes[q + 1] {
            if s.order[at] == i: return q
        }
    }
    return -1
}

test Potts.PseudoGrad "with factors and hidden units: the pseudolikelihood's gradient for every table equals its central differences, and Energy is the free energy summed over the units" {
    r := rand.Rand(22)
    f, y := naeCase(12, 15, r)
    for i in range f.T.Len(): f.T[i] = r.Uniform(-1.0, 1.0)
    h := Hidden(2, 3, 2, 6, 12)
    for j in range 6 {
        for a in range 3: h.At[3 * j + a] = (j * 2 + a * 5) % 12
        h.Type[j] = j % 2
    }
    for i in range h.H.Len(): h.H[i] = r.Uniform(-1.0, 1.0)
    h.C[0], h.C[1] = 0.3, -0.4
    h.Index()
    m := Potts(2, 1)
    m.Fac = f
    m.Hid = h
    e := message.Edges(12, 1)
    e.Set(Array<I32>(0), Array<I32>(0), 0)
    fz := Array<F64>(12)
    gw, gb, L := Array<F64>(4), Array<F64>(2), Array<F64>(2)
    m.PseudoGrad(e, fz, y, gw, gb, L)
    tables := Array<mut Array<F64>&>[f.T, h.H, h.C]
    grads := Array<mut Array<F64>&>[f.G, h.GH, h.GC]
    hstep := 1e-6
    for t in range 3 {
        tab := tables[t]
        want := Array<F64>(tab.Len())
        for j in range tab.Len() {
            keep := tab[j]
            tab[j] = keep + hstep
            up := m.PseudoGrad(e, fz, y, gw, gb, L)
            tab[j] = keep - hstep
            down := m.PseudoGrad(e, fz, y, gw, gb, L)
            tab[j] = keep
            want[j] = (up - down) / (2.0 * hstep)
        }
        for j in range 3 {
            gj := grads[j]
            for x in range gj.Len(): gj[x] = 0.0
        }
        m.PseudoGrad(e, fz, y, gw, gb, L)
        for j in range tab.Len(): assert (grads[t][j] - want[j]).Abs() < 1e-5 * (1.0 + want[j].Abs()), "table " + $t + " entry " + $j
    }
    # the free energy: -log of the sum over every unit's state of exp(-E(x, h))
    brute F64 = 0.0
    for q in range f.Count: brute += f.T[f.entry(q, -1, 0, y, 0)]
    z F64 = 1.0
    for j in range h.Units: z *= 1.0 + h.input(j, y, 0).Exp()
    assert (m.Energy(e, fz, y, 0) - (brute - z.Log())).Abs() < 1e-10
}

test Fitter "hidden units fitted by pseudolikelihood to not-all-equal answers, no pairs: the loss falls, and block Gibbs over units and cells runs to a low free energy" {
    r := rand.Rand(23)
    n := 40
    first F64 = 0.0
    m := Potts(2, 1)
    h := Hidden(2, 3, 1, 80, n)
    for i in range h.H.Len(): h.H[i] = r.Uniform(-0.1, 0.1)
    m.Hid = h
    f0, _ := naeCase(n, 80, r)
    for j in range 80 {
        for a in range 3: h.At[3 * j + a] = f0.At[3 * j + a]
    }
    h.Index()
    e := message.Edges(n, 1)
    e.Set(Array<I32>(0), Array<I32>(0), 0)
    fz := Array<F64>(n)
    t := Fitter(m)
    for step in range 200 {
        # answers satisfying the same clauses: the planted one or its complement, and random other satisfying ones
        y := Array<I32>(n)
        for i in range n: y[i] = I32(r.Below(2))
        for {
            ok := true
            for j in range 80 {
                a, b, c := h.At[3 * j], h.At[3 * j + 1], h.At[3 * j + 2]
                if y[a] == y[b] and y[b] == y[c]: ok = false
            }
            if ok: break
            # flip one cell of each violated clause at random (WalkSAT-like) until satisfied
            for j in range 80 {
                a, b, c := h.At[3 * j], h.At[3 * j + 1], h.At[3 * j + 2]
                if y[a] == y[b] and y[b] == y[c] {
                    v := h.At[3 * j + r.Below(3)]
                    y[v] = 1 - y[v]
                }
            }
        }
        t.Add(e, fz, y)
        loss := t.Step(0.05)
        if step == 0: first = loss
    }
    assert t.Loss < 0.9 * first, $first + " -> " + $t.Loss
    s := Sampler(n, 16, 2)
    s.Colour(e)
    s.Start(r)
    s.Anneal(m, e, fz, Schedule(200, 1.0, 0.05))
    best := s.Best()
    assert s.Energies[best] == m.Energy(e, fz, s.X, best * n)
}

test Potts.Stats "the statistics are the energy's derivative for every table (pairs, unary terms, factors, hidden units)" {
    r := rand.Rand(31)
    e, y := planted(12, 2, 2, r)
    f, _ := naeCase(12, 10, r)
    for i in range f.T.Len(): f.T[i] = r.Uniform(-1.0, 1.0)
    h := Hidden(2, 3, 2, 4, 12)
    for j in range 4 {
        for a in range 3: h.At[3 * j + a] = (j * 3 + a * 4) % 12
        h.Type[j] = j % 2
    }
    for i in range h.H.Len(): h.H[i] = r.Uniform(-1.0, 1.0)
    h.Index()
    m := Potts(2, 2)
    m.Fac = f
    m.Hid = h
    for i in range 4: m.W[i] = r.Uniform(-1.0, 1.0)
    for i in range 4: m.B[i] = r.Uniform(-1.0, 1.0)
    fz := Array<F64>(24)
    for i in range 24: fz[i] = r.Uniform(0.0, 1.0)
    gw, gb := Array<F64>(4), Array<F64>(4)
    m.Stats(e, fz, y, 0, 1.0, gw, gb)
    tables := Array<mut Array<F64>&>[m.W, m.B, f.T, h.H, h.C]
    grads := Array<Array<F64>&>[gw, gb, f.G, h.GH, h.GC]
    for t in range 5 {
        tab := tables[t]
        for j in range tab.Len() {
            keep := tab[j]
            tab[j] = keep + 1e-6
            up := m.Energy(e, fz, y, 0)
            tab[j] = keep - 1e-6
            down := m.Energy(e, fz, y, 0)
            tab[j] = keep
            want := (up - down) / 2e-6
            assert (grads[t][j] - want).Abs() < 1e-6 * (1.0 + want.Abs()), "table " + $t + " entry " + $j + ": " + $grads[t][j] + " against " + $want
        }
    }
}

# a planted 3-colourable graph of n cells with a share of clues, its features and answer
fn cluedCase(n I64, clue F64, r mut rand.Rand&) message.Edges, Array<F64>, Array<I32> {
    e, y := planted(n, 3, 2, r)
    clues := Array<I32>(n, -1)
    for i in range n {
        if r.Uniform(0.0, 1.0) < clue: clues[i] = y[i]
    }
    f := Array<F64>(n * ClueFeatureCount(3))
    ClueFeatures(e, clues, 3, f)
    return e, f, y
}

test Fitter.CD "CD-1, persistent CD-1 and EP each learn the colouring rule from planted answers (40 % clues): the fitted energy's chains solve new graphs of 128 cells" {
    for rule in range 3 {
        r := rand.Rand(U64(40 + rule))
        m := Potts(3, ClueFeatureCount(3))
        t := Fitter(m)
        s := Sampler(32, 16, 3)
        pool := Vec<Sampler>()
        graphs := Vec<message.Edges>()
        feats := Vec<Array<F64>>()
        ys := Vec<Array<I32>>()
        if rule == 1 {
            # persistent chains: a fixed pool of graphs, each with its own chains
            for _ in range 16 {
                e, f, y := cluedCase(32, 0.4, r)
                ps := Sampler(32, 16, 3)
                ps.Colour(e)
                ps.Start(r)
                pool.Push(ps)
                graphs.Push(e)
                feats.Push(f)
                ys.Push(y)
            }
        }
        for step in range 150 {
            for b in range 4 {
                if rule == 1 {
                    q := (step * 4 + b) % 16
                    t.CD(graphs[q], feats[q], ys[q], pool[q], 1, true, true)
                    continue
                }
                e, f, y := cluedCase(32, 0.4, r)
                s.Colour(e)
                if rule == 0 { t.CD(e, f, y, s, 1) } else { t.EP(e, f, y, s, 5, 1, 1.0, r) }
            }
            t.Step(0.05)
        }
        solved I64 = 0
        for _ in range 4 {
            e, f, _ := cluedCase(128, 0.4, r)
            q := Sampler(128, 16, 3)
            q.Colour(e)
            q.Start(r)
            q.Anneal(m, e, f, Schedule(300, 2.0, 0.05))
            # proper and keeping every clue: the rule's energy 0 and the clue term matched
            ok := Potts.Colouring(3).Energy(e, Array<F64>(128), q.X, q.Best() * 128) == 0.0
            for i in range 128 {
                if f[i * 5 + 3] == 0.0 and f[i * 5 + I64(q.X[q.Best() * 128 + i])] == 0.0: ok = false
            }
            if ok: solved += 1
        }
        assert solved >= 3, "rule " + $rule + ": " + $solved + " of 4"
    }
}

fn Factors.sat3(n I64, count I64, r mut rand.Rand&) Factors {
    # a planted 3-SAT instance: clause signs drawn until the planted answer satisfies it; a table per sign pattern, 1
    # on the pattern's one violating assignment
    y := Array<I32>(n)
    for i in range n: y[i] = I32(r.Below(2))
    f := Factors(2, 3, 8, count, n)
    q I64 = 0
    for q < count {
        a, b, c := r.Below(n), r.Below(n), r.Below(n)
        if a == b or b == c or a == c: continue
        sg := r.Below(8)
        # literal j negated if bit (2 - j) of sg is set; violating value of cell j is that bit
        if I64(y[a]) == (sg >> 2) & 1 and I64(y[b]) == (sg >> 1) & 1 and I64(y[c]) == sg & 1: continue
        f.At[3 * q], f.At[3 * q + 1], f.At[3 * q + 2] = a, b, c
        f.Table[q] = sg
        q++
    }
    for sg in range 8: f.T[sg * 8 + sg] = 1.0
    f.Index()
    return f
}

test Sampler.Focus "the focused heat bath solves a planted 3-SAT instance (factors) and a planted 3-colourable graph (edges), with and without weights; Left 0 means energy 0, and the chains do not depend on the thread count" {
    r := rand.Rand(31)
    fs := Factors.sat3(200, 800, r)
    ms := Potts(2, 1)
    ms.Fac = fs
    es := message.Edges(200, 1)
    es.Set(Array<I32>(0), Array<I32>(0), 0)
    for sched in Array<FocusSchedule>[FocusSchedule(200000, 0.5), FocusSchedule(200000, 0.5, 0.1, 0.5, 1000)] {
        s := Sampler(200, 4, 2)
        s.Start(rand.Rand(5))
        s.Focus(ms, es, Array<F64>(200), sched)
        assert s.Left[s.Best()] == 0 and s.Energies[s.Best()] == 0.0, $s.Energies[s.Best()]
    }
    e, _ := planted(150, 3, 2, r)
    m := Potts.Colouring(3)
    answers := Vec<Array<I32>>()
    for threads in Array<I64>[1, 3] {
        s := Sampler(150, 4, 3, threads)
        s.Start(rand.Rand(6))
        s.Focus(m, e, Array<F64>(150), FocusSchedule(200000, 0.5, 0.1, 0.5, 1000))
        for c in range 4: assert (s.Left[c] == 0) == (s.Energies[c] == 0.0)
        assert s.Energies[s.Best()] == 0.0, $s.Energies[s.Best()]
        answers.Push(s.X)
    }
    assert answers[0] == answers[1]
}
