# dyn/system - a dynamical system: a tree of modules holding populations of neurons with named state (dyn/neuron),
# connections between them (dyn/conn), signals the module's rules read, and rules on clocks. It is recorded through
# handles (Pop, Conn, Mod, Sig), laid out once by Plan - one flat parameter region (every connection's weights, then
# every population's biases), its gradient region in the same layout, every population's state, every workspace - and
# then run with nothing allocated: Clamp and Target give a batch, Settle and Nudged relax it (dyn/settle), learning
# rules step the parameters. docs/redesign.md section 1.4 is the design, docs/settling.md the model.
#
# A child module reads its own signals first, then its parent's (Read): the global "how it went" flows down, each rule's
# "what happened" stays local. The rules' code is dyn/learn's: Attach records a rule on a clock, AttachedAt reads them
# back, and a learn.Learner's Tick runs a clock's.
#
# Structure may change while running (docs/redesign.md section 3, decision 3): a connection's weights are masked in
# place (Prune; by a rule: Rule.Prune, dyn/learn), a sparse one's masked entries dropped in place (Compact), a
# population's units retired (Retire) - the loops stay allocation-free. Sparsify stores the dense blocks that pruning
# thinned as sparse rows, so their products skip what was pruned: the one step that allocates, run where the caller
# chooses. Macs counts what a settle's products cost as the structure now stands.
#
# The stability tools: Gain (the sup-norm bound, the largest incoming absolute weight sum of a relaxing unit times its
# activation's largest slope), Contraction (the spectral bound, the coupling's largest singular value times that slope),
# the norm the certificate holds (Bound: Norm.Sup or Norm.Spectral) and its kappa (Kappa), Certify (every recurrent
# connection scaled so that kappa is a target, 0.9 by default), Restrain (scaled back into the certified set where they
# left it), Rate (the certified contraction q = 1 - dt (1 - kappa)) and the budgets that follow (settling.md 1.2, 1.4,
# 1.10; the spectral certificate, docs/redesign.md 4.3).
#
# The backend (docs/redesign.md 1.10). Plan takes `on`, a kernels/device Backend - by default the one device.SetDefault
# chose, the CPU until then. On the GPU (a build with -define Gpu=true) Plan lays every region out a second time on the
# device (dyn/mirror) and Settle, Nudged, Reset and Warm run there; EP's contrast (dyn/learn) and learn.AdamW's step
# too. What reads host state - Activity, Predict, Loss, State, Params, Weights, Bias, ParamGrads, the stability tools -
# brings it down first, and what writes it marks the device's copy stale, so a read is never silently old. What the GPU
# cannot run is refused at Plan by name (DeviceError.Unsupported): spiking and custom populations, sparse and
# event-driven connections, Anderson and Gauss-Seidel sweeps.

import "std/os"
import "std/rand"
import "../tensor"
import "../kernels/fpmode"
import "../kernels/device"
import "neuron"
import "conn"
import "settle"
import "halt"

Gpu Bool = false

if Gpu {
    import "mirror"

    # the system's mirror on the GPU, where it was planned there
    type onGpu<T> struct(n I64) {
        M mut mirror.Mirror<T>?& = null
    }
} else {
    type onGpu<T> struct(n I64) { }
}

# handles: a population, a connection, a module, a signal - numbered in the order they were made
type Pop I64
type Conn I64
type Mod I64
type Sig I64

# the clocks rules run on: inside a settle, per sample or moment, per episode, in sleep
type Clock enum { Sweep, Step, Episode, Sleep }

# the norm a certificate holds the coupling in: Sup, the gain (Gain: incoming mass times slope; a sweep contracts in the
# sup norm), or Spectral, the coupling's largest singular value times the slope (Contraction; a sweep contracts in the
# Euclidean norm; the default: it lets a trained system keep its accuracy, PROGRESS.md "The stop test in the
# certificate's norm"). Both make the fixed point unique; the spectral bound is never above the gain for a symmetric
# coupling. The board needs Sup (its ranges, settling.md 4.2)
type Norm enum { Sup, Spectral }

# learning and adaptation as rules on a module (run by dyn/learn's Learner)
type Rule enum {
    Ep(beta F64, centered Bool)                     # contrast of nudged phases into ParamGrads
    ThreeFactor(signal Sig, decay F64, rate F64)    # eligibility trace x the module's signal
    Homeostasis(target F64, rate F64)               # thresholds or gains toward a target rate
    DeltaWrite(c Conn, gate Sig)                    # fast weights written while settling
    Prune(by conn.Score, target F64, pace F64, regrow F64, schedule conn.Schedule)   # weights masked by a score, toward a fraction kept
    Custom(r mut any Update&)
}

# a rule beyond the built-in ones, given its system's parameters and gradients (flat) on its clock
type Update trait {
    mut Apply(params mut Array<F32>&, grads mut Array<F32>&)
}

# the gradient at a fixed point (dyn/learn)
type Implicit enum { Exact(tol F64, sweeps I64), Jfb, Ep(beta F64) }

# a signal looked up by a name no module on the way to the root has
type SignalError error {
    Missing(name String)
}

type modRec struct(Parent I64, Name String) { Parent, Name }

type popRec struct(In I64, Name String) { In, Name }

type sigRec struct(In I64, Name String, Width I64, At I64) { In, Name, Width, At }

type ruleRec struct(In I64, What Rule, When Clock) { In, What, When }

# a system of T elements (state and weights; F32 to run, F64 to check), batch rows a phase, phases phases side by side
# (free, plus, minus), its sweeps split over threads tasks
type System<T> struct(batch I64, threads I64 = 1, phases I64 = 3) {
    Batch I64 = batch
    Phases I64 = phases
    E mut settle.Engine<T>& = settle.Engine<T>(batch, phases, threads)
    Planned Bool = false
    Scheme settle.Sweeping = settle.Sweeping()          # the sweeps of the budgets it gives (BudgetFor)
    Bound Norm = Norm.Spectral                          # the norm Certify, Restrain, Rate and the tolerances hold kappa in
    rateBlocks mut Array<F64>& = Array<F64>(4)          # NudgedRate's reading of the coupling (blocks)
    rateM mut Array<F64>& = Array<F64>(5)               # and its matrix M (blockMatrix), kept so that a rate allocates nothing
    mods mut Vec<modRec>& = Vec<modRec>[modRec(-1, "root")]
    pops mut Vec<popRec>& = Vec<popRec>()
    sigs mut Vec<sigRec>& = Vec<sigRec>()
    rules mut Vec<ruleRec>& = Vec<ruleRec>()
    signals mut Array<T>& = Array<T>(0)
    gpu mut onGpu<T>& = onGpu<T>(0)
}

# ---- recording ----

fn (s System<T>&) Root() Mod { return Mod(0) }

# a module under parent
fn (s mut System<T>&) Module(parent Mod, name String&) Mod {
    s.mods.Push(modRec(I64(parent), name))
    return Mod(s.mods.Len() - 1)
}

# a population of size units of model n in module m
fn (s mut System<T>&) Population(m Mod, name String&, size I64, n neuron.Neuron, role neuron.Role = neuron.Role.Hidden) Pop {
    s.E.Pops.Push(settle.Population<T>(size, n, role, s.Batch * s.Phases, s.Batch))
    s.pops.Push(popRec(I64(m), name))
    return Pop(s.pops.Len() - 1)
}

# connection c's weights made ternary while the system learns (before Plan; dense and symmetric connections, on the
# CPU): the parameters hold each post row's absmean ternary weights times its scale - what every settle, energy and
# adjoint reads - and the connection keeps the real-valued latent weights a lesson's gradient is stepped into (straight
# through the rounding). An optimizer step is bracketed by Latent and Quantized (learn.AdamW does it itself)
fn (s mut System<T>&) Ternary(c Conn) { s.E.Links[I64(c)].Ternary = true }

# the parameters of the ternary connections set to their latent weights, for an optimizer's step
fn (s mut System<T>&) Latent() {
    for l in s.E.Links {
        if not l.Ternary: continue
        for i in range l.Count: s.E.Params[l.Off + i] = l.Latent[i]
    }
}

# after an optimizer's step: the ternary connections' parameters kept as their latent weights and quantized again
fn (s mut System<T>&) Quantized() {
    for l in s.E.Links {
        if not l.Ternary: continue
        for i in range l.Count: l.Latent[i] = s.E.Params[l.Off + i]
        l.Quantize(s.E.Params)
    }
}

# a connection from pre into post, wired so; reciprocal also carries post's activities back into pre (Symmetric always
# does); frozen: learning leaves its weights
fn (s mut System<T>&) Connect(pre Pop, post Pop, w conn.Wiring, frozen Bool = false, reciprocal Bool = false) Conn {
    a :~ s.E.Pops[I64(pre)]
    b :~ s.E.Pops[I64(post)]
    s.E.Links.Push(conn.Link<T>(I64(pre), I64(post), a.Size, b.Size, w, reciprocal, frozen))
    return Conn(s.E.Links.Len() - 1)
}

# a signal of width values in module m, zero until Set (declared after Plan, the signals' room grows to hold it)
fn (s mut System<T>&) Signal(m Mod, name String&, width I64 = 1) Sig {
    at I64 = 0
    for g in s.sigs: at += g.Width
    s.sigs.Push(sigRec(I64(m), name, width, at))
    if s.Planned: s.signals ~ Array<T>[s.signals[i] if i < at else T(0) for i in range at + width]
    return Sig(s.sigs.Len() - 1)
}

# a rule on module m, run on clock c (by learn.Learner's Tick)
fn (s mut System<T>&) Attach(m Mod, r Rule, c Clock) {
    s.rules.Push(ruleRec(I64(m), r, c))
}

# a rule as attached: where, what, and the clock it runs on
type Attached struct(Where Mod, What Rule, When Clock) { Where, What, When }

# how many rules are attached
fn (s System<T>&) Attachments() I64 { return s.rules.Len() }

# the rule attached i-th (learn.Learner.Tick walks them, running a clock's in the order attached)
fn (s System<T>&) AttachedAt(i I64) Attached {
    g := s.rules[i]
    return Attached(Mod(g.In), g.What, g.When)
}

# ---- the plan ----

# lays everything out and draws the weights from r (Glorot-uniform; biases zero), on the backend on (the default one,
# device.SetDefault's; the CPU until set). Refuses a structure the settle cannot run: a connection into an input, an
# event-driven one that is reciprocal, spiking populations beside rate ones or as inputs, spiking populations of
# different windows, a custom model outside a System<F32> - and on the GPU (DeviceError) what has no GPU form, by name,
# a build without the GPU, or the device's failure
fn (s mut System<T>&) Plan(r mut rand.Rand&, on device.Backend = device.Backend.Default()) ? tensor.ShapeError, conn.WiringError, device.DeviceError {
    if s.Planned: error tensor.ShapeError.Mismatch("Plan twice")
    try s.check()
    fpmode.Startup()
    if on == device.Backend.Gpu {
        if Gpu {
            why := mirror.Refusal(s.E, s.Scheme)
            if why != "": error device.DeviceError.Unsupported("no GPU form of " + why + ": plan this system on device.Backend.Cpu")
        } else {
            try device.NotBuilt()
        }
    }
    e :~ s.E
    count I64 = 0
    for l in e.Links {
        try l.Check()
        l.Draw(r)
        count += l.Count
    }
    for p in e.Pops: count += p.Size
    e.Params ~ Array<T>(count)
    e.Grads ~ Array<T>(count)
    at I64 = 0
    for i in range e.Links.Len() {
        l :~ e.Links[i]
        l.Folded = e.Pops[l.Pre].Role == neuron.Role.Input
        l.Lay(e.Params, at, s.Batch * s.Phases, r)
        at += l.Count
        s.route(l, i)
        if not l.Ternary: continue
        if not (l.Kind == conn.Wiring.Dense or l.Kind == conn.Wiring.Symmetric): error tensor.ShapeError.Mismatch("a ternary connection is dense or symmetric")
        if on == device.Backend.Gpu: error tensor.ShapeError.Mismatch("ternary connections run on the CPU")
        l.Latent ~ Array<T>(l.Count)
        for k in range l.Count: l.Latent[k] = e.Params[l.Off + k]
        l.Quantize(e.Params)
    }
    unit I64 = 0
    for p in e.Pops {
        p.Bias = at
        at += p.Size
        p.Unit = unit
        unit += p.Size
    }
    width I64 = 0
    for g in s.sigs: width += g.Width
    s.signals ~ Array<T>(width)
    e.Ready()
    e.Reserve(s.Scheme.Anderson)
    if Gpu {
        if on == device.Backend.Gpu {
            try device.Open()
            s.gpu.M = try mirror.Mirror<T>.Make(device.Opened!, e, s.Scheme)
        }
    }
    s.Planned = true
}

# where a settle of batch rows over a hidden population of width units runs fastest, as G-M2 measured it on the machine
# GP5 ran on (PROGRESS.md, "GP5"; Ryzen 5 7600, RTX 4060): on the GPU where there is one and batch x width is at least
# 16384 (from 1.1x there to 9x at 512 x 1024), else on the CPU (at one thread: 1.5-3x the GPU below it). A measured
# rule for mnist_learn's 784-H-10 system, not a model of every system: Plan's default stays the CPU
fn SettleOn(batch I64, width I64) device.Backend { return device.Backend.Gpu if device.GpuAvailable() and batch * width >= 16384 else device.Backend.Cpu }

# whether it was planned on the GPU
fn (s System<T>&) OnGpu() Bool {
    if Gpu {
        return s.gpu.M is not null
    } else {
        return false
    }
}

if Gpu {
    # its mirror on the GPU (planned there)
    fn (s System<T>&) Mirror() mut mirror.Mirror<T>& { return s.gpu.M! }
}

# host and device kept current (dyn/mirror): population i's state, the recurrent weights, every parameter, the
# gradients brought down where the device's are newer; and after the host writes them, the device's marked stale.
# Nothing on the CPU
fn (s System<T>&) hostState(i I64) {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.HostState(s.E, i)
    }
}

fn (s System<T>&) hostCoupling() {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.HostCoupling(s.E)
    }
}

fn (s System<T>&) wroteCoupling() {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.WroteCoupling(s.E)
    }
}

fn (s System<T>&) wroteParams() {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.WroteParams(s.E)
    }
}

fn (s System<T>&) wroteGrads() {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.WroteGrads(s.E)
    }
}

fn (s System<T>&) wroteState(i I64) {
    if Gpu {
        if s.gpu.M is not null: s.gpu.M!.WroteState(s.E, i)
    }
}

# how its settles sweep from now on, in the budgets it gives (BudgetFor, a Learner's): Anderson's room reserved where
# planned (allocates, once)
fn (s mut System<T>&) Use(scheme settle.Sweeping) {
    if s.OnGpu() and (scheme.Anderson > 0 or scheme.GaussSeidel): unreachable "a system planned on the GPU sweeps by Jacobi: Anderson acceleration and Gauss-Seidel sweeps stay on the CPU"
    s.Scheme = scheme
    if s.Planned: s.E.Reserve(scheme.Anderson)
}

# connection i into the lists of the populations it feeds: folded into its post's constant (its pre an input), else
# carried forward into post and, reciprocal, back into pre
fn (s mut System<T>&) route(l conn.Link<T>&, i I64) {
    post :~ s.E.Pops[l.Post]
    if l.Folded {
        post.Folds.Push(i)
        return
    }
    post.In.Push(i)
    if l.Both: s.E.Pops[l.Pre].Back.Push(i)
}

fn (s System<T>&) check() ? tensor.ShapeError {
    lifs, rates := 0, 0
    window I64 = 0
    for p in s.E.Pops {
        model := p.Model
        if p.Role == neuron.Role.Input {
            if model != neuron.Neuron.Rate: error tensor.ShapeError.Mismatch("an input population is of rate neurons")
            continue
        }
        if model == neuron.Neuron.Lif {
            if window != 0 and model.window != window: error tensor.ShapeError.Mismatch("every spiking population of a system counts over one window")
            if model.window < 1: error tensor.ShapeError.Mismatch("a spiking window is at least one step")
            window = model.window
            lifs++
        } else {
            rates++
        }
        if model == neuron.Neuron.Custom and not isF32<T>(): error tensor.ShapeError.Mismatch("a custom model runs in a System<F32>")
    }
    if lifs > 0 and rates > 0: error tensor.ShapeError.Mismatch("a system's relaxing populations are all spiking or all rate (or custom) ones")
    for l in s.E.Links {
        if s.E.Pops[l.Post].Role == neuron.Role.Input: error tensor.ShapeError.Mismatch("a connection into an input population")
        if l.Both and s.E.Pops[l.Pre].Role == neuron.Role.Input: error tensor.ShapeError.Mismatch("a reciprocal connection from an input population")
    }
}

fn isF32<T>() Bool {
    return match T {
        case F32: true
        case _: false
    }
}

# ---- data in ----

# the system's checks of a batch given for p: a [batch, size] tensor
fn (s System<T>&) batchOf<Y>(p Pop, x tensor.Tensor<Y>&, width I64) mut Array<Y>& ? tensor.ShapeError {
    if not s.Planned: error tensor.ShapeError.Mismatch("a batch given before Plan")
    if x.Rank() != 2 or x.Dim(0) != s.Batch or x.Dim(1) != width {
        error tensor.ShapeError.Mismatch("population " + $I64(p) + " takes [" + $s.Batch + ", " + $width + "], not " + $x.Dims)
    }
    return try x.Flat()
}

# p's drive for the next settles, [batch, size]: an input's state is its drive (held fixed); any other population's is
# added to its total (a memory's read, a stimulus)
fn (s mut System<T>&) Clamp(p Pop, x tensor.Tensor<T>&) ? tensor.ShapeError {
    pop := s.E.Pops[I64(p)]
    from := try s.batchOf(p, x, pop.Size)
    for i in range from.Len(): pop.Drive[i] = from[i]
}

# a cross-entropy readout's classes, [batch, groups]
fn (s mut System<T>&) Target(p Pop, y tensor.Tensor<I32>&) ? tensor.ShapeError {
    pop := s.E.Pops[I64(p)]
    groups := settle.GroupsOf(pop.Role)
    if groups == 0: error tensor.ShapeError.Mismatch("population " + $I64(p) + " is no cross-entropy readout")
    from := try s.batchOf(p, y, groups)
    for i in range from.Len(): pop.Labels[i] = from[i]
}

# a squared-error readout's targets, [batch, size]
fn (s mut System<T>&) TargetValues(p Pop, y tensor.Tensor<T>&) ? tensor.ShapeError {
    pop := s.E.Pops[I64(p)]
    if pop.Target.Len() == 0: error tensor.ShapeError.Mismatch("population " + $I64(p) + " is no readout")
    from := try s.batchOf(p, y, pop.Size)
    for i in range from.Len(): pop.Target[i] = from[i]
}

# ---- signals ----

# a signal's values, set
fn (s mut System<T>&) Set(sig Sig, v tensor.Tensor<T>&) ? tensor.ShapeError {
    g := s.sigs[I64(sig)]
    if v.Count() != g.Width: error tensor.ShapeError.Mismatch("signal " + $g.Name + " holds " + $g.Width + " values, not " + $v.Count())
    from :~ try v.Flat()
    for i in range g.Width: s.signals[g.At + i] = from[i]
}

# the signal called name as module m sees it: its own, else its parent's, up to the root - a view of its values
fn (s System<T>&) Read(m Mod, name String&) tensor.Tensor<T> ? SignalError {
    at := I64(m)
    for at >= 0 {
        for g in s.sigs {
            if g.In == at and g.Name == name: return tensor.Tensor<T>.Over(s.signals, g.At, g.Width)!
        }
        at = s.mods[at].Parent
    }
    error SignalError.Missing(name)
}

# signal sig's values, a view (what a rule given the signal's handle reads)
fn (s System<T>&) Value(sig Sig) tensor.Tensor<T> {
    g := s.sigs[I64(sig)]
    return tensor.Tensor<T>.Over(s.signals, g.At, g.Width)!
}

# whether population p is in module m or in a module under it (the populations a rule attached to m reaches)
fn (s System<T>&) Within(p Pop, m Mod) Bool {
    at := s.pops[I64(p)].In
    for at >= 0 {
        if at == I64(m): return true
        at = s.mods[at].Parent
    }
    return false
}

# ---- settling ----

# phase settled from its committed state (Reset it for a cold start) within the budget, with its inputs' drives and
# targets as given: allocation-free. Its state is committed either way; the Settlement says how it went
fn (s mut System<T>&) Settle(phase settle.Phase, b settle.Budget) settle.Settlement {
    ph := phase.Index()
    if ph >= s.Phases: unreachable "a system of " + $s.Phases + " phases has no " + $phase
    s.E.Beta[ph] = 0.0 if phase == settle.Phase.Free else s.E.Beta[ph]
    if Gpu {
        if s.gpu.M is not null: return s.gpu.M!.Settle(s.E, ph, ph + 1, b, true)
    }
    return s.E.Settle(ph, ph + 1, b, true)
}

# every nudged phase settled from the free phase's state, side by side: +beta toward the readouts' targets and,
# centered, -beta away (Minus) - one product per connection per sweep for both
fn (s mut System<T>&) Nudged(b settle.Budget, beta F64 = 0.5, centered Bool = true) settle.Settlement {
    hi := 3 if centered else 2
    if s.Phases < hi: unreachable "a system of " + $s.Phases + " phases cannot hold these nudged phases"
    s.E.Beta[1] = beta
    if centered: s.E.Beta[2] = -beta
    if Gpu {
        if s.gpu.M is not null {
            for ph in range 1, hi: s.gpu.M!.Warm(s.E, ph, 0)
            return s.gpu.M!.Settle(s.E, 1, hi, b, false)
        }
    }
    for ph in range 1, hi: s.E.Warm(ph, 0)
    return s.E.Settle(1, hi, b, false)
}

# phase's state at rest: every field but the kept ones (LifCell.Kept) zero
fn (s mut System<T>&) Reset(phase settle.Phase) {
    if Gpu {
        if s.gpu.M is not null {
            s.gpu.M!.Reset(s.E, phase.Index())
            return
        }
    }
    s.E.Reset(phase.Index())
}

# phase's state set to from's
fn (s mut System<T>&) Warm(phase settle.Phase, from settle.Phase) {
    if Gpu {
        if s.gpu.M is not null {
            s.gpu.M!.Warm(s.E, phase.Index(), from.Index())
            return
        }
    }
    s.E.Warm(phase.Index(), from.Index())
}

# the nudge phase was last settled with (0 for the free phase)
fn (s System<T>&) NudgeOf(phase settle.Phase) F64 { return s.E.Beta[phase.Index()] }

# the step of a sweep, in (0, 1]: 1 is plain fixed-point iteration
fn (s mut System<T>&) Step(dt F64) { s.E.Dt = dt }

# ---- state and parameters out ----

# p's named state, every phase's rows (phases x batch x size, a phase's batch rows after another's): its cells' Columns
# - RateCell<T> for rate and custom populations, LifCell<T> for spiking ones. Writing it writes the state
fn (s System<T>&) State<C>(p Pop) mut Columns<C>& {
    s.wroteState(I64(p))
    pop :~ s.E.Pops[I64(p)]
    match C {
        case neuron.RateCell<T> { return pop.R0 }
        case neuron.LifCell<T> { return pop.L0 }
    }
}

# p's activities in phase, [batch, size], a view
fn (s System<T>&) Activity(phase settle.Phase, p Pop) tensor.Tensor<T> {
    s.hostState(I64(p))
    pop :~ s.E.Pops[I64(p)]
    n := s.Batch * pop.Size
    return tensor.Tensor<T>.Over(pop.Activity(0), phase.Index() * n, s.Batch, pop.Size)!
}

# the class each row answers on a readout in phase: its most active unit (of each group, numbered within it), [batch,
# groups] into out
fn (s System<T>&) Predict(phase settle.Phase, p Pop, out mut Array<I32>&) {
    s.hostState(I64(p))
    pop :~ s.E.Pops[I64(p)]
    groups := settle.GroupsOf(pop.Role).Max(1)
    a :~ pop.Activity(0)
    w := pop.Size / groups
    base := phase.Index() * s.Batch * pop.Size
    for b in range s.Batch {
        for g in range groups {
            at := base + b * pop.Size + g * w
            best I64 = 0
            for j in range 1, w: best = j if a[at + j] > a[at + best] else best
            out[b * groups + g] = I32(best)
        }
    }
}

# the readouts' cost in phase, averaged over the batch rows
fn (s System<T>&) Loss(phase settle.Phase) F64 {
    total F64 = 0.0
    for i in range s.E.Pops.Len() {
        pop :~ s.E.Pops[i]
        role := pop.Role
        if role != neuron.Role.Readout: continue
        s.hostState(i)
        a :~ pop.Activity(0)
        for b in range s.Batch {
            at := (phase.Index() * s.Batch + b) * pop.Size
            total += neuron.CostOf(role.cost, a, at, pop.Size, pop.Labels, b * settle.GroupsOf(role), pop.Target, b * pop.Size)
        }
    }
    return total / F64(s.Batch)
}

# connection c's weights, a view of the parameter region: [post, pre] for the dense forms, [pre, post] for an
# event-driven one, A ([post, rank]) for a low-rank one (B follows it), the stored values for a sparse one ([Count])
fn (s System<T>&) Weights(c Conn) tensor.Tensor<T> {
    s.wroteParams()
    l :~ s.E.Links[I64(c)]
    return match l.Kind {
        case conn.Wiring.Dense, conn.Wiring.Symmetric: tensor.Tensor<T>.Over(s.E.Params, l.Off, l.PostSize, l.PreSize)!
        case conn.Wiring.Events: tensor.Tensor<T>.Over(s.E.Params, l.Off, l.PreSize, l.PostSize)!
        case conn.Wiring.LowRank(rank): tensor.Tensor<T>.Over(s.E.Params, l.Off, l.PostSize, rank)!
        case _: tensor.Tensor<T>.Over(s.E.Params, l.Off, l.Count)!
    }
}

# connection c as the settle runs it: its kind, sides, offset, sparse form and mask
fn (s System<T>&) Link(c Conn) mut conn.Link<T>& { return s.E.Links[I64(c)] }

# population p as the settle runs it
fn (s System<T>&) Pop(p Pop) mut settle.Population<T>& { return s.E.Pops[I64(p)] }

# p's biases, a view of the parameter region
fn (s System<T>&) Bias(p Pop) tensor.Tensor<T> {
    s.wroteParams()
    pop :~ s.E.Pops[I64(p)]
    return tensor.Tensor<T>.Over(s.E.Params, pop.Bias, pop.Size)!
}

# every parameter, flat, as the graph's: what optimizers, clipping and checkpoints step in one pass. On the GPU a view
# of the host's copy, brought current and taken as written (the device's copy goes up before it is next read): a view
# kept and written later is not seen there - step a GPU plan with learn.AdamW
fn (s System<T>&) Params() tensor.Tensor<T> {
    s.wroteParams()
    return tensor.Tensor<T>.Over(s.E.Params, 0, s.E.Params.Len())!
}

# their gradients, in the same layout (on the GPU as Params)
fn (s System<T>&) ParamGrads() tensor.Tensor<T> {
    s.wroteGrads()
    return tensor.Tensor<T>.Over(s.E.Grads, 0, s.E.Grads.Len())!
}

# the counts so far: sweeps (time steps) of every settle, and the last settle's
fn (s System<T>&) Sweeps() I64 { return s.E.Sweeps }

fn (s System<T>&) Last() settle.Settlement { return s.E.Last }

# ---- structure while running ----

# connection c's parameters (a Tiles' stored tiles) whose keep is false masked in place: zeroed, their gradient too
fn (s mut System<T>&) Prune(c Conn, keep Array<Bool>&) {
    s.wroteParams()
    s.wroteGrads()
    s.E.Links[I64(c)].Prune(keep, s.E.Params, s.E.Grads)
}

# unit j of p retired: held at rest from the next sweep on (its rows zero), so nothing it is connected to hears it
fn (s mut System<T>&) Retire(p Pop, j I64) {
    pop :~ s.E.Pops[I64(p)]
    if not pop.Alive[j]: return
    pop.Alive[j] = false
    pop.Retired++
}

# every sparse connection's masked entries dropped in place: products cheaper from now on. Gives the entries removed
fn (s mut System<T>&) Compact() I64 {
    s.wroteParams()
    s.wroteGrads()
    removed I64 = 0
    for l in s.E.Links: removed += l.Compact(s.E.Params, s.E.Grads)
    return removed
}

# every masked weight zero again: after an optimizer's step, whose momentum moves a weight whose gradient is held at zero.
# Nothing masked, nothing to do - on the GPU the parameters then stay where they are (no round trip a lesson)
fn (s mut System<T>&) Hold() {
    masked := false
    for l in s.E.Links: masked = masked or (l.Pruned > 0 and l.Tiles is null)
    if not masked: return
    s.wroteParams()
    for l in s.E.Links: l.Hold(s.E.Params)
}

# every dense block (Dense, Symmetric) with at most the fraction below of its weights live stored as sparse rows over
# its region (Link.Sparsify): what it computes is unchanged, its products cost its live weights. Allocates the patterns;
# an optimizer made before is made again (the parameters moved). Gives the connections converted
fn (s mut System<T>&) Sparsify(below F64 = 0.5) I64 {
    if s.OnGpu(): unreachable "a system planned on the GPU has no sparse rows: Sparsify stays on the CPU"
    n I64 = 0
    for l in s.E.Links {
        if l.Kind != conn.Wiring.Dense and l.Kind != conn.Wiring.Symmetric: continue
        if F64(l.Live()) > below * F64(l.Count): continue
        l.Sparsify(s.E.Params, s.E.Grads)!
        n++
    }
    return n
}

# the multiply-adds of a settle of one batch row: Once, its folded connections' (an input carried into the constant,
# once a settle); Sweep, every recurrent connection's carry, both ways where reciprocal (each sweep). As the structure
# now stands (Link.Macs): a masked weight of a dense block still costs its multiply-add
type Macs struct(Once I64, Sweep I64) {
    Once
    Sweep
}

# a settle of sweeps sweeps
fn (m Macs&) Settle(sweeps I64) I64 { return m.Once + sweeps * m.Sweep }

fn (s System<T>&) Macs() Macs {
    once, sweep := 0, 0
    for l in s.E.Links {
        if l.Folded { once += l.Macs() } else { sweep += l.Macs() * (2 if l.Both else 1) }
    }
    return Macs(once, sweep)
}

# ---- stability ----

# every unit's incoming mass over the recurrent connections (a folded one's source is constant and does not count)
fn (s mut System<T>&) masses() {
    s.hostCoupling()
    e :~ s.E
    for i in range e.Mass.Len(): e.Mass[i] = 0.0
    for l in e.Links {
        if not l.Folded: l.AddMass(e.Params, e.Mass, e.Pops[l.Post].Unit, e.Pops[l.Pre].Unit)
    }
}

# the largest slope of the relaxing populations' activations (infinite for spiking and custom ones)
fn (s System<T>&) slope() F64 {
    worst F64 = 0.0
    for p in s.E.Pops {
        if p.Role != neuron.Role.Input: worst = worst.Max(neuron.Slope(p.Model))
    }
    return worst
}

# the feedback gain kappa: the largest incoming mass of a relaxing unit times the activations' largest slope. Below 1 a
# sweep at dt = 1 is a contraction in the sup norm by this factor: one equilibrium, and the certificate's bounds
fn (s mut System<T>&) Gain() F64 {
    s.masses()
    most F64 = 0.0
    for p in s.E.Pops {
        if p.Role == neuron.Role.Input: continue
        for j in range p.Size: most = most.Max(s.E.Mass[p.Unit + j])
    }
    return 0.0 if most == 0.0 else most * s.slope()
}

# kappa in the norm the certificate holds (Bound): the gain, or the spectral bound by the warm power iteration (a few
# iterations a lesson; to a relative 1e-6 in at most 200 - an estimate from below, as every iterate is)
fn (s mut System<T>&) Kappa() F64 { return s.kappaTo(200, 1e-6) }

fn (s mut System<T>&) kappaTo(iterations I64, tol F64) F64 {
    s.hostCoupling()
    if s.Bound == Norm.Sup: return s.Gain()
    slope := s.slope()
    if not (slope <= F64.Max): return slope
    return s.E.Spectral(iterations, tol) * slope
}

# every recurrent connection scaled by one factor so that kappa (in the norm of Bound; the spectral bound found to a
# relative 1e-9 here, once) is target (which keeps a reciprocal block symmetric); nothing for a system with no recurrent
# weights or no bounded slope
fn (s mut System<T>&) Certify(target F64 = 0.9) {
    k := s.kappaTo(1000, 1e-9)
    if k == 0.0 or not (k <= F64.Max): return
    s.scale(target / k)
}

fn (s mut System<T>&) scale(f F64) {
    s.wroteCoupling()
    for l in s.E.Links {
        if not l.Folded: l.Scale(s.E.Params, f)
    }
}

# the weights projected back into the certified set. Sup: each recurrent connection whose units' gain exceeds target
# scaled by the factor the worst of them needs (all factors found before any is applied). Spectral: every recurrent
# connection by the one factor that brings the spectral bound to target (the norm is not a per-unit quantity)
fn (s mut System<T>&) Restrain(target F64 = 0.9) {
    s.hostCoupling()
    if s.Bound == Norm.Spectral {
        k := s.Kappa()
        if k > target and k <= F64.Max: s.scale(target / k)
        return
    }
    s.masses()
    l := s.slope()
    if not (l <= F64.Max): return
    e :~ s.E
    factors := Array<F64>(e.Links.Len(), 1.0)
    for i in range e.Links.Len() {
        c :~ e.Links[i]
        if c.Folded: continue
        factors[i] = s.worstFactor(e.Pops[c.Post], l, target)
        if c.Both: factors[i] = factors[i].Min(s.worstFactor(e.Pops[c.Pre], l, target))
    }
    s.wroteCoupling()
    for i in range e.Links.Len() {
        if factors[i] < 1.0: e.Links[i].Scale(e.Params, factors[i])
    }
}

fn (s System<T>&) worstFactor(p settle.Population<T>&, slope F64, target F64) F64 {
    f F64 = 1.0
    for j in range p.Size {
        g := slope * s.E.Mass[p.Unit + j]
        if g > target: f = f.Min(target / g)
    }
    return f
}

# the spectral bound of the coupling: the activations' largest slope times the largest singular value of the recurrent
# weights between relaxing units (power iteration, Engine.Spectral, to a relative 1e-9 in at most iterations). Below 1
# a sweep at dt = 1 is a contraction in the Euclidean norm by this factor - at most Gain() where the coupling is
# symmetric (|W|_2 <= |W|_inf), often far below it; infinite for spiking and custom populations
fn (s mut System<T>&) Contraction(iterations I64 = 1000) F64 {
    s.hostCoupling()
    slope := s.slope()
    sigma := s.E.Spectral(iterations, 1e-9)
    return 0.0 if sigma == 0.0 else sigma * slope
}

# the certified rate q at which a sweep shrinks the residual (in the norm of Bound) - of a free phase, or of the nudged
# pair settled with beta (+beta and -beta) - or 1 where nothing is certified. A sweep's Jacobian is a diagonal part
# (1 - dt) - dt beta f_i (f_i the force's self-slope) plus dt (W D + beta C), C the force's coupling between units
# (neuron.ForceCoupling); in any operator norm it is at most |diagonal| + dt kappa_beta. At +beta the shortened step
# keeps the diagonal within 1 - dt and kappa_beta = kappa + beta c; at -beta the step is not shortened, the self-slope
# adds instead and kappa_beta = kappa + beta (f + c). q = 1 - dt (1 - kappa_beta), the worse of the two
fn (s mut System<T>&) Rate(beta F64 = 0) F64 {
    k := s.Kappa()
    if beta == 0.0: return rateOf(s.E.Dt, k)
    b := beta.Abs()
    plus := rateOf(s.E.Dt / (1.0 + b * s.E.ForceSlope()), k + b * s.E.ForceCoupling())
    minus := rateOf(s.E.Dt, k + b * (s.E.ForceSlope() + s.E.ForceCoupling()))
    return plus.Max(minus)
}

fn rateOf(dt F64, kappa F64) F64 { return 1.0 if kappa >= 1.0 else 1.0 - dt * (1.0 - kappa) }

# kappa of a phase nudged with beta (Rate): the free kappa plus the force's coupling, and its self-slope at -beta
fn (s mut System<T>&) NudgedKappa(beta F64) F64 {
    extra := s.E.ForceCoupling() + (s.E.ForceSlope() if beta < 0.0 else 0.0)
    return s.Kappa() + beta.Abs() * extra
}

# the certified rate of the nudged pair settled with beta from the free phase's committed state (free the settlement
# that left it there, its residual measured in the norm of Bound): Rate(beta) with the readouts' force bounded over the
# region the settle can reach instead of at its worst, row by row, in the better of two norms (rowRate). Gives the
# worst row's rate (1 where a row is not certified, the free phase did not converge, or the model is spiking) and the
# rows certified on their own
fn (s mut System<T>&) NudgedRate(beta F64, free settle.Settlement) F64, I64 {
    if not free.Converged or s.E.Spiking: return 1.0, 0
    k := s.Kappa()
    for i in range s.E.Pops.Len() {
        if s.E.Pops[i].Role == neuron.Role.Readout: s.hostState(i)
    }
    blocks :~ s.blocks(k)
    worst F64 = 0.0
    rows := 0
    for row in range s.E.Batch {
        q, _ := s.rowRate(row, k, blocks, beta.Abs(), free.Residual)
        worst = worst.Max(q)
        if q < 1.0: rows++
    }
    return worst, rows
}

# NudgedRate's rate of one row and the norm it holds in: t = 0 for the certificate's own (plainRate), t > 0 for the
# block norm max(|x_h|, |x_y| / t) (blockRate) - whichever certifies the lower rate
fn (s System<T>&) rowRate(row I64, k F64, blocks Array<F64>&, b F64, rest F64) F64, F64 {
    plain := s.plainRate(row, k, b, rest)
    q, t := s.blockRate(row, blocks, b, rest)
    if plain <= q: return plain, 0.0
    return q, t
}

# the rate in the certificate's own norm: the start's residual (the step over dt) is at most rest + beta |F(s0)|, rest
# the free settle's residual (the state it kept is the one it measured) and F(s0) the force there (neuron.ForceSize).
# Where a sweep's Jacobian has norm at most q = 1 - dt (1 - kappa_beta) on the ball of radius r about the start, and
# rest + beta |F(s0)| <= (1 - kappa_beta) r, the sweep maps the ball into itself (|G(u) - u0| <= q r + dt (1 -
# kappa_beta) r = r), so the settle stays in it and shrinks the residual by q every sweep. kappa_beta is kappa plus
# beta times the force's Jacobian within r of the start (neuron.ForceOver): its part between units at +beta (the
# shortened step absorbs the diagonal), the whole at -beta. r is grown from the start's residual / (1 - kappa) by a
# quarter until the ball holds; 1 where none does within 100 growths, kappa_beta reaches 1 (it only grows with r), the
# free phase is not certified (kappa >= 1), or a readout has no slope bound
fn (s System<T>&) plainRate(row I64, k F64, b F64, rest F64) F64 {
    if rateOf(s.E.Dt, k) >= 1.0: return 1.0
    euclid := s.Bound == Norm.Spectral
    start := rest + b * s.forceSize(row, euclid)
    r := start / (1.0 - k)
    for _ in range 100 {
        c, w := s.forceOver(row, r, euclid)
        minus := k + b * w
        if minus >= 1.0: return 1.0
        if (1.0 - minus) * r >= start: return rateOf(s.E.Dt / (1.0 + b * s.E.ForceSlope()), k + b * c).Max(rateOf(s.E.Dt, minus))
        r *= 1.25
    }
    return 1.0
}

# what blockRate reads of the coupling, once a call: [sigma_hh, sigma_hy, sigma_yy, s_h] - the norm (Bound's) bounding
# the recurrent weights within the hidden units (every relaxing unit not a readout), between them and the readouts, and
# within the readouts, each sigma = kappa / the largest slope (a block's norm is at most the whole's) or 0 where no
# connection joins those units, and the hidden units' largest slope
fn (s System<T>&) blocks(k F64) Array<F64>& {
    out :~ s.rateBlocks
    for i in range 4: out[i] = 0.0
    slope := s.slope()
    if not (slope > 0.0 and slope <= F64.Max): return out
    sigma := k / slope
    e :~ s.E
    for l in e.Links {
        if l.Folded: continue
        pre, post := e.Pops[l.Pre].Role == neuron.Role.Readout, e.Pops[l.Post].Role == neuron.Role.Readout
        out[0 if not pre and not post else 2 if pre and post else 1] = sigma
    }
    for p in e.Pops {
        if p.Role != neuron.Role.Input and p.Role != neuron.Role.Readout: out[3] = out[3].Max(neuron.Slope(p.Model))
    }
    return out
}

# the rate in the block norm |x|_t = max(|x_h|, |x_y| / t) (h the hidden units, y the readouts, each part in Bound's
# norm): a sweep's Jacobian (1 - dt) + dt (W D + beta J_F) has blocks bounded by the matrix M = [a b; c d] - a =
# sigma_hh s_h, b = sigma_hy s_y, c = sigma_hy s_h, d = sigma_yy s_y + beta f, s_y the readouts' largest slope over the
# ball (neuron.SlopeOver) and f the force's Jacobian over it (neuron.ForceOver: between units at +beta, whole at -beta)
# - so its norm in |.|_t is at most (1 - dt) + dt kappa_t, kappa_t = max(a + b t, c / t + d), least at M's Perron
# vector (1, t) where it is M's spectral radius. Saturated readouts (s_y small) leave the hidden-readout coupling
# little: with no lateral blocks the condition is beta f < 1 - kappa^2 s_y / s_h instead of beta f < 1 - kappa. The ball
# argument is plainRate's in |.|_t: the start's residual is at most max(rest, (rest + beta |F|) / t) (the force is the
# readouts'), the y-ball's radius r t. t is taken from M at the previous radius (the free state's first) and r grown
# by a quarter until the ball holds at that t; 1 where M's spectral radius reaches 1 or nothing holds in 100 growths
fn (s System<T>&) blockRate(row I64, blocks Array<F64>&, b F64, rest F64) F64, F64 {
    if blocks[1] == 0.0: return 1.0, 0.0
    euclid := s.Bound == Norm.Spectral
    size := b * s.forceSize(row, euclid)
    m :~ s.blockMatrix(row, blocks, b, 0.0)
    t := perron(m)
    if t == 0.0: return 1.0, 0.0
    r := rest.Max((rest + size) / t) / (1.0 - kappaAt(m, t))
    for _ in range 100 {
        m ~ s.blockMatrix(row, blocks, b, r * t)
        start := rest.Max((rest + size) / t)
        minus := kappaAt(m, t)
        if minus < 1.0 and (1.0 - minus) * r >= start {
            plus := (m[0] + m[1] * t).Max(m[2] / t + m[4])
            return rateOf(s.E.Dt / (1.0 + b * s.E.ForceSlope()), plus).Max(rateOf(s.E.Dt, minus)), t
        }
        t = perron(m)
        if t == 0.0: return 1.0, 0.0
        r *= 1.25
    }
    return 1.0, 0.0
}

# blockRate's M within radius ry of row's readouts: [a, b, c, d at -beta, d at +beta]
fn (s System<T>&) blockMatrix(row I64, blocks Array<F64>&, b F64, ry F64) Array<F64>& {
    euclid := s.Bound == Norm.Spectral
    sy := s.readoutSlope(row, ry)
    c, w := s.forceOver(row, ry, euclid)
    sh := blocks[3]
    m :~ s.rateM
    m[0], m[1], m[2] = blocks[0] * sh, blocks[1] * sy, blocks[1] * sh
    m[3], m[4] = blocks[2] * sy + b * w, blocks[2] * sy + b * c
    return m
}

# kappa_t of M at -beta: max(a + b t, c / t + d)
fn kappaAt(m Array<F64>&, t F64) F64 { return (m[0] + m[1] * t).Max(m[2] / t + m[3]) }

# the weight t of M's Perron vector (1, t) at -beta, where kappa_t is M's spectral radius (b t^2 + (a - d) t - c = 0);
# 0 where that radius is 1 or more (nothing certified) or the blocks do not couple
fn perron(m Array<F64>&) F64 {
    a, b, c, d := m[0], m[1], m[2], m[3]
    radius := (a + d) / 2.0 + (((a - d) / 2.0).Pow(2.0) + b * c).Sqrt()
    if not (radius < 1.0) or b <= 0.0 or c <= 0.0: return 0.0
    return (radius - a) / b
}

# the readouts' largest slope with each potential of row moved by at most r (neuron.SlopeOver); infinite for a readout
# not a rate population
fn (s System<T>&) readoutSlope(row I64, r F64) F64 {
    worst F64 = 0.0
    for p in s.E.Pops {
        if p.Role != neuron.Role.Readout: continue
        model := p.Model
        if model != neuron.Neuron.Rate: return Inf
        rho := model.rho
        for j in range p.Size {
            u := F64(p.R0.U[row * p.Size + j])
            worst = worst.Max(neuron.SlopeOver(rho, u - r, u + r))
        }
    }
    return worst
}

# the size of the readouts' force in row of the free phase, per unit of beta, in the certificate's norm
fn (s System<T>&) forceSize(row I64, euclid Bool) F64 {
    total F64 = 0.0
    for p in s.E.Pops {
        role := p.Role
        if role != neuron.Role.Readout: continue
        size := neuron.ForceSize(role.cost, p.R0.S, row * p.Size, p.Size, p.Labels, row * settle.GroupsOf(role), p.Target, row * p.Size, euclid)
        total = total + size if euclid else total.Max(size)
    }
    return total.Sqrt() if euclid else total
}

# the readouts' largest force Jacobian within r of row's free state, between units and whole (neuron.ForceOver)
fn (s System<T>&) forceOver(row I64, r F64, euclid Bool) F64, F64 {
    most, whole F64 = 0.0, 0.0
    for p in s.E.Pops {
        role := p.Role
        if role != neuron.Role.Readout: continue
        if p.Model != neuron.Neuron.Rate: return Inf, Inf
        c, w := neuron.ForceOver(role.cost, p.Model.rho, p.R0.U, row * p.Size, p.Size, r, euclid)
        most, whole = most.Max(c), whole.Max(w)
    }
    return most, whole
}

# the training tolerance (settling.md 1.4): phases solved to it add an error no larger than the contrast's O(beta^2)
# bias - max(beta^3 (1 - kappa) / 10, 100 u), kappa held at most 0.9. The residual is tested in the certificate's own
# norm (BudgetFor: unit by unit under Sup, each row's Euclidean norm under Spectral), so the distance bound
# |v - v*| <= tau / (1 - kappa) holds in that norm, and per unit under either (|x|_inf <= |x|_2). A spiking system's:
# two spikes a window
fn (s mut System<T>&) LessonTolerance(beta F64) F64 {
    if s.E.Spiking: return 2.0 / F64(s.E.Window)
    kappa := s.Kappa().Min(0.9)
    return (beta * beta * beta * (1.0 - kappa) / 10.0).Max(100.0 * roundoff<T>())
}

# a budget for a settle to tol, free or nudged with beta: twice the sweeps the certificate says a cold start needs
# (ln tol / ln q, q held at most 0.95), at least 128, tested in the certificate's norm (Euclid under Spectral); a
# spiking system's 32 windows
fn (s mut System<T>&) BudgetFor(tol F64, beta F64 = 0) settle.Budget {
    if s.E.Spiking: return settle.Budget(32 * s.E.Window, tol, 0.0, s.Scheme)
    return s.BudgetAt(tol, s.Rate(beta).Min(0.95))
}

# a budget for a settle to tol at the certified rate q: twice the sweeps q says a cold start needs, at least 128,
# tested in the certificate's norm
fn (s System<T>&) BudgetAt(tol F64, q F64) settle.Budget {
    return settle.Budget(I64((2.0 * tol.Log() / q.Log()).Ceil().Max(128.0)), tol, 0.0, s.Scheme, s.Bound == Norm.Spectral)
}

# the unit roundoff of T
fn roundoff<T>() F64 {
    return match T {
        case F32: 5.960464477539063e-8
        case F64: 1.1102230246251565e-16
    }
}

# ---- what must not allocate, decided while compiling (S17a, G42): structure changed in place, state moved between
# settles, a settle and a nudged one (the sweeps' own pieces are pinned in dyn/settle, dyn/neuron and dyn/conn) ----

fn pruneOf(s mut System<F32>&, keep Array<Bool>&) { s.Prune(Conn(0), keep) }
fn retireOf(s mut System<F32>&) { s.Retire(Pop(0), 0) }
fn compactOf(s mut System<F32>&) { s.Compact() }
fn holdOf(s mut System<F32>&) { s.Hold() }
fn restOf(s mut System<F32>&) {
    s.Reset(settle.Phase.Free)
    s.Warm(settle.Phase.Plus, settle.Phase.Free)
}

assert not pruneOf.Allocates, "pruning allocates"
assert not retireOf.Allocates, "retiring a unit allocates"
assert not compactOf.Allocates, "compacting allocates"
assert not holdOf.Allocates, "holding masked weights at zero allocates"
assert not restOf.Allocates, "a cold or warm start allocates"
assert not System<F32>.Settle.Allocates, "a settle allocates"
assert not System<F32>.Nudged.Allocates, "a nudged settle allocates"

# ---- tests ----

# x (3 linear inputs) -> h (5) <-> y (2), h with a lateral block: every wiring of the rate path, F64
fn small(s mut System<F64>&, rho neuron.Rho, lateral conn.Wiring, r mut rand.Rand&) {
    root := s.Root()
    x := s.Population(root, "x", 3, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 5, neuron.Neuron.Rate(rho))
    y := s.Population(root, "y", 2, neuron.Neuron.Rate(rho), neuron.Role.Readout(neuron.Cost.Squared))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Connect(h, h, lateral, reciprocal = true)
    s.Plan(r)!
    for b in range s.Batch {
        for j in range 3: s.Pop(x).Drive[b * 3 + j] = r.Uniform(-1.0, 1.0)
    }
    for j in range 7: s.E.Params[s.Pop(h).Bias + j] = r.Uniform(-0.2, 0.2)
}

# Gaussian elimination of a x = b, n unknowns
fn solve(a mut Array<F64>&, b mut Array<F64>&, n I64) {
    for c in range n {
        p := c
        for i in range c + 1, n: p = i if a[i * n + c].Abs() > a[p * n + c].Abs() else p
        for k in range n { t := a[c * n + k]
            a[c * n + k] = a[p * n + k]
            a[p * n + k] = t }
        t := b[c]
        b[c] = b[p]
        b[p] = t
        for i in range c + 1, n {
            f := a[i * n + c] / a[c * n + c]
            for k in range c, n: a[i * n + k] -= f * a[c * n + k]
            b[i] -= f * b[c]
        }
    }
    for c := n - 1, c >= 0, c-- {
        for k in range c + 1, n: b[c] -= a[c * n + k] * b[k]
        b[c] /= a[c * n + c]
    }
}

test SettleOn "G-M2's rule: the CPU below batch x width 16384, the GPU from it where there is one" {
    assert SettleOn(32, 128) == device.Backend.Cpu and SettleOn(64, 128) == device.Backend.Cpu and SettleOn(32, 256) == device.Backend.Cpu
    big := device.Backend.Gpu if device.GpuAvailable() else device.Backend.Cpu
    assert SettleOn(128, 128) == big and SettleOn(32, 512) == big and SettleOn(512, 1024) == big
}

test System.Settle "linear neurons settle to the solution of (I - W_eff) v = c, c the bias and the folded input" {
    r := rand.Rand(2)
    s := System<F64>(2, 1, 1)
    small(s, neuron.Rho.Linear, conn.Wiring.Dense, r)
    s.Certify(0.8)
    out := s.Settle(settle.Phase.Free, settle.Budget(400, 1e-12))
    assert out.Converged
    for b in range 2 {
        # the relaxing units h (0 .. 5) and y (5 .. 7): v = c + W_eff v
        a := Array<F64>(49)
        c := Array<F64>(7)
        wx := s.Weights(Conn(0))
        wy := s.Weights(Conn(1))
        wl := s.Weights(Conn(2))
        for i in range 7: a[i * 7 + i] = 1.0
        for i in range 5 {
            c[i] = s.E.Params[s.Pop(Pop(1)).Bias + i]
            for j in range 3: c[i] += wx.Get(i, j) * s.Pop(Pop(0)).Drive[b * 3 + j]
            for j in range 5: a[i * 7 + j] -= wl.Get(i, j) + wl.Get(j, i)
            for k in range 2: a[i * 7 + 5 + k] -= wy.Get(k, i)
        }
        for k in range 2 {
            c[5 + k] = s.E.Params[s.Pop(Pop(2)).Bias + k]
            for i in range 5: a[(5 + k) * 7 + i] -= wy.Get(k, i)
        }
        solve(a, c, 7)
        h := s.Activity(settle.Phase.Free, Pop(1))
        y := s.Activity(settle.Phase.Free, Pop(2))
        for i in range 5: assert (h.Get(b, i) - c[i]).Abs() < 1e-10
        for k in range 2: assert (y.Get(b, k) - c[5 + k]).Abs() < 1e-10
    }
}

# x (one input, drive 1) -> h (n linear units, a uniform positive lateral block) certified at kappa: the bound of the
# certificate is tight here - the residual of a cold settle shrinks by exactly kappa a sweep
fn System<T>.tight(n I64, kappa F64) System<T> {
    r := rand.Rand(3)
    s := System<T>(1, 1, 1)
    root := s.Root()
    x := s.Population(root, "x", 1, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", n, neuron.Neuron.Rate(neuron.Rho.Linear))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, h, conn.Wiring.Symmetric)
    s.Plan(r)!
    s.Weights(Conn(0)).Fill(1.0)
    s.Weights(Conn(1)).Fill(1.0)
    s.Pop(x).Drive[0] = 1.0
    s.Certify(kappa)
    return s
}

test System.Settle "the certificate's sweep counts at kappa 0.9: a cold settle needs ln(tol) / ln(0.9) sweeps - 64 at the lesson tolerance, 66 at 1e-3, 71 at the life tolerance" {
    s := System<F64>.tight(16, 0.9)
    assert (s.Gain() - 0.9).Abs() < 1e-12
    wants := Array<I64>[64, 66, 71]
    for i, tol in Array<F64>[1.25e-3, 1e-3, 6.25e-4] {
        want := wants[i]
        s.Reset(settle.Phase.Free)
        out := s.Settle(settle.Phase.Free, settle.Budget(128, tol))
        assert out.Converged and out.Sweeps == want, "tol " + $tol + ": " + $out.Sweeps + " sweeps"
        assert out.Sweeps <= I64((tol.Log() / 0.9.Log()).Ceil())
    }
    # the equilibrium: v = 1 + 0.9 v, every unit
    assert (s.Activity(settle.Phase.Free, Pop(1)).Get(0, 3) - 10.0).Abs() < 1e-3 / (1.0 - 0.9)
    # a warm start from it needs none
    assert s.Settle(settle.Phase.Free, settle.Budget(128, 6.25e-4)).Sweeps == 0
}

test System.Settle "a refusal: a budget too small ends unconverged, with the sweeps it took" {
    s := System<F64>.tight(4, 0.9)
    out := s.Settle(settle.Phase.Free, settle.Budget(10, 1e-3))
    assert not out.Converged and out.Sweeps == 10 and not out.Diverged()
    s.Weights(Conn(1)).Fill(1e300)
    s.Reset(settle.Phase.Free)
    assert s.Settle(settle.Phase.Free, settle.Budget(20, 1e-3)).Diverged()
}

test System.Settle "damping changes the path, not the equilibrium, and removes a period-2 cycle" {
    # a linear neuron feeding itself with weight -1: v <- 1 - v swings between 0 and 1 with a residual that never
    # shrinks; a step shortened by half lands on 1 / 2 at once
    s := System<F64>(1)
    h := s.Population(s.Root(), "h", 1, neuron.Neuron.Rate(neuron.Rho.Linear))
    s.Connect(h, h, conn.Wiring.Dense)
    s.Plan(rand.Rand(7))!
    s.Weights(Conn(0)).Fill(-1.0)
    s.Bias(h).Fill(1.0)
    out := s.Settle(settle.Phase.Free, settle.Budget(100, 1e-10))
    assert not out.Converged and out.Sweeps == 100
    s.Reset(settle.Phase.Free)
    damped := s.Settle(settle.Phase.Free, settle.Budget(100, 1e-10, 0.5))
    assert damped.Converged and (s.Activity(settle.Phase.Free, h).Get(0, 0) - 0.5).Abs() < 1e-12
    # a damped settle of a certified system ends where an undamped one does
    t := System<F64>.tight(8, 0.9)
    t.Settle(settle.Phase.Free, settle.Budget(400, 1e-13))
    star := Array<F64>[t.Activity(settle.Phase.Free, Pop(1)).Get(0, i) for i in range 8]
    t.Reset(settle.Phase.Free)
    assert t.Settle(settle.Phase.Free, settle.Budget(2000, 1e-13, 0.5)).Converged
    for i in range 8: assert (t.Activity(settle.Phase.Free, Pop(1)).Get(0, i) - star[i]).Abs() < 2e-12
}

# x (20 inputs) -> a (24 tanh) <-> b (16 tanh) <-> y (6, cross-entropy in two groups) with every wiring: a dense input,
# a reciprocal sparse block, a low-rank one, a lateral tiled block, an event-driven feedback, a symmetric readout; F32,
# batch rows (130: three chunks a phase, the last short) and threads as given
fn System<T>.mixed(batch I64, threads I64) System<T> {
    r := rand.Rand(5)
    s := System<T>(batch, threads)
    root := s.Root()
    x := s.Population(root, "x", 20, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    a := s.Population(root, "a", 24, neuron.Neuron.Rate(neuron.Rho.Tanh))
    b := s.Population(root, "b", 16, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(root, "y", 6, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.CrossEntropy(0.25, 2)))
    s.Connect(x, a, conn.Wiring.Dense)
    s.Connect(a, b, conn.Wiring.Csr(0.4), reciprocal = true)
    s.Connect(a, b, conn.Wiring.LowRank(3))
    s.Connect(a, a, conn.Wiring.Tiles(8, 0.6), reciprocal = true)
    s.Connect(b, a, conn.Wiring.Events(1e-5))
    s.Connect(b, y, conn.Wiring.Symmetric)
    s.Plan(r)!
    for i in range batch * 20: s.Pop(x).Drive[i] = T(r.Uniform(-1.0, 1.0))
    for i in range batch * 2: s.Pop(y).Labels[i] = I32(r.Below(3))
    for i in range 46: s.E.Params[s.Pop(a).Bias + i] = T(r.Uniform(-0.1, 0.1))
    s.Bound = Norm.Sup                  # Gauss-Seidel's rate is proven under the sup-norm certificate (redesign 1.4)
    s.Certify(0.9)
    return s
}

# x (8 inputs) -> h (32 tanh) <-> y (4, cross-entropy): a chain whose answers follow its inputs, certified at 0.9
fn System<T>.chain(batch I64) System<T> {
    r := rand.Rand(9)
    s := System<T>(batch, 1)
    root := s.Root()
    x := s.Population(root, "x", 8, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 32, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(root, "y", 4, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.CrossEntropy(0.25, 1)))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Plan(r)!
    for i in range batch * 8: s.Pop(x).Drive[i] = T(r.Uniform(-3.0, 3.0))
    s.Bound = Norm.Sup
    s.Certify(0.9)
    return s
}

# the chain settled, then the drive of every other row turned round: a warm start whose answers move
fn System<T>.turned(rows I64) System<T> {
    s := System<T>.chain(rows)
    s.Settle(settle.Phase.Free, settle.Budget(400, 1e-12))
    for r in range 0, rows, 2 {
        for i in range 8: s.Pop(Pop(0)).Drive[r * 8 + i] = -s.Pop(Pop(0)).Drive[r * 8 + i]
    }
    return s
}

# the readout's answers (its largest unit) in the free phase's rows that agree between two chains
fn sameAnswers<T>(p System<T>&, q System<T>&, rows I64) I64 {
    u := p.State<neuron.RateCell<T>>(Pop(2)).S
    v := q.State<neuron.RateCell<T>>(Pop(2)).S
    same I64 = 0
    for r in range rows {
        if halt.ArgMax(u, r * 4, 4) == halt.ArgMax(v, r * 4, 4): same += 1
    }
    return same
}

test System.Settle "a stable answer stops a settle (Budget.Stable): fewer sweeps than the tolerance needs, nearly every answer the converged state's; with per-row stops each row at its own sweep" {
    full := System<F64>.turned(130)
    f := full.Settle(settle.Phase.Free, settle.Budget(2000, 1e-12, 0.5))
    assert f.Converged and not f.Halted
    for euclid in Array<Bool>[false, true] {
        s := System<F64>.turned(130)
        h := s.Settle(settle.Phase.Free, settle.Budget(2000, 1e-12, 0.5, settle.Sweeping(), euclid, 3))
        assert h.Halted and not h.Converged and h.Sweeps < f.Sweeps, $h + " against " + $f
        assert sameAnswers(full, s, 130) >= 125, $sameAnswers(full, s, 130) + " of 130 answers"
        if not euclid: continue
        early I64 = 0
        for r in range 130 {
            # a row left as it was is at its fixed point and stops on the tolerance at once; a turned one on its answer
            if r % 2 == 1: assert s.E.RowStop[r] == 0, "row " + $r + " stopped at " + $s.E.RowStop[r]
            if r % 2 == 1: continue
            assert s.E.RowStop[r] >= 3 and s.E.RowStop[r] <= h.Sweeps, "row " + $r + " stopped at " + $s.E.RowStop[r]
            if s.E.RowStop[r] < h.Sweeps: early += 1
        }
        assert early > 0, "every turned row stopped at sweep " + $h.Sweeps
    }
    # a budget without it never halts
    t := System<F64>.turned(130)
    assert not t.Settle(settle.Phase.Free, settle.Budget(2000, 1e-12, 0.5)).Halted
}

# a and b's state, every phase, against another's: the same bit for bit
fn sameState<T>(p System<T>&, q System<T>&) Bool {
    for i in range 1, 4 {
        u :~ p.State<neuron.RateCell<T>>(Pop(i))
        v :~ q.State<neuron.RateCell<T>>(Pop(i))
        if u.U != v.U or u.S != v.S: return false
    }
    return true
}

test System.Settle "Jacobi sweeps in tasks equal one thread bit for bit, free and nudged, every wiring" {
    one := System<F32>.mixed(130, 1)
    free := one.Settle(settle.Phase.Free, settle.Budget())
    nudged := one.Nudged(settle.Budget())
    assert free.Converged and nudged.Converged, "free " + $free + " nudged " + $nudged
    for threads in range 2, 5 {
        s := System<F32>.mixed(130, threads)
        s.E.TaskWork = 0                            # every sweep in tasks, however small
        assert s.Settle(settle.Phase.Free, settle.Budget()).Sweeps == free.Sweeps
        assert s.Nudged(settle.Budget()).Sweeps == nudged.Sweeps
        assert sameState(one, s), $threads + " threads"
    }
}

# the largest difference of p's potentials from q's, every relaxing population and phase
fn apart<T>(p System<T>&, q System<T>&) F64 {
    worst := 0.0
    for i in range 1, p.E.Pops.Len() {
        u := p.State<neuron.RateCell<T>>(Pop(i)).U
        v := q.State<neuron.RateCell<T>>(Pop(i)).U
        for j in range u.Len(): worst = worst.Max(F64(u[j] - v[j]).Abs())
    }
    return worst
}

test System.Use "Anderson and Gauss-Seidel sweeps settle where plain Jacobi sweeps do, free and nudged, every wiring, in fewer sweeps" {
    plain := System<F64>.mixed(4, 1)
    b := settle.Budget(2000, 1e-11)
    free := plain.Settle(settle.Phase.Free, b)
    nudged := plain.Nudged(b)
    assert free.Converged and nudged.Converged
    ways := Array<settle.Sweeping>[settle.Sweeping(5), settle.Sweeping(0, true), settle.Sweeping(3, true)]
    for way in ways {
        s := System<F64>.mixed(4, 2)
        s.Use(way)
        f := s.Settle(settle.Phase.Free, s.BudgetFor(1e-11))
        n := s.Nudged(s.BudgetFor(1e-11, 0.5))
        assert f.Converged and n.Converged, $way + ": " + $f + " " + $n
        # the event-driven feedback carries a unit's change only past 1e-5: where it is left depends on the path, by
        # about that over 1 - kappa
        assert apart(plain, s) < 1e-5, $way + ": " + $apart(plain, s)
        assert f.Sweeps < free.Sweeps and n.Sweeps < nudged.Sweeps, $way + ": " + $f.Sweeps + " and " + $n.Sweeps + " sweeps against " + $free.Sweeps + " and " + $nudged.Sweeps
    }
    # no event-driven connection: the same fixed point to what the tolerance leaves, tol / (1 - kappa)
    p := System<F64>(3)
    small(p, neuron.Rho.Tanh, conn.Wiring.Tiles(2, 0.7), rand.Rand(6))
    p.Certify(0.9)
    p.Settle(settle.Phase.Free, b)
    p.Nudged(b)
    for way in ways {
        q := System<F64>(3)
        small(q, neuron.Rho.Tanh, conn.Wiring.Tiles(2, 0.7), rand.Rand(6))
        q.Certify(0.9)
        q.Use(way)
        assert q.Settle(settle.Phase.Free, q.BudgetFor(1e-11)).Converged and q.Nudged(q.BudgetFor(1e-11, 0.5)).Converged
        assert apart(p, q) < 2e-10, $way + ": " + $apart(p, q)
    }
    # in tasks, bit for bit as one thread
    one := System<F32>.mixed(130, 1)
    one.Use(settle.Sweeping(4, true))
    one.Settle(settle.Phase.Free, one.BudgetFor(1e-5))
    one.Nudged(one.BudgetFor(1e-5, 0.5))
    many := System<F32>.mixed(130, 3)
    many.Use(settle.Sweeping(4, true))
    many.E.TaskWork = 0
    many.Settle(settle.Phase.Free, many.BudgetFor(1e-5))
    many.Nudged(many.BudgetFor(1e-5, 0.5))
    assert sameState(one, many)
}

test System.Use "Gauss-Seidel sweeps a one-way chain in its order, whatever order its populations were made in: one sweep reaches the fixed point" {
    s := System<F64>(2, 1, 1)
    root := s.Root()
    c := s.Population(root, "c", 3, neuron.Neuron.Rate(neuron.Rho.Tanh))
    b := s.Population(root, "b", 4, neuron.Neuron.Rate(neuron.Rho.Tanh))
    a := s.Population(root, "a", 5, neuron.Neuron.Rate(neuron.Rho.Tanh))
    x := s.Population(root, "x", 2, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    s.Connect(x, a, conn.Wiring.Dense)
    s.Connect(b, c, conn.Wiring.Dense)
    s.Connect(a, b, conn.Wiring.Dense)
    s.Plan(rand.Rand(4))!
    for i in range 4: s.Pop(x).Drive[i] = 0.5 * F64(i) - 0.7
    jacobi := s.Settle(settle.Phase.Free, settle.Budget(50, 1e-14))
    s.Reset(settle.Phase.Free)
    s.Use(settle.Sweeping(0, true))
    seidel := s.Settle(settle.Phase.Free, s.BudgetFor(1e-14))
    assert jacobi.Sweeps == 3 and seidel.Sweeps == 1, $jacobi.Sweeps + " and " + $seidel.Sweeps
}

test System.Contraction "the spectral bound: kappa exactly where the coupling is uniform, the largest singular value of the dense coupling where it is not" {
    t := System<F64>.tight(16, 0.9)
    assert (t.Contraction() - 0.9).Abs() < 1e-8, $t.Contraction()
    r := rand.Rand(2)
    s := System<F64>(2, 1, 1)
    small(s, neuron.Rho.Tanh, conn.Wiring.Dense, r)
    s.Certify(0.8)
    # W_eff over h (0 .. 5) and y (5 .. 7), as the linear test reads it; its largest singular value by power iteration
    a := coupling(s)
    v := Array<F64>(7, 1.0)
    sigma := 0.0
    for _ in range 5000 {
        w := times(a, v, 7, false)
        sigma = length(w)
        u := times(a, w, 7, true)
        size := length(u)
        for j in range 7: v[j] = u[j] / size
    }
    assert (s.Contraction() - sigma).Abs() < 1e-7 * sigma, $s.Contraction() + " against " + $sigma
    assert s.Contraction() <= s.Gain() + 1e-12
    # every wiring, F32: at most the gain (the coupling is not symmetric, the bound still well below)
    m := System<F32>.mixed(4, 1)
    assert m.Contraction() > 0.0 and m.Contraction() < m.Gain(), $m.Contraction() + " against the gain " + $m.Gain()
}

# small's coupling between relaxing units, dense: W_eff over h (0 .. 5) and y (5 .. 7), 7 x 7
fn coupling(s System<F64>&) Array<F64> {
    a := Array<F64>(49)
    wy := s.Weights(Conn(1))
    wl := s.Weights(Conn(2))
    for i in range 5 {
        for j in range 5: a[i * 7 + j] = wl.Get(i, j) + wl.Get(j, i)
        for k in range 2 {
            a[i * 7 + 5 + k] = wy.Get(k, i)
            a[(5 + k) * 7 + i] = wy.Get(k, i)
        }
    }
    return a
}

# the largest singular value of a (n x n) by a dense method: the largest eigenvalue of a^T a by cyclic Jacobi
# rotations (until the off-diagonal is below 1e-30), its square root
fn singular(a Array<F64>&, n I64) F64 {
    b := Array<F64>(n * n)
    for i in range n {
        for j in range n: b[i * n + j] = dot(a, i, j, n)
    }
    for _ in range 100 {
        if offDiagonal(b, n) < 1e-30: break
        for p in range n {
            for q in range p + 1, n: rotate(b, n, p, q)
        }
    }
    most := 0.0
    for i in range n: most = most.Max(b[i * n + i])
    return most.Sqrt()
}

# (a^T a)[i, j]: column i of a against column j
fn dot(a Array<F64>&, i I64, j I64, n I64) F64 {
    t := 0.0
    for k in range n: t += a[k * n + i] * a[k * n + j]
    return t
}

fn offDiagonal(b Array<F64>&, n I64) F64 {
    t := 0.0
    for p in range n {
        for q in range p + 1, n: t += b[p * n + q] * b[p * n + q]
    }
    return t
}

# b <- J^T b J for the Jacobi rotation in the plane (p, q) that zeroes b[p, q]
fn rotate(b mut Array<F64>&, n I64, p I64, q I64) {
    if b[p * n + q] == 0.0: return
    theta := (b[q * n + q] - b[p * n + p]) / (2.0 * b[p * n + q])
    sign := 1.0 if theta >= 0.0 else -1.0
    t := sign / (theta.Abs() + (theta * theta + 1.0).Sqrt())
    c := 1.0 / (t * t + 1.0).Sqrt()
    sn := t * c
    for k in range n {
        bp, bq := b[k * n + p], b[k * n + q]
        b[k * n + p] = c * bp - sn * bq
        b[k * n + q] = sn * bp + c * bq
    }
    for k in range n {
        bp, bq := b[p * n + k], b[q * n + k]
        b[p * n + k] = c * bp - sn * bq
        b[q * n + k] = sn * bp + c * bq
    }
}

test System.Contraction "the spectral bound against a dense SVD of the coupling, four random systems; certified and restrained in the spectral norm it is the target, and the warm power iteration (Kappa) follows a step of the weights" {
    for seed in range 2, 6 {
        r := rand.Rand(U64(seed))
        s := System<F64>(2, 1, 1)
        small(s, neuron.Rho.Tanh, conn.Wiring.Dense, r)
        sigma := singular(coupling(s), 7)
        assert (s.Contraction() - sigma).Abs() < 1e-8 * sigma, "seed " + $seed + ": " + $s.Contraction() + " against " + $sigma
        s.Bound = Norm.Spectral
        s.Certify(0.8)
        assert (singular(coupling(s), 7) - 0.8).Abs() < 1e-6, "certified: " + $singular(coupling(s), 7)
        # a step of the weights (every recurrent one doubled): Kappa, warm from the last vector, sees it; Restrain brings it back
        s.scale(2.0)
        assert (s.Kappa() - 1.6).Abs() < 1e-5, "after the step: " + $s.Kappa()
        s.Restrain(0.8)
        assert (singular(coupling(s), 7) - 0.8).Abs() < 1e-5, "restrained: " + $singular(coupling(s), 7)
        # inside the set already: left as it is
        s.Restrain(0.9)
        assert (singular(coupling(s), 7) - 0.8).Abs() < 1e-5
    }
}

# x (3 inputs) -> h (24 tanh units, a dense lateral block both ways) <-> y (4): a coupling whose spectral bound is far
# below its gain
fn System<T>.wide(seed U64) System<T> {
    r := rand.Rand(seed)
    s := System<T>(2, 1, 1)
    root := s.Root()
    x := s.Population(root, "x", 3, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 24, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(root, "y", 4, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Squared))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, h, conn.Wiring.Dense, reciprocal = true)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Plan(r)!
    for i in range 6: s.Pop(x).Drive[i] = T(r.Uniform(-1.0, 1.0))
    return s
}

test System.Certify "certified in the spectral norm (the gain above 1, outside the sup-norm certificate) a settle converges within the budget, and a cold and a warm start reach one fixed point" {
    s := System<F64>.wide(4)
    s.Bound = Norm.Spectral
    s.Certify(0.9)
    assert (s.Contraction() - 0.9).Abs() < 1e-7, $s.Contraction()
    assert s.Gain() > 1.0, "the gain " + $s.Gain()
    tol := 1e-10
    cold := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
    assert cold.Converged, $cold.Sweeps + " sweeps, residual " + $cold.Residual
    first := Array<F64>[s.Activity(settle.Phase.Free, Pop(1)).Get(k / 24, k % 24) for k in range 48]
    # another drive settled, then the first again from there
    x :~ s.Pop(Pop(0))
    for i in range 6: x.Drive[i] = -x.Drive[i]
    assert s.Settle(settle.Phase.Free, s.BudgetFor(tol)).Converged
    for i in range 6: x.Drive[i] = -x.Drive[i]
    warm := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
    assert warm.Converged
    # each row within tol / (1 - kappa) of the fixed point in the Euclidean norm (the residual tested row by row),
    # tanh's slope 1: per unit, and over the row
    h := s.Activity(settle.Phase.Free, Pop(1))
    for b in range 2 {
        d := 0.0
        for i in range 24: d += (h.Get(b, i) - first[b * 24 + i]) * (h.Get(b, i) - first[b * 24 + i])
        assert d.Sqrt() < 2.0 * tol / 0.1, "row " + $b + ": " + $d.Sqrt()
    }
}

test System.BudgetFor "under the spectral certificate the residual is tested row by row in the Euclidean norm: the settlement's residual is a row's norm, at least its largest unit's and at most sqrt(n) times it" {
    s := System<F64>.wide(5)
    s.Bound = Norm.Spectral
    s.Certify(0.9)
    b := s.BudgetFor(1e-6)
    assert b.Euclid
    rows := s.Settle(settle.Phase.Free, settle.Budget(3, 0.0, 0.0, settle.Sweeping(), true))
    s.Reset(settle.Phase.Free)
    units := s.Settle(settle.Phase.Free, settle.Budget(3, 0.0))
    assert rows.Residual >= units.Residual and rows.Residual <= 28.0.Sqrt() * units.Residual, $rows.Residual + " against " + $units.Residual
    assert s.Settle(settle.Phase.Free, b).Converged
}

test System.Rate "a nudged phase counts the cross-entropy force's coupling: kappa + beta c at +beta, kappa + beta (f + c) at -beta; the nudged pair at beta 0.5 settles within its budget though the bound certifies neither phase" {
    s := System<F64>.wideClasses(6)
    s.Bound = Norm.Spectral
    s.Certify(0.9)
    # Classes(): T = 0.25, so the self-slope f and the coupling c are 1 each, tanh's slope 1
    assert (s.NudgedKappa(0.05) - 0.95).Abs() < 1e-6 and (s.NudgedKappa(-0.05) - 1.0).Abs() < 1e-6
    assert s.Rate(0.04) < 1.0 and s.Rate(0.5) == 1.0
    tol := s.LessonTolerance(0.5)
    assert s.Settle(settle.Phase.Free, s.BudgetFor(tol)).Converged
    for k in range 4 {
        for i in range 2: s.Pop(Pop(2)).Labels[i] = I32((k + i) % 4)
        out := s.Nudged(s.BudgetFor(tol, 0.5), 0.5)
        assert out.Converged, "labels " + $k + ": " + $out.Sweeps + " sweeps, residual " + $out.Residual
    }
}

test System.NudgedRate "the nudged pair's rate bounded over the region it can reach certifies beta 0.5 for a confident readout, which the worst case does not, and every sweep shrinks the residual by at most that rate" {
    for bound in [Norm.Spectral, Norm.Sup] {
        s := System<F64>.confident(6, 3.0, 0.5, bound)
        tol := s.LessonTolerance(0.5)
        free := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
        assert free.Converged
        for k in range 4 {
            for i in range 2: s.Pop(Pop(2)).Labels[i] = I32((k + i) % 4)
            q, rows := s.NudgedRate(0.5, free)
            assert s.Rate(0.5) == 1.0 and q < 1.0 and rows == 2, $bound + " labels " + $k + ": rate " + $q
            assertContracts(s, 0.5, free, s.BudgetAt(tol, q).Sweeps, tol)
        }
    }
}

test System.NudgedRate "soundness: over random systems, kappas, readout confidences, betas, labels and both norms, every settle the rate certifies shrinks its residual by at most that rate every sweep - the contraction measured between consecutive states - and the bound is no looser than needed to certify some and refuse others" {
    certified, refused := 0, 0
    tightest F64 = 0.0
    for trial in range 96 {
        bound := Norm.Spectral if trial % 2 == 0 else Norm.Sup
        s := System<F64>.confident(U64(100 + trial), [0.0, 1.0, 2.0, 4.0][trial / 2 % 4], [0.2, 0.5, 0.8][trial / 8 % 3], bound)
        beta := [0.1, 0.25, 0.5, 1.0][trial / 24]
        tol := s.LessonTolerance(beta)
        free := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
        assert free.Converged
        for i in range 2: s.Pop(Pop(2)).Labels[i] = I32((trial * 7 + i * 3) % 4)
        q, _ := s.NudgedRate(beta, free)
        if q >= 1.0 {
            refused++
            continue
        }
        certified++
        tightest = tightest.Max(assertContracts(s, beta, free, s.BudgetAt(tol, q).Sweeps, tol))
    }
    assert certified >= 24 and refused >= 12, $certified + " certified, " + $refused + " refused"
    assert tightest > 0.5, "the measured contraction at most " + $tightest + " of the certified rate"
}

test System.NudgedRate "the block norm: on a layered system (no lateral blocks) with saturated readouts it certifies rows the certificate's own norm refuses, and every row it certifies contracts at its rate in it, both phases, both norms" {
    plainRows, blockRows, gained, refused := 0, 0, 0, 0
    tightest F64 = 0.0
    for trial in range 36 {
        bound := Norm.Spectral if trial % 2 == 0 else Norm.Sup
        s := System<F64>.layered(U64(200 + trial), [1.0, 2.0, 4.0][trial / 2 % 3], bound)
        beta := [0.1, 0.5, 1.0][trial / 12]
        tol := s.LessonTolerance(beta)
        free := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
        assert free.Converged
        for i in range 2: s.Pop(Pop(2)).Labels[i] = I32((trial * 7 + i * 3) % 10)
        k := s.Kappa()
        blocks :~ s.blocks(k)
        for row in range s.E.Batch {
            plain := s.plainRate(row, k, beta, free.Residual)
            q, t := s.blockRate(row, blocks, beta, free.Residual)
            if plain < 1.0: plainRows++
            if q < 1.0: blockRows++
            if q < 1.0 and plain >= 1.0: gained++
            if q >= 1.0 and plain >= 1.0: refused++
            assert q >= 1.0 or t > 0.0
        }
        q, _ := s.NudgedRate(beta, free)
        tightest = tightest.Max(assertContracts(s, beta, free, s.BudgetAt(tol, q.Min(0.95)).Sweeps, tol))
    }
    assert gained >= 12 and refused >= 12, $plainRows + " rows certified in the plain norm, " + $blockRows + " in the block norm, " + $gained + " by it alone, " + $refused + " by neither"
    assert tightest > 0.5, "the measured contraction at most " + $tightest + " of the certified rate"
}

test System.Settle "a per-row stop: the rows of one batch stop at their own sweeps and leave the products, every one within 10 tol / (1 - kappa) of where the whole batch's settle leaves it, free and nudged, and the row-sweeps they leave out are not run" {
    mixed, skipped := 0, 0
    for trial in range 36 {
        s := System<F64>.layered(U64(200 + trial), [1.0, 2.0, 4.0][trial / 2 % 3], Norm.Spectral)
        beta := [0.1, 0.5, 1.0][trial / 12]
        tol := s.LessonTolerance(beta)
        bound := 10.0 * tol / (1.0 - s.Kappa())
        for i in range 2: s.Pop(Pop(2)).Labels[i] = I32((trial * 7 + i * 3) % 10)
        s.E.RowStops = false
        s.Reset(settle.Phase.Free)
        assert s.Settle(settle.Phase.Free, s.BudgetFor(tol)).Converged
        whole := s.potentials()
        s.E.RowStops = true
        before := s.E.Skipped
        s.Reset(settle.Phase.Free)
        free := s.Settle(settle.Phase.Free, s.BudgetFor(tol))
        assert free.Converged
        assert gap(s.potentials(), whole) <= bound, "trial " + $trial + ": the free rows stopped " + $gap(s.potentials(), whole) + " from the whole settle's"
        q, _ := s.NudgedRate(beta, free)
        b := s.BudgetAt(tol, q.Min(0.95))
        assert s.Nudged(b, beta).Converged
        at := Array<I64>(6, -1)
        for r in range 6: at[r] = s.E.RowStop[r]
        kept := s.potentials()
        skipped += s.E.Skipped - before
        s.E.RowStops = false
        s.Nudged(b, beta)
        assert gap(kept, s.potentials()) <= bound, "trial " + $trial + ": the nudged rows stopped " + $gap(kept, s.potentials()) + " from the whole settle's, tolerance " + $tol
        for r in range 2, 6 {
            if at[r] >= 0 and at[r] != at[2 + (r + 1) % 4]: mixed++
        }
    }
    assert mixed > 0 and skipped > 0, "rows stopped at their own sweeps in " + $mixed + " cases, " + $skipped + " row-sweeps left out"
}

# every relaxing population's potentials, every phase, in one array
fn (s System<T>&) potentials() Array<F64> {
    n := 0
    for i in range 1, s.E.Pops.Len(): n += s.State<neuron.RateCell<T>>(Pop(i)).U.Len()
    out := Array<F64>(n)
    at := 0
    for i in range 1, s.E.Pops.Len() {
        u := s.State<neuron.RateCell<T>>(Pop(i)).U
        for j in range u.Len(): out[at + j] = F64(u[j])
        at += u.Len()
    }
    return out
}

# the largest difference between two arrays of the same length
fn gap(a Array<F64>&, b Array<F64>&) F64 {
    dist := 0.0
    for i in range a.Len(): dist = dist.Max((a[i] - b[i]).Abs())
    return dist
}

# the nudged pair at beta settled sweep by sweep from the free state (free its settlement): in each row the rate
# certifies (rowRate), every step between consecutive states at most q times the last, measured in the norm the row's
# rate holds in (stepNorm), in both phases; the settle within tol before sweeps. Gives the largest step ratio over q
fn assertContracts(s mut System<F64>&, beta F64, free settle.Settlement, sweeps I64, tol F64) F64 {
    n := s.E.Batch
    k := s.Kappa()
    blocks :~ s.blocks(k)
    qs, ts := Array<F64>(n, 1.0), Array<F64>(n, 0.0)
    for row in range n {
        q, t := s.rowRate(row, k, blocks, beta, free.Residual)
        qs[row] = q
        ts[row] = t
    }
    one := settle.Budget(1, 0.0, 0.0, s.Scheme, s.Bound == Norm.Spectral)
    s.Nudged(one, beta)
    before := s.potentials()
    last := Array<F64>(2 * n, 0.0)
    worst F64 = 0.0
    for sweep in range 1, sweeps {
        out := s.E.Settle(1, 3, one, false)
        now := s.potentials()
        for pr in range 2 * n {
            q := qs[pr % n]
            step := s.stepNorm(before, now, n + pr, ts[pr % n])
            if q < 1.0 and last[pr] > 1e-10 {
                assert step <= q * last[pr] * (1.0 + 1e-9), "sweep " + $sweep + ", row " + $pr + ": step " + $step + " after " + $last[pr] + ", rate " + $q + ", t " + $ts[pr % n]
                worst = worst.Max(step / last[pr] / q)
            }
            last[pr] = step
        }
        before = now
        if out.Residual <= tol.Max(1e-11): return worst
    }
    assert false, "not within " + $tol + " in " + $sweeps + " sweeps"
    return worst
}

# every relaxing population's potentials, all rows, one after another
fn (s System<F64>&) potentials() Array<F64> {
    total := 0
    for p in s.E.Pops {
        if p.Role != neuron.Role.Input: total += p.R0.U.Len()
    }
    out := Array<F64>(total, 0.0)
    at := 0
    for p in s.E.Pops {
        if p.Role == neuron.Role.Input: continue
        for i in range p.R0.U.Len(): out[at + i] = p.R0.U[i]
        at += p.R0.U.Len()
    }
    return out
}

# the norm of row's step from a to b (potentials()): Bound's over every relaxing unit where t is 0, else the block norm
# max(|x_h|, |x_y| / t) of blockRate
fn (s System<F64>&) stepNorm(a Array<F64>&, b Array<F64>&, row I64, t F64) F64 {
    euclid := s.Bound == Norm.Spectral
    h, y F64 = 0.0, 0.0
    at := 0
    for p in s.E.Pops {
        if p.Role == neuron.Role.Input: continue
        readout := p.Role == neuron.Role.Readout
        for j in range p.Size {
            d := (b[at + row * p.Size + j] - a[at + row * p.Size + j]).Abs()
            part := d * d if euclid else d
            if readout { y = y + part if euclid else y.Max(part) } else { h = h + part if euclid else h.Max(part) }
        }
        at += p.R0.U.Len()
    }
    if euclid: h, y = h.Sqrt(), y.Sqrt()
    if t > 0.0: return h.Max(y / t)
    return (h * h + y * y).Sqrt() if euclid else h.Max(y)
}

# wideClasses certified at kappa in the norm bound, its readout confident: unit 0's bias +b, the others' -b
fn System<T>.confident(seed U64, b F64, kappa F64, bound Norm) System<T> {
    s := System<T>.wideClasses(seed)
    s.Bound = bound
    s.Certify(kappa)
    y := s.Bias(Pop(2))
    for j in range 4: y.Set(T(b if j == 0 else -b), j)
    return s
}

# x (8 inputs) -> h (32 tanh) <-> y (10 tanh classes, T = 0.25), MNIST's shape: no lateral block, certified at 0.9
# in the norm bound, its readout confident (unit 0's bias +b, the others' -b)
fn System<T>.layered(seed U64, b F64, bound Norm) System<T> {
    r := rand.Rand(seed)
    s := System<T>(2, 1, 3)
    root := s.Root()
    x := s.Population(root, "x", 8, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 32, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(root, "y", 10, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes()))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Plan(r)!
    for i in range 16: s.Pop(x).Drive[i] = T(r.Uniform(-1.0, 1.0))
    s.Bound = bound
    s.Certify(0.9)
    yb := s.Bias(Pop(2))
    for j in range 10: yb.Set(T(b if j == 0 else -b), j)
    return s
}

# wide's system with a cross-entropy readout (Classes: 4 classes, T = 0.25)
fn System<T>.wideClasses(seed U64) System<T> {
    r := rand.Rand(seed)
    s := System<T>(2, 1, 3)
    root := s.Root()
    x := s.Population(root, "x", 3, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 24, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(root, "y", 4, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes()))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, h, conn.Wiring.Dense, reciprocal = true)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Plan(r)!
    for i in range 6: s.Pop(x).Drive[i] = T(r.Uniform(-1.0, 1.0))
    return s
}

# a v (n x n, trans: a^T v)
fn times(a Array<F64>&, v Array<F64>&, n I64, trans Bool) Array<F64> {
    out := Array<F64>(n)
    for i in range n {
        for j in range n: out[i] += (a[j * n + i] if trans else a[i * n + j]) * v[j]
    }
    return out
}

fn length(v Array<F64>&) F64 {
    s := 0.0
    for x in v: s += x * x
    return s.Sqrt()
}

test System.Nudged "the nudged phases start from the free fixed point: +beta lowers the cost, -beta raises it" {
    s := System<F64>.mixed(4, 2)
    s.Settle(settle.Phase.Free, settle.Budget(256, 1e-9))
    free := s.Loss(settle.Phase.Free)
    out := s.Nudged(settle.Budget(256, 1e-9), 0.5)
    assert out.Converged and s.NudgeOf(settle.Phase.Plus) == 0.5 and s.NudgeOf(settle.Phase.Minus) == -0.5
    assert s.Loss(settle.Phase.Plus) < free and s.Loss(settle.Phase.Minus) > free
    # a small nudge moves the state by O(beta): the plus and minus phases straddle the free one
    s.Nudged(settle.Budget(256, 1e-12), 1e-3)
    p, f, m := s.Activity(settle.Phase.Plus, Pop(3)), s.Activity(settle.Phase.Free, Pop(3)), s.Activity(settle.Phase.Minus, Pop(3))
    for j in range 6 {
        d := (p.Get(1, j) - f.Get(1, j)) + (m.Get(1, j) - f.Get(1, j))
        assert d.Abs() < 1e-5 and (p.Get(1, j) - f.Get(1, j)).Abs() < 1e-2
    }
}

test System.Settle "a spiking population under a constant drive fires at the rate the analytic formula gives" {
    window I64 = 4000
    leak F64 = 0.05
    r := rand.Rand(14)
    s := System<F64>(6, 1, 1)
    h := s.Population(s.Root(), "h", 1, neuron.Neuron.Lif(leak, 1.0, 1.0, window))
    s.Plan(r)!
    drives := Array<F64>[0.5, 0.98, 1.05, 1.5, 2.5, 6.0]
    for b in range 6: s.Pop(h).Drive[b] = drives[b]
    out := s.Settle(settle.Phase.Free, settle.Budget(40 * window, 2.0 / F64(window)))
    assert out.Converged and out.Sweeps >= 2 * window and out.Sweeps % window == 0
    for b in range 6 {
        rate := s.Activity(settle.Phase.Free, h).Get(b, 0)
        f := neuron.LifRateOf(drives[b], leak, 1.0)
        if f == 0.0 { assert rate == 0.0 } else { assert (rate - f).Abs() <= f * f / (1.0 - f) + 1.0 / F64(window) }
    }
}

test System.Reset "a cold start clears the state but the fields kept across settles (LifCell.Kept)" {
    r := rand.Rand(15)
    s := System<F64>(2, 1, 1)
    h := s.Population(s.Root(), "h", 3, neuron.Neuron.Spiking(window = 8))
    s.Plan(r)!
    cells :~ s.State<neuron.LifCell<F64>>(h)
    cells.Theta[4] = 0.5
    cells.V[4] = 0.25
    cells.Trace[4] = 0.125
    s.Reset(settle.Phase.Free)
    assert cells.Theta[4] == 0.5 and cells.V[4] == 0.0 and cells.Trace[4] == 0.0
}

# a population whose model is its own: leaky linear units, u += dt (drive - u), activity u - the rate model of
# Rho.Linear written as a Dynamics
type leaky struct(rows I64, size I64) {
    size
    u mut Array<F32>& = Array<F32>(rows * size)
}

fn (l mut leaky&) Relax(drive tensor.Tensor<F32>&, dt F64, lo I64, hi I64) F64 {
    d :~ drive.Flat()!
    worst F32 = 0.0
    for i in range lo * l.size, hi * l.size {
        r := d[i] - l.u[i]
        worst = worst.Max(r.Abs())
        l.u[i] = l.u[i] + F32(dt) * r
    }
    return F64(worst)
}

fn (l leaky&) Activity() tensor.Tensor<F32> { return tensor.Tensor<F32>.Over(l.u, 0, l.u.Len())! }

fn (l mut leaky&) RelaxVjp(dy tensor.Tensor<F32>&, dx mut tensor.Tensor<F32>&) { }

test System.Settle "a custom model settles where the built-in model it restates does" {
    built := System<F32>.withHidden(neuron.Neuron.Rate(neuron.Rho.Linear))
    mine := leaky(2, 6)
    own := System<F32>.withHidden(neuron.Neuron.Custom(mine))
    a := built.Settle(settle.Phase.Free, settle.Budget(200, 1e-5))
    b := own.Settle(settle.Phase.Free, settle.Budget(200, 1e-5))
    assert a.Converged and b.Converged and a.Sweeps == b.Sweeps
    for i in range 12: assert built.State<neuron.RateCell<F32>>(Pop(1)).S[i] == own.State<neuron.RateCell<F32>>(Pop(1)).S[i]
}

fn System<T>.withHidden(model neuron.Neuron) System<T> {
    r := rand.Rand(16)
    s := System<T>(2, 2, 1)
    x := s.Population(s.Root(), "x", 4, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(s.Root(), "h", 6, model)
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, h, conn.Wiring.Dense)
    s.Plan(r)!
    for i in range 8: s.Pop(x).Drive[i] = T(r.Uniform(-1.0, 1.0))
    s.Weights(Conn(1)).Fill(T(0.1))                 # a gain of 0.6 (a custom model has no slope to certify by)
    return s
}

test System.Prune "a pruned weight is a zero weight, a retired unit rests, and compacting changes no equilibrium" {
    a := System<F64>.mixed(3, 2)
    b := System<F64>.mixed(3, 2)
    keep := Array<Bool>(b.Link(Conn(5)).Count, true)
    for e in range 0, keep.Len(), 4: keep[e] = false
    b.Prune(Conn(5), keep)
    w := a.Weights(Conn(5))
    for e in range 0, keep.Len(), 4: w.Flat()![e] = 0.0
    a.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    b.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    assert sameState(a, b)
    # a sparse block's entries masked, then dropped: the same equilibrium, fewer entries
    csr :~ b.Link(Conn(1)).Csr!
    nnz := csr.Nnz()
    drop := Array<Bool>(b.Link(Conn(1)).Count, true)
    for e in range 0, nnz, 3: drop[e] = false
    b.Prune(Conn(1), drop)
    b.Reset(settle.Phase.Free)
    b.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    before := b.State<neuron.RateCell<F64>>(Pop(2)).S.Copy()
    assert b.Compact() == (nnz + 2) / 3 and csr.Nnz() == nnz - (nnz + 2) / 3
    b.Reset(settle.Phase.Free)
    b.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    after := b.State<neuron.RateCell<F64>>(Pop(2)).S
    for i in range before.Len(): assert (before[i] - after[i]).Abs() < 1e-9
    b.Retire(Pop(1), 2)
    b.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    for row in range 3: assert b.Activity(settle.Phase.Free, Pop(1)).Get(row, 2) == 0.0
}

# every relaxing population's free activities, one array
fn activities(s System<F64>&) Array<F64> {
    v := Vec<F64>()
    for p in range 1, 4 {
        a := s.Activity(settle.Phase.Free, Pop(p))
        for i in range a.Count(): v.Push(a.Flat()![i])
    }
    return v.ToArray()
}

test System.Sparsify "dense blocks thinned by pruning, stored as sparse rows: the same equilibrium, the multiply-adds of their live weights" {
    s := System<F64>.mixed(3, 1)
    before := s.Macs()
    folded := Array<Bool>(s.Link(Conn(0)).Count, true)
    for e in range 0, folded.Len(), 2: folded[e] = false
    s.Prune(Conn(0), folded)
    back := Array<Bool>(s.Link(Conn(5)).Count, true)
    for e in range 0, back.Len(), 3: back[e] = false
    s.Prune(Conn(5), back)
    assert s.Macs().Once == before.Once and s.Macs().Sweep == before.Sweep
    s.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    want := activities(s)
    assert s.Sparsify(0.5) == 1 and s.Link(Conn(0)).Kind == conn.Wiring.Csr and s.Link(Conn(5)).Kind == conn.Wiring.Symmetric
    assert s.Sparsify(0.7) == 1 and s.Link(Conn(5)).Both
    after := s.Macs()
    assert after.Once == before.Once - 240 and after.Sweep == before.Sweep - 2 * 32
    assert after.Settle(10) == after.Once + 10 * after.Sweep
    s.Reset(settle.Phase.Free)
    s.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    got := activities(s)
    for i in range want.Len(): assert (want[i] - got[i]).Abs() < 1e-9
}

fn has<T>(s System<T>&, m Mod, name String&) Bool {
    try s.Read(m, name) catch SignalError.Missing { return false }
    return true
}

test System.Restrain "the gain caps what the recurrent connections carry into a readout unit (a hidden layer's whole vote), not a folded skip into it: the skip's carry can outvote every hidden unit" {
    s := System<F64>(1)
    x := s.Population(s.Root(), "x", 2, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(s.Root(), "h", 8, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(s.Root(), "y", 2, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes()))
    s.Connect(x, h, conn.Wiring.Dense)
    vote := s.Connect(h, y, conn.Wiring.Symmetric)
    skip := s.Connect(x, y, conn.Wiring.Dense)
    s.Plan(rand.Rand(3))!
    s.Bound = Norm.Sup                  # the gain's per-unit caps
    for i in range s.E.Params.Len(): s.E.Params[i] = 4.0 * s.E.Params[i]
    k :~ s.Link(skip)
    before := Array<F64>[s.E.Params[i] for i in range k.Off, k.Off + k.Count]
    s.Restrain(0.9)
    assert s.Gain() <= 0.9 + 1e-9
    v :~ s.Link(vote)
    for j in range 2 {
        # |sum_i W_ji h_i| <= sum_i |W_ji| for any hidden state (|h_i| <= 1, tanh's slope 1)
        mass := 0.0
        for i in range 8: mass += s.E.Params[v.Off + j * 8 + i].Abs()
        assert mass <= 0.9 + 1e-9, "hidden vote " + $mass
        # the skip, untouched, at the input corner (3, 3) or (3, -3) its carry is larger than that
        for i in range 2: assert s.E.Params[k.Off + j * 2 + i] == before[j * 2 + i]
        w0, w1 := s.E.Params[k.Off + j * 2], s.E.Params[k.Off + j * 2 + 1]
        assert 3.0 * (w0.Abs() + w1.Abs()) > 0.9, "skip " + $w0 + " " + $w1
    }
}

test System.Read "a module reads its own signal first, then its parent's" {
    s := System<F32>(1)
    child := s.Module(s.Root(), "child")
    mine := s.Signal(child, "reward")
    theirs := s.Signal(s.Root(), "reward")
    arousal := s.Signal(s.Root(), "arousal", 2)
    s.Population(s.Root(), "h", 2, neuron.Neuron.Rate(neuron.Rho.Tanh))
    s.Plan(rand.Rand(1))!
    s.Set(mine, tensor.Tensor<F32>.Of(Array<F32>[1.0], 1)!)!
    s.Set(theirs, tensor.Tensor<F32>.Of(Array<F32>[2.0], 1)!)!
    s.Set(arousal, tensor.Tensor<F32>.Of(Array<F32>[3.0, 4.0], 2)!)!
    assert s.Read(child, "reward")!.Get(0) == 1.0 and s.Read(s.Root(), "reward")!.Get(0) == 2.0
    assert s.Read(child, "arousal")!.Get(1) == 4.0
    assert not has(s, child, "nothing") and has(s, child, "arousal")
    # a signal declared after the plan: room is made, the others keep their values
    late := s.Signal(child, "late")
    s.Set(late, tensor.Tensor<F32>.Of(Array<F32>[5.0], 1)!)!
    assert s.Value(late).Get(0) == 5.0 and s.Read(child, "arousal")!.Get(1) == 4.0 and s.Value(mine).Get(0) == 1.0
}

# the peak address space, in KB (VmPeak, /proc): what the program took from the system. Not the resident set, which
# transparent huge pages (enabled "always" on some machines) grow by whole 2 MB pages a fault, whatever was allocated -
# olang's own growth checks moved to VmPeak for this (the failure seen here: 70 pages while other builds shared RAM).
# olang's allocator maps 128 KB and up a chunk at a time, so 400 lessons allocating anything at all show here
fn peak() I64 {
    st :~ try os.ReadFile("/proc/self/status") catch default ""
    for line in st.Lines() {
        if line.StartsWith("VmPeak:"): return try line[7:line.Len() - 3].Trim().ParseInt(10) catch default 0
    }
    return 0
}

test System.Settle "a lesson allocates nothing: the address space does not grow over hundreds of free and nudged settles" {
    r := rand.Rand(17)
    s := System<F32>(32, 2)
    x := s.Population(s.Root(), "x", 100, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(s.Root(), "h", 64, neuron.Neuron.Rate(neuron.Rho.Tanh))
    y := s.Population(s.Root(), "y", 10, neuron.Neuron.Rate(neuron.Rho.Tanh), neuron.Role.Readout(neuron.Cost.Classes()))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, y, conn.Wiring.Symmetric)
    s.Connect(h, h, conn.Wiring.Csr(0.2), reciprocal = true)
    s.Plan(r)!
    s.Certify(0.9)
    for i in range 32 * 100: s.Pop(x).Drive[i] = F32(r.Uniform(0.0, 1.0))
    for i in range 32: s.Pop(y).Labels[i] = I32(i % 10)
    b := settle.Budget()
    for _ in range 20 {
        s.Settle(settle.Phase.Free, b)
        s.Nudged(b)
    }
    before := peak()
    for _ in range 400 {
        s.Reset(settle.Phase.Free)
        s.Settle(settle.Phase.Free, b)
        s.Nudged(b)
    }
    grown := peak() - before
    assert grown == 0, "the address space grew by " + $grown + " KB"
}

# two inputs, five hidden units and two squared-error readouts of model, hidden and readout reciprocal, every relaxing
# unit biased above its threshold: a spiking system and its rate model alike
fn System<T>.lifty(model neuron.Neuron) System<T> {
    r := rand.Rand(21)
    s := System<T>(2)
    root := s.Root()
    x := s.Population(root, "x", 2, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
    h := s.Population(root, "h", 5, model)
    o := s.Population(root, "o", 2, model, neuron.Role.Readout(neuron.Cost.Squared))
    s.Connect(x, h, conn.Wiring.Dense)
    s.Connect(h, o, conn.Wiring.Symmetric)
    s.Plan(r)!
    w :~ s.Weights(Conn(1)).Flat()!
    for i in range w.Len(): w[i] = w[i] * T(2)
    for j in range 5: s.E.Params[s.Pop(h).Bias + j] = T(1.3 + 0.1 * F64(j))
    for j in range 2: s.E.Params[s.Pop(o).Bias + j] = T(1.5)
    for j in range 4: s.Pop(x).Drive[j] = T(r.Uniform(0.0, 1.0))
    t :~ s.Pop(o).Target
    t[0], t[1], t[2], t[3] = T(0.15), T(0.02), T(0.02), T(0.15)
    return s
}

test System.Settle "a spiking system settles to its rate model's equilibrium, free and nudged" {
    window I64 = 20000
    a := System<F64>.lifty(neuron.Neuron.Lif(0.1, 1.0, 0.1, window))
    b := System<F64>.lifty(neuron.Neuron.Rate(neuron.Rho.LifRate(0.1, 1.0)))
    spiking := a.Settle(settle.Phase.Free, settle.Budget(40 * window, 2.0 / F64(window)))
    rate := b.Settle(settle.Phase.Free, settle.Budget(20000, 1e-12, 0.75))
    assert spiking.Converged and rate.Converged, "spiking " + $spiking + ", rate " + $rate
    worst F64 = 0.0
    for p in range 1, 3 {
        for row in range 2 {
            for j in range a.Pop(Pop(p)).Size: worst = worst.Max((a.Activity(settle.Phase.Free, Pop(p)).Get(row, j) - b.Activity(settle.Phase.Free, Pop(p)).Get(row, j)).Abs())
        }
    }
    assert worst < 0.015, "rates within " + $worst
    nudged := a.Nudged(settle.Budget(40 * window, 2.0 / F64(window)), 1.0)
    assert nudged.Converged
    # the plus phase moved its readout toward the targets: 0.15 and 0.02 in row 0
    plus := a.Activity(settle.Phase.Plus, Pop(2))
    free := a.Activity(settle.Phase.Free, Pop(2))
    assert (plus.Get(0, 0) - 0.15).Abs() <= (free.Get(0, 0) - 0.15).Abs() + 2.0 / F64(window)
}

test System.Retire "a system with a retired unit converges, free and nudged, the unit at rest" {
    a := System<F64>.mixed(3, 1)
    a.Retire(Pop(1), 2)
    a.Retire(Pop(3), 0)
    out := a.Settle(settle.Phase.Free, settle.Budget(256, 1e-10))
    assert out.Converged, $out
    nudged := a.Nudged(settle.Budget(256, 1e-10))
    assert nudged.Converged, $nudged
    for row in range 3: assert a.Activity(settle.Phase.Free, Pop(1)).Get(row, 2) == 0.0 and a.Activity(settle.Phase.Plus, Pop(3)).Get(row, 0) == 0.0
    # before the fix a retired unit's residual was its total against its zeroed state: never within the tolerance
    assert out.Sweeps < 64 and nudged.Sweeps < 64
    # a retired spiking unit does not keep its system from converging either
    s := System<F64>.lifty(neuron.Neuron.Lif(0.1, 1.0, 0.1, 400))
    s.Retire(Pop(1), 1)
    assert s.Settle(settle.Phase.Free, settle.Budget(40 * 400, 2.0 / 400.0)).Converged
}

# a settle, a nudged pair and a lesson allocate nothing: every product's workspace is reserved at Plan (Engine.Ready),
# so a sweep, a settle and a lesson can be pinned allocation-free
fn settleOf(s mut System<F32>&, b settle.Budget) F64 { return s.Settle(settle.Phase.Free, b).Residual }
fn nudgedOf(s mut System<F32>&, b settle.Budget) F64 { return s.Nudged(b).Residual }
assert not settleOf.Allocates, "a settle allocates"
assert not nudgedOf.Allocates, "a nudged pair allocates"

test System.Settle "weights packed ahead - a reciprocal connection of a population to itself merged into one product - settle to the fixed point the unpacked sweeps reach" {
    sizes := Array<I64>[96, 160]
    for gs in Array<Bool>[false, true] {
        for at in range 2 {
            n := sizes[at]
            states := Vec<Array<F64>>()
            for ahead in Array<Bool>[false, true] {
                s := System<F64>(9, 1)
                x := s.Population(s.Root(), "x", 7, neuron.Neuron.Rate(neuron.Rho.Linear), neuron.Role.Input)
                h := s.Population(s.Root(), "h", n, neuron.Neuron.Rate(neuron.Rho.Tanh))
                g := s.Population(s.Root(), "g", 80, neuron.Neuron.Rate(neuron.Rho.Tanh))
                s.Connect(x, h, conn.Wiring.Dense)
                s.Connect(h, h, conn.Wiring.Dense, reciprocal = true)
                s.Connect(h, g, conn.Wiring.Symmetric)
                try s.Plan(rand.Rand(5)) catch { unreachable }
                s.Certify(0.7)
                s.E.PackAhead = ahead
                d := rand.Rand(6)
                for i in range s.Pop(x).Drive.Len(): s.Pop(x).Drive[i] = d.Uniform(-1.0, 1.0)
                out := s.Settle(settle.Phase.Free, settle.Budget(300, 1e-11, Scheme = settle.Sweeping(GaussSeidel = gs)))
                assert out.Converged, "n " + $n + ": " + $out.Residual
                st := s.State<neuron.RateCell<F64>>(h).S
                kept := Array<F64>(st.Len())
                for i in range st.Len(): kept[i] = st[i]
                states.Push(kept)
            }
            for i in range states[0].Len(): assert (states[0][i] - states[1][i]).Abs() < 1e-9, "n " + $n + " unit " + $i
        }
    }
}
